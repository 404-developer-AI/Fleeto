<Project Sdk="Microsoft.NET.Sdk">
  <!--
    fleeto-tool: migrations and instance initialisation (run by install.sh and setup-dev.ps1), and the Steaan
    key and signing utilities for licenses, releases and backups.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>fleeto-tool</AssemblyName>
    <RootNamespace>Fleeto.Tools</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fleeto.Infrastructure\Fleeto.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
