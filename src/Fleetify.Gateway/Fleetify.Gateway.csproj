<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    fleetify-gateway: the agent endpoint. Enrollment over HTTPS, then one mTLS WebSocket per agent for heartbeats,
    inventory, check results, certificate renewal and signed configuration delivery (ARCHITECTURE.md §1, §4).
  -->
  <PropertyGroup>
    <AssemblyName>Fleetify.Gateway</AssemblyName>
    <RootNamespace>Fleetify.Gateway</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fleetify.Infrastructure\Fleetify.Infrastructure.csproj" />
    <ProjectReference Include="..\Fleetify.Protocol\Fleetify.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Fleetify.Gateway.Tests" />
  </ItemGroup>
</Project>
