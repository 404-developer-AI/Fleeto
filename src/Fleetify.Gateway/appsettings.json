{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Fleetify": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ ",
        "UseUtcTimestamp": true
      }
    }
  },
  "Fleetify": {
    "Secrets": {
      "Directory": ""
    },
    "Database": {
      "Host": "postgres",
      "Port": 5432,
      "Name": "fleetify",
      "MaxPoolSize": 50
    }
  },
  "Gateway": {
    "ListenAddress": "0.0.0.0",
    "AgentPort": 8443,
    "HealthPort": 8081
  }
}
