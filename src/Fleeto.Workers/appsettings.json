{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Amazon": "Warning"
    }
  },
  "Fleeto": {
    "Secrets": {
      "Directory": ""
    },
    "Database": {
      "Host": "postgres",
      "Port": 5432,
      "Name": "fleeto"
    }
  },
  "Email": {
    "PickupDirectory": "",
    "SmtpTimeoutSeconds": 30,
    "CircuitBreakerFailures": 5,
    "CircuitBreakerPauseMinutes": 5,
    "BatchSize": 50
  },
  "Backup": {
    "PgDumpPath": "pg_dump",
    "PgDumpTimeoutMinutes": 180,
    "TempDirectory": "",
    "WalSpoolDirectory": "",
    "UploadAttempts": 3,
    "UploadTimeoutMinutes": 60
  },
  "CheckEvaluation": {
    "Parallelism": 8,
    "BatchSize": 500,
    "SweepWindowMinutes": 10,
    "WideSweepWindowHours": 24
  }
}
