{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Fleeto": {
    "Database": {
      "Host": "localhost",
      "Port": 5432,
      "Name": "fleeto_dev"
    }
  },
  "Web": {
    "HttpPort": 0
  },
  "ReverseProxy": {
    "Enabled": false,
    "KnownNetworks": []
  },
  "DataProtection": {
    "KeysDirectory": "%LOCALAPPDATA%/Fleeto/dev/web-keys"
  },
  "Agent": {
    "BinariesDirectory": "../../agent/dist"
  },
  "Remote": {
    "RelayUrl": "ws://localhost:5202/relay/v1/sessions/"
  }
}
