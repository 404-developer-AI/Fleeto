@inherits LayoutComponentBase
@layout MainLayout
@inject CurrentUser CurrentUser

@* Settings workspace: the settings pages on the left, the selected page on the right. Each page shows only with its permission (0.6.0). *@
<div class="settings-workspace">
    <aside class="client-panel">
        <div class="client-panel-head">
            <span class="settings-panel-title">
                <MudIcon Icon="@Icons.Material.Outlined.Settings" Size="Size.Small" />
                <span>Settings</span>
            </span>
        </div>
        <nav class="client-panel-list" aria-label="Settings">
            @if (_pages.Any(p => !p.Administration))
            {
                <div class="settings-group-title">Templates</div>
                @foreach (var entry in _pages.Where(p => !p.Administration))
                {
                    @Item(entry)
                }
            }
            @if (_pages.Any(p => p.Administration))
            {
                <div class="settings-group-title">Administration</div>
                @foreach (var entry in _pages.Where(p => p.Administration))
                {
                    @Item(entry)
                }
            }
        </nav>
    </aside>

    <section class="workspace-main">
        @Body
    </section>
</div>

@code {
    private IReadOnlyList<SettingsPage> _pages = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _pages = SettingsPages.For(await CurrentUser.TryGetAsync());
        }
        catch (Exception)
        {
            // The panel stays empty; the page itself decides whether it may be shown.
        }
    }

    private static RenderFragment Item(SettingsPage entry) => __builder =>
    {
        <NavLink href="@entry.Href" Match="NavLinkMatch.Prefix" class="settings-link" ActiveClass="selected">
            <MudIcon Icon="@entry.Icon" Size="Size.Small" Class="settings-link-icon" />
            <span class="client-name">@entry.Label</span>
        </NavLink>
    };
}
