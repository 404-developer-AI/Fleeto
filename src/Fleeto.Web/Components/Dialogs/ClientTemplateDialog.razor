@* Create or edit a client template: the policy, patch policy and monitoring templates of the client itself (0.6.0), and its
   sites, each following the client unless it has its own. Only global ones can be used. *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsEdit ? "Edit client template" : "New client template")</MudText>
    </TitleContent>
    <DialogContent>
        @if (IsEdit && ClientCount > 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                @ClientCount client@(ClientCount == 1 ? " follows" : "s follow") this template. Saving applies the changes to @(ClientCount == 1 ? "it" : "all of them").
            </MudAlert>
        }
        <div class="d-flex gap-3 flex-wrap mb-4">
            <MudTextField @bind-Value="_name" Label="Name" Variant="Variant.Outlined" MaxLength="100" AutoFocus="true" Style="min-width:220px" Class="flex-1" />
            <MudTextField @bind-Value="_description" Label="Description (optional)" Variant="Variant.Outlined" MaxLength="1000" Style="min-width:220px" Class="flex-1" />
        </div>

        <div class="fl-panel pa-3 mb-4">
            <MudText Typo="Typo.subtitle1">The client</MudText>
            <MudText Typo="Typo.body2" Class="muted mb-3">Applies to every site and endpoint of the client, unless a site below has its own.</MudText>
            <LinkEditor Selection="_client" Choices="Choices" PolicyInherit="@InheritTexts.Same("Default policy")"
                        PatchInherit="@InheritTexts.Same("No patch policy")" Changed="StateHasChanged" />
        </div>

        <div class="d-flex align-center justify-space-between mb-2">
            <MudText Typo="Typo.subtitle1">Sites</MudText>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Add" OnClick="AddSite">Add site</MudButton>
        </div>
        <MudExpansionPanels MultiExpansion="true" Elevation="0" Class="mb-2">
            @foreach (var site in _sites)
            {
                <MudExpansionPanel @bind-Expanded="site.Expanded" Class="fl-panel mb-2">
                    <TitleContent>
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Outlined.Folder" Size="Size.Small" />
                            <MudText Typo="Typo.body1">@(string.IsNullOrWhiteSpace(site.Name) ? "New site" : site.Name)</MudText>
                            <MudText Typo="Typo.body2" Class="muted">@Summary(site)</MudText>
                        </div>
                    </TitleContent>
                    <ChildContent>
                        <div class="d-flex gap-2 align-start flex-wrap">
                            <MudTextField @bind-Value="site.Name" Label="Site name" Variant="Variant.Outlined" MaxLength="100" Margin="Margin.Dense"
                                          Style="min-width:200px" Class="flex-1" />
                            <MudTextField @bind-Value="site.Description" Label="Description (optional)" Variant="Variant.Outlined" MaxLength="1000"
                                          Margin="Margin.Dense" Style="min-width:200px" Class="flex-1" />
                            <MudTooltip Text="Remove site">
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" OnClick="@(() => _sites.Remove(site))" Class="mt-1" />
                            </MudTooltip>
                        </div>
                        <div class="mt-3">
                            <LinkEditor Selection="site.Links" Choices="Choices" Changed="StateHasChanged"
                                        PolicyInherit="@SameAsClient(_client.Policy, Choices.Policies, "default policy")"
                                        PatchInherit="@SameAsClient(_client.PatchPolicy, Choices.PatchPolicies, "no patch policy")"
                                        InheritedTemplates="ClientTemplates" />
                        </div>
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
        @if (_sites.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="muted">Add at least one site: a client needs at least one site.</MudText>
        }
        <MudText Typo="Typo.caption" Class="muted d-block">
            Only global policies, patch policies and monitoring templates can be used, because a client template applies to any client.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">@(IsEdit ? "Save" : "Create")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private sealed class SiteModel
    {
        public Guid? Id { get; init; }
        public string? Name { get; set; }
        public string? Description { get; set; }
        public LinkSelection Links { get; init; } = new();
        public bool Expanded { get; set; }
    }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public ClientTemplateDetail? Existing { get; set; }

    /// <summary>The global policies, patch policies and monitoring templates.</summary>
    [Parameter, EditorRequired] public LinkChoices Choices { get; set; } = default!;

    [Parameter] public Func<ClientTemplateInput, Task<bool>> OnSubmit { get; set; } = _ => Task.FromResult(true);

    private bool IsEdit => Existing is not null;
    private int ClientCount => Existing?.ClientCount ?? 0;

    private string _name = string.Empty;
    private string? _description;
    private LinkSelection _client = new();
    private List<SiteModel> _sites = [];
    private bool _busy;

    /// <summary>The monitoring templates of the client, which every site runs as well.</summary>
    private IReadOnlyList<InheritedLink> ClientTemplates => _client.TemplateIds
        .Select(id => Choices.MonitoringTemplates.FirstOrDefault(t => t.Id == id))
        .OfType<LinkOption>()
        .Select(t => new InheritedLink(t.Id, t.Name, LinkLevel.Client))
        .ToList();

    protected override void OnInitialized()
    {
        if (Existing is { } template)
        {
            _name = template.Name;
            _description = template.Description;
            _client = LinkSelection.From(template.Client.Policy, template.Client.PatchPolicy, template.Client.MonitoringTemplateIds);
            _sites = template.Sites.Select(s => new SiteModel
            {
                Id = s.Id,
                Name = s.Name,
                Description = s.Description,
                Links = LinkSelection.From(s.Policy, s.PatchPolicy, s.MonitoringTemplateIds)
            }).ToList();
        }
        else
        {
            _sites = [new SiteModel { Name = "Monitoring", Expanded = true }];
        }
    }

    private void AddSite() => _sites.Add(new SiteModel { Expanded = true });

    /// <summary>The empty choices of a site: "Same as client (Servers weekly)", per class when the client chose per class.</summary>
    private static InheritTexts SameAsClient(ClassSelection client, IReadOnlyList<LinkOption> options, string none)
    {
        string Name(Guid? id) => options.FirstOrDefault(o => o.Id == id)?.Name ?? none;
        var server = $"Same as client ({Name(client.For(EndpointClass.Server))})";
        var workstation = $"Same as client ({Name(client.For(EndpointClass.Workstation))})";
        var all = client.For(EndpointClass.Server) == client.For(EndpointClass.Workstation)
            ? server
            : $"Same as client ({Name(client.For(EndpointClass.Server))} for servers, {Name(client.For(EndpointClass.Workstation))} for workstations)";
        return new InheritTexts(all, server, workstation);
    }

    /// <summary>One line under a collapsed site: what it has of its own.</summary>
    private string Summary(SiteModel site)
    {
        var own = new List<string>();
        own.AddRange(site.Links.Policy.ToChoice().Ids.Select(id => Choices.Policies.FirstOrDefault(p => p.Id == id)?.Name).OfType<string>());
        own.AddRange(site.Links.PatchPolicy.ToChoice().Ids.Select(id => Choices.PatchPolicies.FirstOrDefault(p => p.Id == id)?.Name).OfType<string>());

        if (site.Links.TemplateIds.Count > 0)
        {
            own.Add(Ui.Count(site.Links.TemplateIds.Count, "monitoring template"));
        }

        return own.Count == 0 ? "Same as the client" : string.Join(" · ", own);
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        _busy = true;
        try
        {
            var input = new ClientTemplateInput(_name, _description,
                _sites.Select(s => new ClientTemplateSiteInput(s.Id, s.Name, s.Description, s.Links.Policy.ToChoice(), s.Links.TemplateIds.ToList(),
                    s.Links.PatchPolicy.ToChoice())).ToList(),
                new ClientTemplateClientLinks(_client.Policy.ToChoice(), _client.PatchPolicy.ToChoice(), _client.TemplateIds.ToList()));
            if (await OnSubmit(input))
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
