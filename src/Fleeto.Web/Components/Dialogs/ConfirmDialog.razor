@* Confirmation for destructive or privileged actions. Optionally requires typing a text (such as a client code) or a reason. *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body1" Class="mb-3" Style="white-space:pre-line;">@Message</MudText>
        @if (!string.IsNullOrEmpty(TypeToConfirm))
        {
            <MudTextField @bind-Value="_typed" Label="@($"Type {TypeToConfirm} to confirm")" Variant="Variant.Outlined"
                          Immediate="true" AutoFocus="true" MaxLength="100" />
        }
        @if (!string.IsNullOrEmpty(ReasonLabel))
        {
            <MudTextField @bind-Value="_reason" Label="@ReasonLabel" Variant="Variant.Outlined" Lines="2" Immediate="true"
                          AutoFocus="true" MaxLength="500" Counter="500" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="@ConfirmColor" Variant="Variant.Filled" OnClick="Confirm" Disabled="@(!CanConfirm)">@ConfirmText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string Title { get; set; } = "Confirm";
    [Parameter] public string Message { get; set; } = string.Empty;
    [Parameter] public string ConfirmText { get; set; } = "Delete";
    [Parameter] public Color ConfirmColor { get; set; } = Color.Error;

    /// <summary>When set, the confirm button stays disabled until exactly this text is typed (case-insensitive).</summary>
    [Parameter] public string? TypeToConfirm { get; set; }

    /// <summary>When set, a reason is required; the dialog result carries it.</summary>
    [Parameter] public string? ReasonLabel { get; set; }

    private string _typed = string.Empty;
    private string _reason = string.Empty;

    private bool CanConfirm =>
        (string.IsNullOrEmpty(TypeToConfirm) || string.Equals(_typed.Trim(), TypeToConfirm, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(ReasonLabel) || !string.IsNullOrWhiteSpace(_reason));

    private void Cancel() => MudDialog.Cancel();

    private void Confirm()
    {
        if (CanConfirm)
        {
            MudDialog.Close(DialogResult.Ok(!string.IsNullOrEmpty(ReasonLabel) ? _reason.Trim() : _typed.Trim()));
        }
    }
}
