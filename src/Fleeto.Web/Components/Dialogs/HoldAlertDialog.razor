@* Put an alert on hold until a time. Never called snooze, mute or silenced (branding §6). *@
@inject TimeDisplay Time
@inject TimeProvider Clock

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Put alert on hold</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">@Alert.Title</MudText>
        <MudText Typo="Typo.body2" Class="muted mb-3">
            While the alert is on hold, no emails are sent for it and it is left out of the open alerts. It still resolves when
            the cause recovers. If it is still open when the hold ends, it returns and one email is sent.
        </MudText>
        <MudRadioGroup T="int" @bind-Value="_choice">
            <MudRadio T="int" Value="1" Color="Color.Primary">1 hour</MudRadio>
            <MudRadio T="int" Value="4" Color="Color.Primary">4 hours</MudRadio>
            <MudRadio T="int" Value="24" Color="Color.Primary">24 hours</MudRadio>
            <MudRadio T="int" Value="0" Color="Color.Primary">Until a chosen time</MudRadio>
        </MudRadioGroup>
        @if (_choice == 0)
        {
            <DateTimeField @bind-Value="_until" Label="On hold until" Min="@LocalNow" Max="@LocalNow.AddDays(7)" Class="mt-2" />
            <MudText Typo="Typo.caption" Class="muted d-block mt-1">In your time zone. A hold lasts at most 7 days.</MudText>
        }
        <MudTextField @bind-Value="_comment" Label="Comment" Required="true" Placeholder="For example: waiting for a replacement disk"
                      Variant="Variant.Outlined" Lines="3" MaxLength="@AlertActivity.MaxCommentLength" Counter="@AlertActivity.MaxCommentLength"
                      Immediate="true" Class="mt-3" />
        <MudText Typo="Typo.caption" Class="muted d-block mt-1">Shown with the alert in the history of the endpoint.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="@(_busy || (_choice == 0 && _until is null) || string.IsNullOrWhiteSpace(_comment))">Put on hold</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public AlertView Alert { get; set; } = default!;

    /// <summary>Receives the end of the hold in UTC and the comment; returns true when the hold was saved.</summary>
    [Parameter] public Func<DateTime, string?, Task<bool>> OnSubmit { get; set; } = (_, _) => Task.FromResult(true);

    private int _choice = 1;
    private DateTime? _until;
    private string? _comment;
    private bool _busy;

    private DateTime LocalNow => TimeZoneInfo.ConvertTimeFromUtc(Clock.GetUtcNow().UtcDateTime, Time.Zone);

    protected override void OnInitialized()
    {
        var suggestion = LocalNow.AddHours(2);
        _until = suggestion.Date.AddHours(suggestion.Hour);
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        DateTime untilUtc;
        if (_choice == 0)
        {
            var local = DateTime.SpecifyKind(_until!.Value, DateTimeKind.Unspecified);
            if (Time.Zone.IsInvalidTime(local))
            {
                local = local.AddHours(1);
            }

            untilUtc = TimeZoneInfo.ConvertTimeToUtc(local, Time.Zone);
        }
        else
        {
            untilUtc = Clock.GetUtcNow().UtcDateTime.AddHours(_choice);
        }

        _busy = true;
        try
        {
            if (await OnSubmit(untilUtc, _comment))
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
