@* Edit an endpoint: its description, class and site. Opened from the endpoint menu of the clients workspace. *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Edit endpoint · @Endpoint.Hostname</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.subtitle2" Class="mb-3">Management</MudText>
        <MudTextField T="string" @bind-Value="_description" Variant="Variant.Outlined" Label="Description" Margin="Margin.Dense" Class="mb-4"
                      Disabled="@(!CanChangeClass)" MaxLength="EndpointDescriptionRules.MaxLength" Counter="EndpointDescriptionRules.MaxLength" Immediate="true"
                      HelperText="Shown in the endpoint list, for example what the endpoint is for or where it stands. Never changed by the agent." />
        <MudSelect T="string" @bind-Value="_class" Variant="Variant.Outlined" Label="Endpoint class" Margin="Margin.Dense" Class="mb-4" Disabled="@(!CanChangeClass)"
                   HelperText="Detected from the OS edition. Override it when the detection does not fit.">
            <MudSelectItem T="string" Value="@("detected")">Detected (@Ui.ClassLabel(Endpoint.DetectedClass))</MudSelectItem>
            <MudSelectItem T="string" Value="@("workstation")">Workstation</MudSelectItem>
            <MudSelectItem T="string" Value="@("server")">Server</MudSelectItem>
        </MudSelect>
        <MudSelect T="Guid" @bind-Value="_siteId" Variant="Variant.Outlined" Label="Site" Margin="Margin.Dense" Disabled="@(!CanMove)"
                   HelperText="An endpoint can move between sites of the same client only.">
            @foreach (var site in Endpoint.ClientSites)
            {
                <MudSelectItem T="Guid" Value="@site.Id">@site.Name</MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="@(_busy || !Changed)">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public EndpointDetail Endpoint { get; set; } = default!;

    /// <summary>The class may be overridden and the description changed (0.6.0, description 0.8.0).</summary>
    [Parameter] public bool CanChangeClass { get; set; } = true;

    /// <summary>The endpoint may move to another site (0.6.0).</summary>
    [Parameter] public bool CanMove { get; set; } = true;

    /// <summary>Saves what changed: the class override, the site and the description. Returns true when everything saved.</summary>
    [Parameter] public Func<EndpointEdit, Task<bool>> OnSubmit { get; set; } = _ => Task.FromResult(true);

    private string _class = "detected";
    private Guid _siteId;
    private string? _description;
    private bool _busy;

    private EndpointClass? ClassOverride => _class switch { "workstation" => EndpointClass.Workstation, "server" => EndpointClass.Server, _ => null };
    private bool ClassChanged => ClassOverride != Endpoint.ClassOverride;
    private bool SiteChanged => _siteId != Endpoint.SiteId;
    private bool DescriptionChanged => (EndpointDescriptionRules.Clean(_description).Value ?? string.Empty) != (Endpoint.Description ?? string.Empty);
    private bool Changed => ClassChanged || SiteChanged || DescriptionChanged;

    protected override void OnInitialized()
    {
        _class = Endpoint.ClassOverride switch
        {
            EndpointClass.Workstation => "workstation",
            EndpointClass.Server => "server",
            _ => "detected"
        };
        _siteId = Endpoint.SiteId;
        _description = Endpoint.Description;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            if (await OnSubmit(new EndpointEdit(ClassOverride, ClassChanged, _siteId, SiteChanged, _description, DescriptionChanged)))
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
