@* The tags of a client (0.6.0): type a new tag or pick an existing one. A new tag gets the color of its name; admins change colors in Settings, Tags. *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Tags of client @ClientCode</MudText>
    </TitleContent>
    <DialogContent>
        <TagEditor @ref="_editor" Tags="_tags" Available="Available" AutoFocus="true" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string ClientCode { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<TagView> Current { get; set; } = [];

    /// <summary>The tags the user may see, to pick from.</summary>
    [Parameter] public IReadOnlyList<TagView> Available { get; set; } = [];

    [Parameter] public Func<IReadOnlyList<string>, Task<bool>> OnSubmit { get; set; } = _ => Task.FromResult(true);

    private readonly List<TagView> _tags = [];
    private TagEditor? _editor;
    private bool _busy;

    protected override void OnInitialized() => _tags.AddRange(Current);

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        if (_editor is not null && !_editor.CommitTyped())
        {
            return;
        }

        _busy = true;
        try
        {
            if (await OnSubmit(_tags.Select(t => t.Name).ToList()))
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
