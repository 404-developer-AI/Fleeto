@* Create or edit a patch policy (0.6.0). The engine is chosen first (0.9.0): for Action1 every option is one an Action1 automation
   offers (PatchPolicyRules), except turning automatic Windows Update off, which the Fleeto agent does itself (0.7.0); for Fleeto only
   the options of the rounds the Fleeto agent carries out. The scope (global or one client) is chosen at creation and cannot change. *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsEdit ? $"Edit patch policy {_m.Name}" : "New patch policy")</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.subtitle2" Class="mb-1">Who installs the updates</MudText>
        <MudRadioGroup T="PatchEngine" @bind-Value="_m.Engine" Class="mb-1">
            <MudRadio T="PatchEngine" Value="PatchEngine.Fleeto" Color="Color.Primary" Dense="true">Patched by Fleeto</MudRadio>
            <MudRadio T="PatchEngine" Value="PatchEngine.Action1" Color="Color.Primary" Dense="true">Patched by Action1</MudRadio>
        </MudRadioGroup>
        <MudText Typo="Typo.caption" Class="muted d-block mb-3">
            @if (Fleeto)
            {
                @:The Fleeto agent installs the updates in rounds, with the Windows Update Agent, apt or dnf of the endpoint. An endpoint with the Action1 agent stays with Action1, and this policy installs nothing there.
            }
            else
            {
                @:Fleeto keeps an Action1 automation per client for this policy. Endpoints without the Action1 agent get nothing from it.
            }
            @if (IsEdit && Existing!.Engine != _m.Engine)
            {
                @: Changing the engine applies to every endpoint that uses this policy at once.
            }
        </MudText>
        <MudTextField @bind-Value="_m.Name" Label="Name" Variant="Variant.Outlined" MaxLength="@PatchPolicyRules.MaxNameLength" AutoFocus="true" Class="mb-3" />
        <MudTextField @bind-Value="_m.Description" Label="Description (optional)" Variant="Variant.Outlined" Lines="2"
                      MaxLength="@PatchPolicyRules.MaxDescriptionLength" Class="mb-3" />
        @if (!IsEdit)
        {
            <MudSelect T="Guid?" @bind-Value="_clientId" Label="Available for" Variant="Variant.Outlined" Class="mb-3"
                       HelperText="A global patch policy can be linked anywhere and used in client templates; a client patch policy only within that client.">
                <MudSelectItem T="Guid?" Value="@((Guid?)null)">Global (all clients)</MudSelectItem>
                @foreach (var client in Clients)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)client.Id)">@client.Code - @client.Name</MudSelectItem>
                }
            </MudSelect>
        }
        <AppliesToSelect @bind-Value="_m.AppliesTo" Class="mb-3"
                         HelperText="A patch policy for servers or workstations never applies to the other class, wherever it is linked." />
        <MudSwitch T="bool" @bind-Value="_m.Enabled" Color="Color.Primary" Label="Enabled" />
        <MudText Typo="Typo.caption" Class="muted d-block mb-2">@(Fleeto ? "Off starts no rounds. Endpoints are still scanned." : "Off keeps the automations in Action1 but stops them from running.")</MudText>

        <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Schedule</MudText>
        <MudSelect T="PatchScheduleKind" @bind-Value="_m.ScheduleKind" Label="Runs" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2">
            <MudSelectItem T="PatchScheduleKind" Value="PatchScheduleKind.Weekly">Every week, on the chosen days</MudSelectItem>
            <MudSelectItem T="PatchScheduleKind" Value="PatchScheduleKind.MonthlyDay">Every month, on a day of the month</MudSelectItem>
            <MudSelectItem T="PatchScheduleKind" Value="PatchScheduleKind.MonthlyWeekday">Every month, on a weekday such as the second Tuesday</MudSelectItem>
        </MudSelect>
        @switch (_m.ScheduleKind)
        {
            case PatchScheduleKind.Weekly:
                <div class="d-flex flex-wrap gap-1 mb-2">
                    @foreach (var day in WeekOrder)
                    {
                        var flag = PatchPolicyRules.Flag(day);
                        <MudCheckBox T="bool" Value="@_m.WeekDays.HasFlag(flag)" ValueChanged="@(v => _m.WeekDays = v ? _m.WeekDays | flag : _m.WeekDays & ~flag)"
                                     Label="@day.ToString()[..3]" Size="Size.Small" Color="Color.Primary" Dense="true" />
                    }
                </div>
                break;
            case PatchScheduleKind.MonthlyDay:
                <MudNumericField T="int" @bind-Value="_m.MonthDay" Label="Day of the month" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="31"
                                 Style="max-width:180px" Class="mb-2" HelperText="A month without this day skips it." />
                break;
            default:
                <div class="d-flex gap-2 mb-2">
                    <MudSelect T="int" @bind-Value="_m.MonthWeek" Label="Week" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:140px">
                        @for (var week = 1; week <= 4; week++)
                        {
                            var value = week;
                            <MudSelectItem T="int" Value="value">@PatchPolicyRules.Ordinal(value)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="DayOfWeek" @bind-Value="_m.MonthWeekday" Label="Weekday" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:170px">
                        @foreach (var day in WeekOrder)
                        {
                            <MudSelectItem T="DayOfWeek" Value="day">@day</MudSelectItem>
                        }
                    </MudSelect>
                </div>
                break;
        }
        <div class="d-flex gap-2 align-start">
            <TimeField @bind-Value="_m.Start" Label="Starts at" Margin="Margin.Dense" />
            <MudSelect T="bool" @bind-Value="_m.EndpointLocalTime" Label="Time zone" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:260px">
                <MudSelectItem T="bool" Value="true">The endpoint's own time</MudSelectItem>
                <MudSelectItem T="bool" Value="false">UTC</MudSelectItem>
            </MudSelect>
        </div>
        <MudText Typo="Typo.caption" Class="muted d-block">@PatchPolicyRules.DescribeSchedule(_m.ToPolicy()).</MudText>

        <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Updates</MudText>
        <MudRadioGroup T="PatchUpdateScope" @bind-Value="_m.Scope">
            <MudRadio T="PatchUpdateScope" Value="PatchUpdateScope.All" Color="Color.Primary" Dense="true">All missing updates</MudRadio>
            <MudRadio T="PatchUpdateScope" Value="PatchUpdateScope.Filtered" Color="Color.Primary" Dense="true">Only the updates that match these filters</MudRadio>
        </MudRadioGroup>
        @if (_m.Scope == PatchUpdateScope.Filtered)
        {
            <div class="fl-panel pa-3 mt-2">
                @if (!Fleeto)
                {
                    <MudSelect T="string" MultiSelection="true" @bind-SelectedValues="_m.Sources" Label="Sources" Variant="Variant.Outlined" Margin="Margin.Dense"
                               HelperText="Empty means every source. Applications are third-party updates." Class="mb-3">
                        @foreach (var value in PatchPolicyRules.UpdateSources)
                        {
                            <MudSelectItem T="string" Value="value">@value</MudSelectItem>
                        }
                    </MudSelect>
                }
                <MudSelect T="string" MultiSelection="true" @bind-SelectedValues="_m.Severities" Label="Security severities" Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           HelperText="@(Fleeto ? "Empty means every severity. On Linux the severity of an update is the highest of the vulnerabilities it fixes." : "Empty means every severity.")">
                    @foreach (var value in PatchPolicyRules.Severities)
                    {
                        <MudSelectItem T="string" Value="value">@value</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" MultiSelection="true" @bind-SelectedValues="_m.Types" Label="Update types" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Class="mt-3" HelperText="Empty means every type.">
                    @foreach (var value in PatchPolicyRules.UpdateTypes.Where(t => !Fleeto || t != "Feature Updates"))
                    {
                        <MudSelectItem T="string" Value="value">@value</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="_m.ExcludedNames" Label="Leave out updates named (optional)" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Class="mt-3"
                              HelperText="@(Fleeto ? "Separate with commas; * matches anything. The title of a Windows update, the package name on Linux." : "Separate with commas; * matches anything, as in Mozilla*.")" />
                @if (!Fleeto)
                {
                    <MudTextField @bind-Value="_m.ExcludedVendors" Label="Leave out vendors (optional)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Class="mt-3" HelperText="Separate with commas; * matches anything." />
                }
                <MudText Typo="Typo.caption" Class="muted d-block mt-2">An update must match every filter that is set.</MudText>
            </div>
        }

        @if (Fleeto)
        {
            <MudSwitch T="bool" @bind-Value="_m.LinuxSecurityOnly" Color="Color.Primary" Label="Linux: security updates only" Class="mt-3" />
            <MudText Typo="Typo.caption" Class="muted d-block">
                @(_m.LinuxSecurityOnly
                    ? "Only updates from a security archive or advisory are installed on Linux. The rest stays missing on the Patches tab."
                    : "Linux installs every missing update, as a full upgrade (apt dist-upgrade, dnf upgrade) does.")
            </MudText>
            <MudSwitch T="bool" @bind-Value="_m.IncludeDrivers" Color="Color.Primary" Label="Windows: also drivers" Class="mt-2" />
            <MudSwitch T="bool" @bind-Value="_m.MicrosoftUpdate" Color="Color.Primary" Label="Windows: also Microsoft Update" />
            <MudText Typo="Typo.caption" Class="muted d-block">
                @(_m.MicrosoftUpdate
                    ? "The agent registers Microsoft Update for the updates of Office, SQL Server and .NET. An endpoint a WSUS serves keeps its WSUS."
                    : "Only what Windows Update, or the WSUS of a group policy, offers. Feature updates of Windows are never installed.")
            </MudText>

            <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Wait after release</MudText>
            <MudNumericField T="int" @bind-Value="_m.InstallDelayDays" Label="Wait after release (days)" Variant="Variant.Outlined" Margin="Margin.Dense"
                             Min="0" Max="@PatchPolicyRules.MaxInstallDelayDays" Style="max-width:220px"
                             HelperText="0 installs an update in the first round. Without a release date Fleeto counts from the day it first saw the update missing." />
        }
        else
        {
            <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Approval</MudText>
            <MudRadioGroup T="bool" @bind-Value="_m.RequireApproval">
                <MudRadio T="bool" Value="false" Color="Color.Primary" Dense="true">Install every update that is not declined in Action1</MudRadio>
                <MudRadio T="bool" Value="true" Color="Color.Primary" Dense="true">Install only updates approved in the Action1 console</MudRadio>
            </MudRadioGroup>
            @if (!_m.RequireApproval)
            {
                <MudNumericField T="int" @bind-Value="_m.InstallDelayDays" Label="Wait after release (days)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Min="0" Max="@PatchPolicyRules.MaxInstallDelayDays" Style="max-width:220px" Class="mt-2"
                                 HelperText="0 installs an update as soon as the automation runs." />
            }
        }

        <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Restart</MudText>
        <MudSwitch T="bool" @bind-Value="_m.AutoReboot" Color="Color.Primary" Label="Restart the endpoint when an update needs it" />
        @if (_m.AutoReboot)
        {
            <div class="fl-panel pa-3 mt-2">
                <MudSwitch T="bool" @bind-Value="_m.RebootMessage" Color="Color.Primary" Label="Show a message to the signed-in user first" />
                @if (_m.RebootMessage)
                {
                    <MudTextField @bind-Value="_m.RebootMessageText" Label="Message" Variant="Variant.Outlined" Lines="2" Margin="Margin.Dense"
                                  MaxLength="@PatchPolicyRules.MaxRebootMessageLength" Class="mt-2" Placeholder="@PatchPolicyRules.DefaultRebootMessage"
                                  HelperText="Empty uses the text shown here." />
                }
                <MudNumericField T="int" @bind-Value="_m.RebootTimeoutMinutes" Label="Restart after (minutes)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Min="@PatchPolicyRules.MinRebootTimeoutMinutes" Max="@PatchPolicyRules.MaxRebootTimeoutMinutes" Style="max-width:220px" Class="mt-2" />
            </div>
        }
        else
        {
            <MudText Typo="Typo.caption" Class="muted d-block">Updates that need a restart finish at the next restart somebody makes.</MudText>
        }
        @if (Fleeto && _m.AutoReboot)
        {
            <MudText Typo="Typo.caption" Class="muted d-block mt-1">
                A signed-in user on a workstation always sees the message for this time first. A round never restarts a Proxmox VE host: its Patches tab says that a restart is required.
            </MudText>
        }

        <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Missed endpoints</MudText>
        <MudNumericField T="int" @bind-Value="_m.RetryHours" Label="Keep trying for (hours)" Variant="Variant.Outlined" Margin="Margin.Dense"
                         Min="@PatchPolicyRules.MinRetryHours" Max="@PatchPolicyRules.MaxRetryHours" Style="max-width:220px"
                         HelperText="@(Fleeto ? "An endpoint that is off or offline at the start time still gets the round when it connects within this time. Keep it shorter than the time between two rounds." : "How long Action1 keeps trying endpoints that were off or offline at the start time. Keep it shorter than the time between two runs.")" />

        @if (Fleeto)
        {
            <div class="d-flex gap-2 flex-wrap mt-3">
                <MudNumericField T="int" @bind-Value="_m.RandomDelayMinutes" Label="Spread the start over (minutes)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Min="0" Max="@PatchPolicyRules.MaxRandomDelayMinutes" Style="max-width:240px"
                                 HelperText="Each endpoint starts at its own moment within this time, so not every endpoint downloads at once." />
                <MudNumericField T="int" @bind-Value="_m.InstallTimeoutMinutes" Label="An installation may take (minutes)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Min="@PatchPolicyRules.MinInstallTimeoutMinutes" Max="@PatchPolicyRules.MaxInstallTimeoutMinutes" Style="max-width:240px"
                                 HelperText="After this the job times out. The package manager is never stopped; the next scan shows what was installed." />
            </div>

            <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Linux</MudText>
            <MudSwitch T="bool" @bind-Value="_m.TurnOffDistributionUpdates" Color="Color.Primary" Label="Turn off unattended-upgrades and dnf-automatic" />
            <MudText Typo="Typo.caption" Class="muted d-block">
                @(_m.TurnOffDistributionUpdates
                    ? "The Fleeto agent turns the distribution's own automatic updates off, so only the rounds of this policy install updates. It never changes a configuration somebody else wrote, and turns them back on when this policy no longer applies."
                    : "The distribution can also install updates by itself, outside the rounds of this policy.")
            </MudText>
        }
        else
        {
            <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Action1 agent</MudText>
            <MudSwitch T="bool" @bind-Value="_m.AutoInstallAgent" Color="Color.Primary" Label="Install the Action1 agent automatically" />
            <MudText Typo="Typo.caption" Class="muted d-block">
                @if (_m.AutoInstallAgent)
                {
                    @:Fleeto installs the agent of the client's Action1 organization on every managed Windows endpoint this policy applies to that has none, as soon as it is online. A failed installation is tried again after 1, 6 and 24 hours. An agent removed through Fleeto is not installed again by itself.
                }
                else
                {
                    @:Endpoints without the Action1 agent get it only when a technician installs it on the Patches tab.
                }
            </MudText>
        }

        <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Windows Update</MudText>
        <MudSwitch T="bool" @bind-Value="_m.TurnOffWindowsUpdate" Color="Color.Primary" Label="Turn off automatic Windows Update" />
        <MudText Typo="Typo.caption" Class="muted d-block">
            @if (_m.TurnOffWindowsUpdate && Fleeto)
            {
                @:The Fleeto agent turns automatic Windows Update off on every managed Windows endpoint this policy applies to that Fleeto patches, so only the rounds of this policy install updates. A group policy that sets Windows Update wins, and the agent turns Windows Update back on when this policy no longer applies or is switched off.
            }
            else if (_m.TurnOffWindowsUpdate)
            {
                @:The Fleeto agent turns automatic Windows Update off on every managed Windows endpoint this policy applies to that Action1 reports, so only the rounds of this policy install updates. A group policy that sets Windows Update wins, and the agent turns Windows Update back on when this policy no longer applies, is switched off or Action1 no longer reports the endpoint.
            }
            else
            {
                @:Windows can also install updates by itself, outside the rounds of this policy.
            }
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">@(IsEdit ? "Save" : "Create")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private static readonly DayOfWeek[] WeekOrder =
        [DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday];

    /// <summary>The form state; lists are edited as selections and comma-separated text.</summary>
    private sealed class Model
    {
        public string? Name { get; set; }
        public string? Description { get; set; }
        public bool Enabled { get; set; } = true;
        public CheckAppliesTo AppliesTo { get; set; }
        public PatchScheduleKind ScheduleKind { get; set; } = PatchScheduleKind.Weekly;
        public WeekDays WeekDays { get; set; } = WeekDays.Wednesday;
        public int MonthDay { get; set; } = 1;
        public int MonthWeek { get; set; } = 2;
        public DayOfWeek MonthWeekday { get; set; } = DayOfWeek.Wednesday;
        public TimeSpan? Start { get; set; } = TimeSpan.FromHours(20);
        public bool EndpointLocalTime { get; set; } = true;
        public PatchUpdateScope Scope { get; set; } = PatchUpdateScope.All;
        public IReadOnlyCollection<string> Sources { get; set; } = [];
        public IReadOnlyCollection<string> Types { get; set; } = [];
        public IReadOnlyCollection<string> Severities { get; set; } = [];
        public string? ExcludedNames { get; set; }
        public string? ExcludedVendors { get; set; }
        public bool RequireApproval { get; set; }
        public int InstallDelayDays { get; set; }
        public bool AutoReboot { get; set; }
        public bool RebootMessage { get; set; } = true;
        public string? RebootMessageText { get; set; }
        public int RebootTimeoutMinutes { get; set; } = 30;
        public int RetryHours { get; set; } = 24;
        public bool AutoInstallAgent { get; set; }
        public bool TurnOffWindowsUpdate { get; set; }
        public PatchEngine Engine { get; set; } = PatchEngine.Fleeto;
        public bool LinuxSecurityOnly { get; set; }
        public bool IncludeDrivers { get; set; }
        public bool MicrosoftUpdate { get; set; } = true;
        public bool TurnOffDistributionUpdates { get; set; }
        public int InstallTimeoutMinutes { get; set; } = PatchPolicyRules.DefaultInstallTimeoutMinutes;
        public int RandomDelayMinutes { get; set; } = PatchPolicyRules.DefaultRandomDelayMinutes;

        /// <summary>
        /// What is saved: the options of the other engine are left out (Action1-only filters, approval and agent for Fleeto), so a policy
        /// never holds an option its engine does not have.
        /// </summary>
        public PatchPolicyInput ToInput()
        {
            var fleeto = Engine == PatchEngine.Fleeto;
            return new(Name, Description, Enabled, ScheduleKind, WeekDays, MonthDay, MonthWeek, MonthWeekday,
                (int)(Start ?? TimeSpan.Zero).TotalMinutes, EndpointLocalTime, Scope, fleeto ? [] : Sources.ToList(),
                fleeto ? Types.Where(t => t != "Feature Updates").ToList() : Types.ToList(), Severities.ToList(),
                Split(ExcludedNames), fleeto ? [] : Split(ExcludedVendors), !fleeto && RequireApproval, InstallDelayDays, AutoReboot, RebootMessage,
                RebootMessageText, RebootTimeoutMinutes, RetryHours, AppliesTo, !fleeto && AutoInstallAgent, TurnOffWindowsUpdate, Engine,
                LinuxSecurityOnly, IncludeDrivers, MicrosoftUpdate, TurnOffDistributionUpdates, InstallTimeoutMinutes, RandomDelayMinutes);
        }

        /// <summary>A throwaway entity, only to describe the schedule while it is edited.</summary>
        public PatchPolicy ToPolicy() => new()
        {
            ScheduleKind = ScheduleKind, WeekDays = WeekDays, MonthDay = MonthDay, MonthWeek = MonthWeek, MonthWeekday = MonthWeekday,
            StartMinute = (int)(Start ?? TimeSpan.Zero).TotalMinutes, EndpointLocalTime = EndpointLocalTime
        };

        public static Model From(PatchPolicyInput p) => new()
        {
            Name = p.Name, Description = p.Description, Enabled = p.Enabled, ScheduleKind = p.ScheduleKind, WeekDays = p.WeekDays,
            MonthDay = p.MonthDay, MonthWeek = p.MonthWeek, MonthWeekday = p.MonthWeekday, Start = TimeSpan.FromMinutes(p.StartMinute),
            EndpointLocalTime = p.EndpointLocalTime, Scope = p.Scope, Sources = p.UpdateSources.ToHashSet(), Types = p.UpdateTypes.ToHashSet(),
            Severities = p.Severities.ToHashSet(), ExcludedNames = string.Join(", ", p.ExcludedNames),
            ExcludedVendors = string.Join(", ", p.ExcludedVendors), RequireApproval = p.RequireApproval, InstallDelayDays = p.InstallDelayDays,
            AutoReboot = p.AutoReboot, RebootMessage = p.RebootMessage, RebootMessageText = p.RebootMessageText,
            RebootTimeoutMinutes = p.RebootTimeoutMinutes, RetryHours = p.RetryHours, AppliesTo = p.AppliesTo,
            AutoInstallAgent = p.AutoInstallAgent, TurnOffWindowsUpdate = p.TurnOffWindowsUpdate, Engine = p.Engine,
            LinuxSecurityOnly = p.LinuxSecurityOnly, IncludeDrivers = p.IncludeDrivers, MicrosoftUpdate = p.MicrosoftUpdate,
            TurnOffDistributionUpdates = p.TurnOffDistributionUpdates, InstallTimeoutMinutes = p.InstallTimeoutMinutes,
            RandomDelayMinutes = p.RandomDelayMinutes
        };

        private static List<string> Split(string? text) =>
            (text ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
    }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>The patch policy to edit; null creates one.</summary>
    [Parameter] public PatchPolicyInput? Existing { get; set; }

    [Parameter] public IReadOnlyList<ClientOption> Clients { get; set; } = [];
    [Parameter] public Func<Guid?, PatchPolicyInput, Task<bool>> OnSubmit { get; set; } = (_, _) => Task.FromResult(true);

    private bool IsEdit => Existing is not null;
    private bool Fleeto => _m.Engine == PatchEngine.Fleeto;
    private Model _m = new();
    private Guid? _clientId;
    private bool _busy;

    protected override void OnInitialized()
    {
        if (Existing is { } existing)
        {
            _m = Model.From(existing);
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        _busy = true;
        try
        {
            if (await OnSubmit(_clientId, _m.ToInput()))
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
