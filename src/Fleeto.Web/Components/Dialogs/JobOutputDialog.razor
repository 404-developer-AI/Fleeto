@using Fleeto.Core.Domain
@implements IDisposable
@inject JobService JobSvc
@inject CurrentUser CurrentUser
@inject LiveUpdates Live
@inject TimeDisplay Time

@* The result and output of one job, refreshed live while it runs. *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(_view?.Job.ScriptName ?? "Job") on @(_view?.Job.Hostname ?? "")</MudText>
    </TitleContent>
    <DialogContent>
        @if (_view is { } view)
        {
            var job = view.Job;
            <div class="d-flex flex-wrap align-center gap-2 mb-2">
                <StatusChip Text="@Ui.JobStateLabel(job.State, job.Result)" Kind="@Ui.JobStateKind(job.State)" />
                @if (job.ExitCode is { } exitCode)
                {
                    <span>Exit code <strong>@exitCode</strong></span>
                }
                <span class="muted">· @Ui.JobOutputLabel(job.OutputState, job.OutputTruncated)</span>
            </div>
            <MudText Typo="Typo.body2" Class="muted mb-3">
                @ScriptLanguages.Label(job.Language) version @job.ScriptVersionNumber · started by @job.InitiatedByName <TimeText Value="job.CreatedAt" />
                @if (job.StartedAt is not null)
                {
                    <span> · ran from @Time.Absolute(job.StartedAt)@(job.CompletedAt is null ? "" : $" to {Time.Absolute(job.CompletedAt)}")</span>
                }
                else if (job.State is JobState.Queued or JobState.PendingSignature)
                {
                    <span> · runs when the endpoint is online, until @Time.Absolute(job.ValidUntil)</span>
                }
            </MudText>
            @if (!string.IsNullOrEmpty(job.Problem))
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">@job.Problem</MudAlert>
            }
            @if (job.State == JobState.Lost)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                    The job started, but no result arrived. Whether it finished is unknown; check the endpoint before running it again.
                </MudAlert>
            }
            <MudText Typo="Typo.subtitle2">Output (@Ui.Bytes(view.StdoutBytes))</MudText>
            <pre class="job-output mb-3">@(view.Stdout.Length == 0 ? "No output." : view.Stdout)</pre>
            @if (view.StderrBytes > 0)
            {
                <MudText Typo="Typo.subtitle2">Errors (@Ui.Bytes(view.StderrBytes))</MudText>
                <pre class="job-output stderr mb-3">@view.Stderr</pre>
            }
            @if (view.ShortenedInView)
            {
                <MudText Typo="Typo.caption" Class="muted">Only the first 1 MB of each stream is shown here, or the part received so far.</MudText>
            }
        }
        else if (_missing)
        {
            <MudText>The job no longer exists.</MudText>
        }
        else
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public Guid JobId { get; set; }
    [Parameter, EditorRequired] public Guid EndpointId { get; set; }

    private JobOutputView? _view;
    private bool _missing;
    private DebouncedRefresh? _refresh;

    protected override async Task OnInitializedAsync()
    {
        _refresh = new DebouncedRefresh(() => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); }));
        Live.JobsChanged += OnJobsChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var caller = await CurrentUser.GetAsync();
        _view = await JobSvc.GetOutputAsync(caller, JobId);
        _missing = _view is null;
    }

    private void OnJobsChanged(Guid endpointId)
    {
        if (endpointId == EndpointId || endpointId == Guid.Empty)
        {
            _refresh?.Trigger();
        }
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));

    public void Dispose()
    {
        Live.JobsChanged -= OnJobsChanged;
        _refresh?.Dispose();
    }
}
