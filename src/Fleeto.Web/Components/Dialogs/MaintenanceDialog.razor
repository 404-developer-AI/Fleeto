@* Start or change maintenance mode on a client, site or endpoint. Never called snooze, mute or silenced (branding §6). *@
@inject TimeDisplay Time
@inject TimeProvider Clock

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsChange ? "Change maintenance" : "Start maintenance")</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">@Explanation</MudText>
        <MudRadioGroup T="int" @bind-Value="_choice">
            <MudRadio T="int" Value="1" Color="Color.Primary">1 hour</MudRadio>
            <MudRadio T="int" Value="4" Color="Color.Primary">4 hours</MudRadio>
            <MudRadio T="int" Value="24" Color="Color.Primary">24 hours</MudRadio>
            <MudRadio T="int" Value="ChosenTime" Color="Color.Primary">Until a chosen time</MudRadio>
            <MudRadio T="int" Value="UntilTurnedOff" Color="Color.Primary">Until I turn it off</MudRadio>
        </MudRadioGroup>
        @if (_choice == ChosenTime)
        {
            <DateTimeField @bind-Value="_until" Label="Maintenance until" Min="@LocalNow" Max="@LocalNow.AddDays(365)" Class="mt-2" />
            <MudText Typo="Typo.caption" Class="muted d-block mt-1">In your time zone.</MudText>
        }
        @if (IsChange)
        {
            <MudText Typo="Typo.caption" Class="muted d-block mt-2">The new end time counts from now; the start of the maintenance stays.</MudText>
        }
        <MudTextField @bind-Value="_reason" Label="Reason" Required="true" Placeholder="For example: server migration" Variant="Variant.Outlined"
                      Lines="2" MaxLength="@MaintenanceRules.MaxReasonLength" Counter="@MaintenanceRules.MaxReasonLength" Immediate="true" Class="mt-3" />
        <MudText Typo="Typo.caption" Class="muted d-block mt-1">Shown in the history of every endpoint the maintenance covers.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync"
                   Disabled="@(_busy || (_choice == ChosenTime && _until is null) || string.IsNullOrWhiteSpace(_reason))">@(IsChange ? "Save" : "Start maintenance")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const int ChosenTime = 0;
    private const int UntilTurnedOff = -1;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>What goes into maintenance, as shown in the sentence: "client ACME", "site Monitoring" or a host name.</summary>
    [Parameter, EditorRequired] public string TargetLabel { get; set; } = string.Empty;

    /// <summary>True for a client or site: every endpoint below it is covered.</summary>
    [Parameter] public bool CoversEndpoints { get; set; }

    /// <summary>The active maintenance being changed, or null to start one.</summary>
    [Parameter] public MaintenancePeriod? Current { get; set; }

    /// <summary>Receives the end in UTC (null: until turned off) and the reason; returns true when saved.</summary>
    [Parameter] public Func<DateTime?, string?, Task<bool>> OnSubmit { get; set; } = (_, _) => Task.FromResult(true);

    private int _choice = 4;
    private DateTime? _until;
    private string? _reason;
    private bool _busy;

    private bool IsChange => Current is not null;

    private DateTime LocalNow => TimeZoneInfo.ConvertTimeFromUtc(Clock.GetUtcNow().UtcDateTime, Time.Zone);

    private string Explanation => (CoversEndpoints
            ? $"While {TargetLabel} is in maintenance, no alert opens or escalates for its endpoints."
            : $"While {TargetLabel} is in maintenance, no alert opens or escalates for it.") +
        " Open alerts stay open and still resolve when their check recovers. When maintenance ends, an alert opens at the next failing result.";

    protected override void OnInitialized()
    {
        var suggestion = LocalNow.AddHours(2);
        _until = suggestion.Date.AddHours(suggestion.Hour);
        if (Current is { } current)
        {
            _reason = current.Reason;
            if (current.EndsAt is null)
            {
                _choice = UntilTurnedOff;
            }
            else
            {
                var end = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(current.EndsAt.Value, DateTimeKind.Utc), Time.Zone);
                _choice = ChosenTime;
                _until = end.Date.AddHours(end.Hour).AddMinutes(end.Minute);
            }
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        DateTime? endsAtUtc;
        if (_choice == UntilTurnedOff)
        {
            endsAtUtc = null;
        }
        else if (_choice == ChosenTime)
        {
            var local = DateTime.SpecifyKind(_until!.Value, DateTimeKind.Unspecified);
            if (Time.Zone.IsInvalidTime(local))
            {
                local = local.AddHours(1);
            }

            endsAtUtc = TimeZoneInfo.ConvertTimeToUtc(local, Time.Zone);
        }
        else
        {
            endsAtUtc = Clock.GetUtcNow().UtcDateTime.AddHours(_choice);
        }

        _busy = true;
        try
        {
            if (await OnSubmit(endsAtUtc, _reason))
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
