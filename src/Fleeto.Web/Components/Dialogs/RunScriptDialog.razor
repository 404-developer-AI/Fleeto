@using Fleeto.Core.Domain
@* Starts a library script on one or more managed endpoints. Only scripts that run on every chosen endpoint are offered. *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Run script on @TargetLabel</MudText>
    </TitleContent>
    <DialogContent>
        @if (Scripts.Count == 0)
        {
            <MudText Typo="Typo.body2">
                No script in the library runs on @(EndpointIds.Count == 1 ? "this endpoint" : "these endpoints"). Create one under Settings, Scripts, in a language for its
                operating system and for this client or all clients.
            </MudText>
        }
        else
        {
            @if (NotifyAdminsAbove > 0 && EndpointIds.Count > NotifyAdminsAbove)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    This run is above @NotifyAdminsAbove endpoints, so every admin gets an email about it.
                </MudAlert>
            }
            <MudSelect T="Guid?" @bind-Value="_scriptId" Label="Script" Variant="Variant.Outlined" Class="mb-3" AnchorOrigin="Origin.BottomCenter">
                @foreach (var script in Scripts)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)script.Id)">
                        @script.Name · @ScriptLanguages.Label(script.Language) · version @script.VersionNumber@(script.Approved ? " · approved" : "")@(script.ClientCode is null ? "" : $" · {script.ClientCode}")
                    </MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="TimeSpan" @bind-Value="_validity" Label="Run when the endpoint is online within" Variant="Variant.Outlined" Class="mb-2">
                @foreach (var (validity, label) in JobService.Validities)
                {
                    <MudSelectItem T="TimeSpan" Value="validity">@label</MudSelectItem>
                }
            </MudSelect>
            <MudText Typo="Typo.caption" Class="muted d-block">
                The current version runs as SYSTEM or root. An endpoint that is offline longer than this does not run it; the job then expires.
            </MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        @if (Scripts.Count > 0)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="@(_busy || _scriptId is null)">Run script</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public IReadOnlyCollection<Guid> EndpointIds { get; set; } = [];
    [Parameter, EditorRequired] public string TargetLabel { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<RunnableScript> Scripts { get; set; } = [];
    [Parameter] public Func<Guid, TimeSpan, Task<bool>> OnSubmit { get; set; } = (_, _) => Task.FromResult(true);

    /// <summary>Endpoint count above which the run emails every admin (Settings, Scripts); 0 never notifies.</summary>
    [Parameter] public int NotifyAdminsAbove { get; set; }

    private Guid? _scriptId;
    private TimeSpan _validity = ScriptRules.DefaultValidity;
    private bool _busy;

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        if (_scriptId is not { } scriptId)
        {
            return;
        }

        _busy = true;
        try
        {
            if (await OnSubmit(scriptId, _validity))
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
