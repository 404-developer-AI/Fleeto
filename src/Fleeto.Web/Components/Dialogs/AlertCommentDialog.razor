@* Acknowledge, resolve or end the hold of an alert, with the comment that is kept with it (0.6.0). The comment is required, except
   for ending a hold. *@

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">@Alert.Title</MudText>
        @if (!string.IsNullOrEmpty(Explanation))
        {
            <MudText Typo="Typo.body2" Class="muted mb-3">@Explanation</MudText>
        }
        <MudTextField @bind-Value="_comment" Label="@(Required ? "Comment" : "Comment (optional)")" Required="@Required"
                      Placeholder="For example: disk cleaned up, ticket 4711" Variant="Variant.Outlined" Lines="3"
                      MaxLength="@AlertActivity.MaxCommentLength" Counter="@AlertActivity.MaxCommentLength" Immediate="true" AutoFocus="true" />
        <MudText Typo="Typo.caption" Class="muted d-block mt-1">Shown with the alert in the history of the endpoint.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync"
                   Disabled="@(_busy || (Required && string.IsNullOrWhiteSpace(_comment)))">@ActionLabel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public AlertView Alert { get; set; } = default!;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ActionLabel { get; set; } = string.Empty;
    [Parameter] public string? Explanation { get; set; }
    [Parameter] public bool Required { get; set; } = true;

    /// <summary>Receives the comment; returns true when the action was saved.</summary>
    [Parameter] public Func<string?, Task<bool>> OnSubmit { get; set; } = _ => Task.FromResult(true);

    private string? _comment;
    private bool _busy;

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        _busy = true;
        try
        {
            if (await OnSubmit(_comment))
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
