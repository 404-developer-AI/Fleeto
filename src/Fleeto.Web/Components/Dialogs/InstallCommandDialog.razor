@inject IJSRuntime JS
@inject ISnackbar Snackbar

@* Shows a new token's install command exactly once, per platform. Nothing here is stored; closing the dialog discards it. *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Install the agent</MudText>
    </TitleContent>
    <DialogContent>
        @if (Created.InstallCommands is { } commands)
        {
            <MudText Typo="Typo.body2" Class="mb-2">This token is shown only once. Pick the operating system of the endpoint.</MudText>
            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true">
                <MudTabPanel Text="Windows">
                    <MudText Typo="Typo.body2" Class="mt-3 mb-2">Run in an elevated PowerShell on the endpoint.</MudText>
                    <div class="command-box mb-3">@commands.Windows</div>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.ContentCopy"
                               OnClick="@(() => CopyAsync(commands.Windows))">Copy command</MudButton>
                </MudTabPanel>
                <MudTabPanel Text="Linux">
                    <MudText Typo="Typo.body2" Class="mt-3 mb-2">
                        Run in a shell on the endpoint. On a system without sudo, such as Proxmox VE, run it as root without the sudo in front.
                    </MudText>
                    <div class="command-box mb-3">@commands.Linux</div>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.ContentCopy"
                               OnClick="@(() => CopyAsync(commands.Linux))">Copy command</MudButton>
                </MudTabPanel>
            </MudTabs>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3">@Created.Problem</MudAlert>
            <MudText Typo="Typo.body2" Class="mb-2">The token was created and is shown only once. You can revoke it from the token list.</MudText>
            <div class="command-box mb-3">@Created.Token</div>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.ContentCopy"
                       OnClick="@(() => CopyAsync(Created.Token))">Copy token</MudButton>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Close">Done</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public CreatedEnrollmentToken Created { get; set; } = default!;

    private void Close() => MudDialog.Close(DialogResult.Ok(true));

    private async Task CopyAsync(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("fleeto.copyText", text);
            Snackbar.Add("Copied to the clipboard.", Severity.Success);
        }
        catch (JSException)
        {
            Snackbar.Add("Copying did not work in this browser. Select the text and copy it with Ctrl+C.", Severity.Info);
        }
    }
}
