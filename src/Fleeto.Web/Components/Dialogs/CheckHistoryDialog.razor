@* History of one check of an endpoint: the last hour, day, week, month or year. *@
@inherits FleetoPageBase
@inject CheckHistoryService HistorySvc
@inject ScriptOutputService OutputSvc
@inject IDialogService Dialogs
@inject IJSRuntime JS

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">History of @Name@(string.IsNullOrEmpty(_target) ? "" : $" ({_target})")</MudText>
    </TitleContent>
    <DialogContent>
        <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-3">
            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small" OverrideStyles="false">
                @foreach (var range in Enum.GetValues<HistoryRange>())
                {
                    <MudButton Variant="@(range == _range ? Variant.Filled : Variant.Outlined)" Color="@(range == _range ? Color.Primary : Color.Default)"
                               Size="Size.Small" OnClick="@(() => SetRangeAsync(range))">@RangeLabel(range)</MudButton>
                }
            </MudButtonGroup>
            @if (_view is { Targets.Count: > 1 })
            {
                <MudSelect T="string" Value="_target" ValueChanged="SetTargetAsync" Label="Target" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Style="max-width:260px">
                    @foreach (var t in _view.Targets)
                    {
                        <MudSelectItem T="string" Value="t">@(string.IsNullOrEmpty(t) ? "(default)" : t)</MudSelectItem>
                    }
                </MudSelect>
            }
        </div>

        <LoadState Loading="Loading" Failed="LoadFailed" NotFound="@(_view is null && !Loading)" What="check">
            @if (_view is { } view)
            {
                @if (!view.Points.Any(p => p.HasData))
                {
                    <EmptyState Icon="@Icons.Material.Outlined.ShowChart" Title="No results in this period"
                                Text="@(view.Range is HistoryRange.Hour or HistoryRange.Day ? "Results appear here as the agent reports them." : "Longer periods are built from hourly and daily summaries that start with this release.")" />
                }
                else if (view.Kind is ThresholdKind.Flag or ThresholdKind.ExitCode)
                {
                    @if (ScriptOutputRules.Applies(view.Type))
                    {
                        <StatusTimeline View="view" Selected="_runsBucket" BlockSelected="@(point => ShowRunsAsync(view, point))" />
                        @ScriptRuns(view)
                    }
                    else
                    {
                        <StatusTimeline View="view" />
                    }
                }
                else
                {
                    <HistoryChart View="view" SelectedProcessList="_processList" ProcessListSelected="@(bucket => _processList = bucket)" />
                    <div class="d-flex gap-3 mt-2 muted flex-wrap" style="font-size:0.75rem">
                        <span><span class="history-legend history-legend-line"></span> Average</span>
                        <span><span class="history-legend history-legend-band"></span> Lowest to highest</span>
                        @if (view.WarningThreshold is not null)
                        {
                            <span><span class="history-legend history-legend-warning"></span> Warning threshold</span>
                        }
                        @if (view.CriticalThreshold is not null)
                        {
                            <span><span class="history-legend history-legend-critical"></span> Critical threshold</span>
                        }
                        @if (view.Points.Any(p => p.Errors + p.NoResponses > 0))
                        {
                            <span><span class="history-legend history-legend-problem"></span> @(view.Kind == ThresholdKind.Reachability ? "No response or could not run" : "Could not run")</span>
                        }
                        @if (view.ProcessLists.Count > 0)
                        {
                            <span><span class="history-legend history-legend-processes"></span> Process list</span>
                        }
                    </div>
                    <MudText Typo="Typo.caption" Class="muted d-block mt-2">@Summary(view)</MudText>
                    @ProcessList(view)
                }
            }
        </LoadState>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public Guid EndpointId { get; set; }
    [Parameter, EditorRequired] public Guid CheckId { get; set; }
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter] public string? Target { get; set; }

    private HistoryRange _range = HistoryRange.Day;
    // Script checks (0.9.0): the block whose runs are listed, and those runs.
    private DateTime? _runsBucket;
    private IReadOnlyList<ScriptRunView>? _runs;
    private string? _runsProblem;
    private string? _target;
    private CheckHistoryView? _view;
    // The bucket whose process list is shown; the latest one after every load.
    private DateTime? _processList;
    private bool _copying;

    protected override async Task OnInitializedAsync()
    {
        _target = Target;
        await ReloadAsync();
    }

    private Task ReloadAsync() => LoadAsync(async caller =>
    {
        _runsBucket = null;
        _runs = null;
        _runsProblem = null;
        _view = await HistorySvc.GetAsync(caller, EndpointId, CheckId, _target, _range);
        _target = _view?.Target ?? _target;
        _processList = _view is { ProcessLists.Count: > 0 } ? _view.ProcessLists.Keys.Max() : null;
    });

    /// <summary>The processes of the selected bucket (CPU and memory usage, 0.6.0), or where a list comes from when there is none.</summary>
    private RenderFragment ProcessList(CheckHistoryView view) => __builder =>
    {
        if (!ProcessListRules.Applies(view.Type))
        {
            return;
        }

        var cpu = view.Type == CheckType.CpuUsage;
        if (_processList is { } bucket && view.ProcessLists.TryGetValue(bucket, out var snapshot))
        {
            <div class="process-list-panel">
                <div class="d-flex justify-space-between align-baseline flex-wrap gap-2 mb-1">
                    <MudText Typo="Typo.subtitle2">@(cpu ? "CPU" : "Memory") @Ui.CheckValue(view.Type, snapshot.Value) at @Time.Absolute(snapshot.At)</MudText>
                    <div class="d-flex align-center gap-2">
                        <span class="muted" style="font-size:0.75rem">@(view.ProcessLists.Count > 1 ? "Hover over another dot to see its processes." : "")</span>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small" Disabled="_copying"
                                   title="@($"Copy these processes and the {(cpu ? "CPU" : "memory")} usage as an image, for a mail or a ticket")"
                                   OnClick="@(() => CopyProcessListAsync(bucket))">Copy</MudButton>
                    </div>
                </div>
                <MudSimpleTable Dense="true" Elevation="0">
                    <thead>
                        <tr>
                            <th>Process</th>
                            <th class="num">PID</th>
                            <th>User</th>
                            @if (cpu)
                            {
                                <th class="num">CPU</th>
                            }
                            <th class="num">Memory</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var process in snapshot.Processes)
                        {
                            <tr>
                                <td>@process.Name</td>
                                <td class="num">@process.Pid</td>
                                <td>@(string.IsNullOrEmpty(process.User) ? "-" : process.User)</td>
                                @if (cpu)
                                {
                                    <td class="num">@((process.CpuPercent ?? 0).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%</td>
                                }
                                <td class="num">@Ui.Bytes(process.MemoryBytes)</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        }
        else if (view.Range is not HistoryRange.Year)
        {
            <MudText Typo="Typo.caption" Class="muted d-block mt-1">@NoProcessListText(view)</MudText>
        }
    };

    /// <summary>Copies the process list of a bucket as an image (0.7.0); the browser draws it from text formatted here.</summary>
    private async Task CopyProcessListAsync(DateTime bucket)
    {
        _copying = true;
        try
        {
            if (await RunForValueAsync(caller => HistorySvc.GetProcessListReportAsync(caller, EndpointId, CheckId, _target, _range, bucket), null) is not
                { Value: { } report })
            {
                return;
            }

            var outcome = await JS.InvokeAsync<string>("fleeto.copyProcessImage", Reports.ProcessListReportImage.From(report, t => Time.Absolute(t), Time.Zone));
            Snackbar.Add(outcome == "copied"
                ? "The process list is copied as an image. Paste it into a mail or a ticket."
                : "The browser did not allow copying an image, so it was downloaded instead.", Severity.Info);
        }
        catch (JSException)
        {
            Snackbar.Add("The image could not be made in this browser. Try another browser, or copy the table by hand.", Severity.Warning);
        }
        finally
        {
            _copying = false;
        }
    }

    private static string NoProcessListText(CheckHistoryView view) =>
        ProcessListRules.ListAt(view.WarningThreshold, view.CriticalThreshold) is { } at
            ? $"No process list in this period. A result of {Ui.CheckValue(view.Type, at)} or more lists the processes using the most {(view.Type == CheckType.CpuUsage ? "CPU" : "memory")}, and so does Run now."
            : "No process list in this period. Without thresholds only Run now lists the processes.";

    private async Task SetRangeAsync(HistoryRange range)
    {
        _range = range;
        await ReloadAsync();
    }

    private async Task SetTargetAsync(string target)
    {
        _target = target;
        await ReloadAsync();
    }

    private static string RangeLabel(HistoryRange range) => range switch
    {
        HistoryRange.Hour => "Hour",
        HistoryRange.Day => "Day",
        HistoryRange.Week => "Week",
        HistoryRange.Month => "Month",
        _ => "Year"
    };

    private static string Summary(CheckHistoryView view)
    {
        var withValues = view.Points.Where(p => p.Avg is not null).ToList();
        if (withValues.Count == 0)
        {
            return "The check could not run or got no response in this period.";
        }

        var values = withValues.Sum(p => p.Values);
        var avg = withValues.Sum(p => p.Avg!.Value * p.Values) / values;
        var min = withValues.Min(p => p.Min!.Value);
        var max = withValues.Max(p => p.Max!.Value);
        string F(double v) => Ui.CheckValue(view.Type, v, view.Target, view.Parameters);
        var text = $"{values} results. Average {F(avg)}, lowest {F(min)}, highest {F(max)}.";
        var problems = view.Points.Sum(p => p.Errors + p.NoResponses);
        return problems > 0 ? $"{text} {problems} without a value." : text;
    }

    /// <summary>The runs of the selected block of a script check, newest first (0.9.0).</summary>
    private RenderFragment ScriptRuns(CheckHistoryView view) => __builder =>
    {
        if (_runsBucket is not { } bucket)
        {
            <MudText Typo="Typo.caption" Class="muted d-block mt-2">Click a block to see its runs and the output of each run.</MudText>
            return;
        }

        <div class="d-flex align-baseline justify-space-between flex-wrap gap-2 mt-3 mb-1">
            <MudText Typo="Typo.subtitle2">Runs from @Time.Absolute(bucket) to @Time.Absolute(bucket + view.BucketSize)</MudText>
            @if (_runs is { Count: ScriptOutputService.MaxRuns })
            {
                <span class="muted" style="font-size:0.75rem">The newest @ScriptOutputService.MaxRuns runs. Choose a shorter period for fewer runs per block.</span>
            }
        </div>
        if (_runsProblem is not null)
        {
            <MudText Typo="Typo.body2">@_runsProblem</MudText>
        }
        else if (_runs is null)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        }
        else if (_runs.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="muted">The runs of this block are no longer kept: this block comes from the hourly or daily summary. Results are kept as long as Settings, Retention says for check results.</MudText>
        }
        else
        {
            <MudTable Items="_runs" Dense="true" Hover="true" Elevation="0" T="ScriptRunView" OnRowClick="@(e => ShowOutputAsync(e.Item!))"
                      RowStyle="cursor:pointer" Height="@(_runs.Count > 8 ? "320px" : null)" FixedHeader="true">
                <HeaderContent>
                    <MudTh>Ran</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Exit code</MudTh>
                    <MudTh>More info</MudTh>
                    <MudTh>Output</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@Time.Absolute(context.At)</MudTd>
                    <MudTd><StatusChip Text="@context.Status.ToString()" Kind="@Ui.CheckKind(context.Status)" /></MudTd>
                    <MudTd>@(string.IsNullOrEmpty(context.Error) ? context.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "-")</MudTd>
                    <MudTd>
                        @context.Detail
                        @if (!string.IsNullOrEmpty(context.Error))
                        {
                            <div style="color:var(--fl-error)">@context.Error</div>
                        }
                    </MudTd>
                    <MudTd>
                        @if (context.OutputBytes is { } bytes)
                        {
                            @Ui.Bytes(bytes)
                            @if (context.IsCut)
                            {
                                <div style="color:var(--fl-error)">Cut off at the output limit</div>
                            }
                        }
                        else
                        {
                            <span class="muted">First line only</span>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
            <MudText Typo="Typo.caption" Class="muted d-block mt-1">Click a run to see its output.</MudText>
        }
    };

    private async Task ShowRunsAsync(CheckHistoryView view, HistoryPoint point)
    {
        _runsBucket = point.Time;
        _runs = null;
        _runsProblem = null;
        var result = await RunForValueAsync(caller => OutputSvc.GetRunsAsync(caller, EndpointId, CheckId, point.Time, point.Time + view.BucketSize), null);
        if (_runsBucket != point.Time)
        {
            return;
        }

        _runs = result?.Value;
        _runsProblem = result is null ? "The runs could not be read. Click the block again." : null;
    }

    private async Task ShowOutputAsync(ScriptRunView run)
    {
        var parameters = new DialogParameters<ScriptOutputDialog>
        {
            { d => d.EndpointId, EndpointId },
            { d => d.CheckId, CheckId },
            { d => d.Name, Name },
            { d => d.RunId, run.Id },
            { d => d.RunTime, run.Time }
        };
        await Dialogs.ShowAsync<ScriptOutputDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
    }

    private void Close() => MudDialog.Close();
}
