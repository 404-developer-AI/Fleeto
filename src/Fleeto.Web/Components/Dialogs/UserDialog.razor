@* Create a user with a temporary password, or change the roles of a user. *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(Existing is null ? "New user" : $"Roles of {Existing.Email}")</MudText>
    </TitleContent>
    <DialogContent>
        @if (Existing is null)
        {
            <MudTextField @bind-Value="_displayName" Label="Name" Variant="Variant.Outlined" MaxLength="200" AutoFocus="true" Class="mb-3" />
            <MudTextField @bind-Value="_email" Label="Email address" Variant="Variant.Outlined" MaxLength="320" InputType="InputType.Email" Class="mb-3" />
            <MudTextField @bind-Value="_password" Label="Temporary password (at least 12 characters)" Variant="Variant.Outlined" MaxLength="256"
                          InputType="InputType.Password" Class="mb-1" />
            <MudText Typo="Typo.caption" Class="muted d-block mb-3">
                Give the password to the user over a separate channel. At the first sign-in they set up two-factor authentication.
            </MudText>
        }
        <MudText Typo="Typo.subtitle2" Class="mb-1">Roles</MudText>
        <MudCheckBox T="bool" Value="@_roles.Contains(FleetoRoles.Admin)" ValueChanged="@(v => Toggle(FleetoRoles.Admin, v))" Color="Color.Primary"
                     Label="Admin: everything, including Settings" />
        <MudCheckBox T="bool" Value="@_roles.Contains(FleetoRoles.Technician)" ValueChanged="@(v => Toggle(FleetoRoles.Technician, v))" Color="Color.Primary"
                     Label="Technician: manage clients, sites, endpoints, templates and alerts" />
        <MudCheckBox T="bool" Value="@_roles.Contains(FleetoRoles.ReadOnly)" ValueChanged="@(v => Toggle(FleetoRoles.ReadOnly, v))" Color="Color.Primary"
                     Label="Read-only: view everything outside Settings" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">@(Existing is null ? "Create user" : "Save roles")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public UserListItem? Existing { get; set; }

    /// <summary>Email, name, password (unused when editing) and roles.</summary>
    [Parameter] public Func<string, string, string, IReadOnlyCollection<string>, Task<bool>> OnSubmit { get; set; } = (_, _, _, _) => Task.FromResult(true);

    private string _displayName = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private HashSet<string> _roles = [FleetoRoles.Technician];
    private bool _busy;

    protected override void OnInitialized()
    {
        if (Existing is not null)
        {
            _roles = Existing.Roles.ToHashSet();
        }
    }

    private void Toggle(string role, bool selected)
    {
        if (selected)
        {
            _roles.Add(role);
        }
        else
        {
            _roles.Remove(role);
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        _busy = true;
        try
        {
            if (await OnSubmit(_email, _displayName, _password, _roles.ToList()))
            {
                _password = string.Empty;
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
