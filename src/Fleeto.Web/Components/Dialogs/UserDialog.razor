@* Create a user with a temporary password, or change the roles and groups of a user. *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(Existing is null ? "New user" : $"Roles and groups of {Existing.Email}")</MudText>
    </TitleContent>
    <DialogContent>
        @if (Existing is null)
        {
            <MudTextField @bind-Value="_displayName" Label="Name" Variant="Variant.Outlined" MaxLength="200" AutoFocus="true" Class="mb-3" />
            <MudTextField @bind-Value="_email" Label="Email address" Variant="Variant.Outlined" MaxLength="320" InputType="InputType.Email" Class="mb-3" />
            <MudTextField @bind-Value="_password" Label="Temporary password (at least 12 characters)" Variant="Variant.Outlined" MaxLength="256"
                          InputType="InputType.Password" Class="mb-1" />
            <MudText Typo="Typo.caption" Class="muted d-block mb-3">
                Give the password to the user over a separate channel. At the first sign-in they set up two-factor authentication.
            </MudText>
        }
        <MudText Typo="Typo.subtitle2" Class="mb-1">Roles</MudText>
        <MudCheckBox T="bool" Value="@_roles.Contains(FleetoRoles.Admin)" ValueChanged="@(v => Toggle(FleetoRoles.Admin, v))" Color="Color.Primary"
                     Label="Admin: everything on every client, including Settings" />
        <MudCheckBox T="bool" Value="@_roles.Contains(FleetoRoles.Technician)" ValueChanged="@(v => Toggle(FleetoRoles.Technician, v))" Color="Color.Primary"
                     Label="Technician: manage the clients, sites and endpoints of their groups, templates and alerts" />
        <MudCheckBox T="bool" Value="@_roles.Contains(FleetoRoles.ReadOnly)" ValueChanged="@(v => Toggle(FleetoRoles.ReadOnly, v))" Color="Color.Primary"
                     Label="Read-only: view what their groups give, outside Settings" />

        <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">Groups</MudText>
        @if (_roles.Contains(FleetoRoles.Admin))
        {
            <MudText Typo="Typo.body2" Class="muted">An admin sees every client. Groups do not apply.</MudText>
        }
        else if (Groups.Count == 0)
        {
            <MudAlert Severity="Severity.Warning" Dense="true">
                There are no groups yet, so this user would see no clients. Create a group in Settings, Groups.
            </MudAlert>
        }
        else
        {
            @foreach (var group in Groups)
            {
                <MudCheckBox T="bool" Value="@_groups.Contains(group.Id)" ValueChanged="@(v => ToggleGroup(group.Id, v))" Color="Color.Primary"
                             Label="@GroupLabel(group)" />
            }
            @if (_groups.Count == 0)
            {
                <MudText Typo="Typo.caption" Class="d-block mt-1" Style="color:var(--mud-palette-warning-darken)">
                    Without a group this user sees no clients.
                </MudText>
            }
            else if (DefaultDropped)
            {
                <MudText Typo="Typo.caption" Class="muted d-block mt-1">
                    The user leaves the group @Groups.First(g => g.IsDefault).Name, because it is put in another group.
                </MudText>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">@(Existing is null ? "Create user" : "Save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public UserListItem? Existing { get; set; }

    /// <summary>Every group, to choose from (0.6.0).</summary>
    [Parameter] public IReadOnlyList<UserGroupOption> Groups { get; set; } = [];

    /// <summary>Email, name, password (unused when editing), roles and groups (empty for an admin).</summary>
    [Parameter] public Func<string, string, string, IReadOnlyCollection<string>, IReadOnlyCollection<Guid>, Task<bool>> OnSubmit { get; set; } =
        (_, _, _, _, _) => Task.FromResult(true);

    private string _displayName = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private HashSet<string> _roles = [FleetoRoles.Technician];
    private HashSet<Guid> _groups = [];
    private HashSet<Guid> _initialGroups = [];
    private bool _busy;

    /// <summary>The default group is chosen, and so is a group the user was not in yet: the service drops the default one.</summary>
    private bool DefaultDropped => Groups.FirstOrDefault(g => g.IsDefault) is { } fallback && _groups.Contains(fallback.Id) &&
                                   Groups.Any(g => !g.IsDefault && _groups.Contains(g.Id) && !_initialGroups.Contains(g.Id));

    protected override void OnInitialized()
    {
        if (Existing is not null)
        {
            _roles = Existing.Roles.ToHashSet();
            _groups = Existing.Groups.Select(g => g.Id).ToHashSet();
            _initialGroups = [.. _groups];
        }
    }

    private static string GroupLabel(UserGroupOption group) =>
        group.Name + (group.AllClients ? " (every client)" : string.Empty);

    private void Toggle(string role, bool selected)
    {
        if (selected)
        {
            _roles.Add(role);
        }
        else
        {
            _roles.Remove(role);
        }
    }

    private void ToggleGroup(Guid groupId, bool selected)
    {
        if (selected)
        {
            _groups.Add(groupId);
        }
        else
        {
            _groups.Remove(groupId);
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        _busy = true;
        try
        {
            var groups = _roles.Contains(FleetoRoles.Admin) ? [] : _groups.ToList();
            if (await OnSubmit(_email, _displayName, _password, _roles.ToList(), groups))
            {
                _password = string.Empty;
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
