@* Create or edit a policy. The scope (global or one client) is chosen at creation and cannot change. *@
@inject TimeDisplay Time
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(Existing is null ? "New policy" : $"Edit policy {Existing.Name}")</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="Name" Variant="Variant.Outlined" MaxLength="100" AutoFocus="true" Class="mb-3" />
        <MudTextField @bind-Value="_description" Label="Description (optional)" Variant="Variant.Outlined" Lines="2" MaxLength="1000" Class="mb-3" />
        @if (Existing is null)
        {
            <MudSelect T="Guid?" @bind-Value="_clientId" Label="Available for" Variant="Variant.Outlined" Class="mb-3"
                       HelperText="A global policy can be linked to any site; a client policy only to that client's sites.">
                <MudSelectItem T="Guid?" Value="@((Guid?)null)">Global (all clients)</MudSelectItem>
                @foreach (var client in Clients)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)client.Id)">@client.Code - @client.Name</MudSelectItem>
                }
            </MudSelect>
        }
        <MudNumericField T="int" @bind-Value="_heartbeat" Label="Heartbeat interval (seconds)" Variant="Variant.Outlined" Class="mb-1"
                         Min="@PolicyService.MinHeartbeatSeconds" Max="@PolicyService.MaxHeartbeatSeconds" />
        <MudText Typo="Typo.caption" Class="muted d-block mb-3">The agent reports it is alive @Intervals.Describe(Math.Max(1, _heartbeat)).</MudText>
        <MudNumericField T="int" @bind-Value="_inventoryMinutes" Label="Inventory interval (minutes)" Variant="Variant.Outlined" Class="mb-1"
                         Min="15" Max="10080" />
        <MudText Typo="Typo.caption" Class="muted d-block mb-3">Inventory is reported @Intervals.Describe(Math.Max(1, _inventoryMinutes) * 60).</MudText>
        <MudNumericField T="int" @bind-Value="_offlineMinutes" Label="Offline alert after (minutes)" Variant="Variant.Outlined" Class="mb-1"
                         Min="0" Max="@PolicyService.MaxOfflineAlertMinutes" />
        <MudText Typo="Typo.caption" Class="muted d-block mb-3">0 turns offline alerts off. Offline alerts apply to managed endpoints.</MudText>
        <MudSelect T="AlertSeverity" @bind-Value="_offlineSeverity" Label="Offline alert severity" Variant="Variant.Outlined">
            <MudSelectItem T="AlertSeverity" Value="AlertSeverity.Critical">Critical</MudSelectItem>
            <MudSelectItem T="AlertSeverity" Value="AlertSeverity.Warning">Warning</MudSelectItem>
        </MudSelect>
        <MudSwitch T="bool" @bind-Value="_scriptApproval" Color="Color.Primary" Class="mt-3" Label="Require approval of scripts by a second admin" />
        <MudText Typo="Typo.caption" Class="muted d-block">
            Jobs on the endpoints of sites with this policy then run only library scripts whose current version another admin approved.
            Recommended for servers.
        </MudText>
        <MudSelect T="UpdateRing" @bind-Value="_updateRing" Label="Agent updates" Variant="Variant.Outlined" Class="mt-4 mb-1">
            @foreach (var ring in Enum.GetValues<UpdateRing>())
            {
                <MudSelectItem T="UpdateRing" Value="ring">@Ui.UpdateRingLabel(ring)</MudSelectItem>
            }
        </MudSelect>
        <MudText Typo="Typo.caption" Class="muted d-block mb-3">
            When the agents of the linked sites install a new Fleeto release, counted from the moment this instance installed it. Applies to
            agent-only endpoints too.
        </MudText>
        <MudNumericField T="int" @bind-Value="_outputMegabytes" Label="Job output cap (MiB)" Variant="Variant.Outlined" Class="mt-3 mb-1"
                         Min="@PolicyService.MinOutputMegabytes" Max="@PolicyService.MaxOutputMegabytes" />
        <MudText Typo="Typo.caption" Class="muted d-block mb-3">
            Output one job may send back. The endpoint drops whatever a script writes beyond it and the job is marked truncated.
        </MudText>
        <MudText Typo="Typo.subtitle2" Class="mt-4">Remote sessions</MudText>
        <MudNumericField T="int" @bind-Value="_remoteIdleMinutes" Label="Idle timeout (minutes)" Variant="Variant.Outlined" Class="mt-2 mb-1"
                         Min="@RemoteSessionRules.MinIdleTimeoutMinutes" Max="@RemoteSessionRules.MaxIdleTimeoutMinutes" />
        <MudText Typo="Typo.caption" Class="muted d-block mb-3">
            A technician's remote control or remote background connection without input closes after this long. They are warned 2 minutes before.
        </MudText>
        <MudNumericField T="int" @bind-Value="_remoteFileMegabytes" Label="File size cap (MiB)" Variant="Variant.Outlined" Class="mb-1"
                         Min="@PolicyService.MinRemoteFileMegabytes" Max="@PolicyService.MaxRemoteFileMegabytes" />
        <MudText Typo="Typo.caption" Class="muted d-block mb-3">
            The largest file one transfer may carry: downloads and uploads in remote background, and files pasted into or copied from a remote
            control session.
        </MudText>
        <MudSwitch T="bool" @bind-Value="_remoteClipboard" Color="Color.Primary" Label="Synchronise the clipboard in remote control" />
        <MudText Typo="Typo.caption" Class="muted d-block mb-3">
            Text copied on either side is available on the other, files pasted or dragged into the window are placed on the endpoint clipboard,
            and files copied on the endpoint can be downloaded.
        </MudText>
        <MudSwitch T="bool" @bind-Value="_remoteBanner" Color="Color.Primary" Label="Show a banner on workstations during remote control" />
        <MudText Typo="Typo.caption" Class="muted d-block mb-3">The banner names every technician in the session. Servers never show it.</MudText>
        <MudSwitch T="bool" @bind-Value="_remoteConsent" Color="Color.Primary" Label="Ask the signed-in user before remote control on workstations" />
        <MudText Typo="Typo.caption" Class="muted d-block mb-2">
            The first technician of a session waits until the user allows it; a refusal ends the session. Without an answer access is granted
            after the timeout, and with nobody signed in it is granted at once. Servers never ask.
        </MudText>
        @if (_remoteConsent)
        {
            <MudNumericField T="int" @bind-Value="_remoteConsentSeconds" Label="Consent timeout (seconds)" Variant="Variant.Outlined" Class="mb-3"
                             Min="@RemoteSessionRules.MinConsentTimeoutSeconds" Max="@RemoteSessionRules.MaxConsentTimeoutSeconds" />
        }
        <MaintenanceWindowEditor Windows="_windows" DefaultTimeZone="@TimeZoneOptions.IanaId(Time.Zone)" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">@(Existing is null ? "Create policy" : "Save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public PolicyListItem? Existing { get; set; }
    [Parameter] public IReadOnlyList<ClientOption> Clients { get; set; } = [];
    [Parameter] public Func<Guid?, PolicyInput, Task<bool>> OnSubmit { get; set; } = (_, _) => Task.FromResult(true);

    private string _name = string.Empty;
    private string? _description;
    private Guid? _clientId;
    private int _heartbeat = 30;
    private int _inventoryMinutes = 360;
    private int _offlineMinutes = 10;
    private AlertSeverity _offlineSeverity = AlertSeverity.Critical;
    private List<MaintenanceWindowEditor.WindowModel> _windows = [];
    private bool _scriptApproval;
    private UpdateRing _updateRing = UpdateRing.Standard;
    private int _outputMegabytes = (int)(ScriptRules.DefaultMaxOutputBytes / ScriptRules.Mebibyte);
    private int _remoteIdleMinutes = RemoteSessionRules.DefaultIdleTimeoutMinutes;
    private int _remoteFileMegabytes = PolicyService.MaxRemoteFileMegabytes;
    private bool _remoteClipboard = true;
    private bool _remoteBanner = true;
    private bool _remoteConsent;
    private int _remoteConsentSeconds = RemoteSessionRules.DefaultConsentTimeoutSeconds;
    private bool _busy;

    protected override void OnInitialized()
    {
        if (Existing is { } p)
        {
            _name = p.Name;
            _description = p.Description;
            _heartbeat = p.HeartbeatIntervalSeconds;
            _inventoryMinutes = p.InventoryIntervalSeconds / 60;
            _offlineMinutes = p.OfflineAlertAfterMinutes;
            _offlineSeverity = p.OfflineAlertSeverity;
            _windows = p.MaintenanceWindows.Select(MaintenanceWindowEditor.WindowModel.From).ToList();
            _scriptApproval = p.ScriptApprovalRequired;
            _updateRing = p.UpdateRing;
            _outputMegabytes = (int)(p.MaxOutputBytes / ScriptRules.Mebibyte);
            _remoteIdleMinutes = p.RemoteIdleTimeoutMinutes;
            _remoteFileMegabytes = (int)(p.RemoteMaxFileBytes / ScriptRules.Mebibyte);
            _remoteClipboard = p.RemoteClipboardEnabled;
            _remoteBanner = p.RemoteBannerVisible;
            _remoteConsent = p.RemoteConsentRequired;
            _remoteConsentSeconds = p.RemoteConsentTimeoutSeconds;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        _busy = true;
        try
        {
            var input = new PolicyInput(_name, _description, _heartbeat, _inventoryMinutes * 60, _offlineMinutes, _offlineSeverity,
                _windows.Select(w => w.ToWindow()).ToList(), _scriptApproval, _updateRing, _outputMegabytes * ScriptRules.Mebibyte, _remoteIdleMinutes,
                _remoteConsent, _remoteConsentSeconds, _remoteBanner, _remoteClipboard, _remoteFileMegabytes * ScriptRules.Mebibyte);
            if (await OnSubmit(_clientId, input))
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
