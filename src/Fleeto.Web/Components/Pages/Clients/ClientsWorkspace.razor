    private async Task EditEndpointAsync(EndpointRow row)
    {
        // The row carries neither the class override nor the sites of the client: load the endpoint itself.
        EndpointDetail? endpoint = null;
        await LoadAsync(async caller => endpoint = await EndpointSvc.GetAsync(caller, row.Id));
        if (endpoint is null)
        {
            return;
        }

        // Class and site save separately: refresh after the dialog even when only the first save succeeded.
        var saved = false;
        var parameters = new DialogParameters<EndpointDialog>
        {
            { d => d.Endpoint, endpoint },
            {
                d => d.OnSubmit, async (classOverride, classChanged, siteId, siteChanged) =>
                {
                    if (classChanged && !await RunAsync(caller => EndpointSvc.SetClassOverrideAsync(caller, row.Id, classOverride), null))
                    {
                        return false;
                    }

                    saved |= classChanged;
                    if (siteChanged && !await RunAsync(caller => EndpointSvc.MoveAsync(caller, row.Id, siteId), null))
                    {
                        return false;
                    }

                    saved = true;
                    Snackbar.Add($"{row.Hostname} was saved. It receives its new configuration shortly.", Severity.Success);
                    return true;
                }
            }
        };
        var dialog = await DialogService.ShowAsync<EndpointDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        await dialog.Result;
        if (saved)
        {
            await AfterEndpointActionAsync(row.Id);
        }
    }

    private async Task SetTierAsync(EndpointRow row, EndpointTier tier)
    {
        _busy = true;
        try
        {
            var label = tier == EndpointTier.Managed ? "managed" : "agent-only";
            if (await RunAsync(caller => EndpointSvc.SetTierAsync(caller, [row.Id], tier), $"{row.Hostname} is now {label}."))
            {
                await AfterEndpointActionAsync(row.Id);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Runs one script on every selected endpoint and shows the result of the run per endpoint.</summary>
    private async Task RunScriptOnSelectionAsync()
    {
        var ids = _selected.ToList();
        if (ids.Count == 0)
        {
            return;
        }

        if (ids.Count > ScriptRules.MaxEndpointsPerRun)
        {
            Snackbar.Add($"A run reaches at most {ScriptRules.MaxEndpointsPerRun} endpoints. Narrow the selection.", Severity.Warning);
            return;
        }

        IReadOnlyList<RunnableScript> scripts = [];
        var notifyAbove = 0;
        if (!await RunAsync(async caller =>
            {
                scripts = await JobSvc.ListRunnableScriptsAsync(caller, ids);
                notifyAbove = await JobSvc.GetAdminNoticeAboveAsync();
                return ServiceResult.Ok();
            }, null))
        {
            return;
        }

        JobRunResult? run = null;
        var scriptName = string.Empty;
        var parameters = new DialogParameters<RunScriptDialog>
        {
            { d => d.EndpointIds, ids },
            { d => d.TargetLabel, Ui.Count(ids.Count, "endpoint") },
            { d => d.Scripts, scripts },
            { d => d.NotifyAdminsAbove, notifyAbove },
            { d => d.OfferAllUsers, true },
            {
                d => d.OnSubmit, async (scriptId, validity, runAs, _, allUsers) =>
                {
                    var result = await RunForValueAsync(caller => JobSvc.RunAsync(caller, scriptId, ids, validity, runAs, allSignedInUsers: allUsers), null);
                    run = result?.Value;
                    scriptName = scripts.FirstOrDefault(s => s.Id == scriptId)?.Name ?? "Script";
                    return result is not null;
                }
            }
        };
        var dialog = await DialogService.ShowAsync<RunScriptDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        await dialog.Result;
        if (run is not { } started)
        {
            return;
        }

        ClearSelection();
        var show = new DialogParameters<JobBatchDialog>
        {
            { d => d.BatchId, started.BatchId },
            { d => d.ScriptName, scriptName },
            { d => d.Skipped, started.Skipped },
            { d => d.AdminsNotified, started.AdminsNotified }
        };
        var batchDialog = await DialogService.ShowAsync<JobBatchDialog>(null, show, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        await batchDialog.Result;
    }

    private async Task DeployUpdatesOnSelectionAsync()
    {
        var ids = _selected.ToList();
        if (ids.Count == 0)
        {
            return;
        }

        if (ids.Count > PatchRules.MaxEndpointsPerDeployment)
        {
            Snackbar.Add($"A deployment reaches at most {PatchRules.MaxEndpointsPerDeployment} endpoints. Narrow the selection.", Severity.Warning);
            return;
        }

        await DeployUpdatesAsync(ids, Ui.Count(ids.Count, "endpoint"));
    }

    /// <summary>
    /// Deploys every missing update on the given endpoints. Choosing single updates happens on the Patches tab of one
    /// endpoint, where the technician can see what they are choosing.
    /// </summary>
    private async Task DeployUpdatesAsync(IReadOnlyList<Guid> endpointIds, string label)
    {
        DeploymentStartResult? run = null;
        var parameters = new DialogParameters<DeployUpdatesDialog>
        {
            { d => d.EndpointIds, endpointIds },
            { d => d.TargetLabel, label },
            { d => d.OnSubmit, async (bool autoReboot) =>
                {
                    var result = await RunForValueAsync(caller => PatchSvc.StartDeploymentAsync(caller, endpointIds, null, autoReboot), null);
                    run = result?.Value;
                    return run is not null;
                } }
        };
        var dialog = await DialogService.ShowAsync<DeployUpdatesDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        await dialog.Result;
        if (run is not { } started)
        {
            return;
        }

        if (endpointIds.Count > 1)
        {
            ClearSelection();
        }

        var show = new DialogParameters<PatchDeploymentDialog>
        {
            { d => d.BatchId, started.BatchId },
            { d => d.Skipped, started.Skipped }
        };
        var batchDialog = await DialogService.ShowAsync<PatchDeploymentDialog>(null, show, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        await batchDialog.Result;
    }

    private async Task RunScriptAsync(EndpointRow row)
