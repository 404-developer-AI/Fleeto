    private async Task EnrollAgainAsync(EndpointRow row)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { d => d.Title, $"Enroll {row.Hostname} again" },
            {
                d => d.Message,
                "Creates a single-use install command, valid for one day, for an agent that cannot reconnect: it was offline for more than a year, was revoked by mistake, or the endpoint was reinstalled. " +
                "The agent installed with it takes over this endpoint with its checks, alerts, notes and history, and every earlier certificate of this endpoint is revoked. " +
                "If the agent service is still installed on the endpoint, run fleeto-agent uninstall there first."
            },
            { d => d.ConfirmText, "Create install command" }
        };
        var confirm = await DialogService.ShowAsync<ConfirmDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if ((await confirm.Result)!.Canceled)
        {
            return;
        }

        if ((await RunForValueAsync(caller => EnrollmentSvc.CreateForEndpointAsync(caller, row.Id), null))?.Value is not { } created)
        {
            return;
        }

        var show = new DialogParameters<InstallCommandDialog> { { d => d.Created, created } };
        // The command is shown once: the dialog cannot be dismissed by clicking beside it by accident.
        var commandDialog = await DialogService.ShowAsync<InstallCommandDialog>(null, show,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        await commandDialog.Result;
    }

    private async Task RevokeEndpointAsync(EndpointRow row)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { d => d.Title, $"Revoke the agent of {row.Hostname}" },
            { d => d.Message, "Every certificate of this agent is revoked and its connection is closed at once. The agent cannot reconnect, renew or recover; to use this endpoint again, choose Enroll again." },
            { d => d.ReasonLabel, "Reason, for example a stolen laptop or a suspected clone" },
            { d => d.ConfirmText, "Revoke agent" }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
