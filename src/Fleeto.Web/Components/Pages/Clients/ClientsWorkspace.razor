    private async Task CreateSiteAsync()
    {
        var client = _client!;
        Guid? createdId = null;
        var parameters = new DialogParameters<SiteDialog>
        {
            {
                d => d.OnSubmit, async (name, description) =>
                {
                    var result = await RunForValueAsync(caller => SiteSvc.CreateAsync(caller, client.Id, name, description), "The site was created.");
                    createdId = result?.Value;
                    return result is not null;
                }
            }
        };
        var dialog = await DialogService.ShowAsync<SiteDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
