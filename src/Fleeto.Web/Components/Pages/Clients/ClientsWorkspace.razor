@page "/clients"
@page "/clients/{ClientId:guid}"
@page "/sites/{SiteId:guid}"
@attribute [Authorize(Policy = FleetoPolicies.Viewer)]
@inherits FleetoPageBase
@inject ClientService ClientSvc
@inject TagService TagSvc
@inject ClientTemplateService ClientTemplates
@inject SiteService SiteSvc
@inject LinkService LinkSvc
@inject EndpointService EndpointSvc
@inject PatchService PatchSvc
@inject EnrollmentService EnrollmentSvc
@inject JobService JobSvc
@inject MaintenanceService MaintenanceSvc
@inject IDialogService DialogService
@inject LiveUpdates Live
@inject IJSRuntime JS
@inject RemoteWindow RemoteWindow
@inject TimeProvider Clock

@* Clients workspace: clients and sites on the left, the endpoints of the selection on the right, and the selected endpoint below. *@
<PageTitle>@PageTitleText - Fleeto</PageTitle>

<div class="clients-workspace">
    <aside class="client-panel">
        <div class="client-panel-head">
            <a href="/clients" class="client-panel-all @(IsAllScope ? "selected" : "")">
                <MudIcon Icon="@Icons.Material.Outlined.Home" Size="Size.Small" />
                <span>All clients</span>
            </a>
            @if (CanManage)
            {
                <MudTooltip Text="New client">
                    <MudIconButton Icon="@Icons.Material.Outlined.Add" Size="Size.Small" aria-label="New client" OnClick="CreateClientAsync" />
                </MudTooltip>
            }
        </div>
        <div class="px-3 pb-2">
            <div class="d-flex align-center gap-1">
                <MudTextField T="string" Value="_clientSearch" ValueChanged="SearchClientsAsync" Placeholder="Search clients" Variant="Variant.Outlined"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Immediate="true" DebounceInterval="300"
                              Margin="Margin.Dense" Clearable="true" />
                @if (_tagOptions.Count > 0)
                {
                    <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" aria-label="Filter clients by tag" MaxHeight="360">
                        <ActivatorContent>
                            <MudBadge Dot="true" Color="Color.Primary" Visible="@(_tagFilter.Count > 0)" Overlap="true">
                                <MudIconButton Icon="@Icons.Material.Outlined.Sell" Size="Size.Small" aria-label="Filter clients by tag" OnClick="@context.ToggleAsync" />
                            </MudBadge>
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem Disabled="true">Clients with every chosen tag</MudMenuItem>
                            @foreach (var tag in _tagOptions)
                            {
                                <MudMenuItem AutoClose="false" OnClick="@(() => ToggleTagFilterAsync(tag.Id))">
                                    <div class="d-flex align-center gap-2">
                                        <MudIcon Icon="@(_tagFilter.Contains(tag.Id) ? Icons.Material.Outlined.CheckBox : Icons.Material.Outlined.CheckBoxOutlineBlank)" Size="Size.Small" />
                                        <TagChip Name="@tag.Name" Color="tag.Color" />
                                    </div>
                                </MudMenuItem>
                            }
                            @if (_tagFilter.Count > 0)
                            {
                                <MudDivider />
                                <MudMenuItem Icon="@Icons.Material.Outlined.FilterListOff" OnClick="ClearTagFilterAsync">Clear tag filter</MudMenuItem>
                            }
                        </ChildContent>
                    </MudMenu>
                }
            </div>
            @if (_tagFilter.Count > 0)
            {
                <div class="tag-list mt-2" aria-label="Tag filter">
                    @foreach (var tag in _tagOptions.Where(t => _tagFilter.Contains(t.Id)))
                    {
                        <TagChip Name="@tag.Name" Color="tag.Color" Active="true" Title="@($"Stop filtering on tag {tag.Name}")"
                                 OnClick="() => ToggleTagFilterAsync(tag.Id)" />
                    }
                </div>
            }
        </div>
        <nav class="client-panel-list" aria-label="Clients and sites">
            @if (_tree.Count == 0 && !_treeLoading)
            {
                <MudText Typo="Typo.body2" Class="muted px-4 py-2">
                    @(string.IsNullOrEmpty(_clientSearch) && _tagFilter.Count == 0 ? "No clients yet." : "No clients match this search.")
                </MudText>
            }
            @foreach (var client in _tree)
            {
                var expanded = _expanded.Contains(client.Id);
                <div class="client-row @(ClientId == client.Id ? "selected" : "")">
                    <button type="button" class="client-expand" aria-label="@(expanded ? "Collapse" : "Expand") @client.Code" @onclick="() => ToggleExpanded(client.Id)">
                        <MudIcon Icon="@(expanded ? Icons.Material.Outlined.ExpandMore : Icons.Material.Outlined.ChevronRight)" Size="Size.Small" />
                    </button>
                    <a href="@($"/clients/{client.Id}")" class="client-link" title="@($"[{client.Code}] {client.Name}")">
                        <MudIcon Icon="@Icons.Material.Outlined.Business" Size="Size.Small" Class="client-icon" />
                        <span class="client-name @(client.Tags.Count > 0 ? "client-name-fit" : "")">[@client.Code] @client.Name</span>
                        @if (client.Tags.Count > 0)
                        {
                            @* At most two tags fit next to the name; the rest is counted, and the tooltip names them all. *@
                            <span class="tree-tags" title="@($"Tags: {string.Join(", ", client.Tags.Select(t => t.Name))}")">
                                @foreach (var tag in client.Tags.Take(2))
                                {
                                    <TagChip Name="@tag.Name" Color="tag.Color" />
                                }
                                @if (client.Tags.Count > 2)
                                {
                                    <span class="tag-chip tag-gray">+@(client.Tags.Count - 2)</span>
                                }
                            </span>
                        }
                        @MaintenanceBadge(client.MaintenanceActive, client.InMaintenanceCount, client.EndpointCount)
                        @if (client.OpenAlertCount > 0)
                        {
                            <span class="tree-badge tree-badge-alert" title="@($"{client.OpenAlertCount} open alerts")">@client.OpenAlertCount</span>
                        }
                    </a>
                </div>
                @if (expanded)
                {
                    @foreach (var site in client.Sites)
                    {
                        <a href="@($"/sites/{site.Id}")" class="site-row @(SiteId == site.Id ? "selected" : "")" title="@site.Name">
                            <MudIcon Icon="@Icons.Material.Outlined.Folder" Size="Size.Small" Class="client-icon" />
                            <span class="client-name">@site.Name</span>
                            @MaintenanceBadge(site.MaintenanceActive || client.MaintenanceActive, site.InMaintenanceCount, site.EndpointCount)
                            @if (site.OpenAlertCount > 0)
                            {
                                <span class="tree-badge tree-badge-alert">@site.OpenAlertCount</span>
                            }
                            else
                            {
                                <span class="tree-badge">@site.EndpointCount</span>
                            }
                        </a>
                    }
                }
            }
        </nav>
    </aside>

    <section class="workspace-main">
        <LoadState Loading="Loading" Failed="LoadFailed" NotFound="_notFound" What="@(SiteId is null ? "client" : "site")">
            <MudBreadcrumbs Items="Breadcrumb" Class="px-0 pt-0 pb-2 fl-breadcrumbs" />

            <div class="workspace-header">
                <div class="workspace-header-icon">
                    <MudIcon Icon="@(SiteId is not null ? Icons.Material.Outlined.Folder : IsAllScope ? Icons.Material.Outlined.Home : Icons.Material.Outlined.Business)" />
                </div>
                <div class="workspace-header-text">
                    <MudText Typo="Typo.h4" Class="page-title">@HeaderTitle</MudText>
                    <MudText Typo="Typo.body2" Class="muted">@HeaderSubtitle</MudText>
                    @if (PatchSummary is { } patchSummary)
                    {
                        <MudText Typo="Typo.body2" Class="muted">@patchSummary</MudText>
                    }
                    @if (_client is { Tags.Count: > 0 } taggedClient)
                    {
                        <div class="tag-list mt-1" aria-label="Tags">
                            @foreach (var tag in taggedClient.Tags)
                            {
                                <TagChip Name="@tag.Name" Color="tag.Color" />
                            }
                        </div>
                    }
                    @if (ScopeMaintenance is { } scopeMaintenance)
                    {
                        <div class="mt-1"><MaintenanceChip Maintenance="scopeMaintenance" SourceName="@ScopeMaintenanceSource" /></div>
                    }
                </div>
                <div class="workspace-header-actions">
                    @if (_site is { } site && CanManage)
                    {
                        <MudMenu Label="Site settings" StartIcon="@Icons.Material.Outlined.Settings" Variant="Variant.Outlined"
                                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                            <MudMenuItem Icon="@Icons.Material.Outlined.Edit" OnClick="EditSiteAsync">Edit site</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Outlined.Key" OnClick="ShowTokensAsync">Enrollment tokens</MudMenuItem>
                            @MaintenanceMenuItems(MaintenanceTarget.Site, site.Id, $"site {site.Name}", true, site.Maintenance)
                            <MudDivider />
                            <MudMenuItem Icon="@Icons.Material.Outlined.Delete" IconColor="Color.Error" OnClick="DeleteSiteAsync">Delete site</MudMenuItem>
                        </MudMenu>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add"
                                   OnClick="@(() => CreateTokenAsync(site.Id, site.Name))">Add endpoint</MudButton>
                    }
                    else if (_site is not null)
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Tune" OnClick="EditSiteAsync">Policies</MudButton>
                    }
                    else if (_client is { } client && CanManage)
                    {
                        <MudMenu Label="Client settings" StartIcon="@Icons.Material.Outlined.Settings" Variant="Variant.Outlined"
                                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                            <MudMenuItem Icon="@Icons.Material.Outlined.Edit" OnClick="EditClientAsync">Edit client</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Outlined.Sell" OnClick="EditClientTagsAsync">Edit tags</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Outlined.CreateNewFolder" OnClick="CreateSiteAsync">New site</MudMenuItem>
                            @if (client.ClientTemplateId is not null)
                            {
                                <MudMenuItem Icon="@Icons.Material.Outlined.LinkOff" OnClick="DetachClientAsync">Detach from client template</MudMenuItem>
                            }
                            @MaintenanceMenuItems(MaintenanceTarget.Client, client.Id, $"client {client.Code}", true, client.Maintenance)
                            <MudDivider />
                            <MudMenuItem Icon="@Icons.Material.Outlined.Delete" IconColor="Color.Error" OnClick="DeleteClientAsync">Delete client</MudMenuItem>
                        </MudMenu>
                        @if (client.Sites.Count == 1)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add"
                                       OnClick="@(() => CreateTokenAsync(client.Sites[0].Id, client.Sites[0].Name))">Add endpoint</MudButton>
                        }
                        else if (client.Sites.Count > 1)
                        {
                            <MudMenu Label="Add endpoint" StartIcon="@Icons.Material.Outlined.Add" EndIcon="@Icons.Material.Outlined.ArrowDropDown"
                                     Variant="Variant.Filled" Color="Color.Primary" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                <MudMenuItem Disabled="true">Choose the site for the new endpoint</MudMenuItem>
                                @foreach (var clientSite in client.Sites)
                                {
                                    <MudMenuItem Icon="@Icons.Material.Outlined.Folder" OnClick="@(() => CreateTokenAsync(clientSite.Id, clientSite.Name))">@clientSite.Name</MudMenuItem>
                                }
                            </MudMenu>
                        }
                    }
                </div>
            </div>

            <div class="endpoint-list fl-panel">
                <div class="endpoint-list-toolbar">
                    <MudTabs Elevation="0" ActivePanelIndex="_tab" ActivePanelIndexChanged="OnTabChangedAsync" Class="endpoint-class-tabs">
                        <MudTabPanel Text="@($"Servers ({_page?.ServerCount ?? 0})")" Icon="@Icons.Material.Outlined.Dns" />
                        <MudTabPanel Text="@($"Workstations ({_page?.WorkstationCount ?? 0})")" Icon="@Icons.Material.Outlined.Computer" />
                        <MudTabPanel Text="@($"Mixed ({_page?.TotalCount ?? 0})")" Icon="@Icons.Material.Outlined.Devices" />
                    </MudTabs>
                    <div class="endpoint-list-search">
                        <MudTextField T="string" Value="_endpointSearch" ValueChanged="SearchEndpointsAsync" Placeholder="Search endpoints"
                                      Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                                      Immediate="true" DebounceInterval="300" Margin="Margin.Dense" Clearable="true" />
                        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" aria-label="Filter endpoints">
                            <ActivatorContent>
                                <MudBadge Dot="true" Color="Color.Primary" Visible="@FiltersActive" Overlap="true">
                                    <MudIconButton Icon="@Icons.Material.Outlined.FilterList" Variant="Variant.Outlined" Size="Size.Medium" aria-label="Filter endpoints"
                                                   OnClick="@context.ToggleAsync" />
                                </MudBadge>
                            </ActivatorContent>
                            <ChildContent>
                                <MudMenuItem Disabled="true">Status</MudMenuItem>
                                @FilterItem("All statuses", _status == EndpointStatusFilter.All, () => SetStatusAsync(EndpointStatusFilter.All))
                                @FilterItem("Online", _status == EndpointStatusFilter.Online, () => SetStatusAsync(EndpointStatusFilter.Online))
                                @FilterItem("Offline", _status == EndpointStatusFilter.Offline, () => SetStatusAsync(EndpointStatusFilter.Offline))
                                @FilterItem("With open alerts", _status == EndpointStatusFilter.WithOpenAlerts, () => SetStatusAsync(EndpointStatusFilter.WithOpenAlerts))
                                @FilterItem("In maintenance", _status == EndpointStatusFilter.InMaintenance, () => SetStatusAsync(EndpointStatusFilter.InMaintenance))
                                <MudDivider />
                                <MudMenuItem Disabled="true">License tier</MudMenuItem>
                                @FilterItem("All tiers", _tier is null, () => SetTierFilterAsync(null))
                                @FilterItem("Managed", _tier == EndpointTier.Managed, () => SetTierFilterAsync(EndpointTier.Managed))
                                @FilterItem("Agent-only", _tier == EndpointTier.AgentOnly, () => SetTierFilterAsync(EndpointTier.AgentOnly))
                            </ChildContent>
                        </MudMenu>
                    </div>
                </div>

                <div class="endpoint-table-scroll" @ref="_tableScroll">
                    @if (_rowsLoading && _page is null)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    }
                    else if (_page is null || _page.Rows.Count == 0)
                    {
                        @EmptyList()
                    }
                    else
                    {
                        <MudTable T="EndpointRow" Items="_page.Rows" Dense="true" Hover="true" Elevation="0" FixedHeader="true" Class="endpoint-table"
                                  OnRowClick="OnRowClick" RowClassFunc="RowClass">
                            <HeaderContent>
                                @if (CanManage)
                                {
                                    <MudTh Style="width:44px">
                                        <MudCheckBox T="bool" Value="@AllRowsSelected" Dense="true" Size="Size.Small"
                                                     aria-label="Select every endpoint in this list" ValueChanged="SelectAllRows" />
                                    </MudTh>
                                }
                                <MudTh Style="width:36px"></MudTh>
                                <MudTh>Hostname</MudTh>
                                @if (IsAllScope)
                                {
                                    <MudTh>Client</MudTh>
                                }
                                @if (SiteId is null)
                                {
                                    <MudTh>Site</MudTh>
                                }
                                <MudTh>Operating system</MudTh>
                                <MudTh>User</MudTh>
                                <MudTh>Tier</MudTh>
                                <MudTh>Status</MudTh>
                                <MudTh>Last seen</MudTh>
                            </HeaderContent>
                            @* Every cell opens the endpoint menu on right-click (see RowMenu): MudTable has no row-level context menu event. *@
                            <RowTemplate>
                                @if (CanManage)
                                {
                                    @* Selecting must not open the endpoint below the list, so the click stops here. *@
                                    <MudTd @onclick:stopPropagation="true">
                                        <MudCheckBox T="bool" Value="@_selected.Contains(context.Id)" Dense="true" Size="Size.Small"
                                                     aria-label="@($"Select {context.Hostname}")"
                                                     ValueChanged="@(value => SelectRow(context, value))" />
                                    </MudTd>
                                }
                                <MudTd @attributes="RowMenu(context)">
                                    <MudIcon Icon="@(context.EffectiveClass == EndpointClass.Server ? Icons.Material.Outlined.Dns : Icons.Material.Outlined.Computer)"
                                             Size="Size.Small" Class="muted" />
                                </MudTd>
                                <MudTd @attributes="RowMenu(context)"><strong>@context.Hostname</strong></MudTd>
                                @if (IsAllScope)
                                {
                                    <MudTd @attributes="RowMenu(context)">[@context.ClientCode] @context.ClientName</MudTd>
                                }
                                @if (SiteId is null)
                                {
                                    <MudTd @attributes="RowMenu(context)">@context.SiteName</MudTd>
                                }
                                <MudTd @attributes="RowMenu(context)">@context.OsName</MudTd>
                                <MudTd @attributes="RowMenu(context)">@(string.IsNullOrEmpty(context.LoggedOnUser) ? "-" : context.LoggedOnUser)</MudTd>
                                <MudTd @attributes="RowMenu(context)"><StatusChip Text="@Ui.TierLabel(context.Tier)" Kind="@Ui.TierKind(context.Tier)" /></MudTd>
                                <MudTd @attributes="RowMenu(context)">
                                    <div class="d-flex align-center gap-1 flex-wrap">
                                        <StatusChip Text="@(context.IsOnline ? "Online" : "Offline")" Kind="@(context.IsOnline ? StatusKind.Ok : StatusKind.Error)" Dot="true" />
                                        @if (context.OpenAlertCount > 0)
                                        {
                                            <StatusChip Text="@(context.OpenAlertCount == 1 ? "1 alert" : $"{context.OpenAlertCount} alerts")"
                                                        Kind="@(context.HasCriticalAlert ? StatusKind.Error : StatusKind.Warning)" />
                                        }
                                        <MaintenanceChip Maintenance="context.Maintenance" SourceName="@(context.Maintenance?.Source == MaintenanceSource.Client ? context.ClientCode : context.SiteName)" />
                                    </div>
                                </MudTd>
                                <MudTd @attributes="RowMenu(context)"><TimeText Value="context.LastSeenAt" /></MudTd>
                            </RowTemplate>
                        </MudTable>
                        @if (CanManage)
                        {
                            <MudMenu @ref="_endpointMenu" PositionAtCursor="true" aria-label="Endpoint actions">
                                <ActivatorContent></ActivatorContent>
                                <ChildContent>
                                    @if (_selected.Count > 1)
                                    {
                                        <MudMenuItem Icon="@Icons.Material.Outlined.PlayArrow" OnClick="RunScriptOnSelectionAsync">
                                            Run script on @Ui.Count(_selected.Count, "endpoint")
                                        </MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Outlined.SystemUpdateAlt" OnClick="DeployUpdatesOnSelectionAsync">
                                            Deploy updates on @Ui.Count(_selected.Count, "endpoint")
                                        </MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Outlined.Deselect" OnClick="ClearSelection">Clear selection</MudMenuItem>
                                        <MudDivider />
                                    }
                                    @if (_menuRow is { } row)
                                    {
                                        <MudMenuItem Icon="@Icons.Material.Outlined.Edit" OnClick="@(() => EditEndpointAsync(row))">Edit</MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Outlined.Tune" OnClick="@(() => EditEndpointLinksAsync(row.Id, row.Hostname))">Policies</MudMenuItem>
                                        @if (row.Tier == EndpointTier.AgentOnly)
                                        {
                                            <MudMenuItem Icon="@Icons.Material.Outlined.Verified" Disabled="_busy" OnClick="@(() => SetTierAsync(row, EndpointTier.Managed))">Switch to managed</MudMenuItem>
                                        }
                                        else
                                        {
                                            <MudMenuItem Icon="@Icons.Material.Outlined.RemoveModerator" Disabled="_busy" OnClick="@(() => SetTierAsync(row, EndpointTier.AgentOnly))">Switch to agent-only</MudMenuItem>
                                        }
                                        @if (row.Tier == EndpointTier.Managed)
                                        {
                                            @if (RemoteSessionRules.SupportsRemoteControl(row.OsPlatform, row.Desktop))
                                            {
                                                <MudMenuItem Icon="@Icons.Material.Outlined.ScreenShare" OnClick="@(() => RemoteWindow.OpenControlAsync(row.Id))">Remote control</MudMenuItem>
                                            }
                                            <MudMenuItem Icon="@Icons.Material.Outlined.Terminal" OnClick="@(() => RemoteWindow.OpenBackgroundAsync(row.Id))">Remote background</MudMenuItem>
                                            <MudMenuItem Icon="@Icons.Material.Outlined.PlayArrow" OnClick="@(() => RunScriptAsync(row))">Run script</MudMenuItem>
                                            <MudMenuItem Icon="@Icons.Material.Outlined.SystemUpdateAlt" OnClick="@(() => DeployUpdatesAsync([row.Id], row.Hostname))">Deploy updates</MudMenuItem>
                                            @MaintenanceMenuItems(MaintenanceTarget.Endpoint, row.Id, row.Hostname, false, row.OwnMaintenanceActive ? row.OwnMaintenance : null)
                                        }
                                        <MudMenuItem Icon="@Icons.Material.Outlined.Replay" OnClick="@(() => EnrollAgainAsync(row))">Enroll again</MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Outlined.GppBad" OnClick="@(() => RevokeEndpointAsync(row))">Revoke agent</MudMenuItem>
                                        <MudDivider />
                                        <MudMenuItem Icon="@Icons.Material.Outlined.Delete" IconColor="Color.Error" OnClick="@(() => DeleteEndpointAsync(row))">Delete endpoint</MudMenuItem>
                                    }
                                </ChildContent>
                            </MudMenu>
                        }
                        @if (_page.Truncated)
                        {
                            <MudText Typo="Typo.body2" Class="muted px-4 py-2">
                                Showing the first @EndpointService.ListLimit endpoints. Search, filter or pick a client to see the others.
                            </MudText>
                        }
                    }
                </div>
            </div>

            @if (SelectedEndpointId is { } endpointId)
            {
                <div class="split-handle" @ref="_splitHandle" title="Drag to resize the endpoint list" role="separator" aria-orientation="horizontal">
                    <span></span>
                </div>
                <div class="fl-panel endpoint-detail-panel">
                    <div class="d-flex justify-end">
                        <MudTooltip Text="Close">
                            <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" aria-label="Close endpoint details" OnClick="CloseDetail" />
                        </MudTooltip>
                    </div>
                    <EndpointDetailView @ref="_detail" EndpointId="endpointId" Embedded="true" OnChanged="OnEndpointChangedAsync" />
                </div>
            }
        </LoadState>
    </section>
</div>

@code {
    private const int ServersTab = 0;
    private const int WorkstationsTab = 1;

    [Parameter] public Guid? ClientId { get; set; }
    [Parameter] public Guid? SiteId { get; set; }

    [SupplyParameterFromQuery(Name = "endpoint")]
    public Guid? SelectedEndpointId { get; set; }

    /// <summary>True when opened from the Create menu in the navigation: the new client dialog opens once the page has loaded.</summary>
    [SupplyParameterFromQuery(Name = "new")]
    public bool New { get; set; }

    private IReadOnlyList<ClientTreeItem> _tree = [];
    private bool _treeLoading = true;
    private string? _clientSearch;
    private readonly HashSet<Guid> _expanded = [];
    private IReadOnlyList<TagView> _tagOptions = [];
    private readonly HashSet<Guid> _tagFilter = [];

    private string? _scopeKey;
    private bool _notFound;
    private ClientDetail? _client;
    private SiteSummary? _site;

    private EndpointListPage? _page;
    private PatchCompliance _patches = PatchCompliance.None;
    private bool _rowsLoading = true;
    private int _tab = ServersTab;
    private string? _endpointSearch;
    private EndpointStatusFilter _status = EndpointStatusFilter.All;
    private EndpointTier? _tier;
    private bool _busy;
    private MudMenu? _endpointMenu;
    private EndpointRow? _menuRow;
    private readonly HashSet<Guid> _selected = [];
    private EndpointDetailView? _detail;

    private ElementReference _tableScroll;
    private ElementReference _splitHandle;
    private DebouncedRefresh? _refresh;

    private bool IsAllScope => ClientId is null && SiteId is null;
    private bool FiltersActive => _status != EndpointStatusFilter.All || _tier is not null;

    private string PageTitleText => _site is not null ? _site.Name : _client is not null ? _client.Code : "Clients";

    private string HeaderTitle => _site is not null ? _site.Name : _client is not null ? $"[{_client.Code}] {_client.Name}" : "All clients";

    /// <summary>
    /// Patch compliance of the selection, shown only where patch management actually covers endpoints (0.4.0): a client
    /// without an Action1 mapping says nothing rather than "0%".
    /// </summary>
    private string? PatchSummary => _patches.Covered == 0
        ? null
        : $"Patches: {_patches.Percentage}% up to date ({_patches.Compliant} of {_patches.Covered})" +
          (_patches.MissingCritical > 0 ? $", {_patches.MissingCritical} missing critical" : string.Empty) +
          (_patches.NotPatched > 0 ? $", {_patches.NotPatched} not patched" : string.Empty);

    private string HeaderSubtitle
    {
        get
        {
            if (_site is { } site)
            {
                var templates = site.MonitoringTemplateCount == 1 ? "1 monitoring template" : $"{site.MonitoringTemplateCount} monitoring templates";
                return $"[{site.ClientCode}] {site.ClientName} · {site.PolicyName} · {templates}" +
                       (string.IsNullOrEmpty(site.Description) ? string.Empty : " · " + site.Description);
            }

            if (_client is { } client)
            {
                return client.TemplateName is not null
                    ? $"Follows client template {client.TemplateName}. Every endpoint of every site of this client."
                    : "Every endpoint of every site of this client.";
            }

            return "Every endpoint of every client.";
        }
    }

    /// <summary>The own maintenance of the selected client or site, or for a site the maintenance of its client.</summary>
    private EffectiveMaintenance? ScopeMaintenance
    {
        get
        {
            var now = Clock.GetUtcNow().UtcDateTime;
            if (_site is { } site)
            {
                return MaintenanceRules.Effective(MaintenancePeriod.None, site.Maintenance, site.ClientMaintenance, now);
            }

            return _client is { } client ? MaintenanceRules.Effective(MaintenancePeriod.None, MaintenancePeriod.None, client.Maintenance, now) : null;
        }
    }

    private string? ScopeMaintenanceSource => _site is not null && ScopeMaintenance?.Source == MaintenanceSource.Client ? _site.ClientCode : null;

    private List<BreadcrumbItem> Breadcrumb
    {
        get
        {
            var items = new List<BreadcrumbItem> { new("Clients", IsAllScope ? null : "/clients", disabled: IsAllScope) };
            if (_site is { } site)
            {
                items.Add(new BreadcrumbItem($"[{site.ClientCode}] {site.ClientName}", $"/clients/{site.ClientId}"));
                items.Add(new BreadcrumbItem(site.Name, null, disabled: true));
            }
            else if (_client is { } client)
            {
                items.Add(new BreadcrumbItem($"[{client.Code}] {client.Name}", null, disabled: true));
