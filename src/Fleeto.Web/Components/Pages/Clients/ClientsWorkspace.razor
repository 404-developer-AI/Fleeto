    /// <summary>The name and description of the site and its policy, patch policy and monitoring templates (0.6.0).</summary>
    private async Task EditSiteAsync()
    {
        var site = _site!;
        LevelLinks? links = null;
        await LoadAsync(async caller => links = await LinkSvc.GetAsync(caller, LinkLevel.Site, site.Id));
        if (links is null)
        {
            return;
        }

        var parameters = new DialogParameters<LevelLinksDialog>
        {
            { d => d.Title, CanManage ? $"Edit site {site.Name}" : $"Site {site.Name}" },
            { d => d.Links, links },
            { d => d.CanManage, CanManage },
            { d => d.NameLabel, "Site name" },
            { d => d.InitialName, site.Name },
            { d => d.ShowDescription, true },
            { d => d.InitialDescription, site.Description },
            {
                d => d.OnSubmit, async (name, description, input, linksChanged) =>
                {
                    if ((name != site.Name || description != site.Description) &&
                        !await RunAsync(caller => SiteSvc.UpdateAsync(caller, site.Id, name, description), null))
                    {
                        return false;
                    }

                    if (linksChanged && !await RunAsync(caller => LinkSvc.SetAsync(caller, LinkLevel.Site, site.Id, input), null))
                    {
                        return false;
                    }

                    Snackbar.Add(linksChanged
                        ? "The site was saved. Its endpoints receive the new configuration shortly."
                        : "The site was saved.", Severity.Success);
                    return true;
                }
            }
        };
        var dialog = await DialogService.ShowAsync<LevelLinksDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dialog.Result)!.Canceled)
        {
            await ReloadAllAsync();
        }
    }

    private async Task DeleteSiteAsync()
    {
        var site = _site!;
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { d => d.Title, $"Delete site {site.Name}" },
            { d => d.Message, "The site, its links to a policy and monitoring templates, and its enrollment tokens are removed. A site with endpoints cannot be deleted." }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(null, parameters);
