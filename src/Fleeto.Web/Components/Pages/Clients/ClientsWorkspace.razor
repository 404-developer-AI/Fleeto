    private async Task DeleteClientAsync()
    {
        var client = _client!;
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { d => d.Title, $"Delete client {client.Code}" },
            { d => d.Message, $"This removes client {client.Code} with every site, every endpoint and all data of the client: inventory, checks, alerts, enrollment tokens and agent certificates. Connected agents are disconnected and must be enrolled again to return. This cannot be undone." },
            { d => d.TypeToConfirm, client.Code },
            { d => d.ConfirmText, "Delete client" }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(null, parameters);
        var result = await dialog.Result;
        if (!result!.Canceled &&
            await RunAsync(caller => ClientSvc.DeleteAsync(caller, client.Id, result.Data as string), $"Client {client.Code} was deleted."))
        {
            _expanded.Remove(client.Id);
            await LoadTreeAsync();
            Navigation.NavigateTo("/clients");
        }
    }

