    /// <summary>"all" when the whole client or site is in maintenance, "2/14" when some endpoints are.</summary>
    private RenderFragment MaintenanceBadge(bool wholeScope, int count, int endpoints) => __builder =>
    {
        if (!wholeScope && count == 0)
        {
            return;
        }

        var all = wholeScope || count >= endpoints;
        <span class="tree-badge" title="@(all ? "Every endpoint is in maintenance" : $"{count} of {endpoints} endpoints are in maintenance")">
            <MudIcon Icon="@Icons.Material.Outlined.Construction" Style="font-size:11px;vertical-align:-1px" />
            @(all ? "all" : $"{count}/{endpoints}")
        </span>
    };

    /// <param name="current">The active maintenance of the target itself, or null when it has none.</param>
    private RenderFragment MaintenanceMenuItems(MaintenanceTarget target, Guid id, string label, bool coversEndpoints, MaintenancePeriod? current) => __builder =>
    {
        var active = current?.IsActive(Clock.GetUtcNow().UtcDateTime) == true;
        <MudMenuItem Icon="@Icons.Material.Outlined.Construction" OnClick="@(() => StartMaintenanceAsync(target, id, label, coversEndpoints, active ? current : null))">
            @(active ? "Change maintenance" : "Start maintenance")
        </MudMenuItem>
        @if (active)
        {
            <MudMenuItem Icon="@Icons.Material.Outlined.PlayCircle" OnClick="@(() => EndMaintenanceAsync(target, id, label))">End maintenance</MudMenuItem>
        }
    };

    private async Task StartMaintenanceAsync(MaintenanceTarget target, Guid id, string label, bool coversEndpoints, MaintenancePeriod? current)
    {
        var parameters = new DialogParameters<MaintenanceDialog>
        {
            { d => d.TargetLabel, label },
            { d => d.CoversEndpoints, coversEndpoints },
            { d => d.Current, current },
            {
                d => d.OnSubmit, (endsAt, reason) => RunAsync(caller => MaintenanceSvc.StartAsync(caller, target, id, endsAt, reason),
                    endsAt is null ? $"{Capitalize(label)} is in maintenance until you turn it off." : $"{Capitalize(label)} is in maintenance until {Time.Absolute(endsAt)}.")
            }
        };
        var dialog = await DialogService.ShowAsync<MaintenanceDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dialog.Result)!.Canceled)
        {
            await AfterMaintenanceAsync(target, id);
        }
    }

    private async Task EndMaintenanceAsync(MaintenanceTarget target, Guid id, string label)
    {
        if (await RunAsync(caller => MaintenanceSvc.EndAsync(caller, target, id), $"Maintenance of {label} has ended. Alerts open again when a check fails."))
        {
            await AfterMaintenanceAsync(target, id);
        }
    }

    private async Task AfterMaintenanceAsync(MaintenanceTarget target, Guid id)
    {
        await LoadScopeAsync();
        if (target == MaintenanceTarget.Endpoint)
        {
            await AfterEndpointActionAsync(id);
            return;
        }

        await Task.WhenAll(LoadRowsAsync(), LoadTreeAsync());
        if (_detail is not null)
        {
            await _detail.RefreshAsync();
        }
    }

    private static string Capitalize(string text) => text.Length == 0 ? text : char.ToUpperInvariant(text[0]) + text[1..];

