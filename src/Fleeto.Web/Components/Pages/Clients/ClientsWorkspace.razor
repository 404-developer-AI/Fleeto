            return items;
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _refresh = new DebouncedRefresh(() => InvokeAsync(async () =>
        {
            await Task.WhenAll(LoadTreeAsync(), LoadRowsAsync());
            StateHasChanged();
        }));
        Live.EndpointStatusChanged += OnLiveChange;
        Live.AlertChanged += OnLiveChange;
    }

    protected override async Task OnParametersSetAsync()
    {
        OpenCreateFromQuery(New, CreateClientAsync);
        var scopeKey = SiteId?.ToString() ?? ClientId?.ToString() ?? "all";
        if (scopeKey == _scopeKey)
        {
            // Only the selected endpoint changed: the detail view reacts to its own parameter.
            return;
        }

        var firstLoad = _scopeKey is null;
        _scopeKey = scopeKey;
        _page = null;
        _rowsLoading = true;

        if (firstLoad)
        {
            await LoadTreeAsync();
        }

        await LoadScopeAsync();
        if (_notFound)
        {
            return;
        }

        // Open on the first tab that has endpoints: Servers, then Workstations.
        _tab = ServersTab;
        await LoadRowsAsync();
        if (_page is { ServerCount: 0, WorkstationCount: > 0 })
        {
            _tab = WorkstationsTab;
            await LoadRowsAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await RunPendingCreateAsync();
        if (SelectedEndpointId is null)
        {
            return;
        }

        try
        {
            // Idempotent: the script marks an element once it is wired.
            await JS.InvokeVoidAsync("fleeto.initSplitter", _splitHandle, _tableScroll, "fleeto.clients.listHeight");
        }
        catch (JSException)
        {
            // Resizing is a convenience; the list keeps its default height.
        }
        catch (InvalidOperationException)
        {
            // Prerendering: no JavaScript yet.
        }
    }

    private async Task LoadTreeAsync()
    {
        await LoadAsync(async caller =>
        {
            _tagOptions = await TagSvc.ListVisibleAsync(caller);
            _tagFilter.IntersectWith(_tagOptions.Select(t => t.Id));
            _tree = await ClientSvc.ListTreeAsync(caller, _clientSearch, _tagFilter);
        });
        _treeLoading = false;
        if (!string.IsNullOrEmpty(_clientSearch))
        {
            foreach (var client in _tree.Where(c => c.Sites.Count > 0))
            {
                _expanded.Add(client.Id);
            }
        }
    }

    private async Task LoadScopeAsync()
    {
        await LoadAsync(async caller =>
        {
            _site = null;
            _client = null;
            _notFound = false;
            _patches = await PatchSvc.GetComplianceAsync(caller, SiteId is null ? ClientId : null, SiteId);
            if (SiteId is { } siteId)
            {
                _site = await SiteSvc.GetSummaryAsync(caller, siteId);
                _notFound = _site is null;
                if (_site is not null)
                {
                    _expanded.Add(_site.ClientId);
                }
            }
            else if (ClientId is { } clientId)
            {
                _client = await ClientSvc.GetAsync(caller, clientId);
                _notFound = _client is null;
                if (_client is not null)
                {
                    _expanded.Add(_client.Id);
                }
            }
        });
    }

    private async Task LoadRowsAsync()
    {
        if (_notFound)
        {
            return;
        }

        var endpointClass = _tab switch { ServersTab => EndpointClass.Server, WorkstationsTab => (EndpointClass?)EndpointClass.Workstation, _ => null };
        var query = new EndpointListQuery(SiteId is null ? ClientId : null, SiteId, endpointClass, _endpointSearch, _status, _tier);
        await LoadAsync(async caller => _page = await EndpointSvc.ListAsync(caller, query));
        _rowsLoading = false;
        if (_page is { } page)
        {
            _selected.IntersectWith(page.Rows.Select(r => r.Id));
        }
    }

