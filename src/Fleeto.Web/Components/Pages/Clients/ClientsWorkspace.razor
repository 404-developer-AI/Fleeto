    private async Task ShowTokensAsync()
    {
        var site = _site!;
        IReadOnlyList<EnrollmentTokenListItem> tokens = [];
        await LoadAsync(async caller => tokens = await EnrollmentSvc.ListAsync(caller, site.Id));
        var parameters = new DialogParameters<EnrollmentTokensDialog>
        {
            { d => d.SiteName, site.Name },
            { d => d.CanManage, CanManage },
            { d => d.Tokens, tokens },
            { d => d.OnRevoke, token => RevokeTokenAsync(site.Id, token) }
        };
        var dialog = await DialogService.ShowAsync<EnrollmentTokensDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        await dialog.Result;
    }

    private async Task<IReadOnlyList<EnrollmentTokenListItem>?> RevokeTokenAsync(Guid siteId, EnrollmentTokenListItem token)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { d => d.Title, "Revoke enrollment token" },
            { d => d.Message, $"Token {token.Name} stops working at once. Endpoints already enrolled with it are not affected." },
            { d => d.ConfirmText, "Revoke" }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(null, parameters);
        if ((await dialog.Result)!.Canceled || !await RunAsync(caller => EnrollmentSvc.RevokeAsync(caller, token.Id), "The enrollment token was revoked."))
        {
            return null;
        }

        IReadOnlyList<EnrollmentTokenListItem> refreshed = [];
        await LoadAsync(async caller => refreshed = await EnrollmentSvc.ListAsync(caller, siteId));
        return refreshed;
    }

    private async Task CreateTokenAsync(Guid siteId, string siteName)
    {
        CreatedEnrollmentToken? created = null;
        var parameters = new DialogParameters<EnrollmentTokenDialog>
        {
            { d => d.SiteName, siteName },
            {
                d => d.OnSubmit, async (name, lifetime, maxUses) =>
                {
                    var result = await RunForValueAsync(caller => EnrollmentSvc.CreateAsync(caller, siteId, name, lifetime, maxUses), null);
                    created = result?.Value;
                    return result is not null;
                }
            }
        };
        var dialog = await DialogService.ShowAsync<EnrollmentTokenDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        await dialog.Result;
        if (created is null)
        {
            return;
        }

        var show = new DialogParameters<InstallCommandDialog> { { d => d.Created, created } };
        // The command is shown once: the dialog cannot be dismissed by clicking beside it by accident.
        var commandDialog = await DialogService.ShowAsync<InstallCommandDialog>(null, show,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        created = null;
        await commandDialog.Result;
    }

    public override void Dispose()
    {
        Live.EndpointStatusChanged -= OnLiveChange;
        Live.AlertChanged -= OnLiveChange;
        _refresh?.Dispose();
        base.Dispose();
    }
