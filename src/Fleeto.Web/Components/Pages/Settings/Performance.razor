@page "/settings/performance"
@attribute [RequirePermission(Permissions.PerformanceView)]
@inherits FleetoPageBase
@using Fleeto.Core.Performance
@using Fleeto.Infrastructure.Performance
@using Fleeto.Web.Components.Perf
@using System.Globalization
@implements IAsyncDisposable
@inject PerformanceService PerformanceSvc
@inject IJSRuntime JS

<PageTitle>Performance - Fleeto</PageTitle>

<div class="page-header">
    <div>
        <MudText Typo="Typo.h4" Class="page-title">Performance</MudText>
        <MudText Typo="Typo.body2" Class="muted">
            Where Fleeto itself is slow and why: the VPS, the database, our own code, the workers and the agent channel. It measures Fleeto,
            never the endpoints it manages. Export the report and give it to Claude Code in the Fleeto repository.
        </MudText>
    </div>
    <div class="d-flex gap-2 flex-wrap align-center">
        <MudSelect T="PerfPeriod" Value="_period" ValueChanged="OnPeriodChangedAsync" Dense="true" Variant="Variant.Outlined" Label="Period"
                   Style="min-width:140px" Margin="Margin.Dense">
            @foreach (var period in Enum.GetValues<PerfPeriod>())
            {
                <MudSelectItem Value="period">@PerformanceService.Label(period)</MudSelectItem>
            }
        </MudSelect>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.ContentCopy" OnClick="CopyAsync" Disabled="_busy">Copy report</MudButton>
        <MudMenu Label="Download" StartIcon="@Icons.Material.Outlined.Download" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" Variant="Variant.Outlined"
                 Disabled="_busy" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
            <MudMenuItem OnClick="@(() => DownloadAsync(PerfExportFormat.Markdown))">Report for Claude Code (Markdown)</MudMenuItem>
            <MudMenuItem OnClick="@(() => DownloadAsync(PerfExportFormat.Json))">All data (JSON)</MudMenuItem>
            <MudMenuItem OnClick="@(() => DownloadAsync(PerfExportFormat.Zip))">Both, with query plans (ZIP)</MudMenuItem>
        </MudMenu>
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Refresh" OnClick="ReloadAsync">Refresh</MudButton>
    </div>
</div>

<LoadState Loading="Loading" Failed="LoadFailed">
    @if (_view is { } view)
    {
        <div class="d-flex align-center gap-3 flex-wrap mb-3">
            @if (DiagnoseLeft(view) is { } left)
            {
                <StatusChip Text="Diagnose" Kind="StatusKind.Warning" />
                <MudText Typo="Typo.caption">
                    until @Utc(view.DiagnoseUntil!.Value) · @Minutes(left) left · statements, N+1 and callers are measured
                </MudText>
                @if (view.CanManage)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="StopDiagnoseAsync" Disabled="_busy">Stop Diagnose</MudButton>
                }
            }
            else
            {
                <StatusChip Text="@($"Level {view.Settings.Level}")" Kind="@(view.Settings.IsOn ? StatusKind.Active : StatusKind.Neutral)" />
                @if (view.CanManage && view.Settings.IsOn)
                {
                    <MudSelect T="int" @bind-Value="_diagnoseMinutes" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:130px">
                        @foreach (var minutes in DiagnoseChoices(view.Settings))
                        {
                            <MudSelectItem Value="minutes">@Minutes(TimeSpan.FromMinutes(minutes))</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.ManageSearch" OnClick="StartDiagnoseAsync" Disabled="_busy">Start Diagnose</MudButton>
                }
            }
            <MudTooltip Text="Diagnose measures every statement with its fingerprint, finds N+1 queries and names the method that sent each statement. It costs a few percent and ends by itself; use Fleeto while it runs, then export the report.">
                <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" Class="muted" />
            </MudTooltip>
            <MudText Typo="Typo.caption" Class="muted">
                @Utc(view.From) to @Utc(view.To) · @PerformanceRules.Pct(view.Data.DiagnoseShare * 100) in Diagnose · monitor overhead @PerformanceRules.Pct(Overhead(view.Data)) of the CPU
            </MudText>
            <MudTooltip Text="The time the monitor itself spent measuring and writing, as a share of the CPU of the components. On level Basic it stays below 1%; Diagnose may cost a few percent.">
                <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" Class="muted" />
            </MudTooltip>
        </div>

        <MudTabs Elevation="0" Class="fl-tabs" MinimumTabWidth="0" ActivePanelIndex="_tab" ActivePanelIndexChanged="OnTabChangedAsync">
            <MudTabPanel Text="Overview" Icon="@Icons.Material.Outlined.Insights">
                @Overview(view)
            </MudTabPanel>
            <MudTabPanel Text="Pages and API" Icon="@Icons.Material.Outlined.Web">
                <PerfInteractionsTab View="view" LoadTimeline="LoadFlowAsync" />
            </MudTabPanel>
            <MudTabPanel Text="Database" Icon="@Icons.Material.Outlined.Storage">
                <PerfDatabaseTab View="view" Plan="PlanAsync" Analyze="AnalyzeAsync" LoadLive="LoadLiveAsync" />
            </MudTabPanel>
            <MudTabPanel Text="Server" Icon="@Icons.Material.Outlined.Dns">
                <PerfServerTab View="view" />
            </MudTabPanel>
            <MudTabPanel Text="Background" Icon="@Icons.Material.Outlined.Schedule">
                <PerfBackgroundTab View="view" LoadTimeline="LoadFlowAsync" />
            </MudTabPanel>
            <MudTabPanel Text="Agent channel" Icon="@Icons.Material.Outlined.Lan">
                <PerfAgentsTab View="view" LoadTimeline="LoadFlowAsync" />
            </MudTabPanel>
            <MudTabPanel Text="Settings" Icon="@Icons.Material.Outlined.Tune">
                @SettingsTab(view)
            </MudTabPanel>
        </MudTabs>
    }
    else
    {
        <EmptyState Icon="@Icons.Material.Outlined.Speed" Title="Performance is for admins" Text="Ask an admin to look at it." />
    }
</LoadState>

@code {
    private const string PeriodPreference = "fleeto.performance.period";
    private const string TabPreference = "fleeto.performance.tab";

    private const int TabCount = 7;

    private PerformanceView? _view;
    private PerfPeriod _period = PerfPeriod.Hour1;
    private int _tab;
    private bool _busy;
    private SettingsForm? _form;
    private int _diagnoseMinutes = 60;
    private string _marker = string.Empty;
    private bool _addingMarker;

    // The countdown of Diagnose runs on the server clock of the last load plus the time since, refreshed every 15 seconds.
    private readonly System.Diagnostics.Stopwatch _sinceLoad = new();
    private PeriodicTimer? _timer;
    private Task? _ticking;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        _ticking = TickAsync(_timer);
    }

    private async Task TickAsync(PeriodicTimer timer)
    {
        try
        {
            while (await timer.WaitForNextTickAsync())
            {
                if (_view is { DiagnoseUntil: not null } view)
                {
                    // Diagnose ended on the server clock: read again, so the level and the data show it.
                    if (DiagnoseLeft(view) is null)
                    {
                        await InvokeAsync(async () =>
                        {
                            await ReloadAsync();
                            StateHasChanged();
                        });
                    }
                    else
                    {
                        await InvokeAsync(StateHasChanged);
                    }
                }
            }
        }
        catch (ObjectDisposedException)
        {
            // The page closed.
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            _timer?.Dispose();
            if (_ticking is not null)
            {
                await _ticking;
            }
        }
        finally
        {
            Dispose();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // The chosen period and tab are remembered per browser.
        var period = await JS.InvokeAsync<string?>("fleeto.getPreference", PeriodPreference);
        var tab = await JS.InvokeAsync<string?>("fleeto.getPreference", TabPreference);
        var changed = false;
        if (Enum.TryParse<PerfPeriod>(period, out var stored) && stored != _period)
        {
            _period = stored;
            changed = true;
        }

        if (int.TryParse(tab, NumberStyles.None, CultureInfo.InvariantCulture, out var storedTab) && storedTab >= 0 && storedTab < TabCount && storedTab != _tab)
        {
            _tab = storedTab;
            changed = true;
        }

        if (changed)
        {
            await ReloadAsync();
            StateHasChanged();
        }
    }

    private Task ReloadAsync() => LoadAsync(async caller =>
    {
        _view = await PerformanceSvc.GetAsync(caller, _period);
        _sinceLoad.Restart();
        _form = _view is null ? null : SettingsForm.From(_view.Settings);
        if (_view is not null && !DiagnoseChoices(_view.Settings).Contains(_diagnoseMinutes))
        {
            _diagnoseMinutes = DiagnoseChoices(_view.Settings).OrderBy(m => Math.Abs(m - _view.Settings.DiagnoseDefaultMinutes)).First();
        }
    });

    /// <summary>The lengths offered for Diagnose: the default and the usual ones, up to the longest the settings allow.</summary>
    private static IReadOnlyList<int> DiagnoseChoices(PerformanceSettings settings) =>
        new[] { 15, 30, 60, 120, 240, 480, settings.DiagnoseDefaultMinutes }.Where(m => m >= PerformanceService.MinDiagnoseMinutes && m <= settings.DiagnoseMaxMinutes)
            .Distinct().Order().ToList();

    /// <summary>The time Diagnose has left on the server clock, or null when it does not run.</summary>
    private TimeSpan? DiagnoseLeft(PerformanceView view) =>
        view.DiagnoseUntil is { } until && until - (view.Now + _sinceLoad.Elapsed) is { TotalSeconds: > 0 } left ? left : null;

    private static string Minutes(TimeSpan span) => span.TotalMinutes switch
    {
        < 1 => "less than a minute",
        < 120 => $"{Math.Ceiling(span.TotalMinutes).ToString("0", CultureInfo.InvariantCulture)} min",
        _ => $"{(span.TotalMinutes / 60).ToString("0.#", CultureInfo.InvariantCulture)} h"
    };

    private async Task StartDiagnoseAsync()
    {
        _busy = true;
        try
        {
            if (await RunAsync(caller => PerformanceSvc.StartDiagnoseAsync(caller, _diagnoseMinutes),
                    "Diagnose started. Every component measures statements within 30 seconds; use Fleeto as usual and export the report when it ends."))
            {
                await ReloadAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task StopDiagnoseAsync()
    {
        _busy = true;
        try
        {
            if (await RunAsync(caller => PerformanceSvc.StopDiagnoseAsync(caller), "Diagnose stopped. The level is Basic again."))
            {
                await ReloadAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AddMarkerAsync()
    {
        _busy = true;
        try
        {
            if (await RunAsync(caller => PerformanceSvc.AddMarkerAsync(caller, _marker), "The marker is on the timeline."))
            {
                _marker = string.Empty;
                _addingMarker = false;
                await ReloadAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<IReadOnlyList<PerfFlowPoint>?> LoadFlowAsync(PerfSeries flow)
    {
        var caller = Caller ?? await CurrentUser.GetAsync();
        try
        {
            return await PerformanceSvc.GetFlowTimelineAsync(caller, _period, flow.Kind, flow.Key, flow.SubKey);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Snackbar.Add(ServiceSupport.GenericProblem, Severity.Error);
            return null;
        }
    }

    private async Task<PerfPlan?> PlanAsync(PerfPlanTarget target, string id) =>
        (await RunForValueAsync(caller => PerformanceSvc.PlanAsync(caller, target, id), null))?.Value;

    private async Task AnalyzeAsync(string table)
    {
        if (await RunAsync(caller => PerformanceSvc.AnalyzeAsync(caller, table), $"{table} was analyzed. Its new statistics show at the next table snapshot."))
        {
            StateHasChanged();
        }
    }

    private async Task<PerfLiveDatabase?> LoadLiveAsync()
    {
        var caller = Caller ?? await CurrentUser.GetAsync();
        try
        {
            return await PerformanceSvc.GetLiveDatabaseAsync(caller);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            return null;
        }
    }

    private async Task OnPeriodChangedAsync(PerfPeriod period)
    {
        _period = period;
        await JS.InvokeVoidAsync("fleeto.setPreference", PeriodPreference, period.ToString());
        await ReloadAsync();
    }

    private async Task OnTabChangedAsync(int tab)
    {
        _tab = tab;
        await JS.InvokeVoidAsync("fleeto.setPreference", TabPreference, tab.ToString(CultureInfo.InvariantCulture));
    }

    private async Task CopyAsync()
    {
        if (await ExportAsync("copied") is { } report)
        {
            await JS.InvokeVoidAsync("fleeto.copyText", report);
            Snackbar.Add("The report was copied. It holds no ids, client codes, host names or values.", Severity.Success);
        }
    }

    private async Task DownloadAsync(PerfExportFormat format)
    {
        _busy = true;
        try
        {
            if ((await RunForValueAsync(caller => PerformanceSvc.ExportAsync(caller, _period, format, "downloaded"), null))?.Value is { } export)
            {
                await JS.InvokeVoidAsync("fleeto.saveFile", export.FileName, export.ContentType, Convert.ToBase64String(export.Content));
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<string?> ExportAsync(string how)
    {
        _busy = true;
        try
        {
            var result = await RunForValueAsync(caller => PerformanceSvc.ExportMarkdownAsync(caller, _period, how), null);
            return result?.Value;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_form is null)
        {
            return;
        }

        _busy = true;
        try
        {
            if (await RunAsync(caller => PerformanceSvc.SaveSettingsAsync(caller, _form.ToSettings()),
                    "The settings were saved. Every component uses them within 30 seconds."))
            {
                await ReloadAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private static double Overhead(PerformanceDataset data)
    {
        var minutes = data.Runtime.Sum(r => (double)r.Minutes * Math.Max(1, r.Cores));
        return minutes <= 0 ? 0 : data.Runtime.Sum(r => r.OverheadMs) / (minutes * 60_000) * 100;
    }

    private static string Utc(DateTime time) => time.ToString("yyyy-MM-dd HH:mm 'UTC'", CultureInfo.InvariantCulture);

    private static StatusKind ScoreKind(int? score) => score switch
    {
        null => StatusKind.Neutral,
        >= 85 => StatusKind.Ok,
        >= 60 => StatusKind.Warning,
        _ => StatusKind.Error
    };

    private static StatusKind SeverityKind(PerfSeverity severity) => severity switch
    {
        PerfSeverity.Critical => StatusKind.Error,
        PerfSeverity.Warning => StatusKind.Warning,
        _ => StatusKind.Neutral
    };

    private RenderFragment Info(string text) => @<MudTooltip Text="@text"><MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" Class="muted ml-1" /></MudTooltip>;

    private RenderFragment Overview(PerformanceView view) => @<div>
        @if (!view.Settings.IsOn)
        {
            <MudAlert Severity="Severity.Info" Class="mb-3">
                The performance monitor is off, so nothing new is measured. @(view.CanManage ? "Set the level to Basic in the Settings tab." : "Ask an admin to switch it on.")
            </MudAlert>
        }
        else if (view.Data.DiagnoseMinutes == 0 && view.DiagnoseUntil is null)
        {
            <MudAlert Severity="Severity.Normal" Dense="true" Class="mb-3">
                Basic shows where time goes. To see which statements cost it and which method sends them, start Diagnose for an hour,
                use Fleeto as usual, and export the report when it ends.
            </MudAlert>
        }

        <div class="health-grid mb-4">
            @foreach (var score in view.Scores.Where(s => s.Info.Measured))
            {
                <div class="health-card fl-panel">
                    <div class="health-card-head">
                        <span>@score.Info.Label</span>
                        <span style="margin-left:auto">
                            <StatusChip Text="@(score.Score is { } value ? value.ToString(CultureInfo.InvariantCulture) : "No data")" Kind="@ScoreKind(score.Score)" />
                        </span>
                    </div>
                    <div style="font-size:0.875rem">@score.Conclusion</div>
                    <div class="muted" style="font-size:0.75rem">@score.Info.Question</div>
                </div>
            }
        </div>

        <MudText Typo="Typo.h6" Class="section-title mb-2">
            Top bottlenecks
            @Info("Findings ranked by the extra waiting they caused in the period, so a small delay that happens very often comes before a long one that happened twice.")
        </MudText>
        @if (view.Findings.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.CheckCircle" Title="No bottleneck found"
                        Text="No rule found a problem in this period. A short period with little traffic may have too few samples; choose a longer one." />
        }
        else
        {
            <MudExpansionPanels Elevation="0" Class="mb-4" MultiExpansion="true">
                @foreach (var finding in view.Findings.Take(PerformanceRules.MaxFindings))
                {
                    <MudExpansionPanel>
                        <TitleContent>
                            <div class="d-flex align-center gap-2 flex-wrap">
                                <StatusChip Text="@finding.Severity.ToString()" Kind="@SeverityKind(finding.Severity)" />
                                <span class="muted" style="font-size:0.75rem">@PerfCategories.Of(finding.Category).Label</span>
                                <strong>@finding.Title</strong>
                                @if (finding.ImpactMs is { } impact)
                                {
                                    <span class="muted" style="font-size:0.75rem">· @PerformanceRules.Ms(impact) extra waiting</span>
                                }
                            </div>
                        </TitleContent>
                        <ChildContent>
                            <MudText Typo="Typo.body2" Class="mb-2">@finding.Explanation</MudText>
                            <MudSimpleTable Dense="true" Elevation="0" Class="mb-2">
                                <tbody>
                                    @foreach (var evidence in finding.Evidence)
                                    {
                                        <tr><td class="muted" style="width:40%">@evidence.Label</td><td>@evidence.Value</td></tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                            <MudText Typo="Typo.body2"><strong>Likely cause:</strong> @finding.Cause</MudText>
                            <MudText Typo="Typo.body2"><strong>What to change:</strong> @finding.Action</MudText>
                            @foreach (var reference in finding.CodeRefs)
                            {
                                <MudText Typo="Typo.body2" Class="mt-1"><strong>Where to look:</strong> @reference.Kind <span class="mono">@reference.Value</span></MudText>
                                @if (reference.Detail is { Length: > 0 } detail)
                                {
                                    <pre class="mono perf-sql">@PerfRedactor.Default.Sql(detail)</pre>
                                }
                            }
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }

        <MudText Typo="Typo.h6" Class="section-title mb-2">
            Timeline
            @Info("Page interactions and API requests per interval: the line is the 95th percentile, the band runs from the median to the 99th percentile. A red mark is an interval with errors.")
        </MudText>
        <div class="health-trends mb-4">
            <div class="fl-panel pa-3">
                <MudText Typo="Typo.subtitle2" Class="mb-1">Page interactions</MudText>
                @Chart(view, view.Timeline.Select(p => (p.Time, p.Interactions)).ToList(), "Page interactions", view.Settings.Threshold(PerfThresholds.SlowInteraction))
            </div>
            <div class="fl-panel pa-3">
                <MudText Typo="Typo.subtitle2" Class="mb-1">API and sign-in requests</MudText>
                @Chart(view, view.Timeline.Select(p => (p.Time, p.Requests)).ToList(), "Requests", view.Settings.Threshold(PerfThresholds.SlowRequest))
            </div>
        </div>

        <MudGrid Spacing="3">
            <MudItem xs="12" lg="6">
                @Flows("Page interactions", "The pages that cost users the most time, by route template. Load is the page loading its data; event a click or other event on it.",
                    view.Data.Of(PerfKind.Interaction).ToList(), "Page")
            </MudItem>
            <MudItem xs="12" lg="6">
                @Flows("Worker loops", "The loops of the workers by the time they spent, with the share of it in the database.",
                    view.Data.Of(PerfKind.WorkerRun).ToList(), "Loop")
            </MudItem>
            <MudItem xs="12" lg="6">
                @Flows("API and sign-in requests", "Requests outside the pages: the public API, sign-in and downloads, by route template.",
                    view.Data.Of(PerfKind.Http).ToList(), "Route")
            </MudItem>
            <MudItem xs="12" lg="6">
                @Flows("Agent messages", "Messages from agents and watchdogs: the time from receiving one to storing and acknowledging it.",
                    view.Data.Of(PerfKind.AgentMessage).ToList(), "Message")
            </MudItem>
            <MudItem xs="12" lg="6">
                @Flows("Database time by source", "Database commands as the components measured them, by the page, loop or message that sent them.",
                    view.Data.Of(PerfKind.Db).ToList(), "Source")
            </MudItem>
            <MudItem xs="12" lg="6">
                @Flows("External calls", "Outbound HTTP calls of the workers per host: Action1, Microsoft, webhooks and backup storage.",
                    view.Data.Of(PerfKind.External).ToList(), "Host")
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.h6" Class="section-title mt-4 mb-2">
            Runtime per component
            @Info("CPU is a share of the whole VPS. GC pause is the time the process stood still for garbage collection. The queue is work waiting for a thread at the peak of a minute.")
        </MudText>
        @if (view.Data.Runtime.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="muted">No runtime figures in this period.</MudText>
        }
        else
        {
            <div class="fl-panel pa-2 mb-4" style="overflow-x:auto">
                <MudSimpleTable Dense="true" Elevation="0">
                    <thead>
                        <tr><th>Component</th><th>Version</th><th style="text-align:right">CPU avg</th><th style="text-align:right">CPU max</th>
                            <th style="text-align:right">Memory</th><th style="text-align:right">GC pause</th><th style="text-align:right">Queue</th>
                            <th style="text-align:right">Pool busy</th><th style="text-align:right">Connections</th><th style="text-align:right">Exceptions</th>
                            <th style="text-align:right">Monitor</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in view.Data.Runtime)
                        {
                            <tr>
                                <td>@r.Component</td>
                                <td class="mono">@r.Version</td>
                                <td style="text-align:right">@PerformanceRules.Pct(r.CpuPercentAverage)</td>
                                <td style="text-align:right">@PerformanceRules.Pct(r.CpuPercentMax)</td>
                                <td style="text-align:right">@PerformanceRules.Bytes(r.WorkingSetMaxBytes)</td>
                                <td style="text-align:right">@PerformanceRules.Pct(r.GcPausePercent)</td>
                                <td style="text-align:right">@r.ThreadPoolQueueMax</td>
                                <td style="text-align:right">@r.DbPoolBusyMax@(r.DbPoolMax > 0 ? $" of {r.DbPoolMax}" : "")</td>
                                <td style="text-align:right">@r.ConnectionsMax</td>
                                <td style="text-align:right">@PerformanceRules.Count(r.Exceptions)</td>
                                <td style="text-align:right">@PerformanceRules.Ms(r.OverheadMs)</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        }

        @if (view.Data.Host is { } host)
        {
            <MudText Typo="Typo.h6" Class="section-title mb-2">
                VPS
                @Info("Measured by the workers every minute. Every instance on this VPS sees the same host. Steal is CPU the hypervisor gave to other guests on its host.")
            </MudText>
            <div class="health-grid mb-4">
                @HostCard("CPU", $"{PerformanceRules.Pct(host.CpuAverage)} average · {PerformanceRules.Pct(host.CpuP95)} p95 · {host.Cores} cores")
                @HostCard("Steal and iowait", $"{PerformanceRules.Pct(host.StealAverage)} steal · {PerformanceRules.Pct(host.IowaitAverage)} iowait")
                @HostCard("Memory", host.MemoryTotalBytes is { } total ? $"lowest {PerformanceRules.Bytes(host.MemoryAvailableMinBytes ?? 0)} available of {PerformanceRules.Bytes(total)}" : "–")
                @HostCard("Disk", $"{PerformanceRules.Ms(host.DiskLatencyAverageMs)} per operation · {PerformanceRules.Pct(host.DiskUtilizationMaxPercent)} busy at peak")
            </div>
        }

        <div class="d-flex align-center gap-2 mb-2">
            <MudText Typo="Typo.h6" Class="section-title">
                Markers
                @Info("A deploy marker is added when the workers start on a new version. Add your own when you change something, such as an index, so before and after are easy to compare.")
            </MudText>
            @if (view.CanManage && !_addingMarker)
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Add" OnClick="@(() => _addingMarker = true)">Add marker</MudButton>
            }
        </div>
        @if (_addingMarker)
        {
            <div class="d-flex align-center gap-2 mb-3 flex-wrap">
                <MudTextField T="string" @bind-Value="_marker" Label="What changed" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="PerformanceService.MaxMarkerLength"
                              HelperText="E-mail addresses, addresses, client codes and host names are masked." Style="min-width:320px" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddMarkerAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_marker))">Add</MudButton>
                <MudButton Variant="Variant.Text" OnClick="@(() => { _addingMarker = false; _marker = string.Empty; })">Cancel</MudButton>
            </div>
        }
        @if (view.Data.Markers.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="muted mb-4">None in this period.</MudText>
        }
        else
        {
            <div class="fl-panel pa-2 mb-4">
                <MudSimpleTable Dense="true" Elevation="0">
                    <tbody>
                        @foreach (var marker in view.Data.Markers)
                        {
                            <tr><td style="white-space:nowrap">@Utc(marker.Time)</td><td>@marker.Kind</td><td>@marker.Label</td></tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        }

        <MudText Typo="Typo.h6" Class="section-title mb-2">Not measured in this period</MudText>
        <ul class="muted" style="font-size:0.8125rem;padding-left:18px">
            @foreach (var line in view.Data.Missing)
            {
                <li>@line</li>
            }
        </ul>
    </div>;

    private static RenderFragment HostCard(string name, string value) => @<div class="health-card fl-panel">
        <div class="health-card-head"><span>@name</span></div>
        <div class="muted" style="font-size:0.8125rem">@value</div>
    </div>;

    private RenderFragment Flows(string title, string info, IReadOnlyList<PerfSeries> flows, string keyLabel) => @<div>
        <MudText Typo="Typo.h6" Class="section-title mb-2">@title @Info(info)</MudText>
        @if (flows.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="muted">None in this period.</MudText>
        }
        else
        {
            <div class="fl-panel pa-2" style="overflow-x:auto">
                <MudSimpleTable Dense="true" Elevation="0">
                    <thead>
                        <tr><th>@keyLabel</th><th style="text-align:right">Count</th><th style="text-align:right">p50</th><th style="text-align:right">p95</th>
                            <th style="text-align:right">Total</th><th style="text-align:right">DB</th><th style="text-align:right">Errors</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var flow in flows.OrderByDescending(f => f.Sum).Take(10))
                        {
                            <tr>
                                <td class="mono" style="max-width:320px;overflow-wrap:anywhere">@flow.Key@(flow.SubKey.Length > 0 ? $" · {flow.SubKey}" : "")</td>
                                <td style="text-align:right">@PerformanceRules.Count(flow.Count)</td>
                                <td style="text-align:right">@PerformanceRules.Ms(flow.P50)</td>
                                <td style="text-align:right">@PerformanceRules.Ms(flow.P95)</td>
                                <td style="text-align:right">@PerformanceRules.Ms(flow.Sum)</td>
                                <td style="text-align:right">@(flow.Kind == PerfKind.Db ? "–" : PerformanceRules.Pct(flow.DbShare * 100))</td>
                                <td style="text-align:right">@PerformanceRules.Count(flow.Errors)</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        }
    </div>;

    private RenderFragment Chart(PerformanceView view, IReadOnlyList<(DateTime Time, PerfTimelineFlow Flow)> points, string name, double threshold)
    {
        var history = new CheckHistoryView(Guid.Empty, name, CheckType.CpuUsage, string.Empty, [], new Dictionary<string, string>(), ThresholdKind.HigherIsWorse,
            "ms", threshold, null, HistoryRange.Day, view.From, view.To, view.Bucket,
            points.Select(p => p.Flow.Count == 0
                    ? new HistoryPoint(p.Time, null, null, null, 0, 0, 0)
                    : new HistoryPoint(p.Time, p.Flow.P50, p.Flow.P95, p.Flow.P99, (int)Math.Min(int.MaxValue, p.Flow.Count),
                        (int)Math.Min(int.MaxValue, p.Flow.Errors), 0))
                .ToList());
        return points.Any(p => p.Flow.Count > 0)
            ? @<HistoryChart View="history" />
            : @<MudText Typo="Typo.body2" Class="muted">None in this period.</MudText>;
    }

    private RenderFragment SettingsTab(PerformanceView view) => @<div>
        @if (_form is { } form)
        {
            @if (!view.CanManage)
            {
                <MudAlert Severity="Severity.Info" Class="mb-3">You can see these settings; changing them needs the permission Manage performance monitoring.</MudAlert>
            }

            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    <div class="fl-panel pa-4">
                        <MudText Typo="Typo.h6" Class="section-title mb-2">Level</MudText>
                        <MudRadioGroup T="PerfLevel" @bind-Value="form.Level" Disabled="!view.CanManage">
                            <MudRadio Value="PerfLevel.Basic" Color="Color.Primary">Basic: aggregates per minute of every layer, below 1% overhead</MudRadio>
                            <MudRadio Value="PerfLevel.Off" Color="Color.Primary">Off: nothing is measured, and Diagnose stops</MudRadio>
                        </MudRadioGroup>
                        <MudText Typo="Typo.caption" Class="muted d-block mt-1">Diagnose is not a level to choose here: start it at the top of the page, and it ends by itself.</MudText>

                        <MudText Typo="Typo.h6" Class="section-title mt-4 mb-2">Collectors</MudText>
                        @foreach (var collector in PerfCollectors.All)
                        {
                            <div class="mb-1">
                                <MudSwitch T="bool" Value="@(!form.Disabled.Contains(collector.Collector))" ValueChanged="@(on => form.Toggle(collector.Collector, on))"
                                           Color="Color.Primary" Disabled="!view.CanManage" Label="@collector.Label" />
                                <div class="muted" style="font-size:0.75rem;margin-left:52px;margin-top:-6px">@collector.Description</div>
                            </div>
                        }
                    </div>
                </MudItem>
                <MudItem xs="12" md="6">
                    <div class="fl-panel pa-4">
                        <MudText Typo="Typo.h6" Class="section-title mb-2">Collection and retention</MudText>
                        <MudNumericField T="int" @bind-Value="form.SlowEventMs" Label="Slow event (ms)" Min="100" Max="600000" Disabled="!view.CanManage" Class="mb-2"
                                         HelperText="An interaction, request or worker run slower than this is kept on its own, with its split." />
                        <MudNumericField T="int" @bind-Value="form.StatementSnapshotMinutes" Label="Statement statistics every (minutes)" Min="5" Max="60"
                                         Disabled="!view.CanManage" Class="mb-2" />
                        <MudNumericField T="int" @bind-Value="form.TableSnapshotMinutes" Label="Table statistics every (minutes)" Min="15" Max="1440"
                                         Disabled="!view.CanManage" Class="mb-2" />
                        <MudNumericField T="int" @bind-Value="form.MinuteRetentionDays" Label="Keep minute data (days)" Min="1" Max="@PerfRetention.MaxMinuteDays"
                                         Disabled="!view.CanManage" Class="mb-2" />
                        <MudNumericField T="int" @bind-Value="form.HourRetentionDays" Label="Keep hour data (days)" Min="1" Max="400" Disabled="!view.CanManage" Class="mb-2" />
                        <MudNumericField T="int" @bind-Value="form.EventRetentionDays" Label="Keep slow events (days)" Min="1" Max="90" Disabled="!view.CanManage" Class="mb-2" />
                        <MudNumericField T="int" @bind-Value="form.SnapshotRetentionDays" Label="Keep database snapshots (days)" Min="1" Max="90"
                                         Disabled="!view.CanManage" Class="mb-2" />

                        <MudText Typo="Typo.h6" Class="section-title mt-4 mb-2">Diagnose</MudText>
                        <MudNumericField T="int" @bind-Value="form.DiagnoseDefaultMinutes" Label="Default length (minutes)" Min="5" Max="@PerformanceSettings.MaxDiagnoseMinutes"
                                         Disabled="!view.CanManage" Class="mb-2" HelperText="Chosen when Diagnose is started; 60 minutes is enough for a report." />
                        <MudNumericField T="int" @bind-Value="form.DiagnoseMaxMinutes" Label="Longest (minutes)" Min="15" Max="@PerformanceSettings.MaxDiagnoseMinutes"
                                         Disabled="!view.CanManage" Class="mb-2" HelperText="Diagnose costs a few percent, so it is never left on." />
                        <MudNumericField T="int" @bind-Value="form.DiagnoseStatementSnapshotMinutes" Label="Statement statistics every (minutes)" Min="1" Max="60"
                                         Disabled="!view.CanManage" Class="mb-2" />
                        <MudNumericField T="int" @bind-Value="form.DiagnoseTableSnapshotMinutes" Label="Table statistics every (minutes)" Min="5" Max="1440"
                                         Disabled="!view.CanManage" Class="mb-2" />
                    </div>
                </MudItem>
                <MudItem xs="12">
                    <div class="fl-panel pa-4">
                        <MudText Typo="Typo.h6" Class="section-title mb-2">Thresholds of the findings</MudText>
                        @foreach (var group in PerfThresholds.All.GroupBy(t => t.Category))
                        {
                            <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">@PerfCategories.Of(group.Key).Label</MudText>
                            <div class="perf-thresholds">
                                @foreach (var threshold in group)
                                {
                                    <MudNumericField T="double" Value="@form.Thresholds[threshold.Key]" ValueChanged="@(value => form.Thresholds[threshold.Key] = value)"
                                                     Label="@($"{threshold.Label} ({threshold.Unit})")" Min="threshold.Min" Max="threshold.Max" Disabled="!view.CanManage"
                                                     HelperText="@($"{threshold.Description} Default {threshold.Default.ToString("0.##", CultureInfo.InvariantCulture)}.")" />
                                }
                            </div>
                        }
                    </div>
                </MudItem>
            </MudGrid>

            @if (view.CanManage)
            {
                <div class="d-flex justify-end mt-3">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy">Save settings</MudButton>
                </div>
            }
        }
    </div>;

    /// <summary>The settings as the form edits them; every threshold has a value, its default when none is stored.</summary>
    private sealed class SettingsForm
    {
        public PerfLevel Level { get; set; }
        public HashSet<PerfCollector> Disabled { get; } = [];
        public int SlowEventMs { get; set; }
        public int StatementSnapshotMinutes { get; set; }
        public int TableSnapshotMinutes { get; set; }
        public int MinuteRetentionDays { get; set; }
        public int HourRetentionDays { get; set; }
        public int EventRetentionDays { get; set; }
        public int SnapshotRetentionDays { get; set; }
        public int DiagnoseDefaultMinutes { get; set; }
        public int DiagnoseMaxMinutes { get; set; }
        public int DiagnoseStatementSnapshotMinutes { get; set; }
        public int DiagnoseTableSnapshotMinutes { get; set; }
        public Dictionary<string, double> Thresholds { get; } = new(StringComparer.Ordinal);

        public void Toggle(PerfCollector collector, bool on)
        {
            if (on)
            {
                Disabled.Remove(collector);
            }
            else
            {
                Disabled.Add(collector);
            }
        }

        public static SettingsForm From(PerformanceSettings settings)
        {
            var form = new SettingsForm
            {
                Level = settings.Level,
                SlowEventMs = settings.SlowEventMs,
                StatementSnapshotMinutes = settings.StatementSnapshotMinutes,
                TableSnapshotMinutes = settings.TableSnapshotMinutes,
                MinuteRetentionDays = settings.MinuteRetentionDays,
                HourRetentionDays = settings.HourRetentionDays,
                EventRetentionDays = settings.EventRetentionDays,
                SnapshotRetentionDays = settings.SnapshotRetentionDays,
                DiagnoseDefaultMinutes = settings.DiagnoseDefaultMinutes,
                DiagnoseMaxMinutes = settings.DiagnoseMaxMinutes,
                DiagnoseStatementSnapshotMinutes = settings.DiagnoseStatementSnapshotMinutes,
                DiagnoseTableSnapshotMinutes = settings.DiagnoseTableSnapshotMinutes
            };
            form.Disabled.UnionWith(settings.DisabledCollectors);
            foreach (var threshold in PerfThresholds.All)
            {
                form.Thresholds[threshold.Key] = settings.Threshold(threshold.Key);
            }

            return form;
        }

        public PerformanceSettings ToSettings() => new()
        {
            Level = Level,
            DisabledCollectors = Disabled.ToList(),
            SlowEventMs = SlowEventMs,
            StatementSnapshotMinutes = StatementSnapshotMinutes,
            TableSnapshotMinutes = TableSnapshotMinutes,
            MinuteRetentionDays = MinuteRetentionDays,
            HourRetentionDays = HourRetentionDays,
            EventRetentionDays = EventRetentionDays,
            SnapshotRetentionDays = SnapshotRetentionDays,
            DiagnoseDefaultMinutes = DiagnoseDefaultMinutes,
            DiagnoseMaxMinutes = DiagnoseMaxMinutes,
            DiagnoseStatementSnapshotMinutes = DiagnoseStatementSnapshotMinutes,
            DiagnoseTableSnapshotMinutes = DiagnoseTableSnapshotMinutes,
            Thresholds = new Dictionary<string, double>(Thresholds, StringComparer.Ordinal)
        };
    }
}
