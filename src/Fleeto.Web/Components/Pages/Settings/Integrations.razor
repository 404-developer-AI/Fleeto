@page "/settings/integrations"
@attribute [Authorize(Policy = FleetoPolicies.Admin)]
@inherits FleetoPageBase
@using Fleeto.Core.Entities
@using Fleeto.Core.Interfaces
@using Fleeto.Infrastructure.Integrations.Action1
@inject IntegrationService IntegrationSvc

<PageTitle>Integrations - Fleeto</PageTitle>

<div class="page-header">
    <div>
        <MudText Typo="Typo.h4" Class="page-title">Integrations</MudText>
        <MudText Typo="Typo.body2" Class="muted">
            Action1 does the patch management. Fleeto reads its patch state per endpoint and maps each Action1 organization to one client.
        </MudText>
    </div>
</div>

<LoadState Loading="Loading" Failed="LoadFailed">
    <MudGrid Spacing="3">
        <MudItem xs="12" md="6">
            <div class="fl-panel pa-4">
                <div class="d-flex justify-space-between align-center mb-3">
                    <MudText Typo="Typo.h6" Class="section-title">Action1</MudText>
                    @if (_integration is not null)
                    {
                        <StatusChip Text="@(_integration.TestPending ? "Testing" : StatusText(_integration.Status))"
                                    Kind="@(_integration.TestPending ? StatusKind.Active : StatusKindOf(_integration.Status))" />
                    }
                </div>

                <MudTextField @bind-Value="_clientId" Label="Client id" Variant="Variant.Outlined" MaxLength="200" Class="mb-3"
                              HelperText="From Configuration, Users & API Credentials in the Action1 console." />
                <MudTextField @bind-Value="_clientSecret" Label="@(_integration is null ? "Client secret" : "Client secret (leave blank to keep the current secret)")"
                              Variant="Variant.Outlined" InputType="InputType.Password" MaxLength="500" Class="mb-3" />
                <MudSelect T="Action1Region" @bind-Value="_region" Label="Region" Variant="Variant.Outlined" Class="mb-1">
                    @foreach (var region in Regions)
                    {
                        <MudSelectItem T="Action1Region" Value="@region">@Action1Api.RegionName(region)</MudSelectItem>
                    }
                </MudSelect>
                <MudText Typo="Typo.caption" Class="muted d-block mb-3">
                    The region where the Action1 account is registered. Europe keeps the patch data in the EU.
                </MudText>

                <MudSwitch T="bool" @bind-Value="_enabled" Color="Color.Primary" Class="mb-3">Enabled</MudSwitch>

                @if (_integration?.StatusMessage is { Length: > 0 } problem)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">@problem</MudAlert>
                }
                @if (_integration is not null)
                {
                    <MudText Typo="Typo.caption" Class="muted d-block mb-3">
                        Last attempt: <TimeText Value="_integration.LastAttemptAt" />, last success: <TimeText Value="_integration.LastSuccessAt" />
                    </MudText>
                }

                <div class="d-flex gap-2 flex-wrap">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy">Save</MudButton>
                    @if (_integration is not null)
                    {
                        <MudButton Variant="Variant.Outlined" OnClick="TestAsync" Disabled="_busy || _integration.TestPending">
                            Test connection
                        </MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="RemoveAsync" Disabled="_busy">Remove</MudButton>
                    }
                </div>
            </div>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudText Typo="Typo.h6" Class="section-title mb-2">Organizations and clients</MudText>
            @if (_integration is null)
            {
                <EmptyState Icon="@Icons.Material.Outlined.Hub" Title="No Action1 credentials yet"
                            Text="Save the client id and secret first. Fleeto then lists the organizations of the enterprise." />
            }
            else
            {
                <MudText Typo="Typo.body2" Class="muted mb-3">
                    One organization belongs to one client, and one client to one organization. The workers read the
                    organizations from Action1 every four hours and when the connection is tested.
                </MudText>

                @if (_integration.Tenants.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="muted mb-3">
                        No organizations read yet. Test the connection; they appear here when Action1 answers.
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="muted d-block mb-3">
                        @_integration.Tenants.Count organizations, read <TimeText Value="_integration.TenantsUpdatedAt" />
                    </MudText>
                }

                @if (_integration.Tenants.Count > 0)
                {
                    <div class="d-flex gap-2 flex-wrap align-end mb-3">
                        <MudSelect T="Guid" @bind-Value="_mapClientId" Label="Client" Variant="Variant.Outlined" Style="min-width:200px">
                            @foreach (var client in _clients)
                            {
                                <MudSelectItem T="Guid" Value="@client.Id">@client.Code — @client.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSelect T="string" @bind-Value="_mapTenantId" Label="Action1 organization" Variant="Variant.Outlined" Style="min-width:240px">
                            @foreach (var organization in _integration.Tenants)
                            {
                                <MudSelectItem T="string" Value="@organization.Id">@organization.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="MapAsync" Disabled="_busy">Map</MudButton>
                    </div>
                }

                @if (_integration.Mappings.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Outlined.Link" Title="Nothing mapped yet"
                                Text="Pick a client and the Action1 organization it belongs to." />
                }
                else
                {
                    <MudTable Items="_integration.Mappings" Dense="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Client</MudTh>
                            <MudTh>Action1 organization</MudTh>
                            <MudTh>Agent installer link</MudTh>
                            <MudTh />
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.ClientCode — @context.ClientName</MudTd>
                            <MudTd>@(string.IsNullOrEmpty(context.TenantName) ? context.TenantId : context.TenantName)</MudTd>
                            <MudTd>
                                <MudTextField T="string" Value="@InstallerUrl(context)" ValueChanged="@(value => SaveInstallerUrlAsync(context.Id, value))"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="false" Disabled="_busy"
                                              Placeholder="https://app.eu.action1.com/agent/…/Windows/agent.msi" Style="min-width:320px" />
                            </MudTd>
                            <MudTd Style="text-align:right">
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Disabled="_busy"
                                               OnClick="@(() => RemoveMappingAsync(context.Id))" aria-label="Remove mapping" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                    <MudText Typo="Typo.caption" Class="muted d-block mt-2">
                        The installer link lets Fleeto install the Action1 agent on a Windows endpoint that patch management does not cover yet.
                        Fleeto reads it from Action1 where Action1 offers it; otherwise copy it per organization from the Action1 console, under
                        Endpoints, Add endpoints.
                    </MudText>
                }
            }
        </MudItem>
    </MudGrid>
</LoadState>

@code {
    private static readonly Action1Region[] Regions =
        [Action1Region.Europe, Action1Region.NorthAmerica, Action1Region.NorthAmerica2, Action1Region.UnitedKingdom, Action1Region.Australia];

    private IntegrationView? _integration;
    private IReadOnlyList<IntegrationClient> _clients = [];
    private readonly CancellationTokenSource _closed = new();
    private string? _clientId;
    private string? _clientSecret;
    private Action1Region _region = Action1Region.Europe;
    private bool _enabled = true;
    private Guid _mapClientId;
    private string? _mapTenantId;
    private bool _busy;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync() => LoadAsync(async caller =>
    {
        _integration = await IntegrationSvc.GetAction1Async(caller);
        _clients = await IntegrationSvc.ListClientsAsync(caller);
        if (_integration is not null)
        {
            _clientId = _integration.CredentialName;
            _region = _integration.Region;
            _enabled = _integration.Enabled;
        }

        if (_mapClientId == Guid.Empty && _clients.Count > 0)
        {
            _mapClientId = _clients[0].Id;
        }

        if (_mapTenantId is null && _integration is { Tenants.Count: > 0 })
        {
            _mapTenantId = _integration.Tenants[0].Id;
        }
    });

    public override void Dispose()
    {
        _closed.Cancel();
        _closed.Dispose();
        base.Dispose();
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            var input = new Action1Input(_clientId, _clientSecret, _region, _enabled);
            if (await RunAsync(caller => IntegrationSvc.SaveAction1Async(caller, input), "The Action1 credentials were saved."))
            {
                _clientSecret = null;
                await ReloadAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task TestAsync()
    {
        _busy = true;
        try
        {
            // Web cannot reach Action1 itself: the workers make the call and write the result back, usually within seconds.
            if (!await RunAsync(caller => IntegrationSvc.RequestTestAsync(caller), "Testing the connection with Action1."))
            {
                return;
            }

            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }

        await FollowTestAsync();
    }

    /// <summary>Reloads while the workers still have the test to run, so the answer appears without the admin refreshing.</summary>
    private async Task FollowTestAsync()
    {
        for (var attempt = 0; attempt < 30 && _integration?.TestPending == true && !_closed.IsCancellationRequested; attempt++)
        {
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(2), _closed.Token);
            }
            catch (OperationCanceledException)
            {
                return;
            }

            await ReloadAsync();
            StateHasChanged();
        }
    }

    private async Task RemoveAsync()
    {
        _busy = true;
        try
        {
            if (await RunAsync(caller => IntegrationSvc.RemoveAction1Async(caller), "The Action1 integration was removed."))
            {
                _clientId = null;
                _clientSecret = null;
                await ReloadAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task MapAsync()
    {
        if (_mapClientId == Guid.Empty || string.IsNullOrEmpty(_mapTenantId))
        {
            return;
        }

        var name = _integration?.Tenants.FirstOrDefault(o => o.Id == _mapTenantId)?.Name ?? string.Empty;
        _busy = true;
        try
        {
            if (await RunAsync(caller => IntegrationSvc.SaveMappingAsync(caller, _mapClientId, _mapTenantId!, name), "The mapping was saved."))
            {
                await ReloadAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private static string InstallerUrl(IntegrationMappingView mapping) => mapping.AgentInstallerUrl;

    private async Task SaveInstallerUrlAsync(Guid mappingId, string? url)
    {
        _busy = true;
        try
        {
            if (await RunAsync(caller => IntegrationSvc.SaveAgentInstallerUrlAsync(caller, mappingId, url),
                    string.IsNullOrWhiteSpace(url) ? "The installer link was removed." : "The installer link was saved."))
            {
                await ReloadAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveMappingAsync(Guid mappingId)
    {
        _busy = true;
        try
        {
            if (await RunAsync(caller => IntegrationSvc.RemoveMappingAsync(caller, mappingId), "The mapping was removed."))
            {
                await ReloadAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private static string StatusText(IntegrationStatus status) => status switch
    {
        IntegrationStatus.Ok => "Connected",
        IntegrationStatus.Failing => "Failing",
        _ => "Not tested"
    };

    private static StatusKind StatusKindOf(IntegrationStatus status) => status switch
    {
        IntegrationStatus.Ok => StatusKind.Ok,
        IntegrationStatus.Failing => StatusKind.Error,
        _ => StatusKind.Neutral
    };
}
