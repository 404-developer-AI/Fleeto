@page "/settings/monitoring-templates"
@attribute [Authorize(Policy = FleetoPolicies.Viewer)]
@inherits FleetoPageBase
@inject MonitoringTemplateService TemplateSvc
@inject ClientService ClientSvc
@inject IDialogService DialogService

<PageTitle>Monitoring templates - Fleeto</PageTitle>

<div class="page-header">
    <div>
        <MudText Typo="Typo.h4" Class="page-title">Monitoring templates</MudText>
        <MudText Typo="Typo.body2" Class="muted">
            Named sets of checks, linked to sites. A change applies at once to every site that links the template.
        </MudText>
    </div>
    @if (CanManage)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="CreateAsync">New monitoring template</MudButton>
    }
</div>

<LoadState Loading="Loading" Failed="LoadFailed">
    @if (_templates.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.Rule" Title="No monitoring templates yet"
                    Text="Create a monitoring template, add checks to it, then link it to a site." />
    }
    else
    {
        <MudTable Items="_templates" Hover="true" Elevation="0">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Available for</MudTh>
                <MudTh>Checks</MudTh>
                <MudTh>Used by</MudTh>
                @if (CanManage)
                {
                    <MudTh Style="width:110px"></MudTh>
                }
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudLink Href="@($"/settings/monitoring-templates/{context.Id}")"><strong>@context.Name</strong></MudLink>
                    @if (!string.IsNullOrEmpty(context.Description))
                    {
                        <div class="muted" style="font-size:0.8125rem">@context.Description</div>
                    }
                </MudTd>
                <MudTd>@(context.ClientCode ?? "All clients")</MudTd>
                <MudTd>@context.CheckCount</MudTd>
                <MudTd>@Usage(context)</MudTd>
                @if (CanManage)
                {
                    <MudTd Style="white-space:nowrap">
                        <MudTooltip Text="Make a copy"><MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small" OnClick="@(() => CopyAsync(context))" /></MudTooltip>
                        <MudTooltip Text="Delete"><MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(context))" /></MudTooltip>
                    </MudTd>
                }
            </RowTemplate>
        </MudTable>
    }
</LoadState>

@code {
    private IReadOnlyList<MonitoringTemplateListItem> _templates = [];
    private IReadOnlyList<ClientOption> _clients = [];

    protected override Task OnInitializedAsync() => ReloadAsync();

    /// <summary>True when opened from the Create menu in the navigation: the create dialog opens once the page has loaded.</summary>
    [SupplyParameterFromQuery(Name = "new")]
    public bool New { get; set; }

    protected override void OnParametersSet() => OpenCreateFromQuery(New, CreateAsync);

    private Task ReloadAsync() => LoadAsync(async caller =>
    {
        _templates = await TemplateSvc.ListAsync(caller);
        _clients = await ClientSvc.ListOptionsAsync(caller);
    });

    private async Task CreateAsync()
    {
        Guid? createdId = null;
        var parameters = new DialogParameters<MonitoringTemplateDialog>
        {
            { d => d.Clients, _clients },
            {
                d => d.OnSubmit, async (name, description, clientId) =>
                {
                    var result = await RunForValueAsync(caller => TemplateSvc.CreateAsync(caller, name, description, clientId), "The monitoring template was created. Add checks to it.");
                    createdId = result?.Value;
                    return result is not null;
                }
            }
        };
        var dialog = await DialogService.ShowAsync<MonitoringTemplateDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        await dialog.Result;
        if (createdId is { } id)
        {
            Navigation.NavigateTo($"/settings/monitoring-templates/{id}");
        }
    }

    private async Task CopyAsync(MonitoringTemplateListItem template)
    {
        var parameters = new DialogParameters<CopyDialog>
        {
            { d => d.Title, $"Copy monitoring template {template.Name}" },
            { d => d.InitialName, template.Name + " (copy)" },
            { d => d.AllowClientTarget, true },
            { d => d.Clients, _clients },
            { d => d.OnSubmit, (name, clientId) => RunAsync(caller => TemplateSvc.CopyAsync(caller, template.Id, name, clientId), "The copy was created.") }
        };
        var dialog = await DialogService.ShowAsync<CopyDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dialog.Result)!.Canceled)
        {
            await ReloadAsync();
        }
    }

    private async Task DeleteAsync(MonitoringTemplateListItem template)
    {
        var usage = template.ClientCount + template.SiteCount + template.ClientTemplateSiteCount > 0
            ? $"This template is linked to {Usage(template)}. Its checks stop running on those endpoints. "
            : string.Empty;
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { d => d.Title, $"Delete monitoring template {template.Name}" },
            { d => d.Message, usage + "This cannot be undone." }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(null, parameters);
        if (!(await dialog.Result)!.Canceled && await RunAsync(caller => TemplateSvc.DeleteAsync(caller, template.Id), "The monitoring template was deleted."))
        {
            await ReloadAsync();
        }
    }

    private static string Usage(MonitoringTemplateListItem template)
    {
        var parts = new List<string>();
        if (template.ClientCount > 0)
        {
            parts.Add(Ui.Count(template.ClientCount, "client"));
        }

        parts.Add(Ui.Count(template.SiteCount, "site"));
        if (template.ClientTemplateSiteCount > 0)
        {
            parts.Add(Ui.Count(template.ClientTemplateSiteCount, "client template use"));
        }

        return Ui.JoinList(parts);
    }
}
