@page "/settings/users"
@attribute [Authorize(Policy = FleetoPolicies.Admin)]
@inherits FleetoPageBase
@inject UserAdminService UserSvc
@inject SignInSettingsService SignInSvc
@inject IDialogService DialogService

<PageTitle>Users - Fleeto</PageTitle>

<div class="page-header">
    <div>
        <MudText Typo="Typo.h4" Class="page-title">Users</MudText>
        <MudText Typo="Typo.body2" Class="muted">People who can sign in to this instance. Every user signs in with two-factor authentication.</MudText>
    </div>
    <div class="d-flex gap-2">
        @if (_entraConfigured)
        {
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Custom.Brands.Microsoft" OnClick="AddFromMicrosoftAsync">Add from Microsoft</MudButton>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.PersonAdd" OnClick="CreateAsync">New user</MudButton>
    </div>
</div>

<LoadState Loading="Loading" Failed="LoadFailed">
    <MudTable Items="_users" Hover="true" Elevation="0">
        <HeaderContent>
            <MudTh>User</MudTh>
            <MudTh>Roles</MudTh>
            <MudTh>Two-factor</MudTh>
            @if (_entraConfigured)
            {
                <MudTh>Sign-in</MudTh>
            }
            <MudTh>Last sign-in</MudTh>
            <MudTh Style="width:220px"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <strong>@context.DisplayName</strong>
                <div class="muted" style="font-size:0.8125rem">@context.Email</div>
                @if (context.LockedOut)
                {
                    <StatusChip Text="Locked out" Kind="StatusKind.Warning" />
                }
            </MudTd>
            <MudTd>@string.Join(", ", context.Roles)</MudTd>
            <MudTd><StatusChip Text="@(context.TwoFactorEnabled ? "On" : "Not set up")" Kind="@(context.TwoFactorEnabled ? StatusKind.Ok : StatusKind.Neutral)" /></MudTd>
            @if (_entraConfigured)
            {
                <MudTd>
                    @if (context.EntraObjectId is not null)
                    {
                        <StatusChip Text="Microsoft" Kind="StatusKind.Ok" />
                        <div class="muted" style="font-size:0.8125rem">@context.EntraAccount</div>
                    }
                    else
                    {
                        <span class="muted">Local account</span>
                    }
                </MudTd>
            }
            <MudTd><TimeText Value="context.LastLoginAt" /></MudTd>
            <MudTd Style="white-space:nowrap">
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => RolesAsync(context))">Roles</MudButton>
                @if (context.TwoFactorEnabled)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ResetTwoFactorAsync(context))">Reset 2FA</MudButton>
                }
                @if (_entraConfigured)
                {
                    @if (context.EntraObjectId is null)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => LinkAsync(context))">Link</MudButton>
                    }
                    else
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => UnlinkAsync(context))">Unlink</MudButton>
                    }
                }
                @if (context.EntraObjectId is null)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => SetPasswordAsync(context))">Password</MudButton>
                }
                @if (context.Id != Caller?.UserId)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => DeleteAsync(context))">Delete</MudButton>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
</LoadState>

@code {
    private IReadOnlyList<UserListItem> _users = [];
    private bool _entraConfigured;

    protected override Task OnInitializedAsync() => ReloadAsync();

    /// <summary>True when opened from the Create menu in the navigation: the create dialog opens once the page has loaded.</summary>
    [SupplyParameterFromQuery(Name = "new")]
    public bool New { get; set; }

    protected override void OnParametersSet() => OpenCreateFromQuery(New, CreateAsync);

    private Task ReloadAsync() => LoadAsync(async caller =>
    {
        _users = await UserSvc.ListAsync(caller);
        _entraConfigured = (await SignInSvc.GetAsync(caller)).IsComplete;
    });

    private async Task LinkAsync(UserListItem user)
    {
        var parameters = new DialogParameters<EntraLinkDialog>
        {
            { d => d.Email, user.Email },
            { d => d.Account, user.EntraAccount },
            { d => d.OnSubmit, (objectId, account) => RunAsync(caller => UserSvc.LinkEntraAsync(caller, user.Id, objectId, account),
                "The user was linked to Microsoft Entra ID.") }
        };
        var dialog = await DialogService.ShowAsync<EntraLinkDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dialog.Result)!.Canceled)
        {
            await ReloadAsync();
        }
    }

    private async Task AddFromMicrosoftAsync()
    {
        var parameters = new DialogParameters<EntraUserDialog>
        {
            { d => d.OnSubmit, (user, roles) => RunAsync(caller => UserSvc.CreateFromEntraAsync(caller, user.ObjectId, user.Email, user.DisplayName,
                user.Account, roles), $"{user.DisplayName} was added and signs in with Microsoft.") }
        };
        var dialog = await DialogService.ShowAsync<EntraUserDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dialog.Result)!.Canceled)
        {
            await ReloadAsync();
        }
    }

    private async Task SetPasswordAsync(UserListItem user)
    {
        var parameters = new DialogParameters<SetPasswordDialog>
        {
            { d => d.Email, user.Email },
            { d => d.OnSubmit, password => RunAsync(caller => UserSvc.SetPasswordAsync(caller, user.Id, password),
                "The password was set. The user signs in with it and their authenticator code.") }
        };
        var dialog = await DialogService.ShowAsync<SetPasswordDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dialog.Result)!.Canceled)
        {
            await ReloadAsync();
        }
    }

    private async Task UnlinkAsync(UserListItem user)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { d => d.Title, $"Unlink {user.Email} from Microsoft Entra ID" },
            { d => d.Message, "This user has no password, so set one with Password after unlinking. Their open sessions end now." },
            { d => d.ConfirmText, "Unlink" }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(null, parameters);
        if (!(await dialog.Result)!.Canceled && await RunAsync(caller => UserSvc.UnlinkEntraAsync(caller, user.Id), "The link was removed."))
        {
            await ReloadAsync();
        }
    }

    private async Task CreateAsync()
    {
        var parameters = new DialogParameters<UserDialog>
        {
            { d => d.OnSubmit, (email, name, password, roles) => RunAsync(caller => UserSvc.CreateAsync(caller, email, name, password, roles), "The user was created.") }
        };
        var dialog = await DialogService.ShowAsync<UserDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dialog.Result)!.Canceled)
        {
            await ReloadAsync();
        }
    }

    private async Task RolesAsync(UserListItem user)
    {
        var parameters = new DialogParameters<UserDialog>
        {
            { d => d.Existing, user },
            { d => d.OnSubmit, (_, _, _, roles) => RunAsync(caller => UserSvc.SetRolesAsync(caller, user.Id, roles), "The roles were saved. Open sessions pick them up within five minutes.") }
        };
        var dialog = await DialogService.ShowAsync<UserDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dialog.Result)!.Canceled)
        {
            await ReloadAsync();
        }
    }

    private async Task ResetTwoFactorAsync(UserListItem user)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { d => d.Title, $"Reset two-factor authentication of {user.Email}" },
            { d => d.Message, "The authenticator key and recovery codes of this user are removed and their sessions end. At the next sign-in they set up two-factor authentication again." },
            { d => d.ConfirmText, "Reset" }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(null, parameters);
        if (!(await dialog.Result)!.Canceled && await RunAsync(caller => UserSvc.ResetTwoFactorAsync(caller, user.Id), "Two-factor authentication was reset."))
        {
            await ReloadAsync();
        }
    }

    private async Task DeleteAsync(UserListItem user)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { d => d.Title, $"Delete user {user.Email}" },
            { d => d.Message, "The user can no longer sign in and open sessions end. Audit entries of this user are kept." },
            { d => d.ConfirmText, "Delete user" }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(null, parameters);
        if (!(await dialog.Result)!.Canceled && await RunAsync(caller => UserSvc.DeleteAsync(caller, user.Id), "The user was deleted."))
        {
            await ReloadAsync();
        }
    }
}
