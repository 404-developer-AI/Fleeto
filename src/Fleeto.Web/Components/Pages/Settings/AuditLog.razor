@page "/settings/audit-log"
@attribute [Authorize(Policy = FleetoPolicies.Admin)]
@inherits FleetoPageBase
@inject AuditQueryService AuditSvc
@inject ClientService ClientSvc

<PageTitle>Audit log - Fleeto</PageTitle>

<div class="page-header">
    <div>
        <MudText Typo="Typo.h4" Class="page-title">Audit log</MudText>
        <MudText Typo="Typo.body2" Class="muted">Every privileged action, by users, the system and agents. Entries can never be changed or removed.</MudText>
    </div>
</div>

<div class="d-flex gap-3 flex-wrap mb-4 align-center">
    <MudSelect T="string" @bind-Value="_action" Label="Action" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="min-width:240px">
        @foreach (var action in AuditQueryService.KnownActions)
        {
            <MudSelectItem T="string" Value="@action">@action</MudSelectItem>
        }
    </MudSelect>
    <MudTextField T="string" @bind-Value="_actor" Label="Actor" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="200" Style="max-width:200px" />
    <MudTextField T="string" @bind-Value="_targetType" Label="Target type" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="50" Style="max-width:160px" />
    <MudTextField T="string" @bind-Value="_targetId" Label="Target id" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="100" Style="max-width:200px" />
    <MudSelect T="Guid?" @bind-Value="_clientId" Label="Client" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:200px">
        <MudSelectItem T="Guid?" Value="@((Guid?)null)">All clients</MudSelectItem>
        @foreach (var client in _clients)
        {
            <MudSelectItem T="Guid?" Value="@((Guid?)client.Id)">@client.Code</MudSelectItem>
        }
    </MudSelect>
    <MudDatePicker @bind-Date="_from" Label="From" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="max-width:170px" />
    <MudDatePicker @bind-Date="_to" Label="To" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="max-width:170px" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SearchAsync">Search</MudButton>
</div>

<LoadState Loading="Loading" Failed="LoadFailed">
    @if (_items.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.History" Title="No audit entries match these filters" Text="Change the filters and search again." />
    }
    else
    {
        <MudTable Items="_items" Dense="true" Elevation="0">
            <HeaderContent>
                <MudTh>When</MudTh>
                <MudTh>Actor</MudTh>
                <MudTh>Action</MudTh>
                <MudTh>Target</MudTh>
                <MudTh>Details</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd Style="white-space:nowrap"><TimeText Value="context.Time" Absolute="true" /></MudTd>
                <MudTd>
                    @context.ActorName
                    <div class="muted" style="font-size:0.75rem">@context.ActorType@(context.IpAddress is null ? "" : " · " + context.IpAddress)</div>
                </MudTd>
                <MudTd><span class="mono">@context.Action</span></MudTd>
                <MudTd>@context.TargetType<div class="mono muted" style="font-size:0.75rem">@context.TargetId</div></MudTd>
                <MudTd Style="max-width:420px"><pre class="json-box">@Ui.PrettyJson(context.DetailsJson)</pre></MudTd>
            </RowTemplate>
        </MudTable>
        @if (_nextBeforeId is not null)
        {
            <div class="mt-3"><MudButton Variant="Variant.Outlined" OnClick="MoreAsync">Show older entries</MudButton></div>
        }
    }
</LoadState>

@code {
    private string? _action;
    private string? _actor;
    private string? _targetType;
    private string? _targetId;
    private Guid? _clientId;
    private DateTime? _from;
    private DateTime? _to;
    private IReadOnlyList<ClientOption> _clients = [];
    private List<AuditEntryView> _items = [];
    private long? _nextBeforeId;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(async caller => _clients = await ClientSvc.ListOptionsAsync(caller));
        await SearchAsync();
    }

    /// <summary>Dates are picked in the user's time zone; the query runs on UTC.</summary>
    private AuditQuery BuildQuery(long? beforeId)
    {
        DateTime? fromUtc = _from is { } from ? TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(from.Date, DateTimeKind.Unspecified), Time.Zone) : null;
        DateTime? toUtc = _to is { } to ? TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(to.Date.AddDays(1), DateTimeKind.Unspecified), Time.Zone) : null;
        return new AuditQuery(_action, _actor, _targetType, _targetId, _clientId, fromUtc, toUtc, beforeId);
    }

    private Task SearchAsync() => LoadAsync(async caller =>
    {
        var page = await AuditSvc.QueryAsync(caller, BuildQuery(null));
        _items = page.Items.ToList();
        _nextBeforeId = page.NextBeforeId;
    });

    private Task MoreAsync() => LoadAsync(async caller =>
    {
        var page = await AuditSvc.QueryAsync(caller, BuildQuery(_nextBeforeId));
        _items.AddRange(page.Items);
        _nextBeforeId = page.NextBeforeId;
    });
}
