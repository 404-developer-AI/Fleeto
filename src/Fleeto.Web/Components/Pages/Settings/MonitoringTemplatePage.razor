@page "/settings/monitoring-templates/{TemplateId:guid}"
@attribute [RequirePermission(Permissions.MonitoringTemplatesView)]
@inherits FleetoPageBase
@inject MonitoringTemplateService TemplateSvc
@inject ScriptService ScriptSvc
@inject TaskService TaskSvc
@inject IDialogService DialogService

<PageTitle>@(_template?.Name ?? "Monitoring template") - Fleeto</PageTitle>

<LoadState Loading="Loading" Failed="LoadFailed" NotFound="_notFound" What="monitoring template">
    @if (_template is { } template)
    {
        <div class="mb-1"><a href="/settings/monitoring-templates" class="breadcrumb-link">Monitoring templates</a></div>
        <div class="page-header">
            <div>
                <MudText Typo="Typo.h4" Class="page-title">@template.Name</MudText>
                <MudText Typo="Typo.body2" Class="muted">
                    @(template.ClientCode is null ? "Global" : $"For client {template.ClientCode}") · @Ui.AppliesToLabel(template.AppliesTo) · can be linked to @((template.Levels ?? TemplateLevels.All).ToString()) · linked to @template.SiteCount site@(template.SiteCount == 1 ? "" : "s")
                    @if (!string.IsNullOrEmpty(template.Description))
                    {
                        <span> · @template.Description</span>
                    }
                </MudText>
            </div>
            @if (Can(Permissions.MonitoringTemplatesEdit))
            {
                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Edit" OnClick="EditAsync">Edit</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="@(() => EditCheckAsync(null))">Add check</MudButton>
                </div>
            }
        </div>

        @if (template.Checks.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.Rule" Title="No checks yet" Text="Add a check, for example free disk space every 15 minutes." />
        }
        else
        {
            <MudTable Items="template.Checks" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Check</MudTh>
                    <MudTh>Type</MudTh>
                    <MudTh>Interval</MudTh>
                    <MudTh>Thresholds</MudTh>
                    <MudTh>Runs on</MudTh>
                    <MudTh>Enabled</MudTh>
                    @if (Can(Permissions.MonitoringTemplatesEdit))
                    {
                        <MudTh Style="width:110px"></MudTh>
                    }
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <strong>@context.Name</strong>
                        @foreach (var parameter in context.Parameters)
                        {
                            @if (Ui.ParameterText(context.Type, parameter.Key, parameter.Value, _scriptNames) is { } text)
                            {
                                <div class="muted" style="font-size:0.75rem">@text</div>
                            }
                        }
                    </MudTd>
                    <MudTd>@Ui.CheckTypeLabel(context.Type)</MudTd>
                    <MudTd>@Ui.CheckInterval(context.Type, context.IntervalSeconds)</MudTd>
                    <MudTd>@Thresholds(context)</MudTd>
                    <MudTd>@Ui.RunsOnLabel(context.AppliesTo, context.OperatingSystem)</MudTd>
                    <MudTd>
                        <MudSwitch T="bool" Value="context.Enabled" ValueChanged="@(v => SetEnabledAsync(context, v))" Color="Color.Primary" Disabled="@(!Can(Permissions.MonitoringTemplatesEdit))" />
                    </MudTd>
                    @if (Can(Permissions.MonitoringTemplatesEdit))
                    {
                        <MudTd Style="white-space:nowrap">
                            <MudTooltip Text="Edit"><MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="@(() => EditCheckAsync(context))" /></MudTooltip>
                            <MudTooltip Text="Delete"><MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteCheckAsync(context))" /></MudTooltip>
                        </MudTd>
                    }
                </RowTemplate>
            </MudTable>
        }

        @if (Can(Permissions.TasksView))
        {
            <div class="d-flex align-center justify-space-between flex-wrap gap-2 mt-6 mb-2">
                <div>
                    <MudText Typo="Typo.h6">Tasks</MudText>
                    <MudText Typo="Typo.body2" Class="muted">These tasks run on every endpoint that gets this monitoring template, wherever it is linked.</MudText>
                </div>
                @if (CanLinkTasks)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.AddLink" OnClick="LinkTaskAsync">Link task</MudButton>
                }
            </div>
            @if (_tasks.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Outlined.EventRepeat" Title="No tasks linked"
                            Text="Link a task to run its script on every endpoint that gets this monitoring template." />
            }
            else
            {
                <MudTable Items="_tasks" Hover="true" Elevation="0" Dense="true">
                    <HeaderContent>
                        <MudTh>Task</MudTh>
                        <MudTh>For</MudTh>
                        <MudTh>Runs</MudTh>
                        <MudTh>Next run</MudTh>
                        <MudTh>Last run</MudTh>
                        @if (CanLinkTasks)
                        {
                            <MudTh Style="width:52px"></MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudLink Href="@($"/settings/tasks/{context.Id}")" Typo="Typo.body2"><strong>@context.Name</strong></MudLink>
                            @if (!context.Enabled)
                            {
                                <span class="ml-1"><StatusChip Text="Off" Kind="StatusKind.Neutral" /></span>
                            }
                            <div class="muted" style="font-size:0.75rem">@context.StepSummary</div>
                        </MudTd>
                        <MudTd>@(context.ClientCode is null ? "Global" : context.ClientCode)</MudTd>
                        <MudTd>
                            @context.Schedule
                            <div class="muted" style="font-size:0.75rem">@context.Triggers</div>
                        </MudTd>
                        <MudTd><TimeText Value="context.NextRunAt" Never="-" /></MudTd>
                        <MudTd><TimeText Value="context.LastRunAt" Never="Never" /></MudTd>
                        @if (CanLinkTasks)
                        {
                            <MudTd>
                                <MudTooltip Text="Unlink from this monitoring template">
                                    <MudIconButton Icon="@Icons.Material.Outlined.LinkOff" Size="Size.Small" aria-label="Unlink from this monitoring template"
                                                   OnClick="@(() => UnlinkTaskAsync(context))" />
                                </MudTooltip>
                            </MudTd>
                        }
                    </RowTemplate>
                </MudTable>
            }
        }
    }
</LoadState>

@code {
    [Parameter]
    public Guid TemplateId { get; set; }

    private MonitoringTemplateDetail? _template;
    private IReadOnlyDictionary<string, string> _scriptNames = new Dictionary<string, string>();
    private bool _notFound;
    private IReadOnlyList<TaskListItem> _tasks = [];

    /// <summary>Linking a task to a monitoring template changes the template too, so it needs both permissions.</summary>
    private bool CanLinkTasks => Can(Permissions.TasksEdit) && Can(Permissions.MonitoringTemplatesEdit);

    protected override Task OnParametersSetAsync() => ReloadAsync();

    private Task ReloadAsync() => LoadAsync(async caller =>
    {
        _template = await TemplateSvc.GetAsync(caller, TemplateId);
        _notFound = _template is null;
        if (_template?.Checks.Any(c => c.Type == CheckType.Script) == true)
        {
            _scriptNames = (await ScriptSvc.ListForChecksAsync(caller, _template.ClientId)).ToDictionary(s => s.Id.ToString("D"), s => s.Name);
        }

        _tasks = _template is not null && caller.Has(Permissions.TasksView) ? await TaskSvc.ListAsync(caller, TemplateId) : [];
    });

    private async Task LinkTaskAsync()
    {
        IReadOnlyList<TaskOption> tasks = [];
        await LoadAsync(async caller => tasks = await TaskSvc.GetTaskChoicesForTemplateAsync(caller, TemplateId));
        var parameters = new DialogParameters<LinkTaskDialog>
        {
            { d => d.Target, _template!.Name },
            { d => d.HelperText, "The task runs on every endpoint that gets this monitoring template, on top of where it is linked already." },
            { d => d.EmptyText, "Every task you can link is already linked to this monitoring template. Create one in Settings, Tasks." },
            { d => d.Tasks, tasks },
            { d => d.OnSubmit, taskId => RunAsync(caller => TaskSvc.LinkTemplateAsync(caller, taskId, TemplateId), "The task was linked to this monitoring template.") }
        };
        var dialog = await DialogService.ShowAsync<LinkTaskDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dialog.Result)!.Canceled)
        {
            await ReloadAsync();
        }
    }

    private async Task UnlinkTaskAsync(TaskListItem task)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { d => d.Title, $"Unlink task {task.Name}" },
            { d => d.Message, "The task no longer runs on the endpoints of this monitoring template, unless it is linked to them in another way." },
            { d => d.ConfirmText, "Unlink" }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(null, parameters);
        if (!(await dialog.Result)!.Canceled &&
            await RunAsync(caller => TaskSvc.UnlinkTemplateAsync(caller, task.Id, TemplateId), "The task was unlinked from this monitoring template."))
        {
            await ReloadAsync();
        }
    }

    private static string Thresholds(CheckDefinitionView check) =>
        Ui.ThresholdsText(check.Type, check.Parameters, check.WarningThreshold, check.CriticalThreshold);

    private async Task EditAsync()
    {
        var template = _template!;
        var parameters = new DialogParameters<MonitoringTemplateDialog>
        {
            { d => d.IsEdit, true },
            { d => d.InitialName, template.Name },
            { d => d.InitialDescription, template.Description },
            { d => d.InitialAppliesTo, template.AppliesTo },
            { d => d.InitialLevels, template.Levels ?? TemplateLevels.All },
            {
                d => d.OnSubmit, (name, description, _, appliesTo, levels) =>
                    RunAsync(caller => TemplateSvc.UpdateAsync(caller, TemplateId, name, description, appliesTo, levels), "The monitoring template was saved.")
            }
        };
        var dialog = await DialogService.ShowAsync<MonitoringTemplateDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dialog.Result)!.Canceled)
        {
            await ReloadAsync();
        }
    }

    private async Task EditCheckAsync(CheckDefinitionView? check)
    {
        var parameters = new DialogParameters<CheckDialog>
        {
            { d => d.Existing, check },
            { d => d.LoadServices, () => LoadServicesAsync() },
            { d => d.LoadScripts, () => LoadScriptsAsync(null) },
            {
                d => d.OnSubmit, input => RunAsync(caller => TemplateSvc.SaveCheckAsync(caller, TemplateId, check?.Id, input),
                    check is null ? "The check was added. Linked endpoints receive it shortly." : "The check was saved. Linked endpoints receive the change shortly.")
            }
        };
        var dialog = await DialogService.ShowAsync<CheckDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dialog.Result)!.Canceled)
        {
            await ReloadAsync();
        }
    }

    private async Task<IReadOnlyList<ServiceOption>> LoadServicesAsync()
    {
        IReadOnlyList<ServiceOption> services = [];
        await LoadAsync(async caller => services = await TemplateSvc.GetServicesAsync(caller, TemplateId));
        return services;
    }

    private async Task<IReadOnlyList<ScriptOption>> LoadScriptsAsync(string? platform)
    {
        IReadOnlyList<ScriptOption> scripts = [];
        await LoadAsync(async caller => scripts = await ScriptSvc.ListForChecksAsync(caller, _template?.ClientId, platform));
        return scripts;
    }

    private async Task SetEnabledAsync(CheckDefinitionView check, bool enabled)
    {
        await RunAsync(caller => TemplateSvc.SetCheckEnabledAsync(caller, TemplateId, check.Id, enabled),
            enabled ? $"Check {check.Name} is enabled." : $"Check {check.Name} is disabled.");
        await ReloadAsync();
    }

    private async Task DeleteCheckAsync(CheckDefinitionView check)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { d => d.Title, $"Delete check {check.Name}" },
            { d => d.Message, "The check stops running on every endpoint that uses this template, and its results and alerts are no longer updated." }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(null, parameters);
        if (!(await dialog.Result)!.Canceled && await RunAsync(caller => TemplateSvc.DeleteCheckAsync(caller, TemplateId, check.Id), "The check was deleted."))
        {
            await ReloadAsync();
        }
    }
}
