@page "/settings/policies"
@attribute [Authorize(Policy = FleetoPolicies.Viewer)]
@inherits FleetoPageBase
@inject PolicyService PolicySvc
@inject ClientService ClientSvc
@inject IDialogService DialogService

<PageTitle>Policies - Fleeto</PageTitle>

<div class="page-header">
    <div>
        <MudText Typo="Typo.h4" Class="page-title">Policies</MudText>
        <MudText Typo="Typo.body2" Class="muted">
            Agent behaviour for the endpoints of a client, site or single endpoint; the most specific link wins. Policies are linked, not copied: a change applies at once to every endpoint that uses the policy.
        </MudText>
    </div>
    @if (CanManage)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="CreateAsync">New policy</MudButton>
    }
</div>

<LoadState Loading="Loading" Failed="LoadFailed">
    <MudTable Items="_policies" Hover="true" Elevation="0">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Available for</MudTh>
            <MudTh>For</MudTh>
            <MudTh>Heartbeat</MudTh>
            <MudTh>Inventory</MudTh>
            <MudTh>Offline alert</MudTh>
            <MudTh>Agent updates</MudTh>
            <MudTh>Maintenance windows</MudTh>
            <MudTh>Used by</MudTh>
            @if (CanManage)
            {
                <MudTh Style="width:140px"></MudTh>
            }
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <strong>@context.Name</strong>
                @if (context.IsDefault)
                {
                    <span class="ml-1"><StatusChip Text="Default" Kind="StatusKind.Active" /></span>
                }
                @if (context.ScriptApprovalRequired)
                {
                    <span class="ml-1"><StatusChip Text="Script approval" Kind="StatusKind.Neutral" /></span>
                }
                @if (context.MaxOutputBytes != ScriptRules.DefaultMaxOutputBytes)
                {
                    <span class="ml-1"><StatusChip Text="@($"Output {context.MaxOutputBytes / ScriptRules.Mebibyte} MiB")" Kind="StatusKind.Neutral" /></span>
                }
                @if (!string.IsNullOrEmpty(context.Description))
                {
                    <div class="muted" style="font-size:0.8125rem">@context.Description</div>
                }
            </MudTd>
            <MudTd>@(context.ClientCode ?? "All clients")</MudTd>
            <MudTd>@Ui.AppliesToLabel(context.AppliesTo)</MudTd>
            <MudTd>@Intervals.Describe(context.HeartbeatIntervalSeconds)</MudTd>
            <MudTd>@Intervals.Describe(context.InventoryIntervalSeconds)</MudTd>
            <MudTd>@(context.OfflineAlertAfterMinutes == 0 ? "Off" : $"{context.OfflineAlertSeverity} after {context.OfflineAlertAfterMinutes} min")</MudTd>
            <MudTd>@Ui.UpdateRingLabel(context.UpdateRing)</MudTd>
            <MudTd>
                @if (context.MaintenanceWindows.Count == 0)
                {
                    <span class="muted">None</span>
                }
                @foreach (var window in context.MaintenanceWindows)
                {
                    <div style="font-size:0.8125rem">@(string.IsNullOrEmpty(window.Name) ? "" : window.Name + ": ")@Fleeto.Core.Domain.MaintenanceWindows.Describe(window)</div>
                }
            </MudTd>
            <MudTd>@Usage(context)</MudTd>
            @if (CanManage)
            {
                <MudTd Style="white-space:nowrap">
                    <MudTooltip Text="Edit"><MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="@(() => EditAsync(context))" /></MudTooltip>
                    <MudTooltip Text="Make a copy"><MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small" OnClick="@(() => CopyAsync(context))" /></MudTooltip>
                    @if (!context.IsDefault)
                    {
                        <MudTooltip Text="Delete"><MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(context))" /></MudTooltip>
                    }
                </MudTd>
            }
        </RowTemplate>
    </MudTable>
</LoadState>

@code {
    private IReadOnlyList<PolicyListItem> _policies = [];
    private IReadOnlyList<ClientOption> _clients = [];

    protected override Task OnInitializedAsync() => ReloadAsync();

    /// <summary>True when opened from the Create menu in the navigation: the create dialog opens once the page has loaded.</summary>
    [SupplyParameterFromQuery(Name = "new")]
    public bool New { get; set; }

    protected override void OnParametersSet() => OpenCreateFromQuery(New, CreateAsync);

    private Task ReloadAsync() => LoadAsync(async caller =>
    {
        _policies = await PolicySvc.ListAsync(caller);
        _clients = await ClientSvc.ListOptionsAsync(caller);
    });

    private async Task CreateAsync()
    {
        var parameters = new DialogParameters<PolicyDialog>
        {
            { d => d.Clients, _clients },
            { d => d.OnSubmit, (clientId, input) => RunAsync(caller => PolicySvc.CreateAsync(caller, clientId, input), "The policy was created.") }
        };
        await ShowAsync(parameters);
    }

    private async Task EditAsync(PolicyListItem policy)
    {
        var parameters = new DialogParameters<PolicyDialog>
        {
            { d => d.Existing, policy },
            { d => d.OnSubmit, (_, input) => RunAsync(caller => PolicySvc.UpdateAsync(caller, policy.Id, input), "The policy was saved. Endpoints that use it receive the change shortly.") }
        };
        await ShowAsync(parameters);
    }

    private async Task ShowAsync(DialogParameters<PolicyDialog> parameters)
    {
        var dialog = await DialogService.ShowAsync<PolicyDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dialog.Result)!.Canceled)
        {
            await ReloadAsync();
        }
    }

    private async Task CopyAsync(PolicyListItem policy)
    {
        var parameters = new DialogParameters<CopyDialog>
        {
            { d => d.Title, $"Copy policy {policy.Name}" },
            { d => d.InitialName, policy.Name + " (copy)" },
            { d => d.AllowClientTarget, true },
            { d => d.Clients, _clients },
            { d => d.OnSubmit, (name, clientId) => RunAsync(caller => PolicySvc.CopyAsync(caller, policy.Id, name, clientId), "The copy was created.") }
        };
        var dialog = await DialogService.ShowAsync<CopyDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dialog.Result)!.Canceled)
        {
            await ReloadAsync();
        }
    }

    private async Task DeleteAsync(PolicyListItem policy)
    {
        var usage = policy.ClientCount + policy.SiteCount + policy.EndpointCount > 0
            ? $"This policy is linked to {Links(policy)}. They follow the next wider level, or the default policy, once it is gone. "
            : string.Empty;
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { d => d.Title, $"Delete policy {policy.Name}" },
            { d => d.Message, usage + "This cannot be undone." }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(null, parameters);
        if (!(await dialog.Result)!.Canceled && await RunAsync(caller => PolicySvc.DeleteAsync(caller, policy.Id), "The policy was deleted."))
        {
            await ReloadAsync();
        }
    }

    private static string Links(PolicyListItem policy)
    {
        var parts = new List<string>();
        if (policy.ClientCount > 0)
        {
            parts.Add(Ui.Count(policy.ClientCount, "client"));
        }

        if (policy.SiteCount > 0 || (policy.ClientCount == 0 && policy.EndpointCount == 0))
        {
            parts.Add(Ui.Count(policy.SiteCount, "site"));
        }

        if (policy.EndpointCount > 0)
        {
            parts.Add(Ui.Count(policy.EndpointCount, "endpoint"));
        }

        return Ui.JoinList(parts);
    }

    private static string Usage(PolicyListItem policy)
    {
        var usage = policy.IsDefault && policy.ClientCount + policy.SiteCount + policy.EndpointCount == 0
            ? "Everything without a policy"
            : policy.IsDefault ? $"Everything without a policy, and {Links(policy)}" : Links(policy);
        return policy.ClientTemplateSiteCount > 0 ? $"{usage}, {Ui.Count(policy.ClientTemplateSiteCount, "client template use")}" : usage;
    }
}
