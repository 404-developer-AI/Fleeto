@page "/settings/instance"
@attribute [RequirePermission(Permissions.InstanceView)]
@inherits FleetoPageBase
@inject SettingsService SettingsSvc
@inject PatchManagementService PatchManagementSvc
@inject IDialogService DialogService

<PageTitle>Instance - Fleeto</PageTitle>

<div class="page-header">
    <div>
        <MudText Typo="Typo.h4" Class="page-title">Instance</MudText>
        <MudText Typo="Typo.body2" Class="muted">The identity of this Fleeto installation, set by install.sh, and the patch management it works with.</MudText>
    </div>
</div>

<LoadState Loading="Loading" Failed="LoadFailed">
    @if (_instance is { } i)
    {
        <div class="fl-panel pa-4" style="max-width:820px">
            <MudSimpleTable Dense="true" Elevation="0">
                <tbody>
                    <tr><td class="muted">FQDN</td><td>@i.Fqdn</td></tr>
                    <tr><td class="muted">Web address</td><td>@i.WebBaseUrl</td></tr>
                    <tr><td class="muted">Agent address</td><td>@i.AgentHostName:@i.AgentPort</td></tr>
                    <tr><td class="muted">Instance id</td><td class="mono">@i.InstanceId</td></tr>
                    <tr>
                        <td class="muted">CA fingerprint (SHA-256)</td>
                        <td class="mono">@(i.CaFingerprint ?? "Not created yet: fleeto-signer has not started.")</td>
                    </tr>
                    <tr><td class="muted">CA valid until</td><td><TimeText Value="i.CaExpiresAt" Absolute="true" Never="-" /></td></tr>
                    <tr><td class="muted">Signing key id</td><td class="mono">@(i.SigningKeyId ?? "Not created yet")</td></tr>
                    <tr><td class="muted">Version</td><td>Fleeto @i.Version</td></tr>
                    <tr><td class="muted">Installed</td><td><TimeText Value="i.CreatedAt" Absolute="true" /></td></tr>
                </tbody>
            </MudSimpleTable>
        </div>
    }
    else
    {
        <EmptyState Icon="@Icons.Material.Outlined.Dns" Title="Instance settings are missing" Text="Run install.sh (or fleeto-tool migrate) for this instance." />
    }

    @if (_patching is { } patching)
    {
        <div class="fl-panel pa-4 mt-4" style="max-width:820px">
            <div class="d-flex align-center gap-2 mb-2">
                <MudText Typo="Typo.h6">Patch management</MudText>
                <StatusChip Text="@PatchManagement.Describe(patching.Manager)" Kind="StatusKind.Neutral" />
                <MudSpacer />
                @if (Caller?.IsAdmin == true)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="_busy" OnClick="ChooseAsync">
                        @(patching.Manager == PatchManager.Fleeto ? "Patch with Action1" : "Patch with Fleeto")
                    </MudButton>
                }
            </div>
            <MudText Typo="Typo.body2" Class="muted mb-2">
                @if (patching.Manager == PatchManager.Fleeto)
                {
                    @:The Fleeto agent patches the endpoints with the Windows Update Agent, apt or dnf, in the rounds of their patch policy. Fleeto never
                    @:installs the Action1 agent; an endpoint that still has it is patched by Action1 until the agent is removed.
                }
                else
                {
                    @:Patch policies for patching by Action1 become automations in Action1, and Fleeto can install the Action1 agent. Patch policies for
                    @:patching by Fleeto patch the endpoints without the Action1 agent.
                }
                @if (patching.ChangedAt is { } changed)
                {
                    <span> Chosen <TimeText Value="changed" />.</span>
                }
            </MudText>

            @if (patching.Manager == PatchManager.Fleeto)
            {
                @if (patching.Agents.Count == 0)
                {
                    <MudText Typo="Typo.body2">No endpoint has the Action1 agent.</MudText>
                }
                else
                {
                    <div class="d-flex align-center gap-2 mb-1">
                        <MudText Typo="Typo.subtitle2">Action1 agents that remain (@patching.Agents.Count)</MudText>
                        <MudSpacer />
                        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Refresh" Disabled="_busy" OnClick="ReloadAsync">Refresh</MudButton>
                        @if (Caller?.IsAdmin == true && patching.Agents.Any(a => a.CanStart))
                        {
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" Disabled="_busy" OnClick="RemoveAsync">Remove Action1 agents</MudButton>
                        }
                    </div>
                    <div style="max-height:420px;overflow:auto">
                        <MudSimpleTable Dense="true" Elevation="0">
                            <thead><tr><th>Client</th><th>Endpoint</th><th>Class</th><th>Removal</th></tr></thead>
                            <tbody>
                                @foreach (var agent in patching.Agents)
                                {
                                    <tr>
                                        <td>@agent.ClientCode</td>
                                        <td>@agent.Hostname@(agent.Managed ? "" : " (agent-only)")</td>
                                        <td>@Ui.ClassLabel(agent.Class)</td>
                                        <td>
                                            <StatusChip Text="@StatusLabel(agent.Status)" Kind="@StatusKindOf(agent.Status)" />
                                            @if (agent.Detail is { } detail)
                                            {
                                                <div class="muted" style="font-size:0.8125rem">@detail</div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </div>
                }
            }
        </div>
    }
</LoadState>

@code {
    private InstanceView? _instance;
    private PatchManagementView? _patching;
    private bool _busy;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync() => LoadAsync(async caller =>
    {
        _instance = await SettingsSvc.GetInstanceAsync(caller);
        _patching = await PatchManagementSvc.GetAsync(caller);
    });

    private static string StatusLabel(Action1RemovalStatus status) => status switch
    {
        Action1RemovalStatus.NotStarted => "Not asked",
        Action1RemovalStatus.WaitingForAction1 => "Waiting for Action1",
        Action1RemovalStatus.RemovedByAction1 => "Action1 uninstalls it when the endpoint is online",
        Action1RemovalStatus.JobRunning => "Removal job on its way",
        Action1RemovalStatus.JobSucceeded => "Removed, waiting for the next inventory",
        Action1RemovalStatus.JobFailed => "Removal job did not succeed",
        _ => "Remove by hand"
    };

    private static StatusKind StatusKindOf(Action1RemovalStatus status) => status switch
    {
        Action1RemovalStatus.JobFailed or Action1RemovalStatus.ByHand => StatusKind.Error,
        Action1RemovalStatus.NotStarted => StatusKind.Warning,
        Action1RemovalStatus.RemovedByAction1 or Action1RemovalStatus.JobSucceeded => StatusKind.Ok,
        _ => StatusKind.Active
    };

    private async Task ChooseAsync()
    {
        var target = _patching?.Manager == PatchManager.Fleeto ? PatchManager.Action1 : PatchManager.Fleeto;
        _busy = true;
        try
        {
            var preview = await RunForValueAsync(caller => PatchManagementSvc.PreviewAsync(caller, target), null);
            if (preview?.Value is not { } value)
            {
                return;
            }

            var parameters = new DialogParameters<PatchManagerDialog>
            {
                { d => d.Target, target },
                { d => d.Preview, value },
                { d => d.Agents, value.Agents },
                {
                    d => d.OnConfirm, (includeAgentOnly, code) => RunAsync(caller => PatchManagementSvc.ChooseAsync(caller, target, includeAgentOnly, code),
                        target == PatchManager.Fleeto
                            ? "This instance now patches with Fleeto. The Action1 agents are being removed; this page shows where each stands."
                            : "This instance now patches with Action1.")
                }
            };
            await ShowAsync(parameters);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveAsync()
    {
        var parameters = new DialogParameters<PatchManagerDialog>
        {
            { d => d.RemoveOnly, true },
            { d => d.Target, PatchManager.Fleeto },
            { d => d.Agents, _patching?.Agents ?? [] },
            {
                d => d.OnConfirm, (includeAgentOnly, code) => RunAsync(caller => PatchManagementSvc.RemoveAgentsAsync(caller, includeAgentOnly, code),
                    "The Action1 agents are being removed.")
            }
        };
        await ShowAsync(parameters);
    }

    private async Task ShowAsync(DialogParameters<PatchManagerDialog> parameters)
    {
        var dialog = await DialogService.ShowAsync<PatchManagerDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (!(await dialog.Result)!.Canceled)
        {
            await ReloadAsync();
        }
    }
}
