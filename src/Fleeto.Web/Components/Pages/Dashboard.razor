@page "/"
@attribute [Authorize(Policy = FleetoPolicies.Viewer)]
@inherits FleetoPageBase
@inject DashboardService DashboardData
@inject DashboardDesignService Dashboards

<PageTitle>Dashboard - Fleeto</PageTitle>

<div class="page-header">
    <div>
        <MudText Typo="Typo.h4" Class="page-title">Dashboard</MudText>
        @if (_dashboard.Id is not null)
        {
            <MudText Typo="Typo.body2" Class="muted">@_dashboard.Name</MudText>
        }
    </div>
    @* The dashboard of the instance is designed in Settings (0.8.0); the link only for who may design it. *@
    @if (Can(Permissions.DashboardsManage))
    {
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.DashboardCustomize"
                   Href="@(_dashboard.Id is { } id ? $"/settings/dashboards/{id}" : "/settings/dashboards")">Design dashboards</MudButton>
    }
</div>

<LoadState Loading="Loading" Failed="LoadFailed">
    @if (_credentials is { } credentials)
    {
        @foreach (var credential in credentials)
        {
            <MudAlert Severity="@(credential.Expired ? Severity.Error : Severity.Warning)" Class="mb-3">
                @if (credential.Expired)
                {
                    <span>
                        @credential.Name expired on @Time.Absolute(credential.ExpiresAt). @Capitalize(credential.StopsWorking) has stopped@(credential.FallbackInUse ? "; email goes through SMTP until it is renewed" : "").
                    </span>
                }
                else
                {
                    <span>@credential.Name expires on @Time.Absolute(credential.ExpiresAt). After that date @credential.StopsWorking stops.</span>
                }
                @* The way to renew it only for somebody who may open its settings page (0.6.0). *@
                @if (CanOpen(credential.SettingsPath))
                {
                    <span> @credential.NextStep </span><MudLink Href="@credential.SettingsPath">Open settings</MudLink>
                }
                else
                {
                    <span> Ask an admin to renew it.</span>
                }
            </MudAlert>
        }
        <DashboardView Layout="_dashboard.Layout" />
    }
</LoadState>

@code {
    private static string Capitalize(string value) => value.Length == 0 ? value : char.ToUpperInvariant(value[0]) + value[1..];

    private bool CanOpen(string path) =>
        SettingsPages.All.FirstOrDefault(p => path.StartsWith(p.Href, StringComparison.OrdinalIgnoreCase)) is { } page && Can(page.Permission);

    // The expiring-credential warnings stay above every dashboard, not as a tile, so no layout can hide them (DASHBOARDS.md §2).
    private IReadOnlyList<CredentialWarning>? _credentials;
    private UserDashboard _dashboard = DashboardDesignService.Default;

    protected override Task OnInitializedAsync() => LoadAsync(async caller =>
    {
        _dashboard = await Dashboards.GetForUserAsync(caller);
        _credentials = await DashboardData.GetCredentialWarningsAsync();
    });
}
