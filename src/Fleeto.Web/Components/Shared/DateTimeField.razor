@using System.Globalization
@* The one date-and-time field of Fleeto (0.6.0): the browser's own calendar with a time, compact enough for any dialog. The
   value is a local time without a kind; the caller converts it with the user's time zone. Used with DateField and TimeField. *@
<MudTextField T="string" Value="@Text" ValueChanged="OnChangedAsync" InputType="InputType.DateTimeLocal" Label="@Label" Variant="Variant.Outlined"
              Margin="Margin" Class="@Class" Style="@Style" HelperText="@HelperText" Disabled="Disabled" ShrinkLabel="true"
              UserAttributes="@Attributes" />

@code {
    private const string Format = "yyyy-MM-dd'T'HH:mm";

    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public DateTime? Min { get; set; }
    [Parameter] public DateTime? Max { get; set; }
    [Parameter] public Margin Margin { get; set; } = Margin.None;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; } = "max-width:240px";
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private string? Text => Value?.ToString(Format, CultureInfo.InvariantCulture);

    private Dictionary<string, object?> Attributes => PickerAttributes.Range(Min?.ToString(Format, CultureInfo.InvariantCulture),
        Max?.ToString(Format, CultureInfo.InvariantCulture), step: 60);

    private Task OnChangedAsync(string? text) =>
        ValueChanged.InvokeAsync(DateTime.TryParseExact(text, ["yyyy-MM-dd'T'HH:mm", "yyyy-MM-dd'T'HH:mm:ss"], CultureInfo.InvariantCulture,
            DateTimeStyles.None, out var parsed) ? DateTime.SpecifyKind(parsed, DateTimeKind.Unspecified) : null);
}
