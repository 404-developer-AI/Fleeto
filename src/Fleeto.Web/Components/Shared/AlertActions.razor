@* Actions on one unresolved alert: acknowledge, put on hold, end hold, resolve, each with its own permission (0.6.0); on a resolved
   alert whose hold still runs only end hold. Render only where AnyAction is true for the caller. *@
@inherits FleetoPageBase
@inject AlertService AlertSvc
@inject IDialogService DialogService
@inject TimeProvider Clock

@if ((Alert.State != AlertState.Resolved && AnyAction(Caller)) || (Alert.HasHold(Clock.GetUtcNow().UtcDateTime) && Can(Permissions.AlertsHold)))
{
    <MudMenu Icon="@Icons.Material.Outlined.MoreVert" Size="Size.Small" Dense="true" AriaLabel="Alert actions" AnchorOrigin="Origin.BottomRight"
             TransformOrigin="Origin.TopRight">
        @if (Alert.State == AlertState.Open && Can(Permissions.AlertsAcknowledge))
        {
            <MudMenuItem Icon="@Icons.Material.Outlined.Check" OnClick="AcknowledgeAsync">Acknowledge</MudMenuItem>
        }
        @if (Can(Permissions.AlertsHold))
        {
            @if (Alert.HasHold(Clock.GetUtcNow().UtcDateTime))
            {
                <MudMenuItem Icon="@Icons.Material.Outlined.PlayCircle" OnClick="EndHoldAsync">End hold</MudMenuItem>
            }
            else if (Alert.State != AlertState.Resolved)
            {
                <MudMenuItem Icon="@Icons.Material.Outlined.PauseCircle" OnClick="HoldAsync">Put on hold</MudMenuItem>
            }
        }
        @if (Alert.State != AlertState.Resolved && Can(Permissions.AlertsResolve))
        {
            <MudMenuItem Icon="@Icons.Material.Outlined.TaskAlt" OnClick="ResolveAsync">Resolve</MudMenuItem>
        }
    </MudMenu>
}

@code {
    /// <summary>The caller may act on alerts at all: the column for these actions is shown.</summary>
    public static bool AnyAction(Caller? caller) =>
        caller is not null && (caller.Has(Permissions.AlertsAcknowledge) || caller.Has(Permissions.AlertsHold) || caller.Has(Permissions.AlertsResolve));

    protected override Task OnInitializedAsync() => LoadAsync(_ => Task.CompletedTask);

    [Parameter, EditorRequired] public AlertView Alert { get; set; } = default!;

    /// <summary>Raised after an action succeeded, so the owner reloads.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private Task AcknowledgeAsync() => AfterAsync(AlertActionPrompts.AcknowledgeAsync(DialogService, AlertSvc, Alert, RunAsync));

    private Task ResolveAsync() => AfterAsync(AlertActionPrompts.ResolveAsync(DialogService, AlertSvc, Alert, RunAsync));

    private Task EndHoldAsync() => AfterAsync(AlertActionPrompts.EndHoldAsync(DialogService, AlertSvc, Alert, RunAsync));

    private Task HoldAsync() => AfterAsync(AlertActionPrompts.HoldAsync(DialogService, AlertSvc, Time, Alert, RunAsync));

    private async Task AfterAsync(Task<bool> action)
    {
        if (await action)
        {
            await OnChanged.InvokeAsync();
        }
    }
}
