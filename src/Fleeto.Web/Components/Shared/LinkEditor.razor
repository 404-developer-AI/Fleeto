@* The policy, patch policy and monitoring templates of a client, site, endpoint or client template (0.6.0), in one compact
   block. Every choice names what applies without it, so the most specific level winning is visible where it is chosen; a
   client or site can choose differently for servers and workstations. *@
<div class="link-editor">
    <ClassChoiceEditor Selection="Selection.Policy" Options="Choices.Policies" Label="Policy" Icon="@Icons.Material.Outlined.Tune"
                       Inherit="PolicyInherit" Locked="PolicyLocked" EndpointClass="EndpointClass" Disabled="Disabled" Changed="Changed"
                       HelperText="Agent behaviour: intervals, offline alerts, maintenance windows, scripts and remote sessions." />

    <div class="mt-3">
        <ClassChoiceEditor Selection="Selection.PatchPolicy" Options="Choices.PatchPolicies" Label="Patch policy"
                           Icon="@Icons.Material.Outlined.SystemUpdateAlt" Inherit="PatchInherit" Locked="PatchLocked" EndpointClass="EndpointClass"
                           Disabled="Disabled" Changed="Changed" HelperText="When Action1 installs updates on the managed Windows endpoints." />
    </div>

    @if (ShowTemplates)
    {
        <MudSelect T="Guid" MultiSelection="true" SelectedValues="Templates" SelectedValuesChanged="SetTemplatesAsync" Label="Monitoring templates"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(Disabled || TemplatesDisabledText is not null)" Class="mt-3"
                   AdornmentIcon="@Icons.Material.Outlined.MonitorHeart" Adornment="Adornment.Start"
                   ToStringFunc="@(id => Choices.MonitoringTemplates.FirstOrDefault(t => t.Id == id)?.Name ?? string.Empty)"
                   HelperText="@(TemplatesDisabledText ?? "Checks of these templates run on top of the ones that apply already. A template for servers or workstations only runs on those.")">
            @foreach (var template in Choices.MonitoringTemplates.Where(t => !LockedTemplates.Contains(t.Id) &&
                                                                          (EndpointClass is not { } cls || EffectivePolicyRules.IsFor(t.AppliesTo, cls))))
            {
                <MudSelectItem T="Guid" Value="@template.Id">@ClassChoiceEditor.Name(template)</MudSelectItem>
            }
        </MudSelect>
        @if (LockedTemplates.Count > 0 || InheritedTemplates.Count > 0)
        {
            <div class="d-flex flex-wrap gap-1 align-center mt-2">
                <MudText Typo="Typo.caption" Class="muted mr-1">Also running:</MudText>
                @foreach (var id in LockedTemplates)
                {
                    <StatusChip Text="@($"{Choices.MonitoringTemplates.FirstOrDefault(t => t.Id == id)?.Name} · client template")" Kind="StatusKind.Neutral" />
                }
                @foreach (var inherited in InheritedTemplates)
                {
                    <StatusChip Text="@($"{inherited.Name} · {From(inherited.Level)}")" Kind="StatusKind.Neutral" />
                }
            </div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public LinkSelection Selection { get; set; } = default!;
    [Parameter, EditorRequired] public LinkChoices Choices { get; set; } = default!;

    /// <summary>The empty choices of the policy: what applies without one here, such as "Inherit: Servers (from site)".</summary>
    [Parameter] public InheritTexts PolicyInherit { get; set; } = InheritTexts.Same("Inherit");

    [Parameter] public InheritTexts PatchInherit { get; set; } = InheritTexts.Same("Inherit");

    /// <summary>The class slots of the policy the client template set: they can be replaced, not emptied.</summary>
    [Parameter] public IReadOnlyCollection<CheckAppliesTo> PolicyLocked { get; set; } = [];

    [Parameter] public IReadOnlyCollection<CheckAppliesTo> PatchLocked { get; set; } = [];

    /// <summary>The class of the endpoint on endpoint level: one choice each, for that class only.</summary>
    [Parameter] public EndpointClass? EndpointClass { get; set; }

    [Parameter] public bool ShowTemplates { get; set; } = true;

    /// <summary>Why monitoring templates cannot be chosen here; null when they can.</summary>
    [Parameter] public string? TemplatesDisabledText { get; set; }

    /// <summary>Monitoring templates the client template linked here: they cannot be removed.</summary>
    [Parameter] public IReadOnlyCollection<Guid> LockedTemplates { get; set; } = [];

    /// <summary>Monitoring templates that apply from a wider level anyway.</summary>
    [Parameter] public IReadOnlyList<InheritedLink> InheritedTemplates { get; set; } = [];

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Called after any choice changed.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private IReadOnlyCollection<Guid> _templates = [];
    private LinkSelection? _loadedFrom;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_loadedFrom, Selection))
        {
            _loadedFrom = Selection;
            _templates = Selection.TemplateIds.Where(id => !LockedTemplates.Contains(id)).ToHashSet();
        }
    }

    /// <summary>The templates chosen here; the ones the client template linked stay in the selection whatever is picked.</summary>
    private IReadOnlyCollection<Guid> Templates => _templates;

    private Task SetTemplatesAsync(IEnumerable<Guid> value)
    {
        _templates = value.ToHashSet();
        Selection.TemplateIds.Clear();
        Selection.TemplateIds.UnionWith(_templates);
        Selection.TemplateIds.UnionWith(LockedTemplates);
        return Changed.InvokeAsync();
    }

    /// <summary>"from client", "from site", or "default" for the default policy.</summary>
    public static string From(LinkLevel level) => level switch
    {
        LinkLevel.Client => "from client",
        LinkLevel.Site => "from site",
        LinkLevel.Endpoint => "from endpoint",
        _ => "default"
    };
}
