@* Edits the recurring maintenance windows of a policy. The list is owned by the parent and changed in place. *@
@using Fleeto.Core.Domain

<MudText Typo="Typo.subtitle2" Class="mt-4">Maintenance windows</MudText>
<MudText Typo="Typo.caption" Class="muted d-block mb-2">
    While a window runs, the endpoints that use this policy open and escalate no alerts, as in maintenance mode.
    Open alerts stay open and still resolve.
</MudText>

@for (var i = 0; i < Windows.Count; i++)
{
    var window = Windows[i];
    var index = i;
    <div class="fl-panel pa-3 mb-2">
        <div class="d-flex align-center gap-2 mb-2">
            <MudTextField @bind-Value="window.Name" Label="Name (optional)" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="100" />
            <MudTooltip Text="Remove this window">
                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Windows.RemoveAt(index))" />
            </MudTooltip>
        </div>
        <div class="d-flex flex-wrap gap-1 mb-2">
            @foreach (var day in Days)
            {
                <MudCheckBox T="bool" Value="@window.Days.HasFlag(day)" ValueChanged="@(v => window.Days = v ? window.Days | day : window.Days & ~day)"
                             Label="@day.ToString()[..3]" Size="Size.Small" Color="Color.Primary" Dense="true" />
            }
        </div>
        <div class="d-flex flex-wrap gap-2">
            <MudTimePicker @bind-Time="window.Start" Label="Starts at" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:130px" />
            <MudNumericField T="int" @bind-Value="window.Hours" Label="Hours" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="168" Style="max-width:100px" />
            <MudNumericField T="int" @bind-Value="window.Minutes" Label="Minutes" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="59" Style="max-width:100px" />
            <MudSelect T="CheckAppliesTo" @bind-Value="window.AppliesTo" Label="Applies to" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:170px">
                <MudSelectItem T="CheckAppliesTo" Value="CheckAppliesTo.All">All endpoints</MudSelectItem>
                <MudSelectItem T="CheckAppliesTo" Value="CheckAppliesTo.Server">Servers</MudSelectItem>
                <MudSelectItem T="CheckAppliesTo" Value="CheckAppliesTo.Workstation">Workstations</MudSelectItem>
            </MudSelect>
        </div>
        <MudAutocomplete T="string" @bind-Value="window.TimeZone" Label="Time zone" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2"
                         SearchFunc="SearchZonesAsync" ToStringFunc="ZoneLabel" MaxItems="50" Strict="true" ResetValueOnEmptyText="false" />
    </div>
}

<MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Add" OnClick="Add">Add maintenance window</MudButton>

@code {
    private static readonly WeekDays[] Days =
        [WeekDays.Monday, WeekDays.Tuesday, WeekDays.Wednesday, WeekDays.Thursday, WeekDays.Friday, WeekDays.Saturday, WeekDays.Sunday];

    [Parameter, EditorRequired]
    public List<WindowModel> Windows { get; set; } = [];

    /// <summary>The time zone a new window starts in (the browser's).</summary>
    [Parameter]
    public string DefaultTimeZone { get; set; } = "UTC";

    /// <summary>Editable state of one window.</summary>
    public sealed class WindowModel
    {
        public string? Name { get; set; }
        public WeekDays Days { get; set; } = WeekDays.Sunday;
        public TimeSpan? Start { get; set; } = new(2, 0, 0);
        public int Hours { get; set; } = 4;
        public int Minutes { get; set; }
        public string? TimeZone { get; set; }
        public CheckAppliesTo AppliesTo { get; set; } = CheckAppliesTo.All;

        public static WindowModel From(MaintenanceWindow window) => new()
        {
            Name = window.Name,
            Days = window.Days,
            Start = MaintenanceWindows.TryParseStart(window.Start, out var start) ? start.ToTimeSpan() : null,
            Hours = window.DurationMinutes / 60,
            Minutes = window.DurationMinutes % 60,
            TimeZone = window.TimeZone,
            AppliesTo = window.AppliesTo
        };

        public MaintenanceWindow ToWindow() => new(Name, Days,
            Start is { } start ? $"{start.Hours:00}:{start.Minutes:00}" : string.Empty, Hours * 60 + Minutes, TimeZone ?? string.Empty, AppliesTo);
    }

    private void Add() => Windows.Add(new WindowModel { TimeZone = DefaultTimeZone });

    private static string ZoneLabel(string? id) => TimeZoneOptions.All.FirstOrDefault(z => z.Id == id)?.Label ?? id ?? string.Empty;

    private static Task<IEnumerable<string>> SearchZonesAsync(string? text, CancellationToken cancellationToken)
    {
        var term = text?.Trim();
        var matches = TimeZoneOptions.All
            .Where(z => string.IsNullOrEmpty(term) || z.Label.Contains(term, StringComparison.OrdinalIgnoreCase))
            .Select(z => z.Id);
        return Task.FromResult(matches);
    }
}
