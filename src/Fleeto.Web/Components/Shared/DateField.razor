@using System.Globalization
@* The one date field of Fleeto (0.6.0): the browser's own calendar, like DateTimeField without the time. *@
<MudTextField T="string" Value="@Text" ValueChanged="OnChangedAsync" InputType="InputType.Date" Label="@Label" Variant="Variant.Outlined"
              Margin="Margin" Class="@Class" Style="@Style" HelperText="@HelperText" Disabled="Disabled" ShrinkLabel="true"
              Clearable="Clearable" UserAttributes="@Attributes" />

@code {
    private const string Format = "yyyy-MM-dd";

    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public DateTime? Min { get; set; }
    [Parameter] public DateTime? Max { get; set; }
    [Parameter] public Margin Margin { get; set; } = Margin.None;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; } = "max-width:200px";
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Clearable { get; set; }

    private string? Text => Value?.ToString(Format, CultureInfo.InvariantCulture);

    private Dictionary<string, object?> Attributes => PickerAttributes.Range(Min?.ToString(Format, CultureInfo.InvariantCulture),
        Max?.ToString(Format, CultureInfo.InvariantCulture));

    private Task OnChangedAsync(string? text) =>
        ValueChanged.InvokeAsync(DateTime.TryParseExact(text, Format, CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed)
            ? DateTime.SpecifyKind(parsed.Date, DateTimeKind.Unspecified)
            : null);
}
