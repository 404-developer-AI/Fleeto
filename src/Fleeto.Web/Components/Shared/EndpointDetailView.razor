    /// <summary>
    /// Starts a deployment on this endpoint: every missing update, or the ones chosen in the list. What is deployed is
    /// decided by the service again; this only asks and then shows what the product reports.
    /// </summary>
    private async Task DeployAsync(IReadOnlyList<MissingUpdateView>? chosen)
    {
        if (_endpoint is not { } endpoint)
        {
            return;
        }

        var updateIds = chosen?.Select(u => u.Id).ToList();
        var parameters = new DialogParameters<DeployUpdatesDialog>
        {
            { d => d.EndpointIds, new[] { endpoint.Id } },
            { d => d.TargetLabel, endpoint.Hostname },
            { d => d.UpdateNames, chosen?.Select(u => u.Version.Length == 0 ? u.Name : $"{u.Name} {u.Version}").ToList() ?? [] },
            { d => d.OnSubmit, async (bool autoReboot) =>
                {
                    var started = await RunForValueAsync(caller => PatchSvc.StartDeploymentAsync(caller, [endpoint.Id], updateIds, autoReboot), null);
                    if (started?.Value is not { } run)
                    {
                        return false;
                    }

                    _chosenUpdates = [];
                    await ShowDeploymentAsync(run);
                    return true;
                } }
        };
        var dialog = await DialogService.ShowAsync<DeployUpdatesDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        await dialog.Result;
    }

    /// <summary>
    /// Puts the Action1 agent on this endpoint as a signed job, so patch management can cover it. The signer writes what
    /// runs; this only asks for it and shows where the result appears.
    /// </summary>
    private async Task InstallAction1AgentAsync()
    {
        if (_endpoint is not { } endpoint || _installingAgent)
        {
            return;
        }

        var parameters = new DialogParameters<ConfirmDialog>
        {
            { d => d.Title, $"Install the Action1 agent on {endpoint.Hostname}" },
            {
                d => d.Message,
                "Fleeto sends a signed job that downloads the Action1 agent of this client's organization and installs it silently, without a restart. " +
                "The endpoint keeps its Fleeto agent; the Action1 agent runs next to it. Its patch state appears after the endpoint has reported its next inventory."
            },
            { d => d.ConfirmText, "Install agent" }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if ((await dialog.Result)!.Canceled)
        {
            return;
        }

        _installingAgent = true;
        try
        {
            if (await RunAsync(caller => PatchSvc.InstallAgentAsync(caller, endpoint.Id),
                    "The installation was started. Its result appears on the Jobs tab."))
            {
                await RefreshAsync();
            }
        }
        finally
        {
            _installingAgent = false;
        }
    }

    private async Task SyncPatchesAsync()
    {
        if (_endpoint is null || _requestingSync)
        {
            return;
        }

        _requestingSync = true;
        try
        {
            await RunAsync(caller => PatchSvc.RequestSyncAsync(caller, EndpointId), null);
            await RefreshAsync();
        }
        finally
        {
            _requestingSync = false;
        }
    }

    /// <summary>
    /// Removes the Action1 agent from this endpoint (0.6.0): through Action1 when it reports the endpoint, which also drops
    /// it from the Action1 console, otherwise with a signed job.
    /// </summary>
    private async Task RemoveAction1AgentAsync(bool throughAction1)
    {
        if (_endpoint is not { } endpoint || _removingAgent)
        {
            return;
        }

        var parameters = new DialogParameters<ConfirmDialog>
        {
            { d => d.Title, $"Remove the Action1 agent from {endpoint.Hostname}" },
            {
                d => d.Message,
                throughAction1
                    ? "Fleeto asks Action1 to remove this endpoint from its organization. Action1 then uninstalls its agent from the endpoint and stops patching it, " +
                      "and the patch state and scheduled deployments of this endpoint stop in Fleeto. The Fleeto agent stays. Install the Action1 agent again to undo it."
                    : "Fleeto sends a signed job that uninstalls the Action1 agent silently, without a restart. The Fleeto agent stays."
            },
            { d => d.ConfirmText, "Remove agent" },
            { d => d.ConfirmColor, Color.Error }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if ((await dialog.Result)!.Canceled)
        {
            return;
        }

        _removingAgent = true;
        try
        {
            var removed = await RunForValueAsync(caller => PatchSvc.RemoveAgentAsync(caller, endpoint.Id), null);
            if (removed is { Success: true, Value: var viaAction1 })
            {
                Snackbar.Add(viaAction1
                    ? "Fleeto asks Action1 to remove the agent. The outcome appears on this tab."
                    : "The removal was started. Its result appears on the Jobs tab.", MudBlazor.Severity.Success);
                await RefreshAsync();
            }
        }
        finally
        {
            _removingAgent = false;
        }
    }

    /// <summary>What Action1 logged for this endpoint in one deployment (0.6.0).</summary>
    private async Task ShowHistoryAsync(Guid deploymentId)
    {
        var parameters = new DialogParameters<DeploymentHistoryDialog>
        {
            { d => d.DeploymentId, deploymentId },
            { d => d.EndpointId, EndpointId }
        };
        await DialogService.ShowAsync<DeploymentHistoryDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
    }

    private async Task ShowDeploymentAsync(DeploymentStartResult run)
    {
        var parameters = new DialogParameters<PatchDeploymentDialog>
        {
            { d => d.BatchId, run.BatchId },
            { d => d.Skipped, run.Skipped }
        };
        var dialog = await DialogService.ShowAsync<PatchDeploymentDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        await dialog.Result;
        await RefreshAsync();
    }

    private RenderFragment NoInventory() => __builder =>
    {
        <EmptyState Icon="@Icons.Material.Outlined.Inventory2" Title="No inventory yet"
                    Text="The agent reports inventory shortly after it connects, and again on the interval of the policy." />
    };

    // ---------------------------------------------------------------------------------------------------------------
    // Storage (0.6.0)
    // ---------------------------------------------------------------------------------------------------------------

    private RenderFragment Storage() => __builder =>
    {
        var storage = _storage;
        if (storage is null)
        {
            <EmptyState Icon="@Icons.Material.Outlined.Storage" Title="Loading" Text="Reading the storage scans of this endpoint." />
        }
        else if (!storage.Managed)
        {
            <EmptyState Icon="@Icons.Material.Outlined.Storage" Title="Storage analysis needs a managed endpoint"
                        Text="Switch this endpoint to managed to see which folders and files use its drives." />
        }
        else if (storage.Volumes.Count == 0)
        {
            @if (!storage.AgentSupports)
            {
                <EmptyState Icon="@Icons.Material.Outlined.Storage" Title="The agent cannot scan storage yet"
                            Text="@($"Storage analysis needs agent {StorageRules.MinimumAgentVersion} or newer. The agent updates on its own, following the update ring of its policy.")" />
            }
            else
            {
                <EmptyState Icon="@Icons.Material.Outlined.Storage" Title="No storage scan yet" Text="@NoScanText(storage)" />
                @if (storage.CanScan && storage.RequestedAt is null)
                {
                    <div class="d-flex justify-center">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Refresh" Disabled="_storageScanning"
                                   OnClick="RequestStorageScanAsync">Scan now</MudButton>
                    </div>
                }
            }
        }
        else
        {
            <div class="d-flex gap-2 flex-wrap align-center mb-3">
                @foreach (var volume in storage.Volumes)
                {
                    var selected = storage.Selected?.Summary.Volume == volume.Volume;
                    var used = volume.TotalBytes - volume.FreeBytes;
                    <MudButton Variant="@(selected ? Variant.Filled : Variant.Outlined)" Color="@(selected ? Color.Primary : Color.Default)" Size="Size.Small"
                               StartIcon="@Icons.Material.Outlined.Storage" OnClick="@(() => SelectStorageVolumeAsync(volume.Volume))">
                        @volume.Volume · @Ui.Bytes(used) of @Ui.Bytes(volume.TotalBytes) used
                    </MudButton>
                }
                <MudSpacer />
                @if (storage.Selected is { } shown)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small" Disabled="_storageExporting"
                               title="Copy the drive and its 10 largest folders and files as an image, for a mail or a ticket"
                               OnClick="@(() => CopyStorageImageAsync(shown.Summary.Volume))">Copy summary</MudButton>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.PictureAsPdf" Size="Size.Small" Disabled="_storageExporting"
                               title="Download a PDF report with every scanned folder and file of this drive"
                               OnClick="@(() => ExportStoragePdfAsync(shown.Summary.Volume))">Export PDF</MudButton>
                }
                @if (storage.CanScan)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Refresh" Size="Size.Small"
                               Disabled="@(_storageScanning || storage.RequestedAt is not null)" OnClick="RequestStorageScanAsync">Scan now</MudButton>
                }
            </div>

            @if (storage.RequestedAt is { } requestedAt)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    A scan was asked for <TimeText Value="requestedAt" />. The result appears here when the agent finishes.
                </MudAlert>
            }

            @if (storage.Selected is { } detail)
            {
                var summary = detail.Summary;
                <MudText Typo="Typo.body2" Class="muted mb-2">
                    Scanned <TimeText Value="summary.ScannedAt" /> in @StorageDuration(summary.DurationMs)
                    · @(summary.Method == StorageScanMethod.Mft ? "master file table" : "folder walk")
                    · @summary.FileCount.ToString("N0", CultureInfo.InvariantCulture) files
                    · @summary.FolderCount.ToString("N0", CultureInfo.InvariantCulture) folders
                    @if (!string.IsNullOrEmpty(summary.Filesystem))
                    {
                        <span> · @summary.Filesystem</span>
                    }
                </MudText>
                @if (!summary.Complete)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                        This scan is incomplete@(string.IsNullOrEmpty(summary.Error) ? "" : $": {summary.Error}"). Sizes are at least the values shown.
                    </MudAlert>
                }
                else if (!string.IsNullOrEmpty(summary.Error))
                {
                    <MudText Typo="Typo.caption" Class="muted d-block mb-2">@summary.Error</MudText>
                }

                @StorageFolders(detail)
                @StorageFiles(detail)
            }
        }
    };

    private static string NoScanText(EndpointStorageView storage) =>
        storage.RequestedAt is not null
            ? "A scan was asked for. The result appears here when the agent finishes."
            : storage.ScanIntervalHours == 0
                ? "The policy of this endpoint schedules no scans. Start one with Scan now."
                : $"The agent scans its drives at low priority, {Ui.StorageScanInterval(storage.ScanIntervalHours).ToLowerInvariant()}. The first scan starts within an hour of the agent getting this setting.";

    private static string StorageDuration(int milliseconds) => milliseconds switch
    {
        < 1000 => $"{milliseconds} ms",
        < 60_000 => $"{(milliseconds / 1000d).ToString("0.#", CultureInfo.InvariantCulture)} seconds",
        _ => $"{(milliseconds / 60_000d).ToString("0.#", CultureInfo.InvariantCulture)} minutes"
    };

    private RenderFragment StorageFolders(StorageVolumeDetail detail) => __builder =>
    {
        var total = Math.Max(1, detail.Summary.TotalBytes);
        var visible = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        <MudText Typo="Typo.h6" Class="section-title mb-2">Largest folders</MudText>
        <MudSimpleTable Dense="true" Elevation="0" Hover="true" Class="detail-table storage-table mb-5">
            <thead>
                <tr>
                    <th>Folder</th>
                    <th class="text-right">Size on disk</th>
                    <th style="width:140px">Of the drive</th>
                    <th class="text-right">Files</th>
                    <th class="text-right" title="@CompareTitle(detail.PreviousAt, "No earlier scan")">Since previous</th>
                    <th class="text-right" title="@CompareTitle(detail.WeekAt, "No scan a week old yet")">7 days</th>
                    <th class="text-right" title="@CompareTitle(detail.MonthAt, "No scan a month old yet")">30 days</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in detail.Folders)
                {
                    if (row.ParentPath is not null && !(visible.Contains(row.ParentPath) && _storageExpanded.Contains(row.ParentPath)))
                    {
                        continue;
                    }

                    visible.Add(row.Path);
                    var share = row.SizeBytes * 100d / total;
                    var expanded = _storageExpanded.Contains(row.Path);
                    <tr>
                        <td title="@row.Path">
                            <div class="d-flex align-center" style="@($"padding-left:{row.Depth * 18}px")">
                                @if (row.HasChildren)
                                {
                                    <MudIconButton Icon="@(expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                                                   Size="Size.Small" OnClick="@(() => ToggleStorageFolder(row.Path))"
                                                   aria-label="@(expanded ? "Collapse" : "Expand")" />
                                }
                                else
                                {
                                    <span class="storage-indent"></span>
                                }
                                <MudIcon Icon="@Icons.Material.Outlined.Folder" Size="Size.Small" Class="mr-1 muted" />
                                <span class="storage-name">@row.Name</span>
                            </div>
                        </td>
                        <td class="text-right">@Ui.Bytes(row.SizeBytes)</td>
                        <td>
                            <div class="storage-bar" title="@($"{share.ToString("0.#", CultureInfo.InvariantCulture)}% of {Ui.Bytes(detail.Summary.TotalBytes)}")">
                                <div class="storage-bar-fill" style="@($"width:{Math.Clamp(share, 0, 100).ToString("0.##", CultureInfo.InvariantCulture)}%")"></div>
                            </div>
                        </td>
                        <td class="text-right">@row.FileCount.ToString("N0", CultureInfo.InvariantCulture)</td>
                        <td class="text-right">@StorageChange(row.ChangeSincePrevious)</td>
                        <td class="text-right">@StorageChange(row.ChangeWeek)</td>
                        <td class="text-right">@StorageChange(row.ChangeMonth)</td>
                        <td class="text-right">
                            <MudIconButton Icon="@Icons.Material.Outlined.ShowChart" Size="Size.Small" title="History of this folder"
                                           aria-label="History of this folder" OnClick="@(() => ShowStorageHistoryAsync(detail.Summary.Volume, row.Path))" />
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    };

    private string CompareTitle(DateTime? at, string none) => at is { } time ? $"Compared with the scan of {Time.Short(time)}" : none;

    private RenderFragment StorageFiles(StorageVolumeDetail detail) => __builder =>
    {
        <MudText Typo="Typo.h6" Class="section-title mb-2">Largest files</MudText>
        @if (detail.Files.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="muted">The scan listed no files.</MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" Elevation="0" Hover="true" Class="detail-table storage-table">
                <thead>
                    <tr>
                        <th>File</th>
                        <th class="text-right">Size on disk</th>
                        <th>Changed</th>
                    </tr>
                </thead>
