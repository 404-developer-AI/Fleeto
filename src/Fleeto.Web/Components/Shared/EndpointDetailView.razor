@* Endpoint detail: header and the tabs Summary, Checks, Software, Notes, Jobs, Tasks, Patches, Vulnerabilities (Linux), Storage and History. Used below
   the endpoint list in the
   clients workspace (Embedded) and on the full endpoint page. Only data of the visible tab is loaded. *@
@inherits FleetoPageBase
@inject EndpointService EndpointSvc
@inject EndpointCheckService CheckSvc
@inject NoteService NoteSvc
@inject JobService JobSvc
@inject PatchService PatchSvc
@inject ScriptService ScriptSvc
@inject StorageService StorageSvc
@inject VulnerabilityService VulnerabilitySvc
@inject TaskService TaskSvc
@inject MaintenanceService MaintenanceSvc
@using System.Globalization
@inject IDialogService DialogService
@inject TimeProvider Clock
@inject LiveUpdates Live
@inject IJSRuntime JS

<LoadState Loading="Loading" Failed="LoadFailed" NotFound="_notFound" What="endpoint">
    @if (_endpoint is { } e)
    {
        <div class="endpoint-detail @(Embedded ? "embedded" : "")">
            <div class="endpoint-detail-header">
                <div class="endpoint-icon">
                    <MudIcon Icon="@((e.ClassOverride ?? e.DetectedClass) == EndpointClass.Server ? Icons.Material.Outlined.Dns : Icons.Material.Outlined.Computer)" />
                </div>
                <div class="endpoint-detail-heading">
                    <div class="d-flex align-center gap-2 flex-wrap">
                        <span class="endpoint-detail-title">@e.Hostname</span>
                        <StatusChip Text="@(e.IsOnline ? "Online" : "Offline")" Kind="@(e.IsOnline ? StatusKind.Ok : StatusKind.Error)" Dot="true" />
                        <StatusChip Text="@Ui.TierLabel(e.Tier)" Kind="@Ui.TierKind(e.Tier)" />
                        @if (e.OpenAlertCount > 0)
                        {
                            <StatusChip Text="@AlertCountText(e.OpenAlertCount)" Kind="StatusKind.Active" />
                        }
                        @if (e.HeldAlertCount > 0)
                        {
                            <StatusChip Text="@($"{e.HeldAlertCount} on hold")" Kind="StatusKind.Neutral" />
                        }
                        <MaintenanceChip Maintenance="e.Maintenance" SourceName="@MaintenanceSourceName(e)" />
                    </div>
                    <div class="muted endpoint-detail-subtitle">
                        @e.OsName · @Ui.ClassLabel(e.ClassOverride ?? e.DetectedClass) · [@e.ClientCode] @e.ClientName › @e.SiteName
                    </div>
                </div>
                <div class="endpoint-detail-actions">
                    @* Remote control and remote background open from the right-click menu of the endpoint list only (0.6.0). *@
                    <MudTooltip Text="@(e.IsOnline ? "Refresh: reload this endpoint and ask the agent for a fresh inventory" : "Refresh")">
                        <MudIconButton Icon="@Icons.Material.Outlined.Refresh" Variant="Variant.Outlined" Disabled="_refreshing" OnClick="RefreshNowAsync"
                                       aria-label="Refresh" />
                    </MudTooltip>
                    @if (Embedded)
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.OpenInNew" Href="@($"/endpoints/{e.Id}")">Open page</MudButton>
                    }
                </div>
            </div>

            @* A tab shows only with its permission (0.6.0); the services refuse its data without it anyway. *@
            <MudTabs Elevation="0" Class="fl-tabs endpoint-tabs" MinimumTabWidth="0" ActivePanelIndex="@VisibleTabs.IndexOf(_tab)"
                     ActivePanelIndexChanged="OnTabChangedAsync">
                <MudTabPanel Text="Summary" Icon="@Icons.Material.Outlined.Info">
                    @Summary(e)
                </MudTabPanel>
                @if (VisibleTabs.Contains(ChecksTab))
                {
                    <MudTabPanel Text="Checks" Icon="@Icons.Material.Outlined.Rule">
                        @Checks(e)
                    </MudTabPanel>
                }
                @if (VisibleTabs.Contains(SoftwareTab))
                {
                    <MudTabPanel Text="Software" Icon="@Icons.Material.Outlined.Apps">
                        @Software()
                    </MudTabPanel>
                }
                @if (VisibleTabs.Contains(NotesTab))
                {
                    <MudTabPanel Text="Notes" Icon="@Icons.Material.Outlined.StickyNote2">
                        @Notes(e)
                    </MudTabPanel>
                }
                @if (VisibleTabs.Contains(JobsTab))
                {
                    <MudTabPanel Text="Jobs" Icon="@Icons.Material.Outlined.Terminal">
                        @Jobs(e)
                    </MudTabPanel>
                }
                @if (VisibleTabs.Contains(TasksTab))
                {
                    <MudTabPanel Text="Tasks" Icon="@Icons.Material.Outlined.EventRepeat">
                        @Tasks(e)
                    </MudTabPanel>
                }
                @if (VisibleTabs.Contains(PatchesTab))
                {
                    <MudTabPanel Text="Patches" Icon="@Icons.Material.Outlined.Security">
                        @Patches()
                    </MudTabPanel>
                }
                @if (VisibleTabs.Contains(VulnerabilitiesTab))
                {
                    <MudTabPanel Text="Vulnerabilities" Icon="@Icons.Material.Outlined.GppMaybe">
                        @VulnerabilitiesContent()
                    </MudTabPanel>
                }
                @if (VisibleTabs.Contains(StorageTab))
                {
                    <MudTabPanel Text="Storage" Icon="@Icons.Material.Outlined.Storage">
                        @Storage()
                    </MudTabPanel>
                }
                @if (VisibleTabs.Contains(HistoryTab))
                {
                    <MudTabPanel Text="History" Icon="@Icons.Material.Outlined.History">
                        @History()
                    </MudTabPanel>
                }
            </MudTabs>
        </div>
    }
</LoadState>

@code {
    private static EndpointComponentView? Component(EndpointDetail endpoint, AgentComponent component) =>
        endpoint.Components?.FirstOrDefault(c => c.Component == component);

    private const int SummaryTab = 0;
    private const int ChecksTab = 1;
    private const int SoftwareTab = 2;
    private const int NotesTab = 3;
    private const int JobsTab = 4;
    private const int PatchesTab = 5;
    private const int StorageTab = 6;
    private const int HistoryTab = 7;
    private const int TasksTab = 8;
    private const int VulnerabilitiesTab = 9;

    /// <summary>The tabs the roles of the user allow, in order (0.6.0); the summary always.</summary>
    private List<int> VisibleTabs
    {
        get
        {
            List<int> tabs = [SummaryTab];
            AddIf(ChecksTab, Permissions.ChecksView);
            AddIf(SoftwareTab, Permissions.SoftwareView);
            AddIf(NotesTab, Permissions.NotesView);
            AddIf(JobsTab, Permissions.JobsView);
            AddIf(TasksTab, Permissions.TasksView);
            AddIf(PatchesTab, Permissions.PatchesView);
            // Linux only (0.8.0): Patches covers Windows.
            if (_endpoint?.OsPlatform == "linux")
            {
                AddIf(VulnerabilitiesTab, Permissions.VulnerabilitiesView);
            }

            AddIf(StorageTab, Permissions.StorageView);
            AddIf(HistoryTab, Permissions.HistoryView);
            return tabs;

            void AddIf(int tab, string permission)
            {
                if (Can(permission))
                {
                    tabs.Add(tab);
                }
            }
        }
    }

    /// <summary>The roles of the user allow at least one action on a check (0.6.0).</summary>
    private bool HasCheckMenu => Can(Permissions.ChecksRun) || Can(Permissions.ChecksEdit) || AlertActions.AnyAction(Caller);

    [Parameter, EditorRequired]
    public Guid EndpointId { get; set; }

    /// <summary>True below the endpoint list: shows an "Open page" button and uses a compact layout.</summary>
    [Parameter]
    public bool Embedded { get; set; }

    /// <summary>Raised after something on the endpoint changed here (alerts, checks), so the owner can refresh its list.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private Guid _loadedId;
    private EndpointDetail? _endpoint;
    private bool _notFound;
    private int _tab = SummaryTab;
    private InventoryView? _inventory;
    private EndpointChecksView? _checks;
    private NotePage? _notes;
    private List<NoteView> _noteItems = [];
    private IReadOnlyList<JobListItem>? _jobs;
    private EndpointTasksView? _tasks;
    private EndpointPatchView? _patches;
    private IReadOnlyList<DeploymentView> _deployments = [];
    private HashSet<MissingUpdateView> _chosenUpdates = [];
    private bool _installingAgent;
    private bool _removingAgent;
    private bool _requestingSync;
    private IReadOnlyList<AlertView> _alerts = [];
    private IReadOnlyList<EndpointEventView> _events = [];
    private IReadOnlyList<AuditEntryView> _audit = [];
    private IReadOnlyDictionary<Guid, IReadOnlyList<AlertActivityView>> _alertActivities = new Dictionary<Guid, IReadOnlyList<AlertActivityView>>();
    private IReadOnlyList<MaintenanceRecordView> _maintenance = [];
    private IReadOnlyList<VulnerabilityHistoryRow> _vulnerabilityHistory = [];
    private string? _vulnerabilityHistorySearch;
    private string? _softwareSearch;
    private string? _alertSearch;
    private string? _eventSearch;
    private string? _auditSearch;
    private string? _maintenanceSearch;
    private EndpointStorageView? _storage;
    private EndpointVulnerabilityView? _vulnerabilities;
    private string? _vulnerabilitySearch;
    private readonly HashSet<string> _vulnerabilityExpanded = new(StringComparer.Ordinal);
    private string? _storageVolume;
    private readonly HashSet<string> _storageExpanded = new(StringComparer.OrdinalIgnoreCase);
    private bool _storageScanning;
    private bool _storageExporting;
    private DebouncedRefresh? _refresh;
    private bool _refreshing;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _refresh = new DebouncedRefresh(() => InvokeAsync(async () => { await ReloadAsync(); StateHasChanged(); }));
        Live.EndpointStatusChanged += OnEndpointChange;
        Live.CheckResultsChanged += OnEndpointChange;
        Live.AlertChanged += OnAlertChange;
        Live.JobsChanged += OnJobsChange;
        Live.TasksChanged += OnTasksChange;
        Live.PatchDeploymentsChanged += OnDeploymentChange;
        Live.StorageScansChanged += OnStorageChange;
        Live.PatchRequestsChanged += OnDeploymentChange;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (EndpointId == _loadedId)
        {
            return;
        }

        _loadedId = EndpointId;
        _softwareSearch = null;
        _alertSearch = null;
        _eventSearch = null;
        _auditSearch = null;
        _maintenanceSearch = null;
        _vulnerabilityHistorySearch = null;
        _inventory = null;
        _storage = null;
        _storageVolume = null;
        _vulnerabilities = null;
        _vulnerabilitySearch = null;
        _vulnerabilityExpanded.Clear();
        _storageExpanded.Clear();
        Loading = _endpoint is null;
        await ReloadAsync();
    }

    /// <summary>
    /// The Refresh button (0.6.0): asks a live agent for a fresh inventory, which the page shows when it arrives (the gateway
    /// publishes the endpoint status), and reloads what is stored now.
    /// </summary>
    private async Task RefreshNowAsync()
    {
        _refreshing = true;
        try
        {
            var asked = false;
            await RunAsync(async caller =>
            {
                var result = await EndpointSvc.RequestInventoryAsync(caller, EndpointId);
                asked = result is { Success: true, Value: true };
                return result;
            }, null);
            await ReloadAsync();
            if (asked)
            {
                Snackbar.Add("Asked the agent for a fresh inventory. The page updates when it arrives.", MudBlazor.Severity.Info);
            }
        }
        finally
        {
            _refreshing = false;
        }
    }

    /// <summary>Reloads the endpoint after its owner changed it (the endpoint menu of the clients workspace).</summary>
    public async Task RefreshAsync()
    {
        await ReloadAsync();
        StateHasChanged();
    }

    private async Task ReloadAsync()
    {
        await LoadAsync(async caller =>
        {
            var endpoint = await EndpointSvc.GetAsync(caller, EndpointId);
            _endpoint = endpoint;
            _notFound = endpoint is null;
            if (endpoint is not null)
            {
                await LoadTabAsync(caller);
            }
        });
    }

    private async Task LoadTabAsync(Caller caller)
    {
        if (!VisibleTabs.Contains(_tab))
        {
            _tab = SummaryTab;
        }

        switch (_tab)
        {
            case SummaryTab:
            case SoftwareTab:
                _inventory = await EndpointSvc.GetInventoryAsync(caller, EndpointId);
                break;
            case ChecksTab:
                _checks = await CheckSvc.GetChecksAsync(caller, EndpointId);
                break;
            case NotesTab:
                _notes = await NoteSvc.ListAsync(caller, EndpointId);
                _noteItems = _notes?.Items.ToList() ?? [];
                break;
            case JobsTab:
                _jobs = await JobSvc.ListForEndpointAsync(caller, EndpointId);
                break;
            case TasksTab:
                _tasks = await TaskSvc.GetForEndpointAsync(caller, EndpointId);
                break;
            case PatchesTab:
                _patches = await PatchSvc.GetAsync(caller, EndpointId);
                _deployments = await PatchSvc.ListDeploymentsAsync(caller, EndpointId);
                // An update that is no longer missing cannot stay chosen, or a deployment would name something that is gone.
                _chosenUpdates = [.. _chosenUpdates.Where(u => _patches?.Missing.Any(m => m.Id == u.Id) == true)];
                break;
            case VulnerabilitiesTab:
                _vulnerabilities = await VulnerabilitySvc.GetEndpointAsync(caller, EndpointId);
                break;
            case StorageTab:
                _storage = await StorageSvc.GetAsync(caller, EndpointId, _storageVolume);
                if (_storage?.Selected is { } selected && _storageExpanded.Count == 0 && selected.Folders.Count > 0)
                {
                    // A drive opens with its first level of folders visible.
                    _storageExpanded.Add(selected.Folders[0].Path);
                }

                break;
            case HistoryTab:
                await LoadHistoryAsync(caller, HistorySection.All);
                break;
        }
    }

    private async Task OnTabChangedAsync(int index)
    {
        var tabs = VisibleTabs;
        _tab = index >= 0 && index < tabs.Count ? tabs[index] : SummaryTab;
        await LoadAsync(LoadTabAsync);
    }

    private void OnEndpointChange(Guid id)
    {
        if (id == EndpointId || id == Guid.Empty)
        {
            _refresh?.Trigger();
        }
    }

    private void OnStorageChange(Guid id)
    {
        if (_tab == StorageTab && (id == EndpointId || id == Guid.Empty))
        {
            _refresh?.Trigger();
        }
    }

    // Alert notifications carry the alert id, not the endpoint id.
    private void OnAlertChange(Guid _) => _refresh?.Trigger();

    private void OnJobsChange(Guid id)
    {
        if (_tab is JobsTab or TasksTab && (id == EndpointId || id == Guid.Empty))
        {
            _refresh?.Trigger();
        }
    }

    // The payload is a task id; a change to any task can change what applies to this endpoint.
    private void OnTasksChange(Guid _)
    {
        if (_tab == TasksTab)
        {
            _refresh?.Trigger();
        }
    }

    // The payload is a deployment or patch request id, so the tab reloads its own patch state rather than matching on an endpoint id.
    private void OnDeploymentChange(Guid _)
    {
        if (_tab == PatchesTab)
        {
            _refresh?.Trigger();
        }
    }

    private static string MaintenanceSourceName(EndpointDetail e) => e.Maintenance?.Source switch
    {
        MaintenanceSource.Client => e.ClientCode,
        MaintenanceSource.Site => e.SiteName,
        _ => e.Hostname
    };

    private static string AlertCountText(int count) => count == 1 ? "1 open alert" : $"{count} open alerts";

    private RenderFragment Summary(EndpointDetail e) => __builder =>
    {
        var inv = _inventory;
        <div class="summary-container">
        <div class="summary-grid">
            <div>
                <div class="d-flex flex-column gap-3">
                    <div class="fl-panel pa-4">
                        <MudText Typo="Typo.h6" Class="section-title mb-2">Status</MudText>
                        <MudSimpleTable Dense="true" Elevation="0" Class="detail-table">
                            <tbody>
                                <tr><td class="muted">Connection</td><td>@(e.IsOnline ? "Online" : "Offline") · last seen <TimeText Value="e.LastSeenAt" /></td></tr>
                                @if (e.Maintenance is { } maintenance)
                                {
                                    <tr>
                                        <td class="muted">Maintenance</td>
                                        <td>
                                            @(maintenance.EndsAt is null ? "Until turned off" : $"Until {Time.Absolute(maintenance.EndsAt)}")
                                            @if (maintenance.Source == MaintenanceSource.PolicyWindow)
                                            {
                                                <span> · maintenance window of policy @maintenance.SourceName</span>
                                            }
                                            else if (maintenance.Source != MaintenanceSource.Endpoint)
                                            {
                                                <span> · through @maintenance.Source.ToString().ToLowerInvariant() @MaintenanceSourceName(e)</span>
                                            }
                                            <div class="muted" style="font-size:0.75rem">
                                                Started <TimeText Value="maintenance.StartedAt" />@(string.IsNullOrEmpty(maintenance.StartedByName) ? "" : $" by {maintenance.StartedByName}")@(string.IsNullOrEmpty(maintenance.Reason) ? "" : $" · {maintenance.Reason}")
                                            </div>
                                        </td>
                                    </tr>
                                }
                                <tr><td class="muted">Operating system</td><td>@e.OsName @e.OsVersion (@e.Architecture)</td></tr>
                                <tr>
                                    <td class="muted">Agent version</td>
                                    <td>
                                        @e.AgentVersion
                                        @if (SemanticVersion.IsOlder(e.AgentVersion, e.ReleaseVersion ?? FleetoVersion.Current))
                                        {
                                            <span class="ml-1"><StatusChip Text="Out of date" Kind="StatusKind.Warning" /></span>
                                        }
                                        @if (Component(e, AgentComponent.Agent) is { UpdateState: { } agentUpdate } agentState)
                                        {
                                            <div class="muted" style="font-size:0.75rem">
                                                @Ui.UpdateStateLabel(agentUpdate) @agentState.UpdateVersion <TimeText Value="agentState.UpdateAt" />@(string.IsNullOrEmpty(agentState.UpdateDetail) ? "" : $" · {agentState.UpdateDetail}")
                                            </div>
                                        }
                                        @if (Component(e, AgentComponent.Agent) is { } agentWaitState && Ui.UpdateWaitText(agentWaitState, e.AgentVersion, e, Clock.GetUtcNow().UtcDateTime, Time.Absolute) is { } agentWait)
                                        {
                                            <div class="muted" style="font-size:0.75rem">@agentWait</div>
                                        }
                                        @if (!e.IsOnline && Component(e, AgentComponent.Agent) is { ServiceState: not ComponentServiceState.Unknown } agentService)
                                        {
                                            <div class="muted" style="font-size:0.75rem">
                                                The watchdog reports the agent service as @Ui.ServiceStateLabel(agentService.ServiceState).ToLowerInvariant()@(string.IsNullOrEmpty(agentService.ServiceDetail) ? "" : $": {agentService.ServiceDetail}")
                                            </div>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <td class="muted">Watchdog</td>
                                    <td>
                                        @{ var watchdogWait = Component(e, AgentComponent.Watchdog) is { } waitState ? Ui.UpdateWaitText(waitState, e.WatchdogVersion, e, Clock.GetUtcNow().UtcDateTime, Time.Absolute) : null; }
                                        @if (string.IsNullOrEmpty(e.WatchdogVersion))
                                        {
                                            <span class="muted">@(watchdogWait is null ? "Not installed yet: the agent installs it with the next release offer" : "Not installed yet")</span>
                                        }
                                        else
                                        {
                                            @e.WatchdogVersion
                                            <span class="ml-1"><StatusChip Text="@(e.WatchdogOnline ? "Online" : "Offline")" Kind="@(e.WatchdogOnline ? StatusKind.Ok : StatusKind.Neutral)" /></span>
                                            @if (!e.WatchdogOnline && e.WatchdogLastSeenAt is { } watchdogSeen)
                                            {
                                                <span class="muted ml-1" style="font-size:0.75rem">last seen <TimeText Value="watchdogSeen" /></span>
                                            }
                                        }
                                        @if (Component(e, AgentComponent.Watchdog) is { } watchdogState)
                                        {
                                            @if (!e.WatchdogOnline && watchdogState.ServiceState != ComponentServiceState.Unknown)
                                            {
                                                <div class="muted" style="font-size:0.75rem">
                                                    The agent reports the watchdog service as @Ui.ServiceStateLabel(watchdogState.ServiceState).ToLowerInvariant()@(string.IsNullOrEmpty(watchdogState.ServiceDetail) ? "" : $": {watchdogState.ServiceDetail}")
                                                </div>
                                            }
                                            @if (watchdogState.UpdateState is { } watchdogUpdate)
                                            {
                                                <div class="muted" style="font-size:0.75rem">
                                                    @Ui.UpdateStateLabel(watchdogUpdate) @watchdogState.UpdateVersion <TimeText Value="watchdogState.UpdateAt" />@(string.IsNullOrEmpty(watchdogState.UpdateDetail) ? "" : $" · {watchdogState.UpdateDetail}")
                                                </div>
                                            }
                                            @if (watchdogWait is not null)
                                            {
                                                <div class="muted" style="font-size:0.75rem">@watchdogWait</div>
                                            }
                                        }
                                    </td>
                                </tr>
                                <tr><td class="muted">Agent certificate</td><td>@(e.ActiveCertificates > 0 ? $"Valid until {Time.Absolute(e.CertificateExpiresAt)}" : "No valid certificate: the agent cannot connect")</td></tr>
                            </tbody>
                        </MudSimpleTable>
                    </div>
                    <div class="fl-panel pa-4">
                        <MudText Typo="Typo.h6" Class="section-title mb-2">Hardware</MudText>
                        @if (inv is null)
                        {
                            <MudText Typo="Typo.body2" Class="muted">The agent has not reported inventory yet.</MudText>
                        }
                        else
                        {
                            <MudSimpleTable Dense="true" Elevation="0" Class="detail-table">
                                <tbody>
                                    <tr><td class="muted">Manufacturer</td><td>@inv.Manufacturer</td></tr>
                                    <tr><td class="muted">Model</td><td>@inv.Model</td></tr>
                                    <tr><td class="muted">Serial number</td><td>@inv.SerialNumber</td></tr>
                                    <tr><td class="muted">CPU</td><td>@inv.CpuModel (@inv.CpuCores cores, @inv.CpuLogicalProcessors threads)</td></tr>
                                    <tr><td class="muted">Memory</td><td>@Ui.Bytes(inv.MemoryTotalBytes)</td></tr>
                                    <tr><td class="muted">Last boot</td><td><TimeText Value="inv.BootTime" /></td></tr>
                                    <tr><td class="muted">Domain</td><td>@(string.IsNullOrEmpty(inv.Domain) ? "-" : inv.Domain)</td></tr>
                                    <tr><td class="muted">Inventory received</td><td><TimeText Value="inv.ReceivedAt" /></td></tr>
                                    @if (!string.IsNullOrEmpty(inv.Action1AgentId))
                                    {
                                        <tr><td class="muted">Action1 agent</td><td>@inv.Action1AgentId</td></tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        }
                    </div>
                </div>
            </div>
            <div>
                <div class="d-flex flex-column gap-3">
                    <div class="fl-panel pa-4">
                        <MudText Typo="Typo.h6" Class="section-title mb-2">Disks</MudText>
                        @if (inv is null || inv.Disks.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="muted">The agent has not reported disks yet.</MudText>
                        }
                        else
                        {
                            @foreach (var disk in inv.Disks)
                            {
                                var usedPercent = disk.TotalBytes > 0 ? (disk.TotalBytes - disk.FreeBytes) * 100.0 / disk.TotalBytes : 0;
                                <div class="mb-3">
                                    <div class="d-flex justify-space-between">
                                        <span><strong>@disk.Mount</strong> <span class="muted">@disk.Filesystem</span></span>
                                        <span class="muted">@Ui.Bytes(disk.FreeBytes) free of @Ui.Bytes(disk.TotalBytes)</span>
                                    </div>
                                    <MudProgressLinear Value="usedPercent" Color="@(usedPercent >= 90 ? Color.Error : usedPercent >= 80 ? Color.Warning : Color.Primary)"
                                                       Rounded="true" Size="Size.Medium" Class="mt-1" />
                                </div>
                            }
                        }
                    </div>
                    <div class="fl-panel pa-4">
                        <MudText Typo="Typo.h6" Class="section-title mb-2">Network</MudText>
                        <MudSimpleTable Dense="true" Elevation="0" Class="detail-table mb-2">
                            <tbody>
                                @{ var privateConnection = Ui.IsPrivateConnection(e.PublicIpAddress); }
                                <tr>
                                    <td class="muted">@(privateConnection ? "Connection address" : "Public IP")</td>
                                    <td>
                                        @if (string.IsNullOrEmpty(e.PublicIpAddress))
                                        {
                                            <span>-</span>
                                        }
                                        else
                                        {
                                            <span class="mono">@e.PublicIpAddress</span>
                                            @if (privateConnection)
                                            {
                                                <MudTooltip Text="The agent reaches the instance inside a private network (same LAN, VPN or local DNS), so its public IP is not known.">
                                                    <span class="muted"> · private network</span>
                                                </MudTooltip>
                                            }
                                            <span class="muted"> · seen <TimeText Value="e.PublicIpSeenAt" /></span>
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </MudSimpleTable>
                        @if (inv is null || inv.NetworkInterfaces.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="muted">The agent has not reported network interfaces yet.</MudText>
                        }
                        else
                        {
                            <MudSimpleTable Dense="true" Elevation="0" Class="detail-table">
                                <thead><tr><th>Interface</th><th>MAC address</th><th>IP addresses</th></tr></thead>
                                <tbody>
                                    @foreach (var nic in inv.NetworkInterfaces)
                                    {
                                        <tr><td>@nic.Name</td><td class="mono">@nic.MacAddress</td><td class="mono">@string.Join(", ", nic.IpAddresses)</td></tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        }
                    </div>
                </div>
            </div>
        </div>
        </div>
    };

    private RenderFragment Checks(EndpointDetail e) => __builder =>
    {
        if (_checks is null)
        {
            return;
        }

        if (!_checks.Managed)
        {
            <EmptyState Icon="@Icons.Material.Outlined.Rule" Title="No checks on agent-only endpoints"
                        Text="Checks run on managed endpoints. Switch this endpoint to managed from the endpoint list to use them." />
            return;
        }

        <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
            <MudText Typo="Typo.body2" Class="muted">
                @if (_checks.ConfigurationPending)
                {
                    <span>The agent has not applied the latest configuration yet. New or changed checks start once it has.</span>
                }
                else
                {
                    <span>Checks from the monitoring templates of the client, the site and this endpoint, and checks of this endpoint only.</span>
                }
            </MudText>
            @if (Can(Permissions.ChecksEdit))
            {
                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.LibraryAddCheck" OnClick="@(() => EditTemplatesAsync(e))">Monitoring templates</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="@(() => EditEndpointCheckAsync(e, null))">Add check</MudButton>
                </div>
            }
        </div>

        if (_checks.Rows.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.Rule" Title="No checks yet"
                        Text="Link a monitoring template to the site or to this endpoint, or add a check for this endpoint only." />
            return;
        }

        var now = Clock.GetUtcNow().UtcDateTime;
        <MudTable Items="_checks.Rows" Dense="true" Hover="true" Elevation="0">
            <HeaderContent>
                <MudTh Style="width:44px"></MudTh>
                <MudTh>Check</MudTh>
                <MudTh>Result</MudTh>
                <MudTh>More info</MudTh>
                <MudTh>Interval</MudTh>
                <MudTh>Last run</MudTh>
                <MudTh>Status</MudTh>
                @if (HasCheckMenu)
                {
                    <MudTh Style="width:52px"></MudTh>
                }
            </HeaderContent>
            <RowTemplate>
                <MudTd><MudIcon Icon="@RowIcon(context)" Color="@RowColor(context)" Size="Size.Small" /></MudTd>
                <MudTd>
                    <strong>@context.Name</strong>@(string.IsNullOrEmpty(context.Target) ? "" : $" ({context.Target})")
                    <div class="muted check-source">
                        <MudTooltip Text="@SourceTooltip(context.Source)" Placement="Placement.Top">
                            <MudIcon Icon="@SourceIcon(context.Source)" Class="check-source-icon" aria-label="@SourceTooltip(context.Source)" />
                        </MudTooltip>
                        <span>@SourceText(context)@(context.HasOverrides ? " · adjusted for this endpoint" : "")</span>
                    </div>
                </MudTd>
                <MudTd>@(context.Status is null ? "-" : Ui.CheckValue(context.Type, context.Value, context.Target, context.Parameters))</MudTd>
                <MudTd>
                    @context.Detail
                    @if (!string.IsNullOrEmpty(context.Error))
                    {
                        <div style="color:var(--fl-error)">@context.Error</div>
                    }
                </MudTd>
                <MudTd>@Ui.CheckInterval(context.Type, context.IntervalSeconds)</MudTd>
                <MudTd>
                    @if (context.Status is not null)
                    {
                        <MudLink OnClick="@(() => ShowHistoryAsync(context))" Typo="Typo.body2" title="Show the history of this check"><TimeText Value="context.LastResultAt" Never="-" /></MudLink>
                    }
                    else
                    {
                        <TimeText Value="context.LastResultAt" Never="-" />
                    }
                </MudTd>
                <MudTd>
                    <div class="d-flex flex-wrap gap-1">
                        <StatusChip Text="@RowStatusText(context)" Kind="@RowStatusKind(context)" />
                        @if (context.OpenAlert is { } alert && alert.IsHeld(now))
                        {
                            <StatusChip Text="@($"On hold until {Time.Absolute(alert.HeldUntil)}")" Kind="StatusKind.Neutral" />
                        }
                    </div>
                </MudTd>
                @if (HasCheckMenu)
                {
                    <MudTd>
                        <MudMenu Icon="@Icons.Material.Outlined.MoreVert" Size="Size.Small" Dense="true" AriaLabel="Check actions"
                                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                            @if (context.Status is not null)
                            {
                                <MudMenuItem Icon="@Icons.Material.Outlined.ShowChart" OnClick="@(() => ShowHistoryAsync(context))">History</MudMenuItem>
                            }
                            @if (Can(Permissions.ChecksRun) && !context.DisabledOnEndpoint && CheckCatalog.Get(context.Type).RunsOnAgent)
                            {
                                <MudMenuItem Icon="@Icons.Material.Outlined.PlayArrow" OnClick="@(() => RunCheckAsync(context, false))">Run now</MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Outlined.RestartAlt" OnClick="@(() => RunCheckAsync(context, true))">Reset and run</MudMenuItem>
                            }
                            @if (context.OpenAlert is { } rowAlert)
                            {
                                @if (rowAlert.State == AlertState.Open && Can(Permissions.AlertsAcknowledge))
                                {
                                    <MudMenuItem Icon="@Icons.Material.Outlined.Check" OnClick="@(() => AlertActionAsync(rowAlert, AlertAction.Acknowledge))">Acknowledge alert</MudMenuItem>
                                }
                                @if (Can(Permissions.AlertsHold) && rowAlert.IsHeld(now))
                                {
                                    <MudMenuItem Icon="@Icons.Material.Outlined.PlayCircle" OnClick="@(() => AlertActionAsync(rowAlert, AlertAction.EndHold))">End hold</MudMenuItem>
                                }
                                else if (Can(Permissions.AlertsHold))
                                {
                                    <MudMenuItem Icon="@Icons.Material.Outlined.PauseCircle" OnClick="@(() => AlertActionAsync(rowAlert, AlertAction.Hold))">Put alert on hold</MudMenuItem>
                                }
                                @if (Can(Permissions.AlertsResolve))
                                {
                                    <MudMenuItem Icon="@Icons.Material.Outlined.TaskAlt" OnClick="@(() => AlertActionAsync(rowAlert, AlertAction.Resolve))">Resolve alert</MudMenuItem>
                                }
                            }
                            @if (Can(Permissions.ChecksEdit) && context.Source == CheckSource.Endpoint)
                            {
                                <MudMenuItem Icon="@Icons.Material.Outlined.Edit" OnClick="@(() => EditEndpointCheckAsync(e, context.DefinitionId))">Edit</MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Outlined.Delete" OnClick="@(() => DeleteEndpointCheckAsync(context))">Delete</MudMenuItem>
                            }
                            else if (Can(Permissions.ChecksEdit))
                            {
                                <MudMenuItem Icon="@Icons.Material.Outlined.Tune" OnClick="@(() => EditOverrideAsync(context))">Edit for this endpoint</MudMenuItem>
                                @if (context.DisabledOnEndpoint)
                                {
                                    <MudMenuItem Icon="@Icons.Material.Outlined.ToggleOn" OnClick="@(() => SetDisabledAsync(context, false))">Enable on this endpoint</MudMenuItem>
                                }
                                else
                                {
                                    <MudMenuItem Icon="@Icons.Material.Outlined.ToggleOff" OnClick="@(() => SetDisabledAsync(context, true))">Disable on this endpoint</MudMenuItem>
                                }
                            }
                        </MudMenu>
                    </MudTd>
                }
            </RowTemplate>
        </MudTable>
    };

    private RenderFragment Jobs(EndpointDetail e) => __builder =>
    {
        if (_jobs is null)
        {
            return;
        }

        <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
            <MudText Typo="Typo.body2" Class="muted">Scripts run on this endpoint, newest first. Click a job for its output.</MudText>
            @if (Can(Permissions.ScriptsRun) && e.Tier == EndpointTier.Managed)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.PlayArrow" OnClick="@(() => RunScriptAsync(e))">Run script</MudButton>
            }
        </div>

        if (_jobs.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.Terminal" Title="No jobs yet"
                        Text="@(e.Tier == EndpointTier.Managed ? "Run a script from the library on this endpoint." : "Scripts run on managed endpoints. Switch this endpoint to managed from the endpoint list to use them.")" />
            return;
        }

        <MudTable Items="_jobs" Dense="true" Hover="true" Elevation="0" OnRowClick="@((TableRowClickEventArgs<JobListItem> args) => ShowJobAsync(args.Item!))" RowStyle="cursor:pointer">
            <HeaderContent>
                <MudTh Style="width:170px">Started</MudTh>
                <MudTh>Script</MudTh>
                <MudTh>Result</MudTh>
                <MudTh>Output</MudTh>
                <MudTh Style="width:160px">By</MudTh>
                @if (Can(Permissions.JobsCancel))
                {
                    <MudTh Style="width:52px"></MudTh>
                }
            </HeaderContent>
            <RowTemplate>
                <MudTd><TimeText Value="context.StartedAt ?? context.CreatedAt" /></MudTd>
                <MudTd>
                    @context.ScriptName <span class="muted">v@(context.ScriptVersionNumber)</span>
                    @if (context.RunAs == JobRunAs.LoggedOnUser && (context.RunAsAccount ?? context.RunAsChosenAccount) is { } account)
                    {
                        <span class="muted"> · @account</span>
                    }
                </MudTd>
                <MudTd>
                    <StatusChip Text="@Ui.JobStateLabel(context.State, context.Result, context.ExitStatus)" Kind="@Ui.JobStateKind(context.State, context.ExitStatus)" />
                    @if (context.ExitCode is { } exitCode)
                    {
                        <span class="muted ml-1">exit @exitCode</span>
                    }
                </MudTd>
                <MudTd><span class="muted">@Ui.JobOutputLabel(context.OutputState, context.OutputTruncated)</span></MudTd>
                <MudTd>@context.InitiatedByName</MudTd>
                @if (Can(Permissions.JobsCancel))
                {
                    <MudTd @onclick:stopPropagation="true">
                        @if (context.CanCancel)
                        {
                            <MudTooltip Text="Cancel"><MudIconButton Icon="@Icons.Material.Outlined.Cancel" Size="Size.Small" OnClick="@(() => CancelJobAsync(context))" /></MudTooltip>
                        }
                    </MudTd>
                }
            </RowTemplate>
        </MudTable>
    };

    private RenderFragment Tasks(EndpointDetail e) => __builder =>
    {
        if (_tasks is null)
        {
            return;
        }

        <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
            <MudText Typo="Typo.h6" Class="section-title">Linked tasks</MudText>
            @if (Can(Permissions.TasksEdit))
            {
                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.AddLink" OnClick="@(() => LinkTaskAsync(e))">Link task</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="@(() => NewTaskAsync(e))">New task</MudButton>
                </div>
            }
        </div>
        if (_tasks.Tasks.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.EventRepeat" Title="No tasks for this endpoint"
                        Text="Link a task to this endpoint, or to its client, its site or a monitoring template it gets." />
        }
        else
        {
            <MudTable Items="_tasks.Tasks" Dense="true" Hover="true" Elevation="0" Class="mb-4">
                <HeaderContent>
                    <MudTh>Task</MudTh>
                    <MudTh>Runs</MudTh>
                    <MudTh>Next run</MudTh>
                    <MudTh>Last run</MudTh>
                    <MudTh>Last result</MudTh>
                    @if (Can(Permissions.TasksEdit))
                    {
                        <MudTh Style="width:52px"></MudTh>
                    }
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudLink Href="@($"/settings/tasks/{context.Id}")" Typo="Typo.body2"><strong>@context.Name</strong></MudLink>
                        @if (!context.Enabled)
                        {
                            <span class="ml-1"><StatusChip Text="Off" Kind="StatusKind.Neutral" /></span>
                        }
                        <div class="muted" style="font-size:0.75rem">@context.StepSummary · linked to @LinkedText(context)</div>
                    </MudTd>
                    <MudTd>
                        @context.Schedule
                        <div class="muted" style="font-size:0.75rem">@context.Triggers</div>
                    </MudTd>
                    <MudTd>
                        @if (context.Problem is { } problem)
                        {
                            <span style="color:var(--mud-palette-warning-darken)">Does not run here: @problem</span>
                        }
                        else if (!context.Enabled)
                        {
                            <span class="muted">Switched off</span>
                        }
                        else if (context.NextRunAt is { } next)
                        {
                            <TimeText Value="next" />
                            @if (context.RandomDelayMinutes > 0)
                            {
                                <div class="muted" style="font-size:0.75rem">plus a random delay of up to @Ui.Count(context.RandomDelayMinutes, "minute")</div>
                            }
                        }
                        else
                        {
                            <span class="muted">Not scheduled</span>
                        }
                    </MudTd>
                    <MudTd>
                        @if (context.LastRun is { } last)
                        {
                            <TimeText Value="last.At" />
                            <div class="muted" style="font-size:0.75rem">@Ui.TaskTriggerText(last.Trigger, last.CheckName, last.InitiatedByName)</div>
                        }
                        else
                        {
                            <span class="muted">Never</span>
                        }
                    </MudTd>
                    <MudTd>
                        @if (context.LastRun is { } lastRun)
                        {
                            <div style="@(CanOpenOutput(lastRun) ? "cursor:pointer" : "")"
                                 title="@(CanOpenOutput(lastRun) ? "Show the output of the script" : null)" @onclick="@(() => ShowTaskOutputAsync(lastRun))">
                                @TaskResult(lastRun)
                            </div>
                        }
                    </MudTd>
                    @if (Can(Permissions.TasksEdit))
                    {
                        <MudTd>
                            @if (context.LinkedToEndpoint)
                            {
                                <MudTooltip Text="Unlink from this endpoint">
                                    <MudIconButton Icon="@Icons.Material.Outlined.LinkOff" Size="Size.Small" aria-label="Unlink from this endpoint"
                                                   OnClick="@(() => UnlinkTaskAsync(context))" />
                                </MudTooltip>
                            }
                        </MudTd>
                    }
                </RowTemplate>
            </MudTable>
        }

        <MudText Typo="Typo.h6" Class="section-title mb-2">History</MudText>
        if (_tasks.History.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="muted">No task has run on this endpoint yet.</MudText>
            return;
        }

        <MudText Typo="Typo.body2" Class="muted mb-2">
            Newest first@(Can(Permissions.JobsView) ? ". Click a run for the output of the script." : ".")
        </MudText>
        <MudTable Items="_tasks.History" Dense="true" Hover="true" Elevation="0" RowsPerPage="25"
                  OnRowClick="@((TableRowClickEventArgs<EndpointTaskRunItem> args) => ShowTaskOutputAsync(args.Item!))"
                  RowStyleFunc="@((EndpointTaskRunItem run, int _) => CanOpenOutput(run) ? "cursor:pointer" : "")">
            <HeaderContent>
                <MudTh Style="width:170px">When</MudTh>
                <MudTh>Task</MudTh>
                <MudTh>Started by</MudTh>
                <MudTh>Result</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><TimeText Value="context.At" /></MudTd>
                <MudTd>@context.TaskName</MudTd>
                <MudTd>@Ui.TaskTriggerText(context.Trigger, context.CheckName, context.InitiatedByName)</MudTd>
                <MudTd>
                    @TaskResult(context)
                    @if (context.Target.StepCount > 1 && context.Target.Steps.Count > 0)
                    {
                        <div class="mt-1" @onclick:stopPropagation="true">
                            <TaskRunSteps Steps="context.Target.Steps" OnOutput="@(Can(Permissions.JobsView) ? ShowStepOutputAsync : default(EventCallback<Guid>))" />
                        </div>
                    }
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new[] { 25, 50 }" />
            </PagerContent>
        </MudTable>
    };

    /// <summary>The result of a run of a task on this endpoint: the state, the exit code and why it did not run or failed.</summary>
    private RenderFragment TaskResult(EndpointTaskRunItem run) => __builder =>
    {
        var target = run.Target;
        <StatusChip Text="@TaskService.StateText(target)" Kind="@Ui.TaskStateKind(target)" />
        @if (target.ExitCode is { } exitCode)
        {
            <span class="muted ml-1">exit @exitCode</span>
        }
        @if ((target.Reason ?? target.Problem) is { } why)
        {
            <div class="muted" style="font-size:0.75rem">@why</div>
        }
        @if (target.State == TaskTargetState.Pending)
        {
            <div class="muted" style="font-size:0.75rem">Due @Time.Absolute(target.DueAt)</div>
        }
    };

    /// <summary>"the client and this endpoint", "monitoring template Servers": every way the task reaches this endpoint.</summary>
    private static string LinkedText(EndpointTaskItem task)
    {
        var parts = task.LinkedThrough.Select(l => l switch
        {
            LinkLevel.Client => "the client",
            LinkLevel.Site => "the site",
            _ => "this endpoint"
        }).Concat(task.LinkedTemplates.Select(t => $"monitoring template {t}")).ToList();
        return parts.Count <= 1 ? string.Concat(parts) : string.Join(", ", parts[..^1]) + " and " + parts[^1];
    }

    private async Task LinkTaskAsync(EndpointDetail e)
    {
        IReadOnlyList<TaskOption> tasks = [];
        await LoadAsync(async caller => tasks = await TaskSvc.GetEndpointTaskChoicesAsync(caller, e.Id));
        var parameters = new DialogParameters<LinkTaskDialog>
        {
            { d => d.Target, e.Hostname },
            { d => d.HelperText, "The task runs on this endpoint on top of where it is linked already." },
            { d => d.EmptyText, "Every task you can link is already linked to this endpoint. Create a new task instead." },
            { d => d.Tasks, tasks },
            { d => d.OnSubmit, taskId => RunAsync(caller => TaskSvc.LinkAsync(caller, taskId, LinkLevel.Endpoint, e.Id), "The task was linked to this endpoint.") }
        };
        var dialog = await DialogService.ShowAsync<LinkTaskDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dialog.Result)!.Canceled)
        {
            await LoadAsync(LoadTabAsync);
        }
    }

    /// <summary>A new task, linked to this endpoint when it is saved; it starts as a task of the endpoint's client.</summary>
    private async Task NewTaskAsync(EndpointDetail e)
    {
        var parameters = new DialogParameters<TaskDialog>
        {
            { d => d.Clients, new[] { new ClientOption(e.ClientId, e.ClientCode, e.ClientName) } },
            { d => d.DefaultClientId, e.ClientId },
            { d => d.CanRestart, Can(Permissions.EndpointsRestart) },
            { d => d.DefaultTimeZone, TimeZoneOptions.IanaId(Time.Zone) },
            { d => d.LoadScripts, clientId => TaskSvc.GetScriptChoicesAsync(Caller!, clientId) },
            { d => d.LoadChecks, clientId => TaskSvc.GetCheckChoicesAsync(Caller!, clientId) },
            {
                d => d.OnSubmit, async input =>
                {
                    var created = await RunForValueAsync(caller => TaskSvc.SaveAsync(caller, null, input), null);
                    if (created?.Value is not { } taskId)
                    {
                        return false;
                    }

                    // The task exists now; a link that fails leaves it for Settings, Tasks, with the reason shown.
                    await RunAsync(caller => TaskSvc.LinkAsync(caller, taskId, LinkLevel.Endpoint, e.Id), "The task was created and linked to this endpoint.");
                    return true;
                }
            }
        };
        var dialog = await DialogService.ShowAsync<TaskDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (!(await dialog.Result)!.Canceled)
        {
            await LoadAsync(LoadTabAsync);
        }
    }

    private async Task UnlinkTaskAsync(EndpointTaskItem task)
    {
        var message = task.LinkedThrough.Count > 1 || task.LinkedTemplates.Count > 0
            ? "The link to this endpoint is removed. The task keeps running here through its other links."
            : "The task no longer runs on this endpoint. Its runs here stay in the history.";
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { d => d.Title, $"Unlink task {task.Name}" },
            { d => d.Message, message },
            { d => d.ConfirmText, "Unlink" }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(null, parameters);
        if (!(await dialog.Result)!.Canceled &&
            await RunAsync(caller => TaskSvc.UnlinkAsync(caller, task.Id, LinkLevel.Endpoint, EndpointId), "The task was unlinked from this endpoint."))
        {
            await LoadAsync(LoadTabAsync);
        }
    }

    private EventCallback<Guid> ShowStepOutputAsync => EventCallback.Factory.Create<Guid>(this, async jobId =>
    {
        var parameters = new DialogParameters<JobOutputDialog> { { d => d.JobId, jobId }, { d => d.EndpointId, EndpointId } };
        var dialog = await DialogService.ShowAsync<JobOutputDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        await dialog.Result;
    });

    private bool CanOpenOutput(EndpointTaskRunItem run) => run.Target.JobId is not null && Can(Permissions.JobsView);

    private async Task ShowTaskOutputAsync(EndpointTaskRunItem run)
    {
        if (!CanOpenOutput(run))
        {
            return;
        }

        var parameters = new DialogParameters<JobOutputDialog> { { d => d.JobId, run.Target.JobId!.Value }, { d => d.EndpointId, EndpointId } };
        var dialog = await DialogService.ShowAsync<JobOutputDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        await dialog.Result;
    }

    private async Task RunScriptAsync(EndpointDetail e)
    {
        IReadOnlyList<RunnableScript> scripts = [];
        SignedInUsersView? signedIn = null;
        await LoadAsync(async caller =>
        {
            scripts = await JobSvc.ListRunnableScriptsAsync(caller, [e.Id]);
            signedIn = await JobSvc.GetSignedInUsersAsync(caller, e.Id);
        });
        var parameters = new DialogParameters<RunScriptDialog>
        {
            { d => d.EndpointIds, new[] { e.Id } },
            { d => d.TargetLabel, e.Hostname },
            { d => d.Scripts, scripts },
            { d => d.SignedInUsers, signedIn },
            { d => d.OnSubmit, (scriptId, validity, runAs, userId, allUsers) => RunAsync(caller => JobSvc.RunAsync(caller, scriptId, [e.Id], validity, runAs, userId, allUsers),
                allUsers
                    ? "A job was started for every signed-in user. They run as soon as the endpoint receives them."
                    : "The job was started. It runs as soon as the endpoint receives it.") }
        };
        var dialog = await DialogService.ShowAsync<RunScriptDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dialog.Result)!.Canceled)
        {
            await LoadAsync(LoadTabAsync);
        }
    }

    private async Task ShowJobAsync(JobListItem job)
    {
        var parameters = new DialogParameters<JobOutputDialog> { { d => d.JobId, job.Id }, { d => d.EndpointId, job.EndpointId } };
        var dialog = await DialogService.ShowAsync<JobOutputDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        await dialog.Result;
    }

    private async Task CancelJobAsync(JobListItem job)
    {
        if (await RunAsync(caller => JobSvc.CancelAsync(caller, job.Id), "The job was cancelled."))
        {
            await LoadAsync(LoadTabAsync);
        }
    }

    private RenderFragment Notes(EndpointDetail e) => __builder =>
    {
        if (_notes is null)
        {
            return;
        }

        if (!_notes.Managed)
        {
            <EmptyState Icon="@Icons.Material.Outlined.StickyNote2" Title="No notes on agent-only endpoints"
                        Text="Notes are available on managed endpoints. Switch this endpoint to managed from the endpoint list to use them." />
            return;
        }

        <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
            <MudText Typo="Typo.body2" Class="muted">Newest first. The author can edit a note.</MudText>
            @if (Can(Permissions.NotesCreate))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="@(() => EditNoteAsync(null))">Add note</MudButton>
            }
        </div>

        if (_noteItems.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.StickyNote2" Title="No notes yet"
                        Text="Write down what others should know about this endpoint, such as a known issue or a change you made." />
            return;
        }

        <MudTable Items="_noteItems" Dense="true" Elevation="0">
            <HeaderContent>
                <MudTh Style="width:170px">Created</MudTh>
                <MudTh Style="width:180px">Author</MudTh>
                <MudTh>Note</MudTh>
                @if (Can(Permissions.NotesCreate) || Can(Permissions.NotesDelete))
                {
                    <MudTh Style="width:52px"></MudTh>
                }
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <TimeText Value="context.CreatedAt" />
                    @if (context.EditedAt is not null)
                    {
                        <div class="muted" style="font-size:0.75rem">edited <TimeText Value="context.EditedAt" /></div>
                    }
                </MudTd>
                <MudTd>@context.AuthorName</MudTd>
                <MudTd><div class="note-body">@NoteMarkdown.ToHtml(context.Body)</div></MudTd>
                @if (Can(Permissions.NotesCreate) || Can(Permissions.NotesDelete))
                {
                    <MudTd>
                        @if ((context.AuthorUserId == Caller?.UserId && Can(Permissions.NotesCreate)) || Can(Permissions.NotesDelete))
                        {
                            <MudMenu Icon="@Icons.Material.Outlined.MoreVert" Size="Size.Small" Dense="true" AriaLabel="Note actions"
                                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                @if (context.AuthorUserId == Caller?.UserId && Can(Permissions.NotesCreate))
                                {
                                    <MudMenuItem Icon="@Icons.Material.Outlined.Edit" OnClick="@(() => EditNoteAsync(context))">Edit</MudMenuItem>
                                }
                                @if (Can(Permissions.NotesDelete))
                                {
                                    <MudMenuItem Icon="@Icons.Material.Outlined.Delete" OnClick="@(() => DeleteNoteAsync(context))">Delete</MudMenuItem>
                                }
                            </MudMenu>
                        }
                    </MudTd>
                }
            </RowTemplate>
        </MudTable>
        @if (_notes.NextCursor is not null)
        {
            <div class="mt-3"><MudButton Variant="Variant.Outlined" OnClick="MoreNotesAsync">Show older notes</MudButton></div>
        }
    };

    private RenderFragment Software() => __builder =>
    {
        if (_inventory is null)
        {
            @NoInventory()
            return;
        }

        <div class="d-flex align-center justify-space-between mb-2 flex-wrap gap-2">
            <MudText Typo="Typo.body2" Class="muted">@_inventory.Software.Count applications · received <TimeText Value="_inventory.ReceivedAt" /></MudText>
            <MudTextField T="string" @bind-Value="_softwareSearch" Placeholder="Search software" Immediate="true" DebounceInterval="200"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Search" Style="max-width:320px" Clearable="true" />
        </div>
        <MudTable Items="FilteredSoftware" Dense="true" Elevation="0" RowsPerPage="25">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Version</MudTh>
                <MudTh>Publisher</MudTh>
                <MudTh>Installed</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Name</MudTd>
                <MudTd>@context.Version</MudTd>
                <MudTd>@context.Publisher</MudTd>
                <MudTd>@context.InstallDate</MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" />
            </PagerContent>
        </MudTable>
    };

    /// <summary>The package groups the search keeps: a group whose package, binaries or CVEs contain the text.</summary>
    private IEnumerable<VulnerabilityPackageGroup> FilteredVulnerabilityGroups =>
        _vulnerabilities is not { } view ? []
        : string.IsNullOrWhiteSpace(_vulnerabilitySearch) ? view.Groups
        : view.Groups.Where(g => MatchesVulnerabilitySearch(g.Package) || g.Binaries.Any(MatchesVulnerabilitySearch) ||
                                 g.Findings.Any(f => MatchesVulnerabilitySearch(f.Cve)));

    private bool MatchesVulnerabilitySearch(string text) => text.Contains(_vulnerabilitySearch!.Trim(), StringComparison.OrdinalIgnoreCase);

    private void ToggleVulnerabilityGroup(VulnerabilityPackageGroup group)
    {
        var key = GroupKey(group);
        if (!_vulnerabilityExpanded.Remove(key))
        {
            _vulnerabilityExpanded.Add(key);
        }
    }

    private static string GroupKey(VulnerabilityPackageGroup group) => group.IsKernel ? "kernel:" + group.Package : group.Package;

    private static string GroupCounts(VulnerabilityPackageGroup group)
    {
        var withoutFix = group.Findings.Count - group.Fixable;
        return (group.Fixable, withoutFix) switch
        {
            (> 0, > 0) => $"{group.Fixable} fixable, {withoutFix} without a fix",
            (> 0, _) => $"{group.Fixable} fixable",
            _ => $"{withoutFix} without a fix"
        };
    }

    private static string OriginLabel(string? origin) => origin switch
    {
        null or "" => "Unknown",
        PackageInventory.LocalOrigin => "Installed from a file",
        _ => origin
    };

    private RenderFragment VulnerabilitiesContent() => __builder =>
    {
        var view = _vulnerabilities;
        if (view is null)
        {
            <EmptyState Icon="@Icons.Material.Outlined.GppMaybe" Title="Loading" Text="Reading the vulnerabilities of this endpoint." />
            return;
        }

        if (!view.Managed)
        {
            <EmptyState Icon="@Icons.Material.Outlined.GppMaybe" Title="Vulnerability reporting needs a managed endpoint"
                        Text="Switch this endpoint to managed to see which known vulnerabilities affect its packages." />
            return;
        }

        if (view.Summary is not { } summary)
        {
            <EmptyState Icon="@Icons.Material.Outlined.GppMaybe" Title="Not matched yet"
                        Text="Fleeto matches this endpoint once its agent reports its packages and the security data of its release is fetched. This takes a few minutes." />
            return;
        }

        var release = Ui.ReleaseLabel(summary.Distribution, summary.Release);
        var coverageText = summary.Coverage switch
        {
            VulnerabilityCoverage.DistributionNotCovered =>
                $"Fleeto reports vulnerabilities on Ubuntu, Debian, Proxmox VE and AlmaLinux. {release} is not covered, so nothing is known about its packages.",
            VulnerabilityCoverage.ReleaseNotSupported =>
                $"{release} gets no security fixes any more{(summary.Distribution == Vulnerabilities.Ubuntu ? " without Ubuntu Pro" : "")}, so its packages are not checked. Upgrade to a supported release.",
            VulnerabilityCoverage.FeedsPending =>
                $"The security data of {release} has not been fetched yet. If this stays, an admin finds the reason in Settings, Vulnerabilities.",
            _ => null
        };
        if (summary.Coverage == VulnerabilityCoverage.AgentTooOld)
        {
            <EmptyState Icon="@Icons.Material.Outlined.Update" Title="Update the agent to see vulnerabilities"
                        Text="This agent does not report what vulnerability matching needs. Agent 0.8.0 or newer does; it updates through its update ring." />
            return;
        }

        if (coverageText is not null)
        {
            <EmptyState Icon="@Icons.Material.Outlined.GppMaybe"
                        Title="@(summary.Coverage switch { VulnerabilityCoverage.ReleaseNotSupported => "Release no longer supported", VulnerabilityCoverage.FeedsPending => "Security data not fetched yet", _ => "Not covered" })"
                        Text="@coverageText" />
            return;
        }

        var now = Clock.GetUtcNow().UtcDateTime;
        <MudText Typo="Typo.body2" Class="muted mb-2">
            @release · security data updated @(view.FeedsUpdatedAt is { } updated ? Time.Relative(updated) : "not yet") · matched @Time.Relative(summary.MatchedAt)
        </MudText>
        @if (summary.PackageLists is "missing" or "unreadable")
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                Package lists missing: run apt update on this endpoint, so Fleeto can tell which packages come from @(Ui.ReleaseLabel(summary.Distribution, null)).
            </MudAlert>
        }
        else if (summary.PackageListsUpdatedAt is { } listsAt && now - listsAt > TimeSpan.FromDays(30))
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                The package lists were last updated @Time.Relative(listsAt). Run apt update so the endpoint knows the fixed versions as well.
            </MudAlert>
        }
        @if (summary.RestartRequired)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">Restart required: updates installed since the last restart take effect after it.</MudAlert>
        }
        @if (summary.Distribution == Vulnerabilities.AlmaLinux)
        {
            <MudAlert Severity="Severity.Normal" Dense="true" Class="mb-2">Only security updates that AlmaLinux has released are shown.</MudAlert>
        }

        var exploited = view.Groups.Sum(g => g.Exploited);
        <div class="d-flex gap-2 flex-wrap align-center mb-3">
            @if (exploited > 0)
            {
                <StatusChip Text="@($"{exploited} actively exploited")" Kind="StatusKind.Error"
                            Title="Vulnerabilities that CISA (or ENISA) lists as exploited in the wild. Fix these first." />
            }
            @if (summary.Fixable == 0)
            {
                <StatusChip Text="No fixable vulnerabilities" Kind="StatusKind.Ok" />
            }
            @foreach (var (severity, count) in new[] { (VulnerabilitySeverity.Critical, summary.Critical), (VulnerabilitySeverity.High, summary.High),
                         (VulnerabilitySeverity.Medium, summary.Medium), (VulnerabilitySeverity.Low, summary.Low), (VulnerabilitySeverity.Unknown, summary.Unknown) })
            {
                @if (count > 0)
                {
                    <StatusChip Text="@($"{count} {severity.ToString().ToLowerInvariant()}")" Kind="@Ui.VulnerabilityKind(severity)" />
                }
            }
            @if (summary.NoFix > 0)
            {
                <StatusChip Text="@($"{summary.NoFix} without a fix yet")" Kind="StatusKind.Neutral" />
            }
            @if (summary.ProOnly > 0)
            {
                <MudTooltip Text="Fixed in packages of Ubuntu Pro (Expanded Security Maintenance), which this endpoint does not have.">
                    <StatusChip Text="@($"{summary.ProOnly} fixed only in Ubuntu Pro")" Kind="StatusKind.Neutral" />
                </MudTooltip>
            }
            <MudSpacer />
            <MudTextField T="string" @bind-Value="_vulnerabilitySearch" Placeholder="Search CVE or package" Immediate="true" DebounceInterval="200"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Search" Style="max-width:320px" Clearable="true" />
        </div>

        @if (view.Groups.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.VerifiedUser" Title="No open vulnerabilities"
                        Text="@($"The security data of {release} lists no open vulnerability for the packages of this endpoint.")" />
        }
        else
        {
            <MudTable T="VulnerabilityPackageGroup" Items="FilteredVulnerabilityGroups" Dense="true" Elevation="0" RowsPerPage="25" Hover="true"
                      OnRowClick="@(args => ToggleVulnerabilityGroup(args.Item!))" RowStyle="cursor:pointer">
                <HeaderContent>
                    <MudTh Style="width:36px"></MudTh>
                    <MudTh>Package</MudTh>
                    <MudTh>Installed</MudTh>
                    <MudTh>Severity</MudTh>
                    <MudTh>Vulnerabilities</MudTh>
                    <MudTh>Update to</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudIcon Size="Size.Small" Icon="@(_vulnerabilityExpanded.Contains(GroupKey(context)) ? Icons.Material.Outlined.ExpandLess : Icons.Material.Outlined.ExpandMore)" />
                    </MudTd>
                    <MudTd>
                        <strong>@(context.IsKernel ? $"Running kernel ({context.Package})" : context.Package)</strong>
                        @if (!context.IsKernel && !(context.Binaries.Count == 1 && context.Binaries[0] == context.Package) && context.Binaries.Count > 0)
                        {
                            <div class="muted" style="font-size:0.75rem">@string.Join(", ", context.Binaries)</div>
                        }
                    </MudTd>
                    <MudTd><span class="mono">@context.InstalledVersion</span></MudTd>
                    <MudTd>
                        <span class="d-inline-flex align-center gap-1 flex-wrap">
                            <StatusChip Text="@context.Worst.ToString()" Kind="@Ui.VulnerabilityKind(context.Worst)" />
                            @if (context.Exploited > 0)
                            {
                                <StatusChip Text="Exploited" Kind="StatusKind.Error" Title="@($"{context.Exploited} of its vulnerabilities are actively exploited.")" />
                            }
                        </span>
                    </MudTd>
                    <MudTd>@GroupCounts(context)</MudTd>
                    <MudTd><span class="mono">@(context.UpgradeTo ?? "-")</span></MudTd>
                </RowTemplate>
                <ChildRowContent>
                    @if (_vulnerabilityExpanded.Contains(GroupKey(context)))
                    {
                        <MudTr>
                            <td colspan="6" class="pa-0">
                                <MudSimpleTable Dense="true" Elevation="0">
                                    <thead>
                                        <tr><th>CVE</th><th>Severity</th><th>Exploitation</th><th>State</th><th>Fixed in</th><th>Advisory</th><th>First seen</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var finding in context.Findings)
                                        {
                                            <tr>
                                                <td>@VulnerabilityLink(finding.Cve, finding.CveUrl)</td>
                                                <td>
                                                    <StatusChip Text="@finding.Severity.ToString()" Kind="@Ui.VulnerabilityKind(finding.Severity)" />
                                                    @if (!string.IsNullOrEmpty(finding.SourceSeverity) && !string.Equals(finding.SourceSeverity, finding.Severity.ToString(), StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <span class="muted ml-1" style="font-size:0.75rem">@finding.SourceSeverity</span>
                                                    }
                                                    @if (finding.Cvss is { } cvss)
                                                    {
                                                        <span class="muted ml-1" style="font-size:0.75rem" title="CVSS base score">CVSS @cvss.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)</span>
                                                    }
                                                </td>
                                                <td><ExploitBadges Exploit="finding.Exploit" /></td>
                                                <td>@Ui.FixStateLabel(finding.State)</td>
                                                <td><span class="mono">@(finding.FixedVersion ?? "-")</span></td>
                                                <td>@VulnerabilityLink(finding.Advisory, finding.AdvisoryUrl)</td>
                                                <td><TimeText Value="finding.FirstSeenAt" /></td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            </td>
                        </MudTr>
                    }
                </ChildRowContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" />
                </PagerContent>
            </MudTable>
        }

        @if (view.NotOpen.Count > 0 || summary.NotCovered > 0)
        {
            <MudExpansionPanels Elevation="0" Class="mt-3" MultiExpansion="true">
                @if (view.NotOpen.Count > 0)
                {
                    <MudExpansionPanel Text="@($"Not open ({view.NotOpen.Count})")">
                        <MudText Typo="Typo.body2" Class="muted mb-2">
                            Vulnerabilities the distribution does not count as open on this release: deferred, under investigation or not to be fixed.
                        </MudText>
                        <MudSimpleTable Dense="true" Elevation="0">
                            <thead><tr><th>CVE</th><th>Package</th><th>Severity</th><th>Status</th></tr></thead>
                            <tbody>
                                @foreach (var finding in view.NotOpen)
                                {
                                    <tr>
                                        <td>@VulnerabilityLink(finding.Cve, finding.CveUrl)</td>
                                        <td>@finding.Package</td>
                                        <td><StatusChip Text="@finding.Severity.ToString()" Kind="@Ui.VulnerabilityKind(finding.Severity)" /></td>
                                        <td>@(finding.SourceSeverity ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </MudExpansionPanel>
                }
                @if (summary.NotCovered > 0)
                {
                    <MudExpansionPanel Text="@($"Not covered ({summary.NotCovered})")">
                        <MudText Typo="Typo.body2" Class="muted mb-2">
                            Packages from other repositories or installed from a file, and on AlmaLinux packages of a module stream that is not known.
                            The security data of @(Ui.ReleaseLabel(summary.Distribution, null)) does not cover them, so Fleeto does not judge them.
                            @if (view.NotCovered.Count < summary.NotCovered)
                            {
                                <span>The first @view.NotCovered.Count by name are listed.</span>
                            }
                        </MudText>
                        <MudSimpleTable Dense="true" Elevation="0">
                            <thead><tr><th>Package</th><th>Version</th><th>Origin</th></tr></thead>
                            <tbody>
                                @foreach (var package in view.NotCovered)
                                {
                                    <tr>
                                        <td>@package.Name</td>
                                        <td><span class="mono">@package.Version</span></td>
                                        <td>@OriginLabel(package.Origin)</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
        <MudText Typo="Typo.caption" Class="muted mt-2 d-block">
            Packages of the distribution only: container images, snaps, flatpaks and language packages (pip, npm) are not checked.
        </MudText>
    };

    /// <summary>A CVE or advisory with the page of the distribution about it, when there is one; the text itself is never markup.</summary>
    private static RenderFragment VulnerabilityLink(string? text, string? url) => __builder =>
    {
        if (string.IsNullOrEmpty(text))
        {
            <span class="muted">-</span>
        }
        else if (url is null)
        {
            <span>@text</span>
        }
        else
        {
            <MudLink Href="@url" Target="_blank" rel="noopener noreferrer">@text</MudLink>
        }
    };

    private RenderFragment Patches() => __builder =>
    {
        var patches = _patches;
        if (patches is null)
        {
            <EmptyState Icon="@Icons.Material.Outlined.Security" Title="Loading" Text="Reading the patch state of this endpoint." />
        }
        else if (!patches.Managed)
        {
            <EmptyState Icon="@Icons.Material.Outlined.Security" Title="Patch management needs a managed endpoint"
                        Text="Switch this endpoint to managed to see its patch state." />
        }
        else if (!patches.Configured)
        {
            <EmptyState Icon="@Icons.Material.Outlined.Security" Title="No patch management for this client"
                        Text="Connect Action1 in Settings, Integrations and map this client to an Action1 organization." />
        }
        else if (patches.State is not { } state)
        {
            <div class="d-flex justify-end mb-2">@SyncButton(patches)</div>
            @PatchRequestNotice(patches)
            @AgentInstallNotice(patches)
            @if (patches.AgentOnEndpoint.Length > 0)
            {
                <EmptyState Icon="@Icons.Material.Outlined.Security" Title="Not covered by patch management"
                            Text="An Action1 agent runs on this endpoint, but Action1 does not report it in the organization of this client. Sync to read it again; if it registered elsewhere, remove it and install the agent of this client's organization." />
                @if (Can(Permissions.Action1AgentRemove) && patches.CanRemoveAgentByJob)
                {
                    <div class="d-flex justify-center">
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Outlined.RemoveCircleOutline"
                                   Disabled="_removingAgent" OnClick="@(() => RemoveAction1AgentAsync(false))">
                            Remove Action1 agent
                        </MudButton>
                    </div>
                }
            }
            else
            {
                <EmptyState Icon="@Icons.Material.Outlined.Security" Title="Not covered by patch management"
                            Text="Action1 does not report this endpoint. It needs the Action1 agent; Fleeto matches the endpoint as soon as its own agent reports that agent." />
                @if (Can(Permissions.Action1AgentInstall) && patches.CanInstallAgent)
                {
                    var install = patches.AgentInstall;
                    <div class="d-flex justify-center">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.InstallDesktop"
                                   Disabled="@(_installingAgent || install?.Status == Action1AgentStatus.Installing)" OnClick="InstallAction1AgentAsync">
                            @(install?.Status is Action1AgentStatus.Failed or Action1AgentStatus.Stopped ? "Install Action1 agent again" : "Install Action1 agent")
                        </MudButton>
                    </div>
                }
            }
        }
        else
        {
            <div class="d-flex gap-4 flex-wrap align-center mb-3">
                <StatusChip Text="@(state.Coverage == PatchCoverage.Inactive ? "Not patched" : state.IsCompliant ? "Up to date" : "Updates missing")"
                            Kind="@(state.Coverage == PatchCoverage.Inactive ? StatusKind.Error : state.IsCompliant ? StatusKind.Ok : StatusKind.Warning)" />
                @if (state.RebootRequired)
                {
                    <StatusChip Text="Restart pending" Kind="StatusKind.Active" />
                }
                <MudText Typo="Typo.body2" Class="muted">
                    Read <TimeText Value="state.UpdatedAt" />, Action1 last saw this endpoint <TimeText Value="state.ProductLastSeenAt" />
                </MudText>
                <MudSpacer />
                @SyncButton(patches)
            </div>
            @PatchRequestNotice(patches)
            @AgentInstallNotice(patches)

            @if (state.Coverage == PatchCoverage.Inactive)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                    Action1 does not patch this endpoint. Endpoints above the licensed number of the Action1 subscription become inactive.
                </MudAlert>
            }

            <MudSimpleTable Dense="true" Elevation="0" Class="detail-table mb-4" Style="max-width:420px">
                <tbody>
                    <tr><td class="muted">Missing, critical</td><td>@state.MissingCritical</td></tr>
                    <tr><td class="muted">Missing, other</td><td>@state.MissingOther</td></tr>
                    <tr><td class="muted">Action1 agent</td><td>@(string.IsNullOrEmpty(state.ProductAgentVersion) ? "-" : state.ProductAgentVersion)</td></tr>
                </tbody>
            </MudSimpleTable>

            @if (patches.Schedule is { } schedule)
            {
                @PatchSchedule(schedule)
            }

            @Deployments()

            @if (Can(Permissions.PatchesDeploy) || Can(Permissions.Action1AgentRemove))
            {
                <div class="d-flex gap-2 flex-wrap align-center mb-3">
                    @if (Can(Permissions.PatchesDeploy) && state.Coverage == PatchCoverage.Active && !state.IsCompliant)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.SystemUpdateAlt"
                                   OnClick="@(() => DeployAsync(null))">
                            Deploy all missing updates
                        </MudButton>
                        @if (_chosenUpdates.Count > 0)
                        {
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.PlaylistAddCheck"
                                       OnClick="@(() => DeployAsync([.. _chosenUpdates]))">
                                Deploy @Ui.Count(_chosenUpdates.Count, "chosen update")
                            </MudButton>
                        }
                    }
                    <MudSpacer />
                    @if (Can(Permissions.Action1AgentRemove))
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Outlined.RemoveCircleOutline"
                                   Disabled="@(_removingAgent || patches.LastRequest is { IsPending: true, Kind: PatchRequestKind.RemoveAgent })"
                                   OnClick="@(() => RemoveAction1AgentAsync(true))">
                            Remove Action1 agent
                        </MudButton>
                    }
                </div>
            }

            @if (patches.Missing.Count == 0)
            {
                @if (state.IsCompliant)
                {
                    <EmptyState Icon="@Icons.Material.Outlined.CheckCircle" Title="Nothing missing"
                                Text="Action1 reports no missing updates for this endpoint." />
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="muted">
                        The list of missing updates is read in the next pass; the counts above are current.
                    </MudText>
                }
            }
            else
            {
                <MudText Typo="Typo.body2" Class="muted mb-2">
                    @patches.Missing.Count missing updates, read <TimeText Value="patches.DetailUpdatedAt" />
                </MudText>
                <MudTable T="MissingUpdateView" Items="patches.Missing" Dense="true" Elevation="0"
                          MultiSelection="@(Can(Permissions.PatchesDeploy) && state.Coverage == PatchCoverage.Active)" @bind-SelectedItems="_chosenUpdates">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Installed version</MudTh>
                        <MudTh>Latest version</MudTh>
                        <MudTh>Release date</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Update type</MudTh>
                        <MudTh>Vulnerabilities</MudTh>
                        <MudTh>Security severity</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            @context.Name
                            @if (!string.IsNullOrEmpty(context.KbNumber))
                            {
                                <span class="muted"> (@context.KbNumber)</span>
                            }
                        </MudTd>
                        <MudTd>@(context.InstalledVersion.Length > 0 ? context.InstalledVersion : "Not installed")</MudTd>
                        <MudTd>@context.Version</MudTd>
                        <MudTd>@(context.ReleaseDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))</MudTd>
                        <MudTd>
                            @if (context.ApprovalStatus.Length > 0)
                            {
                                <StatusChip Text="@context.ApprovalStatus"
                                            Kind="@(context.ApprovalStatus == "Approved" ? StatusKind.Ok
                                                    : context.ApprovalStatus == "Declined" ? StatusKind.Warning : StatusKind.Neutral)" />
                            }
                        </MudTd>
                        <MudTd>@context.UpdateType</MudTd>
                        <MudTd>
                            @if (context.CveList.Count > 0)
                            {
                                <MudTooltip Text="@context.Cves">
                                    <span>@Ui.Count(context.CveList.Count, "CVE")</span>
                                </MudTooltip>
                            }
                            else
                            {
                                <span class="muted">None</span>
                            }
                        </MudTd>
                        <MudTd>
                            <StatusChip Text="@context.Severity.ToString()"
                                        Kind="@(context.Severity == PatchSeverity.Critical ? StatusKind.Error
                                                : context.Severity == PatchSeverity.Important ? StatusKind.Warning : StatusKind.Neutral)" />
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" />
                    </PagerContent>
                </MudTable>
            }
        }
    };

    /// <summary>
    /// Reads this endpoint from Action1 now (0.6.0). The icon turns until the workers have done it, which the live update of
    /// the request tells this tab.
    /// </summary>
    private RenderFragment SyncButton(EndpointPatchView patches) => __builder =>
    {
        @if (Can(Permissions.PatchesSync))
        {
            var syncing = _requestingSync || patches.LastRequest is { IsPending: true, Kind: PatchRequestKind.Sync };
            <MudTooltip Text="Read the patch state, the missing updates and the next deployment of this endpoint from Action1 now">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Sync"
                           Class="@(syncing ? "icon-spin" : null)" Disabled="syncing" OnClick="SyncPatchesAsync">
                    @(syncing ? "Syncing" : "Sync")
                </MudButton>
            </MudTooltip>
        }
    };

    /// <summary>What became of the last sync or removal of the Action1 agent, while it matters (0.6.0).</summary>
    private RenderFragment PatchRequestNotice(EndpointPatchView patches) => __builder =>
    {
        var request = patches.LastRequest;
        if (request is { IsPending: true, Kind: PatchRequestKind.RemoveAgent })
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                Fleeto asks Action1 to remove this endpoint and uninstall its agent.
            </MudAlert>
        }
        else if (request is { CompletedAt: { } completed } && DateTime.UtcNow - completed < TimeSpan.FromDays(1))
        {
            if (request.Failure is { } failure)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                    @(request.Kind == PatchRequestKind.Sync ? "The sync" : "Removing the Action1 agent") did not succeed
                    (<TimeText Value="completed" />): @failure
                </MudAlert>
            }
            else if (request.Kind == PatchRequestKind.RemoveAgent)
            {
                <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">
                    Action1 removed this endpoint (<TimeText Value="completed" />) and uninstalls its agent the next time the endpoint is online.
                    Fleeto sees the agent gone with the next inventory.
                </MudAlert>
            }
        }
    };

    /// <summary>
    /// Where the installation of the Action1 agent stands (0.6.0): on its way, failed with the reason and the next attempt,
    /// or done. Green only once Action1 reports the endpoint, and only for a day after an installation through Fleeto.
    /// </summary>
    private RenderFragment AgentInstallNotice(EndpointPatchView patches) => __builder =>
    {
        var install = patches.AgentInstall;
        switch (install?.Status)
        {
            case Action1AgentStatus.Installing:
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    Fleeto is installing the Action1 agent on this endpoint@(install.Attempts > 0 ? $" (attempt {install.Attempts + 1})" : "").
                    Patch management covers it as soon as Action1 reports it, usually within the hour.
                </MudAlert>
                break;
            case Action1AgentStatus.Failed:
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
                    Installing the Action1 agent failed: @install.Failure
                    @if (install.Automatic && install.NextAttemptAt is { } next)
                    {
                        <span>Fleeto tries again <TimeText Value="next" />.</span>
                    }
                </MudAlert>
                break;
            case Action1AgentStatus.Stopped:
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
                    Installing the Action1 agent failed @Ui.Count(install.Attempts, "time"), so Fleeto stopped trying: @install.Failure
                    Install it again once the cause is solved.
                </MudAlert>
                break;
            case Action1AgentStatus.Removed when install.Automatic:
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    The Action1 agent was removed through Fleeto, so the patch policy does not install it again by itself. Installing it by hand
                    lets the patch policy take care of it again.
                </MudAlert>
                break;
            case Action1AgentStatus.Missing when install.Automatic:
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    @(install.Failure ?? "The patch policy of this endpoint installs the Action1 agent automatically. Fleeto starts it within a few minutes.")
                </MudAlert>
                break;
            case Action1AgentStatus.Installed when install.ByFleeto && DateTime.UtcNow - install.UpdatedAt < TimeSpan.FromDays(1):
                <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">
                    The Action1 agent is installed and Action1 reports this endpoint (<TimeText Value="install.UpdatedAt" />).
                </MudAlert>
                break;
        }
    };

