    private static RenderFragment StorageChange(long? change) => __builder =>
    {
        if (change is not { } bytes)
        {
            <span class="muted">-</span>
        }
        else if (bytes == 0)
        {
            <span class="muted">0</span>
        }
        else
        {
            <span class="@(bytes > 0 ? "storage-grew" : "storage-shrank")">@Ui.BytesChange(bytes)</span>
        }
    };

    private void ToggleStorageFolder(string path)
    {
        if (!_storageExpanded.Remove(path))
        {
            _storageExpanded.Add(path);
        }
    }

    private async Task SelectStorageVolumeAsync(string volume)
    {
        _storageVolume = volume;
        _storageExpanded.Clear();
        await LoadAsync(LoadTabAsync);
    }

    private async Task RequestStorageScanAsync()
    {
        _storageScanning = true;
        try
        {
            var online = await RunForValueAsync(caller => StorageSvc.RequestScanAsync(caller, EndpointId), null);
            if (online is null)
            {
                return;
            }

            Snackbar.Add(online.Value
                ? "The agent is asked to scan its drives. The result appears here when it finishes."
                : "The endpoint is offline. The agent scans its drives if it connects within the next hour.", Severity.Info);
            await LoadAsync(LoadTabAsync);
        }
        finally
        {
            _storageScanning = false;
        }
    }

    /// <summary>Copies the summary of a drive as an image (0.7.0); the browser draws it from text formatted here.</summary>
    private async Task CopyStorageImageAsync(string volume)
    {
        _storageExporting = true;
        try
        {
            if (await RunForValueAsync(caller => StorageSvc.GetReportAsync(caller, EndpointId, volume, StorageReportFormat.Image), null) is not
                { Value: { } report })
            {
                return;
            }

            var outcome = await JS.InvokeAsync<string>("fleeto.copyStorageImage", Reports.StorageReportImage.From(report, t => Time.Short(t)));
            Snackbar.Add(outcome == "copied"
                ? "The storage summary is copied as an image. Paste it into a mail or a ticket."
                : "The browser did not allow copying an image, so it was downloaded instead.", Severity.Info);
        }
        catch (JSException)
        {
            Snackbar.Add("The image could not be made in this browser. Use Export PDF instead.", Severity.Warning);
        }
        finally
        {
            _storageExporting = false;
        }
    }

    /// <summary>Downloads the PDF report of a drive (0.7.0).</summary>
    private async Task ExportStoragePdfAsync(string volume)
    {
        _storageExporting = true;
        try
        {
            if (await RunForValueAsync(caller => StorageSvc.GetReportAsync(caller, EndpointId, volume, StorageReportFormat.Pdf), null) is not
                { Value: { } report })
            {
                return;
            }

            var pdf = Reports.StorageReportPdf.Render(report, t => Time.Short(t));
            await JS.InvokeVoidAsync("fleeto.saveFile", report.FileName("pdf"), "application/pdf", Convert.ToBase64String(pdf));
        }
        finally
        {
            _storageExporting = false;
        }
    }

    private async Task ShowStorageHistoryAsync(string volume, string path)
    {
        var parameters = new DialogParameters<StorageFolderHistoryDialog>
        {
            { d => d.EndpointId, EndpointId },
            { d => d.Volume, volume },
            { d => d.Path, path }
        };
        await DialogService.ShowAsync<StorageFolderHistoryDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
    }

    // The History tab (0.6.0): each list scrolls within a fixed height and is searched in the database, over everything the endpoint
    // has had, not only the newest rows that are shown.
    private const int HistoryLimit = 200;

    [Flags]
    private enum HistorySection
    {
        Alerts = 1,
        Connections = 2,
        Audit = 4,
        Maintenance = 8,
        Vulnerabilities = 16,
        All = Alerts | Connections | Audit | Maintenance | Vulnerabilities
    }

    // Found and ended vulnerabilities (0.8.0 step 3) belong to the history of a Linux endpoint only, like the Vulnerabilities tab.
    private bool ShowsVulnerabilityHistory => _endpoint?.OsPlatform == "linux" && Can(Permissions.VulnerabilitiesView);

    private async Task LoadHistoryAsync(Caller caller, HistorySection sections)
    {
        if (sections.HasFlag(HistorySection.Alerts))
        {
            _alerts = caller.Has(Permissions.AlertsView) ? await EndpointSvc.GetAlertsAsync(caller, EndpointId, HistoryLimit, _alertSearch) : [];
            _alertActivities = _alerts.Count > 0
                ? await AlertSvc.GetActivitiesAsync(caller, _alerts.Select(a => a.Id).ToList())
                : new Dictionary<Guid, IReadOnlyList<AlertActivityView>>();
        }

        if (sections.HasFlag(HistorySection.Maintenance))
        {
            _maintenance = await MaintenanceSvc.GetEndpointHistoryAsync(caller, EndpointId, HistoryLimit) ?? [];
        }

        if (sections.HasFlag(HistorySection.Connections))
        {
            _events = await EndpointSvc.GetEventsAsync(caller, EndpointId, HistoryLimit, _eventSearch);
        }

        if (sections.HasFlag(HistorySection.Vulnerabilities))
        {
            _vulnerabilityHistory = ShowsVulnerabilityHistory
                ? await VulnerabilitySvc.GetHistoryAsync(caller, EndpointId, HistoryLimit, _vulnerabilityHistorySearch)
                : [];
        }

        if (sections.HasFlag(HistorySection.Audit))
        {
            _audit = await EndpointSvc.GetAuditAsync(caller, EndpointId, HistoryLimit, _auditSearch);
        }
    }

    private async Task SearchAlertsAsync(string? search)
    {
        _alertSearch = search;
        await LoadAsync(caller => LoadHistoryAsync(caller, HistorySection.Alerts));
    }

    private async Task SearchEventsAsync(string? search)
    {
        _eventSearch = search;
        await LoadAsync(caller => LoadHistoryAsync(caller, HistorySection.Connections));
    }

    private async Task SearchVulnerabilityHistoryAsync(string? search)
    {
        _vulnerabilityHistorySearch = search;
        await LoadAsync(caller => LoadHistoryAsync(caller, HistorySection.Vulnerabilities));
    }

    private static (string Text, StatusKind Kind) HistoryKindChip(VulnerabilityHistoryKind kind) => kind switch
    {
        VulnerabilityHistoryKind.Found => ("Found", StatusKind.Warning),
        VulnerabilityHistoryKind.Fixed => ("Fixed", StatusKind.Ok),
        VulnerabilityHistoryKind.Removed => ("Package removed", StatusKind.Neutral),
        _ => ("Withdrawn", StatusKind.Neutral)
    };

    private async Task SearchAuditAsync(string? search)
    {
        _auditSearch = search;
        await LoadAsync(caller => LoadHistoryAsync(caller, HistorySection.Audit));
    }

    // Maintenance periods are few: the search filters what was loaded.
    private Task SearchMaintenanceAsync(string? search)
    {
        _maintenanceSearch = search;
        return Task.CompletedTask;
    }

    private IReadOnlyList<MaintenanceRecordView> FilteredMaintenance => string.IsNullOrWhiteSpace(_maintenanceSearch)
        ? _maintenance
        : _maintenance.Where(m => Matches(m.Reason) || Matches(m.StartedByName) || Matches(m.SourceName) || Matches(MaintenanceSourceText(m))).ToList();

    private bool Matches(string? text) => text?.Contains(_maintenanceSearch!.Trim(), StringComparison.OrdinalIgnoreCase) == true;

    private static string MaintenanceSourceText(MaintenanceRecordView record) => record.Source switch
    {
        MaintenanceSource.Client => $"Client {record.SourceName}",
        MaintenanceSource.Site => $"Site {record.SourceName}",
        _ => "This endpoint"
    };

    private RenderFragment HistoryHeader(string title, string placeholder, string? search, Func<string?, Task> onSearch) => __builder =>
    {
        <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
            <MudText Typo="Typo.h6" Class="section-title">@title</MudText>
            <MudTextField T="string" Value="search" ValueChanged="@(value => onSearch(value))" Placeholder="@placeholder" Immediate="true"
                          DebounceInterval="300" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Search" Style="max-width:320px" Clearable="true" />
        </div>
    };

    private RenderFragment HistoryFooter(int count, string? search, string noun) => __builder =>
    {
        @if (count >= HistoryLimit)
        {
            <MudText Typo="Typo.caption" Class="muted d-block mt-1">
                @(string.IsNullOrWhiteSpace(search)
                    ? $"Showing the newest {HistoryLimit} {noun}. Search to find older ones."
                    : $"Showing the newest {HistoryLimit} {noun} that match. Search more precisely to find older ones.")
            </MudText>
        }
    };

    private RenderFragment History() => __builder =>
    {
        @HistoryHeader("Maintenance", "Search maintenance", _maintenanceSearch, SearchMaintenanceAsync)
        @if (FilteredMaintenance.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="muted mb-5">
                @(string.IsNullOrWhiteSpace(_maintenanceSearch)
                    ? "Maintenance of this endpoint, its site and its client appears here."
                    : "No maintenance matches this search.")
            </MudText>
        }
        else
        {
            <MudTable Items="FilteredMaintenance" Dense="true" Elevation="0" FixedHeader="true" Class="history-table">
                <HeaderContent>
                    <MudTh>Started</MudTh>
                    <MudTh>Ended</MudTh>
                    <MudTh>On</MudTh>
                    <MudTh>Started by</MudTh>
                    <MudTh>Reason</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><TimeText Value="context.StartedAt" /></MudTd>
                    <MudTd>
                        @if (context.EndedAt is { } ended)
                        {
                            <TimeText Value="ended" />
                            @if (context.EndedEarly)
                            {
                                <div class="muted" style="font-size:0.75rem">Ended before its planned end</div>
                            }
                        }
                        else
                        {
                            <StatusChip Text="@(context.EndsAt is null ? "Until turned off" : $"Until {Time.Absolute(context.EndsAt)}")" Kind="StatusKind.Active" />
                        }
                    </MudTd>
                    <MudTd>@MaintenanceSourceText(context)</MudTd>
                    <MudTd>@(context.StartedByName ?? "-")</MudTd>
                    <MudTd><span style="white-space:pre-wrap">@(context.Reason ?? "-")</span></MudTd>
                </RowTemplate>
            </MudTable>
            @HistoryFooter(_maintenance.Count, _maintenanceSearch, "maintenance periods")
            <div class="mb-5"></div>
        }

        @HistoryHeader("Alerts", "Search alerts", _alertSearch, SearchAlertsAsync)
        @if (_alerts.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="muted mb-5">
                @(string.IsNullOrWhiteSpace(_alertSearch) ? "This endpoint has had no alerts." : "No alerts match this search.")
            </MudText>
        }
        else
        {
            var now = Clock.GetUtcNow().UtcDateTime;
            <MudTable Items="_alerts" Dense="true" Elevation="0" FixedHeader="true" Class="history-table">
                <HeaderContent>
                    <MudTh>Severity</MudTh>
                    <MudTh>State</MudTh>
                    <MudTh>Alert</MudTh>
                    <MudTh>Opened</MudTh>
                    <MudTh>Resolved</MudTh>
                    @if (AlertActions.AnyAction(Caller))
                    {
                        <MudTh Style="width:52px"></MudTh>
                    }
                </HeaderContent>
                <RowTemplate>
                    <MudTd><StatusChip Text="@context.Severity.ToString()" Kind="@Ui.SeverityKind(context.Severity)" /></MudTd>
                    <MudTd>
                        @if (context.IsHeld(now))
                        {
                            <StatusChip Text="@($"On hold until {Time.Absolute(context.HeldUntil)}")" Kind="StatusKind.Neutral" />
                        }
                        else
                        {
                            <StatusChip Text="@context.State.ToString()" Kind="@Ui.AlertStateKind(context.State)" />
                        }
                    </MudTd>
                    <MudTd>
                        @context.Title<div class="muted" style="font-size:0.75rem">@context.ResolvedReason</div>
                        <AlertActivityLines Activities="@_alertActivities.GetValueOrDefault(context.Id)" />
                    </MudTd>
                    <MudTd><TimeText Value="context.OpenedAt" /></MudTd>
                    <MudTd><TimeText Value="context.ResolvedAt" Never="-" /></MudTd>
                    @if (AlertActions.AnyAction(Caller))
                    {
                        <MudTd><AlertActions Alert="context" OnChanged="AfterActionAsync" /></MudTd>
                    }
                </RowTemplate>
            </MudTable>
            @HistoryFooter(_alerts.Count, _alertSearch, "alerts")
            <div class="mb-5"></div>
        }

        @if (ShowsVulnerabilityHistory)
        {
            @HistoryHeader("Vulnerabilities", "Search CVE or package", _vulnerabilityHistorySearch, SearchVulnerabilityHistoryAsync)
            @if (_vulnerabilityHistory.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="muted mb-5">
                    @(string.IsNullOrWhiteSpace(_vulnerabilityHistorySearch)
                        ? "Vulnerabilities found on this endpoint, and how they ended, appear here."
                        : "No vulnerabilities match this search.")
                </MudText>
            }
            else
            {
                <MudTable Items="_vulnerabilityHistory" Dense="true" Elevation="0" FixedHeader="true" Class="history-table">
                    <HeaderContent>
                        <MudTh>When</MudTh>
                        <MudTh>Event</MudTh>
                        <MudTh>CVE</MudTh>
                        <MudTh>Package</MudTh>
                        <MudTh>Severity</MudTh>
                        <MudTh>Version</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        @{ var chip = HistoryKindChip(context.Kind); }
                        <MudTd><TimeText Value="context.Time" /></MudTd>
                        <MudTd>
                            <StatusChip Text="@chip.Text" Kind="@chip.Kind"
                                        Title="@(context.Kind == VulnerabilityHistoryKind.Withdrawn ? "The security data no longer lists it for this package, or the endpoint was no longer checked." : null)" />
                        </MudTd>
                        <MudTd>@context.Cve</MudTd>
                        <MudTd>@(context.IsKernel ? $"Running kernel ({context.Package})" : context.Package)</MudTd>
                        <MudTd><StatusChip Text="@context.Severity.ToString()" Kind="@Ui.VulnerabilityKind(context.Severity)" /></MudTd>
                        <MudTd>
                            <span class="mono">@context.InstalledVersion</span>
                            @if (context.FixedVersion is { } fixedIn)
                            {
                                <div class="muted" style="font-size:0.75rem">Fixed in <span class="mono">@fixedIn</span></div>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
                @HistoryFooter(_vulnerabilityHistory.Count, _vulnerabilityHistorySearch, "vulnerability events")
                <div class="mb-5"></div>
            }
        }

        @HistoryHeader("Connections", "Search connections", _eventSearch, SearchEventsAsync)
        @if (_events.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="muted mb-5">
                @(string.IsNullOrWhiteSpace(_eventSearch) ? "Connects and disconnects of the agent appear here." : "No connections match this search.")
            </MudText>
        }
        else
        {
            <MudTable Items="_events" Dense="true" Elevation="0" FixedHeader="true" Class="history-table">
                <HeaderContent>
                    <MudTh>When</MudTh>
                    <MudTh>Event</MudTh>
                    <MudTh>Detail</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><TimeText Value="context.Time" /></MudTd>
                    <MudTd>
                        <StatusChip Text="@Ui.EventLabel(context.Kind)"
                                    Kind="@(context.Kind == EndpointEventKind.Connected ? StatusKind.Ok : context.Kind == EndpointEventKind.Disconnected ? StatusKind.Neutral : StatusKind.Error)" />
                    </MudTd>
                    <MudTd>@context.Detail</MudTd>
                </RowTemplate>
            </MudTable>
            @HistoryFooter(_events.Count, _eventSearch, "connections")
            <div class="mb-5"></div>
        }

        @HistoryHeader("Audit", "Search audit", _auditSearch, SearchAuditAsync)
        @if (_audit.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="muted">
                @(string.IsNullOrWhiteSpace(_auditSearch) ? "Changes to this endpoint appear here." : "No audit entries match this search.")
            </MudText>
        }
        else
        {
            <MudTable Items="_audit" Dense="true" Elevation="0" FixedHeader="true" Class="history-table history-table-tall">
                <HeaderContent>
                    <MudTh>When</MudTh>
                    <MudTh>Who</MudTh>
                    <MudTh>Action</MudTh>
                    <MudTh>Details</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><TimeText Value="context.Time" /></MudTd>
                    <MudTd>@context.ActorName</MudTd>
                    <MudTd><span class="mono">@context.Action</span></MudTd>
                    <MudTd><pre class="json-box">@Ui.PrettyJson(context.DetailsJson)</pre></MudTd>
                </RowTemplate>
            </MudTable>
            @HistoryFooter(_audit.Count, _auditSearch, "audit entries")
        }
    };

    private static string RowStatusText(EndpointCheckRow row) =>
        row.DisabledOnEndpoint ? "Disabled on this endpoint"
        : row.RerunRequested ? "Re-run requested"
        : row.Status is { } status ? status.ToString()
        : "Not run yet";

    private static StatusKind RowStatusKind(EndpointCheckRow row) =>
        row.DisabledOnEndpoint || row.RerunRequested || row.Status is null ? StatusKind.Neutral : Ui.CheckKind(row.Status.Value);

    private static string RowIcon(EndpointCheckRow row) =>
        row.DisabledOnEndpoint ? Icons.Material.Outlined.DoNotDisturbOn
        : row.RerunRequested || row.Status is null ? Icons.Material.Outlined.Schedule
        : CheckIcon(row.Status.Value);

    private static Color RowColor(EndpointCheckRow row) =>
        row.DisabledOnEndpoint || row.RerunRequested || row.Status is null ? Color.Default : CheckColor(row.Status.Value);

    // Where a check comes from (0.6.0): an icon with a tooltip, then the monitoring template or "Manual check".
    private static string SourceText(EndpointCheckRow row) =>
        row.Source == CheckSource.Endpoint ? "Manual check" : row.TemplateName ?? string.Empty;

    private static string SourceIcon(CheckSource source) => source switch
    {
        CheckSource.ClientTemplate => Icons.Material.Outlined.Business,
        CheckSource.SiteTemplate => Icons.Material.Outlined.Folder,
        CheckSource.EndpointTemplate => Icons.Material.Outlined.Computer,
        _ => Icons.Material.Outlined.EditNote
    };

    private static string SourceTooltip(CheckSource source) => source switch
    {
        CheckSource.ClientTemplate => "Monitoring template linked to the client",
        CheckSource.SiteTemplate => "Monitoring template linked to the site",
        CheckSource.EndpointTemplate => "Monitoring template linked to this endpoint",
        _ => "Manual check of this endpoint only"
    };

    private enum AlertAction
    {
        Acknowledge,
        Hold,
        EndHold,
        Resolve
    }

    [Inject] private AlertService AlertSvc { get; set; } = default!;

    private async Task AfterActionAsync()
    {
        await ReloadAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task AlertActionAsync(AlertView alert, AlertAction action)
    {
        var done = action switch
        {
            AlertAction.Acknowledge => await AlertActionPrompts.AcknowledgeAsync(DialogService, AlertSvc, alert, RunAsync),
            AlertAction.EndHold => await AlertActionPrompts.EndHoldAsync(DialogService, AlertSvc, alert, RunAsync),
            AlertAction.Resolve => await AlertActionPrompts.ResolveAsync(DialogService, AlertSvc, alert, RunAsync),
            _ => await AlertActionPrompts.HoldAsync(DialogService, AlertSvc, Time, alert, RunAsync)
        };
        if (done)
        {
            await AfterActionAsync();
        }
    }

    private async Task ShowHistoryAsync(EndpointCheckRow row)
    {
        var parameters = new DialogParameters<CheckHistoryDialog>
        {
            { d => d.EndpointId, EndpointId },
            { d => d.CheckId, row.DefinitionId },
            { d => d.Name, row.Name },
            { d => d.Target, row.Target }
        };
        await DialogService.ShowAsync<CheckHistoryDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
    }

    private async Task RunCheckAsync(EndpointCheckRow row, bool reset)
    {
        var result = await RunForValueAsync(caller => CheckSvc.RequestRunAsync(caller, EndpointId, row.DefinitionId, reset), null);
        if (result is null)
        {
            return;
        }

        var what = reset ? $"{row.Name} was reset and" : row.Name;
        Snackbar.Add(result.Value
                ? $"{what} will run on the agent now. The result appears here when it arrives."
                : $"The endpoint is offline. {what} runs when the agent connects within 10 minutes, otherwise at its next interval.",
            MudBlazor.Severity.Success);
        await AfterActionAsync();
    }

    private async Task SetDisabledAsync(EndpointCheckRow row, bool disabled)
    {
        if (await RunAsync(caller => CheckSvc.SetDisabledAsync(caller, EndpointId, row.DefinitionId, disabled),
                disabled ? $"{row.Name} no longer runs on this endpoint." : $"{row.Name} runs on this endpoint again."))
        {
            await AfterActionAsync();
        }
    }

    private async Task EditOverrideAsync(EndpointCheckRow row)
    {
        CheckOverrideView? view = null;
        await LoadAsync(async caller => view = await CheckSvc.GetOverrideAsync(caller, EndpointId, row.DefinitionId));
        if (view is null)
        {
            Snackbar.Add("This check no longer applies to this endpoint. Refresh the page.", MudBlazor.Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<CheckOverrideDialog>
        {
            { d => d.Check, view },
            { d => d.OnSubmit, input => RunAsync(caller => CheckSvc.SaveOverrideAsync(caller, EndpointId, row.DefinitionId, input), "The check was saved for this endpoint.") }
        };
        var dialog = await DialogService.ShowAsync<CheckOverrideDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dialog.Result)!.Canceled)
        {
            await AfterActionAsync();
        }
    }

    private async Task EditEndpointCheckAsync(EndpointDetail e, Guid? checkId)
    {
        CheckDefinitionView? existing = null;
        if (checkId is { } id)
        {
            await LoadAsync(async caller => existing = await CheckSvc.GetEndpointCheckAsync(caller, EndpointId, id));
            if (existing is null)
            {
                Snackbar.Add("This check no longer exists. Refresh the page.", MudBlazor.Severity.Warning);
                return;
            }
        }

        var parameters = new DialogParameters<CheckDialog>
        {
            { d => d.Existing, existing },
            { d => d.ForEndpoint, true },
            { d => d.EndpointPlatform, e.OsPlatform },
            { d => d.LoadServices, () => LoadServicesAsync() },
            { d => d.LoadScripts, () => LoadScriptsAsync(e.ClientId, e.OsPlatform) },
            {
                d => d.OnSubmit, input => RunAsync(caller => CheckSvc.SaveEndpointCheckAsync(caller, EndpointId, checkId, input),
                    checkId is null ? $"The check was added to {e.Hostname}." : "The check was saved.")
            }
        };
        var dialog = await DialogService.ShowAsync<CheckDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dialog.Result)!.Canceled)
        {
            await AfterActionAsync();
        }
    }

    private async Task<IReadOnlyList<ServiceOption>> LoadServicesAsync()
    {
        IReadOnlyList<ServiceOption> services = [];
        await LoadAsync(async caller => services = await CheckSvc.GetServicesAsync(caller, EndpointId));
        return services;
    }

    private async Task<IReadOnlyList<ScriptOption>> LoadScriptsAsync(Guid clientId, string platform)
    {
        IReadOnlyList<ScriptOption> scripts = [];
        await LoadAsync(async caller => scripts = await ScriptSvc.ListForChecksAsync(caller, clientId, platform));
        return scripts;
    }

    private async Task DeleteEndpointCheckAsync(EndpointCheckRow row)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { d => d.Title, "Delete check" },
            { d => d.Message, $"Delete the check {row.Name} from this endpoint? Its open alerts are resolved." }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(null, parameters);
        if ((await dialog.Result)!.Canceled)
        {
            return;
        }

        if (await RunAsync(caller => CheckSvc.DeleteEndpointCheckAsync(caller, EndpointId, row.DefinitionId), $"{row.Name} was deleted."))
        {
            await AfterActionAsync();
        }
    }

    private async Task EditTemplatesAsync(EndpointDetail e)
    {
        EndpointTemplateLinks? links = null;
        await LoadAsync(async caller => links = await CheckSvc.GetTemplateLinksAsync(caller, EndpointId));
        if (links is null)
        {
            return;
        }

        var parameters = new DialogParameters<EndpointTemplatesDialog>
        {
            { d => d.Hostname, e.Hostname },
            { d => d.Links, links },
            { d => d.OnSubmit, ids => RunAsync(caller => CheckSvc.SetEndpointTemplatesAsync(caller, EndpointId, ids), "The monitoring templates of this endpoint were saved.") }
        };
        var dialog = await DialogService.ShowAsync<EndpointTemplatesDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dialog.Result)!.Canceled)
        {
            await AfterActionAsync();
        }
    }

    private async Task EditNoteAsync(NoteView? note)
    {
        var parameters = new DialogParameters<NoteDialog>
        {
            { d => d.Existing, note },
            {
                d => d.OnSubmit, body => note is null
                    ? RunAsync(caller => NoteSvc.CreateAsync(caller, EndpointId, body), "The note was added.")
                    : RunAsync(caller => NoteSvc.UpdateAsync(caller, note.Id, body), "The note was saved.")
            }
        };
        var dialog = await DialogService.ShowAsync<NoteDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (!(await dialog.Result)!.Canceled)
        {
            await ReloadAsync();
        }
    }

    private async Task DeleteNoteAsync(NoteView note)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { d => d.Title, "Delete note" },
            { d => d.Message, $"Delete the note by {note.AuthorName}? This cannot be undone." }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(null, parameters);
        if ((await dialog.Result)!.Canceled)
        {
            return;
        }

        if (await RunAsync(caller => NoteSvc.DeleteAsync(caller, note.Id), "The note was deleted."))
        {
            await ReloadAsync();
        }
    }

    private Task MoreNotesAsync() => LoadAsync(async caller =>
    {
        var page = await NoteSvc.ListAsync(caller, EndpointId, _notes?.NextCursor);
        if (page is not null)
        {
            _noteItems.AddRange(page.Items);
            _notes = page;
        }
    });

    private IEnumerable<SoftwareInfo> FilteredSoftware =>
        _inventory is null ? []
        : string.IsNullOrWhiteSpace(_softwareSearch) ? _inventory.Software.OrderBy(s => s.Name, StringComparer.OrdinalIgnoreCase)
        : _inventory.Software.Where(s => s.Name.Contains(_softwareSearch, StringComparison.OrdinalIgnoreCase) ||
                                         s.Publisher.Contains(_softwareSearch, StringComparison.OrdinalIgnoreCase))
            .OrderBy(s => s.Name, StringComparer.OrdinalIgnoreCase);

    private static string CheckIcon(CheckStatus status) => status switch
    {
        CheckStatus.Ok => Icons.Material.Filled.CheckCircle,
        CheckStatus.Warning => Icons.Material.Filled.Error,
        CheckStatus.Critical => Icons.Material.Filled.Cancel,
        _ => Icons.Material.Filled.Help
    };

    private static Color CheckColor(CheckStatus status) => status switch
    {
        CheckStatus.Ok => Color.Primary,
        CheckStatus.Warning => Color.Warning,
        CheckStatus.Critical => Color.Error,
        _ => Color.Default
    };

    public override void Dispose()
    {
        Live.EndpointStatusChanged -= OnEndpointChange;
        Live.CheckResultsChanged -= OnEndpointChange;
        Live.AlertChanged -= OnAlertChange;
        Live.JobsChanged -= OnJobsChange;
        Live.TasksChanged -= OnTasksChange;
        Live.PatchDeploymentsChanged -= OnDeploymentChange;
        Live.StorageScansChanged -= OnStorageChange;
        Live.PatchRequestsChanged -= OnDeploymentChange;
        _refresh?.Dispose();
        base.Dispose();
    }
}
