@inherits FleetoPageBase
@using Fleeto.Infrastructure.Settings
@inject SettingsService SettingsSvc

@* Backup destination form, shared by Settings, Backups and the first-admin setup step. *@
<LoadState Loading="Loading" Failed="LoadFailed">
    <MudSelect T="BackupDestinationType" @bind-Value="_type" Label="Destination" Variant="Variant.Outlined" Class="mb-3">
        <MudSelectItem T="BackupDestinationType" Value="BackupDestinationType.S3">S3-compatible object storage (EU)</MudSelectItem>
        <MudSelectItem T="BackupDestinationType" Value="BackupDestinationType.Directory">Directory</MudSelectItem>
        <MudSelectItem T="BackupDestinationType" Value="BackupDestinationType.None">None (backups stay on this server only)</MudSelectItem>
    </MudSelect>

    @if (_type == BackupDestinationType.S3)
    {
        <MudTextField @bind-Value="_endpoint" Label="Endpoint URL" Variant="Variant.Outlined" MaxLength="255" Class="mb-3"
                      Placeholder="https://s3.eu-central-1.amazonaws.com" />
        <div class="d-flex gap-2 mb-3">
            <MudTextField @bind-Value="_region" Label="Region" Variant="Variant.Outlined" MaxLength="255" />
            <MudTextField @bind-Value="_bucket" Label="Bucket" Variant="Variant.Outlined" MaxLength="255" />
        </div>
        <MudTextField @bind-Value="_prefix" Label="Prefix (optional)" Variant="Variant.Outlined" MaxLength="255" Class="mb-3" />
        <MudTextField @bind-Value="_accessKey" Label="Access key" Variant="Variant.Outlined" MaxLength="255" Class="mb-3" />
        <MudTextField @bind-Value="_secret" Label="@(_hasSecret ? "Secret key (leave blank to keep the current key)" : "Secret key")"
                      Variant="Variant.Outlined" InputType="InputType.Password" MaxLength="1000" Class="mb-1" />
        <MudText Typo="Typo.caption" Class="muted d-block mb-3">
            Use credentials that can only write: no read and no delete. Set the retention period as a lifecycle rule on the bucket.
        </MudText>
    }
    else if (_type == BackupDestinationType.Directory)
    {
        <MudTextField @bind-Value="_directory" Label="Directory path" Variant="Variant.Outlined" MaxLength="500" Class="mb-3"
                      HelperText="A directory the workers container can write to, for example a mounted remote file system." />
    }

    @if (_type != BackupDestinationType.None)
    {
        <MudTextField @bind-Value="_publicKey" Label="Backup public key" Variant="Variant.Outlined" MaxLength="200" Class="mb-1" />
        <MudText Typo="Typo.caption" Class="muted d-block mb-3">
            Create the key pair offline with fleeto-tool backup keygen and paste the public key (fleeto-backup-pub:...). Keep the private key offline:
            without it, nobody can read a backup, including this server.
        </MudText>
    }

    <MudSelect T="int" @bind-Value="_hour" Label="Nightly backup at (UTC)" Variant="Variant.Outlined" Class="mb-4" Style="max-width:240px">
        @for (var hour = 0; hour < 24; hour++)
        {
            var value = hour;
            <MudSelectItem T="int" Value="@value">@($"{value:00}:00")</MudSelectItem>
        }
    </MudSelect>

    <div class="d-flex gap-2 flex-wrap">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy">@SaveText</MudButton>
        @if (SecondaryContent is not null)
        {
            @SecondaryContent
        }
    </div>
</LoadState>

@code {
    [Parameter] public string SaveText { get; set; } = "Save";
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public RenderFragment? SecondaryContent { get; set; }

    private BackupDestinationType _type = BackupDestinationType.S3;
    private string? _endpoint;
    private string? _region;
    private string? _bucket;
    private string? _prefix;
    private string? _accessKey;
    private string? _secret;
    private bool _hasSecret;
    private string? _directory;
    private string? _publicKey;
    private int _hour = 2;
    private bool _busy;

    protected override Task OnInitializedAsync() => LoadAsync(async caller =>
    {
        var backup = await SettingsSvc.GetBackupAsync(caller);
        _type = backup.DestinationType == BackupDestinationType.None && string.IsNullOrEmpty(backup.PublicKey) ? BackupDestinationType.S3 : backup.DestinationType;
        _endpoint = backup.S3Endpoint;
        _region = backup.S3Region;
        _bucket = backup.S3Bucket;
        _prefix = backup.S3Prefix;
        _accessKey = backup.S3AccessKeyId;
        _hasSecret = backup.HasS3Secret;
        _directory = backup.DirectoryPath;
        _publicKey = backup.PublicKey;
        _hour = backup.ScheduleHourUtc;
    });

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            var input = new BackupInput(_type, _endpoint, _region, _bucket, _prefix, _accessKey, _secret, _directory, _publicKey, _hour);
            if (await RunAsync(caller => SettingsSvc.SaveBackupAsync(caller, input), "The backup settings were saved."))
            {
                _secret = null;
                _hasSecret = _hasSecret || _type == BackupDestinationType.S3;
                await OnSaved.InvokeAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
