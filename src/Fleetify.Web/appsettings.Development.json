{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Fleetify": {
    "Database": {
      "Host": "localhost",
      "Port": 5432,
      "Name": "fleetify_dev"
    }
  },
  "Web": {
    "HttpPort": 0
  },
  "ReverseProxy": {
    "Enabled": false,
    "KnownNetworks": []
  },
  "DataProtection": {
    "KeysDirectory": "%LOCALAPPDATA%/Fleetify/dev/web-keys"
  },
  "Agent": {
    "BinariesDirectory": "../../agent/dist"
  }
}
