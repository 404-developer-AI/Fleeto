@* Add or edit a check of a monitoring template or of one endpoint. Types, parameters, thresholds and help texts come from
   CheckCatalog; validation messages come from CheckParameters.Validate on save. *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(Existing is null ? "New check" : $"Edit check {Existing.Name}")</MudText>
    </TitleContent>
    <DialogContent>
        <MudSelect T="CheckType" Value="_type" ValueChanged="OnTypeChanged" Label="Check type" Variant="Variant.Outlined" Class="mb-1"
                   Disabled="@(Existing is not null)">
            @foreach (var info in AvailableTypes)
            {
                <MudSelectItem T="CheckType" Value="info.Type">@info.Label</MudSelectItem>
            }
        </MudSelect>
        <MudText Typo="Typo.caption" Class="muted d-block mb-3">
            @Info.Description @(Info.Platforms == CheckPlatforms.All ? "" : $"Runs on {CheckCatalog.PlatformLabel(Info.Platforms)}.")
        </MudText>
        <MudTextField @bind-Value="_name" Label="Name" Variant="Variant.Outlined" MaxLength="100" Class="mb-3" />

        @foreach (var spec in Info.Parameters.Where(s => s.AppliesTo(_type, _values)))
        {
            @ParameterField(spec)
        }

        <MudText Typo="Typo.subtitle2" Class="mb-1">Interval</MudText>
        <div class="d-flex gap-2 mb-1">
            <MudNumericField T="int" @bind-Value="_intervalAmount" Variant="Variant.Outlined" Min="1" Max="100000" Style="max-width:140px" />
            <MudSelect T="int" @bind-Value="_intervalUnit" Variant="Variant.Outlined" Style="max-width:180px">
                <MudSelectItem T="int" Value="1">seconds</MudSelectItem>
                <MudSelectItem T="int" Value="60">minutes</MudSelectItem>
                <MudSelectItem T="int" Value="3600">hours</MudSelectItem>
                <MudSelectItem T="int" Value="86400">days</MudSelectItem>
            </MudSelect>
        </div>
        <MudText Typo="Typo.caption" Class="muted d-block mb-3">Runs @Intervals.Describe(Math.Max(1, IntervalSeconds)).</MudText>

        @if (ThresholdKind == ThresholdKind.ExitCode)
        {
            <MudText Typo="Typo.caption" Class="muted d-block mb-3">@Info.ThresholdHelp</MudText>
        }
        else if (ThresholdKind == ThresholdKind.Flag)
        {
            <MudSwitch T="bool" @bind-Value="_flagWarningOnly" Color="Color.Primary" Label="@(Info.FlagWarningLabel ?? "Report a problem as a warning instead of critical")" Class="mb-3" />
        }
        else
        {
            <MudText Typo="Typo.caption" Class="muted d-block mb-2">@Info.ThresholdHelp</MudText>
            <div class="d-flex gap-2 mb-3">
                <MudNumericField T="double?" @bind-Value="_warning" Label="@UnitLabel("Warning")" Variant="Variant.Outlined" Clearable="true" />
                <MudNumericField T="double?" @bind-Value="_critical" Label="@UnitLabel("Critical")" Variant="Variant.Outlined" Clearable="true" />
            </div>
        }

        <MudNumericField T="int" @bind-Value="_failures" Label="Failed results before an alert opens" Variant="Variant.Outlined" Min="1" Max="100" Class="mb-3" />
        @if (!ForEndpoint)
        {
            <MudSelect T="CheckAppliesTo" @bind-Value="_appliesTo" Label="Runs on" Variant="Variant.Outlined" Class="mb-3">
                <MudSelectItem T="CheckAppliesTo" Value="CheckAppliesTo.All">All endpoints</MudSelectItem>
                <MudSelectItem T="CheckAppliesTo" Value="CheckAppliesTo.Workstation">Workstations only</MudSelectItem>
                <MudSelectItem T="CheckAppliesTo" Value="CheckAppliesTo.Server">Servers only</MudSelectItem>
            </MudSelect>
        }
        <MudSwitch T="bool" @bind-Value="_enabled" Color="Color.Primary" Label="Enabled" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">@(Existing is null ? "Add check" : "Save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public CheckDefinitionView? Existing { get; set; }

    /// <summary>A check that exists only on one endpoint: it runs whatever the endpoint class, so "Runs on" is hidden.</summary>
    [Parameter] public bool ForEndpoint { get; set; }

    /// <summary>For a check on one endpoint: its platform, so only check types that run there are offered.</summary>
    [Parameter] public string? EndpointPlatform { get; set; }

    /// <summary>Loads the services to suggest for a service check (from the endpoint, or from the endpoints of a template).</summary>
    [Parameter] public Func<Task<IReadOnlyList<ServiceOption>>>? LoadServices { get; set; }

    /// <summary>Loads the scripts a script check may use.</summary>
    [Parameter] public Func<Task<IReadOnlyList<ScriptOption>>>? LoadScripts { get; set; }

    [Parameter] public Func<CheckDefinitionInput, Task<bool>> OnSubmit { get; set; } = _ => Task.FromResult(true);

    private CheckType _type = CheckType.CpuUsage;
    private string _name = "CPU usage";
    private readonly Dictionary<string, string> _values = new(StringComparer.Ordinal);
    private int _intervalAmount = 5;
    private int _intervalUnit = 60;
    private double? _warning = 85;
    private double? _critical = 95;
    private bool _flagWarningOnly;
    private int _failures = 1;
    private CheckAppliesTo _appliesTo = CheckAppliesTo.All;
    private bool _enabled = true;
    private bool _busy;
    private IReadOnlyList<ServiceOption>? _services;
    private IReadOnlyList<ScriptOption>? _scripts;

    private CheckTypeInfo Info => CheckCatalog.Get(_type);

    private ThresholdKind ThresholdKind => Info.ThresholdKindFor(_values);

    private IEnumerable<CheckTypeInfo> AvailableTypes =>
        CheckCatalog.All.Where(t => (!ForEndpoint || CheckCatalog.IsSupported(t.Type, EndpointPlatform) || t.Type == Existing?.Type) &&
                                    (t.Type != CheckType.Script || LoadScripts is not null));

    private int IntervalSeconds => (int)Math.Min(int.MaxValue, (long)_intervalAmount * _intervalUnit);

    private string UnitLabel(string label)
    {
        var unit = Info.UnitFor(_values);
        return string.IsNullOrEmpty(unit) ? label : $"{label} ({unit})";
    }

    protected override async Task OnInitializedAsync()
    {
        OnInitializedCore();
        if (LoadScripts is not null)
        {
            _scripts = await LoadScripts();
        }
    }

    private void OnInitializedCore()
    {
        if (Existing is not { } c)
        {
            ApplyDefaults(_type);
            return;
        }

        _type = c.Type;
        _name = c.Name;
        foreach (var (key, value) in c.Parameters)
        {
            _values[key] = value;
        }

        (_intervalAmount, _intervalUnit) = SplitInterval(c.IntervalSeconds);
        _warning = c.WarningThreshold;
        _critical = c.CriticalThreshold;
        _flagWarningOnly = c.WarningThreshold >= 1;
        _failures = c.FailuresBeforeAlert;
        _appliesTo = c.AppliesTo;
        _enabled = c.Enabled;
    }

    private static (int, int) SplitInterval(int seconds) =>
        seconds % 86400 == 0 ? (seconds / 86400, 86400)
        : seconds % 3600 == 0 ? (seconds / 3600, 3600)
        : seconds % 60 == 0 ? (seconds / 60, 60)
        : (seconds, 1);

    private void OnTypeChanged(CheckType type)
    {
        _type = type;
        ApplyDefaults(type);
    }

    /// <summary>Sensible defaults for a new check of this type: name, interval, thresholds and parameters.</summary>
    private void ApplyDefaults(CheckType type)
    {
        var info = CheckCatalog.Get(type);
        _name = info.Label;
        (_intervalAmount, _intervalUnit) = SplitInterval(info.DefaultIntervalSeconds);
        _warning = info.DefaultWarning;
        _critical = info.DefaultCritical;
        _flagWarningOnly = info.DefaultWarning >= 1;
        _values.Clear();
        foreach (var spec in info.Parameters.Where(s => s.Default is not null))
        {
            _values[spec.Name] = spec.Default!;
        }
    }

    private string Value(string name) => _values.TryGetValue(name, out var value) ? value : string.Empty;

    private void SetValue(string name, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            _values.Remove(name);
        }
        else
        {
            _values[name] = value;
        }
    }

    private RenderFragment ParameterField(CheckParameterSpec spec) => __builder =>
    {
        switch (spec.Kind)
        {
            case ParameterKind.Integer:
                <MudNumericField T="int?" Value="@(int.TryParse(Value(spec.Name), out var number) ? number : null)"
                                 ValueChanged="@(v => SetValue(spec.Name, v?.ToString(System.Globalization.CultureInfo.InvariantCulture)))"
                                 Label="@spec.Label" HelperText="@spec.Help" Variant="Variant.Outlined" Min="spec.Min" Max="spec.Max" Clearable="@(!spec.Required)" Class="mb-3" />
                break;
            case ParameterKind.Choice:
                <MudSelect T="string" Value="@Value(spec.Name)" ValueChanged="@(v => SetValue(spec.Name, v))" Label="@spec.Label" HelperText="@spec.Help"
                           Variant="Variant.Outlined" Class="mb-3">
                    @foreach (var choice in spec.Choices ?? [])
                    {
                        <MudSelectItem T="string" Value="choice.Value">@choice.Label</MudSelectItem>
                    }
                </MudSelect>
                break;
            case ParameterKind.Boolean:
                <MudSwitch T="bool" Value="@(Value(spec.Name) == "true")" ValueChanged="@(v => SetValue(spec.Name, v ? "true" : "false"))"
                           Color="Color.Primary" Label="@spec.Label" Class="mb-0" />
                @if (spec.Help is not null)
                {
                    <MudText Typo="Typo.caption" Class="muted d-block mb-3">@spec.Help</MudText>
                }
                break;
            case ParameterKind.Script:
                <MudSelect T="string" Value="@Value(spec.Name)" ValueChanged="@(v => SetValue(spec.Name, v))" Label="@spec.Label" HelperText="@spec.Help"
                           Variant="Variant.Outlined" Class="mb-3">
                    @foreach (var script in _scripts ?? [])
                    {
                        <MudSelectItem T="string" Value="@script.Id.ToString("D")">
                            @script.Name (@ScriptLanguages.Label(script.Language)@(script.ClientCode is null ? "" : $", {script.ClientCode}"))
                        </MudSelectItem>
                    }
                    @if (Value(spec.Name) is { Length: > 0 } chosen && _scripts?.Any(s => s.Id.ToString("D") == chosen) != true)
                    {
                        <MudSelectItem T="string" Value="chosen">Script not available</MudSelectItem>
                    }
                </MudSelect>
                @if (_scripts is { Count: 0 })
                {
                    <MudText Typo="Typo.caption" Class="muted d-block mb-3">
                        There is no script this check can use@(ForEndpoint ? " on this endpoint" : ""). Add one under Settings, Scripts.
                    </MudText>
                }
                break;
            case ParameterKind.Service when LoadServices is not null:
                <MudAutocomplete T="string" Value="@Value(spec.Name)" ValueChanged="@(v => SetValue(spec.Name, v))" SearchFunc="SearchServicesAsync"
                                 CoerceValue="true" CoerceText="false" Label="@spec.Label" HelperText="@spec.Help" Variant="Variant.Outlined"
                                 MaxLength="spec.MaxLength" MaxItems="100" Class="mb-3">
                    <ItemTemplate Context="name">
                        @{ var service = _services?.FirstOrDefault(s => s.Name == name); }
                        <div>
                            <div>@(string.IsNullOrEmpty(service?.DisplayName) ? name : service.DisplayName)</div>
                            <div class="muted" style="font-size:0.75rem">@name@(string.IsNullOrEmpty(service?.State) ? "" : $" · {service.State}")</div>
                        </div>
                    </ItemTemplate>
                </MudAutocomplete>
                break;
            default:
                <MudTextField T="string" Value="@Value(spec.Name)" ValueChanged="@(v => SetValue(spec.Name, v))" Label="@spec.Label" HelperText="@spec.Help"
                              Variant="Variant.Outlined" MaxLength="spec.MaxLength" Class="mb-3" />
                break;
        }
    };

    private async Task<IEnumerable<string>> SearchServicesAsync(string? text, CancellationToken cancellationToken)
    {
        _services ??= LoadServices is null ? [] : await LoadServices();
        var matches = string.IsNullOrWhiteSpace(text)
            ? _services
            : _services.Where(s => s.Name.Contains(text, StringComparison.OrdinalIgnoreCase) || s.DisplayName.Contains(text, StringComparison.OrdinalIgnoreCase));
        return matches.Select(s => s.Name);
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        _busy = true;
        try
        {
            var kind = ThresholdKind;
            var warning = kind == ThresholdKind.Flag ? (_flagWarningOnly ? 1d : null) : kind == ThresholdKind.ExitCode ? null : _warning;
            var critical = kind is ThresholdKind.Flag or ThresholdKind.ExitCode ? null : _critical;
            var input = new CheckDefinitionInput(_name, _type, IntervalSeconds, new Dictionary<string, string>(_values), warning, critical, _failures,
                _appliesTo, _enabled);
            if (await OnSubmit(input))
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
