@inject IJSRuntime JS
@inject ISnackbar Snackbar

@* Shows a new secret exactly once. Nothing here is stored; closing the dialog discards it. *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">@Message This secret is shown only once.</MudText>
        <div class="command-box mb-3">@Secret</div>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.ContentCopy" OnClick="CopyAsync">Copy secret</MudButton>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Close">Done</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Message { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Secret { get; set; } = string.Empty;

    private void Close() => MudDialog.Close(DialogResult.Ok(true));

    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("fleeto.copyText", Secret);
            Snackbar.Add("Copied to the clipboard.", Severity.Success);
        }
        catch (JSException)
        {
            Snackbar.Add("Copying did not work in this browser. Select the text and copy it with Ctrl+C.", Severity.Info);
        }
    }
}
