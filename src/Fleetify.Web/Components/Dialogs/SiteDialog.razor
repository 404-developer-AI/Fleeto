@* Create or edit a site. *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsEdit ? "Edit site" : "New site")</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="Site name" Variant="Variant.Outlined" MaxLength="100" AutoFocus="true"
                      HelperText="For example Monitoring, Agent Only or XDR Only." Class="mb-3" />
        <MudTextField @bind-Value="_description" Label="Description (optional)" Variant="Variant.Outlined" Lines="2" MaxLength="1000" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">@(IsEdit ? "Save" : "Create site")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public string InitialName { get; set; } = string.Empty;
    [Parameter] public string? InitialDescription { get; set; }
    [Parameter] public Func<string, string?, Task<bool>> OnSubmit { get; set; } = (_, _) => Task.FromResult(true);

    private string _name = string.Empty;
    private string? _description;
    private bool _busy;

    protected override void OnInitialized()
    {
        _name = InitialName;
        _description = InitialDescription;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        _busy = true;
        try
        {
            if (await OnSubmit(_name, _description))
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
