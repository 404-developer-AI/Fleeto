@page "/settings/backups"
@attribute [Authorize(Policy = FleetifyPolicies.Admin)]
@inherits FleetoPageBase
@inject SettingsService SettingsSvc

<PageTitle>Backups - Fleeto</PageTitle>

<div class="page-header">
    <div>
        <MudText Typo="Typo.h4" Class="page-title">Backups</MudText>
        <MudText Typo="Typo.body2" Class="muted">
            A nightly database backup, encrypted on this server with the backup public key before it is uploaded.
        </MudText>
    </div>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Backup" OnClick="BackUpNowAsync">Back up now</MudButton>
</div>

<MudGrid Spacing="3">
    <MudItem xs="12" md="6">
        <div class="fl-panel pa-4">
            <MudText Typo="Typo.h6" Class="section-title mb-3">Destination</MudText>
            <BackupForm OnSaved="ReloadAsync" />
        </div>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudText Typo="Typo.h6" Class="section-title mb-2">Recent backups</MudText>
        <LoadState Loading="Loading" Failed="LoadFailed">
            @if (_requestedAt is not null)
            {
                <MudText Typo="Typo.body2" Class="muted mb-2">Last manual request: <TimeText Value="_requestedAt" /></MudText>
            }
            @if (_runs.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Outlined.Backup" Title="No backups yet"
                            Text="The first backup runs at the scheduled hour, or start one with Back up now." />
            }
            else
            {
                <MudTable Items="_runs" Dense="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Started</MudTh>
                        <MudTh>Kind</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Size</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd><TimeText Value="context.StartedAt" /></MudTd>
                        <MudTd>@context.Kind</MudTd>
                        <MudTd>
                            <StatusChip Text="@context.Status.ToString()"
                                        Kind="@(context.Status == BackupRunStatus.Succeeded ? StatusKind.Ok : context.Status == BackupRunStatus.Running ? StatusKind.Active : StatusKind.Error)" />
                            @if (!string.IsNullOrEmpty(context.Error))
                            {
                                <div style="color:var(--fl-error);font-size:0.75rem">@context.Error</div>
                            }
                        </MudTd>
                        <MudTd>@(context.SizeBytes > 0 ? Ui.Bytes(context.SizeBytes) : "-")</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </LoadState>
    </MudItem>
</MudGrid>

@code {
    private IReadOnlyList<BackupRunView> _runs = [];
    private DateTime? _requestedAt;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync() => LoadAsync(async caller =>
    {
        _runs = await SettingsSvc.ListBackupRunsAsync(caller);
        _requestedAt = (await SettingsSvc.GetBackupAsync(caller)).RequestedAt;
    });

    private async Task BackUpNowAsync()
    {
        if (await RunAsync(caller => SettingsSvc.RequestBackupNowAsync(caller), "A backup was requested. It starts within a minute."))
        {
            await ReloadAsync();
        }
    }
}
