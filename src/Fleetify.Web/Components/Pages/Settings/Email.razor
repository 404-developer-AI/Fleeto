@page "/settings/email"
@attribute [Authorize(Policy = FleetifyPolicies.Admin)]
@inherits FleetoPageBase
@using Fleetify.Infrastructure.Settings
@inject SettingsService SettingsSvc
@inject IJSRuntime JS

<PageTitle>Email - Fleeto</PageTitle>

<div class="page-header">
    <div>
        <MudText Typo="Typo.h4" Class="page-title">Email</MudText>
        <MudText Typo="Typo.body2" Class="muted">How Fleeto sends alert notifications, license reminders and warnings: through an SMTP server or Microsoft Graph.</MudText>
    </div>
</div>

<LoadState Loading="Loading" Failed="LoadFailed">
    <div class="fl-panel pa-4 mb-4" style="max-width:720px">
        <MudText Typo="Typo.h6" Class="mb-2">Delivery method</MudText>
        <MudRadioGroup T="EmailProvider" @bind-Value="_provider">
            <MudRadio T="EmailProvider" Value="EmailProvider.Smtp" Color="Color.Primary">SMTP server</MudRadio>
            <MudRadio T="EmailProvider" Value="EmailProvider.MicrosoftGraph" Color="Color.Primary" Disabled="@(!_graphComplete)">Microsoft Graph</MudRadio>
        </MudRadioGroup>
        <MudText Typo="Typo.caption" Class="muted d-block mb-3">
            @if (!_graphComplete)
            {
                <span>Microsoft Graph can be chosen once its settings below are saved with a client secret or a certificate.</span>
            }
            else
            {
                <span>With Microsoft Graph, the SMTP server below is used while the Graph credential has expired, when it is configured.</span>
            }
        </MudText>
        <div class="d-flex gap-2 flex-wrap">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveProviderAsync" Disabled="@(_busy || _provider == _savedProvider)">Use this method</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="TestAsync" Disabled="_busy">Send test email</MudButton>
        </div>
        <MudText Typo="Typo.caption" Class="muted d-block mt-2">The test email goes to @(Caller?.Email) and is normally delivered within a minute.</MudText>
    </div>

    <div class="fl-panel pa-4 mb-4" style="max-width:720px">
        <MudText Typo="Typo.h6">Microsoft Graph</MudText>
        <MudText Typo="Typo.body2" Class="muted mb-3">
            An app registration in Microsoft Entra ID with the Mail.Send application permission and admin consent. Limit it to the sending
            mailbox with an Exchange application access policy, so the registration cannot send as anyone else.
        </MudText>
        <MudTextField @bind-Value="_tenantId" Label="Directory (tenant) ID" Variant="Variant.Outlined" MaxLength="255" Class="mb-3" />
        <MudTextField @bind-Value="_clientId" Label="Application (client) ID" Variant="Variant.Outlined" MaxLength="36" Class="mb-3" />
        <MudTextField @bind-Value="_sender" Label="Send as mailbox" Variant="Variant.Outlined" MaxLength="320" Class="mb-3" />
        <MudSelect T="GraphCredentialType" @bind-Value="_credentialType" Label="Credential" Variant="Variant.Outlined" Class="mb-3">
            <MudSelectItem T="GraphCredentialType" Value="GraphCredentialType.ClientSecret">Client secret</MudSelectItem>
            <MudSelectItem T="GraphCredentialType" Value="GraphCredentialType.Certificate">Certificate (recommended)</MudSelectItem>
        </MudSelect>

        @if (_credentialType == GraphCredentialType.ClientSecret)
        {
            <MudTextField @bind-Value="_secret" Label="@(_graph.HasClientSecret ? "Client secret value (leave blank to keep the current secret)" : "Client secret value")"
                          Variant="Variant.Outlined" InputType="InputType.Password" MaxLength="1000" Class="mb-3" />
            <MudDatePicker @bind-Date="_secretEndsOn" Label="Secret expires on" Variant="Variant.Outlined" Class="mb-1" DateFormat="yyyy-MM-dd" />
            <MudText Typo="Typo.caption" Class="muted d-block mb-3">
                The date under Certificates &amp; secrets in the app registration. Fleeto warns 30 days before it.
                @if (_graph.HasClientSecret && _graph.ClientSecretExpiresAt is { } ends)
                {
                    <span> The stored secret expires on @Time.Absolute(ends).</span>
                }
            </MudText>
        }
        else
        {
            <div class="mb-3">
                @if (_graph.CertificateThumbprint is { } thumbprint)
                {
                    <MudText Typo="Typo.body2">In use: thumbprint <code>@thumbprint</code>, expires on @Time.Absolute(_graph.CertificateExpiresAt).</MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2">No certificate is in use yet.</MudText>
                }
                @if (_graph.PendingCertificateThumbprint is { } pending)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                        New certificate <code>@pending</code>, expires on @Time.Absolute(_graph.PendingCertificateExpiresAt). Download it, upload it under
                        Certificates &amp; secrets in the app registration, then switch to it.
                    </MudAlert>
                }
                <div class="d-flex gap-2 flex-wrap mt-2">
                    <MudButton Variant="Variant.Outlined" OnClick="CreateCertificateAsync" Disabled="_busy">
                        @(_graph.CertificateThumbprint is null && _graph.PendingCertificateThumbprint is null ? "Create certificate" : "Create new certificate")
                    </MudButton>
                    @if (_graph.PendingCertificateThumbprint is not null || _graph.CertificateThumbprint is not null)
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Download" OnClick="DownloadCertificateAsync" Disabled="_busy">
                            Download public certificate
                        </MudButton>
                    }
                    @if (_graph.PendingCertificateThumbprint is not null)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ActivateCertificateAsync" Disabled="_busy">Switch to the new certificate</MudButton>
                    }
                </div>
                <MudText Typo="Typo.caption" Class="muted d-block mt-2">
                    The private key never leaves Fleeto. A certificate is valid for two years; Fleeto warns 30 days before it expires.
                </MudText>
            </div>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveGraphAsync" Disabled="_busy">Save Microsoft Graph settings</MudButton>
    </div>

    <div class="fl-panel pa-4" style="max-width:720px">
        <MudText Typo="Typo.h6" Class="mb-3">SMTP server</MudText>
        <MudTextField @bind-Value="_host" Label="SMTP host" Variant="Variant.Outlined" MaxLength="255" Class="mb-3" />
        <div class="d-flex gap-2 mb-3">
            <MudNumericField T="int" @bind-Value="_port" Label="Port" Variant="Variant.Outlined" Min="1" Max="65535" Style="max-width:140px" />
            <MudSelect T="SmtpSecurity" @bind-Value="_security" Label="Security" Variant="Variant.Outlined">
                <MudSelectItem T="SmtpSecurity" Value="SmtpSecurity.StartTls">STARTTLS</MudSelectItem>
                <MudSelectItem T="SmtpSecurity" Value="SmtpSecurity.Tls">TLS</MudSelectItem>
                <MudSelectItem T="SmtpSecurity" Value="SmtpSecurity.None">None (not recommended)</MudSelectItem>
            </MudSelect>
        </div>
        <MudTextField @bind-Value="_username" Label="Username (optional)" Variant="Variant.Outlined" MaxLength="320" Class="mb-3" />
        <MudTextField @bind-Value="_password" Label="@(_hasPassword ? "Password (leave blank to keep the current password)" : "Password (optional)")"
                      Variant="Variant.Outlined" InputType="InputType.Password" MaxLength="1000" Class="mb-1" />
        @if (_hasPassword)
        {
            <MudCheckBox T="bool" @bind-Value="_clearPassword" Label="Remove the stored password" Size="Size.Small" Class="mb-3" />
        }
        <MudTextField @bind-Value="_fromAddress" Label="Sender address" Variant="Variant.Outlined" MaxLength="320" Class="mb-3 mt-2" />
        <MudTextField @bind-Value="_fromName" Label="Sender name" Variant="Variant.Outlined" MaxLength="100" Class="mb-4" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy">Save SMTP settings</MudButton>
    </div>
</LoadState>

@code {
    private EmailProvider _provider;
    private EmailProvider _savedProvider;
    private GraphView _graph = new("", "", "", GraphCredentialType.ClientSecret, false, null, null, null, null, null, false);
    private bool _graphComplete;
    private string? _tenantId;
    private string? _clientId;
    private string? _sender;
    private GraphCredentialType _credentialType;
    private string? _secret;
    private DateTime? _secretEndsOn;

    private string? _host;
    private int _port = 587;
    private SmtpSecurity _security = SmtpSecurity.StartTls;
    private string? _username;
    private string? _password;
    private bool _hasPassword;
    private bool _clearPassword;
    private string? _fromAddress;
    private string? _fromName = "Fleeto";
    private bool _busy;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync() => LoadAsync(async caller =>
    {
        var email = await SettingsSvc.GetEmailAsync(caller);
        _provider = _savedProvider = email.Provider;
        _graph = email.Graph;
        _graphComplete = email.Graph.IsComplete;
        _tenantId = email.Graph.TenantId;
        _clientId = email.Graph.ClientId;
        _sender = email.Graph.SenderAddress;
        _credentialType = email.Graph.CredentialType;
        _secret = null;
        _secretEndsOn = email.Graph.ClientSecretExpiresAt?.Date;

        var smtp = email.Smtp;
        _host = smtp.Host;
        _port = smtp.Port;
        _security = smtp.Security;
        _username = smtp.Username;
        _hasPassword = smtp.HasPassword;
        _fromAddress = smtp.FromAddress;
        _fromName = smtp.FromName;
        _password = null;
        _clearPassword = false;
    });

    private async Task BusyAsync(Func<Task<bool>> action, bool reload = true)
    {
        _busy = true;
        try
        {
            if (await action() && reload)
            {
                await ReloadAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private Task SaveProviderAsync() =>
        BusyAsync(() => RunAsync(caller => SettingsSvc.SaveProviderAsync(caller, _provider), "The delivery method was saved."));

    private Task SaveGraphAsync() =>
        BusyAsync(() => RunAsync(caller => SettingsSvc.SaveGraphAsync(caller,
            new GraphInput(_tenantId, _clientId, _sender, _credentialType, _secret, _secretEndsOn)), "The Microsoft Graph settings were saved."));

    private Task CreateCertificateAsync() =>
        BusyAsync(() => RunAsync(caller => SettingsSvc.CreateGraphCertificateAsync(caller),
            "A new certificate was created. Download it and upload it to the app registration."));

    private Task ActivateCertificateAsync() =>
        BusyAsync(() => RunAsync(caller => SettingsSvc.ActivateGraphCertificateAsync(caller),
            "Fleeto now signs in with the new certificate. Send a test email to confirm."));

    private Task DownloadCertificateAsync() => BusyAsync(async () =>
    {
        if ((await RunForValueAsync(caller => SettingsSvc.GetGraphPublicCertificateAsync(caller), null))?.Value is not { } certificate)
        {
            return false;
        }

        try
        {
            await JS.InvokeVoidAsync("fleeto.saveFile", $"fleeto-email-{certificate.Thumbprint[..Math.Min(8, certificate.Thumbprint.Length)]}.cer",
                "application/pkix-cert", Convert.ToBase64String(certificate.Der));
        }
        catch (JSException)
        {
            Snackbar.Add("The download did not start in this browser. Try another browser.", Severity.Warning);
        }

        return false;
    }, reload: false);

    private Task SaveAsync() =>
        BusyAsync(() => RunAsync(caller => SettingsSvc.SaveSmtpAsync(caller,
            new SmtpInput(_host, _port, _security, _username, _password, _clearPassword, _fromAddress, _fromName)), "The SMTP settings were saved."));

    private Task TestAsync() =>
        BusyAsync(() => RunAsync(caller => SettingsSvc.SendTestEmailAsync(caller), "A test email was queued. Check your inbox in a minute."), reload: false);
}
