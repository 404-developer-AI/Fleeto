@page "/not-found"
@attribute [AllowAnonymous]
@attribute [AllowWithoutTwoFactor]
@layout LoginLayout

<PageTitle>Page not found - Fleeto</PageTitle>

<div class="login-card">
    <div class="login-header">
        <FleetoMark Size="48" />
        <h1 class="login-title">Page not found</h1>
        <p class="login-subtitle">This page does not exist, or it was moved. Check the address, or go back to the dashboard.</p>
    </div>
    <a href="/" class="login-button" style="display:block;text-align:center;text-decoration:none;box-sizing:border-box;">Back to the dashboard</a>
</div>
