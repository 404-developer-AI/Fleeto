@page "/setup"
@attribute [AllowAnonymous]
@attribute [AllowWithoutTwoFactor]
@attribute [ExcludeFromInteractiveRouting]
@layout LoginLayout
@inject SetupService SetupService
@inject ILogger<Setup> Logger

<PageTitle>Set up Fleeto - Fleeto</PageTitle>

<div class="login-card wide">
    <div class="login-header">
        <FleetoMark Size="48" />
        <h1 class="login-title">Set up Fleeto</h1>
        <p class="login-subtitle">Create the first admin account of this instance.</p>
    </div>

    @switch (_state)
    {
        case SetupTokenState.AdminExists:
            <div class="login-info">Setup is complete. Sign in instead.</div>
            <a href="/account/login" class="login-button" style="display:block;text-align:center;text-decoration:none;box-sizing:border-box;">Sign in</a>
            break;
        case SetupTokenState.Invalid:
            <div class="login-error" role="alert">
                This setup link is not valid. Copy the complete link printed by install.sh, or run install.sh again for a new link.
            </div>
            break;
        case SetupTokenState.Expired:
            <div class="login-error" role="alert">This setup link has expired. Run install.sh (or fleetify-tool migrate) again for a new link.</div>
            break;
        case SetupTokenState.Used:
            <div class="login-error" role="alert">This setup link was already used. Sign in with the account created with it.</div>
            break;
        case SetupTokenState.Valid:
            @if (ProblemMessage is { } problem)
            {
                <div class="login-error" role="alert">@problem</div>
            }
            <form method="post" action="/api/setup">
                <AntiforgeryToken />
                <input type="hidden" name="Token" value="@Token" />
                <div class="login-field">
                    <label for="name" class="login-label">Your name</label>
                    <input type="text" id="name" name="DisplayName" class="login-input" autocomplete="name" maxlength="200" required autofocus />
                </div>
                <div class="login-field">
                    <label for="email" class="login-label">Email address</label>
                    <input type="email" id="email" name="Email" class="login-input" autocomplete="username" maxlength="320" required />
                </div>
                <div class="login-field">
                    <label for="password" class="login-label">Password (at least 12 characters)</label>
                    <input type="password" id="password" name="Password" class="login-input" autocomplete="new-password" minlength="12" maxlength="256" required />
                </div>
                <div class="login-field" style="margin-bottom:24px;">
                    <label for="confirm" class="login-label">Confirm password</label>
                    <input type="password" id="confirm" name="ConfirmPassword" class="login-input" autocomplete="new-password" minlength="12" maxlength="256" required />
                </div>
                <button type="submit" class="login-button">Create admin account</button>
            </form>
            <p class="login-footer">Next you set up two-factor authentication and, optionally, backups.</p>
            break;
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    private string? Token { get; set; }

    [SupplyParameterFromQuery(Name = "problem")]
    private string? Problem { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    private SetupTokenState _state = SetupTokenState.Invalid;

    private string? ProblemMessage =>
        Error == "expired" ? "The page was open too long to submit safely. Fill in the form again."
        : Error == "failed" ? "Something went wrong. Try again, and check the web log if it keeps happening."
        : Enum.TryParse<SetupProblem>(Problem, ignoreCase: true, out var problem) && problem != SetupProblem.None ? SetupResult.Describe(problem)
        : null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _state = await SetupService.CheckAsync(Token);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Checking the setup link failed");
            _state = SetupTokenState.Invalid;
        }
    }
}
