@implements IAsyncDisposable
@inject IJSRuntime JS

@* Live connection dot, version and clock at the bottom of the navigation. The browser pings the circuit every 5 seconds and turns
   the dot red when the server does not answer; the clock runs in the browser in the user's own time zone. *@
<div class="sidebar-status @(Collapsed ? "collapsed" : "")">
    <span class="live-dot" data-fleeto-live role="status" aria-label="Connection to the server"></span>
    @if (!Collapsed)
    {
        <div class="sidebar-status-text">
            <span>v@(FleetifyVersion.Current)</span>
            <span data-fleeto-clock></span>
        </div>
    }
</div>

@code {
    [Parameter]
    public bool Collapsed { get; set; }

    private DotNetObjectReference<SidebarStatus>? _reference;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _reference = DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("fleeto.startStatus", _reference);
        }
        catch (JSException)
        {
            // Without the script the dot stays neutral; nothing else depends on it.
        }
        catch (InvalidOperationException)
        {
            // Static rendering: no circuit to ping.
        }
    }

    /// <summary>Answered by the circuit; a missing answer means the live connection is gone.</summary>
    [JSInvokable]
    public bool Ping() => true;

    public ValueTask DisposeAsync()
    {
        _reference?.Dispose();
        return ValueTask.CompletedTask;
    }
}
