@inherits LayoutComponentBase
@implements IDisposable
@inject TwoFactorGate TwoFactorGate
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject TimeDisplay TimeDisplay
@inject IJSRuntime JS
@inject CurrentUser CurrentUser

<MudThemeProvider Theme="@FleetoTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudDrawer Open="_navOpen" OpenChanged="SetNavOpenAsync" Variant="DrawerVariant.Mini" OpenMiniOnHover="false" Elevation="0"
               Class="@($"app-sidebar {(_navOpen ? "" : "collapsed")}")">
        <div class="sidebar-top">
            <a href="/" class="sidebar-logo" title="Fleeto">
                <FleetoMark Size="32" />
                @if (_navOpen)
                {
                    <span class="sidebar-logo-text">Fleeto</span>
                }
            </a>
        </div>

        <MudNavMenu Class="px-2">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard" title="Dashboard">Dashboard</MudNavLink>
            <MudNavLink Href="/clients" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Business" title="Clients"
                        Class="@(IsClientsArea ? "active" : "")">Clients</MudNavLink>
            <MudNavLink Href="/alerts" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.NotificationsActive" title="Alerts">Alerts</MudNavLink>
            <MudNavGroup Title="Templates" Icon="@Icons.Material.Outlined.LibraryBooks" Expanded="@(_navOpen && _templatesExpanded)"
                         ExpandedChanged="@(v => OnGroupExpandedAsync(v, isTemplates: true))">
                <MudNavLink Href="/templates/client-templates" Match="NavLinkMatch.Prefix">Client templates</MudNavLink>
                <MudNavLink Href="/templates/monitoring-templates" Match="NavLinkMatch.Prefix">Monitoring templates</MudNavLink>
                <MudNavLink Href="/templates/policies" Match="NavLinkMatch.Prefix">Policies</MudNavLink>
            </MudNavGroup>
            <AuthorizeView Policy="@FleetifyPolicies.Admin">
                <MudNavGroup Title="Settings" Icon="@Icons.Material.Outlined.Settings" Expanded="@(_navOpen && _settingsExpanded)"
                             ExpandedChanged="@(v => OnGroupExpandedAsync(v, isTemplates: false))">
                    <MudNavLink Href="/settings/users" Match="NavLinkMatch.Prefix">Users</MudNavLink>
                    <MudNavLink Href="/settings/licensing" Match="NavLinkMatch.Prefix">Licensing</MudNavLink>
                    <MudNavLink Href="/settings/email" Match="NavLinkMatch.Prefix">Email</MudNavLink>
                    <MudNavLink Href="/settings/notification-channels" Match="NavLinkMatch.Prefix">Notification channels</MudNavLink>
                    <MudNavLink Href="/settings/backups" Match="NavLinkMatch.Prefix">Backups</MudNavLink>
                    <MudNavLink Href="/settings/audit-log" Match="NavLinkMatch.Prefix">Audit log</MudNavLink>
                    <MudNavLink Href="/settings/instance" Match="NavLinkMatch.Prefix">Instance</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>
        </MudNavMenu>

        <MudSpacer />

        <div class="sidebar-bottom">
            @if (_navOpen)
            {
                <button type="button" class="sidebar-collapse" @onclick="() => SetNavOpenAsync(false)">
                    <MudIcon Icon="@Icons.Material.Outlined.ChevronLeft" Size="Size.Small" />
                    <span>Collapse</span>
                </button>
            }
            else
            {
                <MudTooltip Text="Expand navigation" Placement="Placement.Right">
                    <button type="button" class="sidebar-collapse icon-only" aria-label="Expand navigation" @onclick="() => SetNavOpenAsync(true)">
                        <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" />
                    </button>
                </MudTooltip>
            }

            <div class="sidebar-footer @(_navOpen ? "" : "collapsed")">
                <SidebarStatus Collapsed="@(!_navOpen)" />
                <div class="sidebar-footer-actions">
                    <AuthorizeView Policy="@FleetifyPolicies.Admin">
                        <MudTooltip Text="Settings" Placement="@(_navOpen ? Placement.Top : Placement.Right)">
                            <a href="/settings/users" class="sidebar-square" aria-label="Settings">
                                <MudIcon Icon="@Icons.Material.Outlined.Settings" Size="Size.Small" />
                            </a>
                        </MudTooltip>
                    </AuthorizeView>
                    <AuthorizeView>
                        <Authorized>
                            <MudMenu AnchorOrigin="@(_navOpen ? Origin.TopLeft : Origin.CenterRight)" TransformOrigin="@(_navOpen ? Origin.BottomLeft : Origin.CenterLeft)"
                                     aria-label="Profile">
                                <ActivatorContent Context="menuContext">
                                    <MudTooltip Text="Profile" Placement="@(_navOpen ? Placement.Top : Placement.Right)">
                                        <span class="sidebar-square" role="button" aria-label="Profile">
                                            <MudIcon Icon="@Icons.Material.Outlined.AccountCircle" Size="Size.Small" />
                                        </span>
                                    </MudTooltip>
                                </ActivatorContent>
                                <ChildContent>
                                    <div class="profile-menu-header">
                                        <div class="profile-menu-name">@(_caller?.Name ?? context.User.Identity?.Name)</div>
                                        @if (_caller is { } caller)
                                        {
                                            <div class="profile-menu-detail">@caller.Email</div>
                                            <div class="profile-menu-detail">@RoleText(caller)</div>
                                        }
                                    </div>
                                    <MudDivider />
                                    <MudMenuItem Icon="@Icons.Material.Outlined.Logout" OnClick="SignOutAsync">Sign out</MudMenuItem>
                                </ChildContent>
                            </MudMenu>
                            @* The menu item submits this form: signing out is a POST with an antiforgery token. *@
                            <form id="fleeto-sign-out" method="post" action="/api/account/logout" class="d-none">
                                <AntiforgeryToken />
                            </form>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Policy="@FleetifyPolicies.Technician">
                        <MudMenu AnchorOrigin="@(_navOpen ? Origin.TopRight : Origin.CenterRight)" TransformOrigin="@(_navOpen ? Origin.BottomRight : Origin.CenterLeft)"
                                 aria-label="Create">
                            <ActivatorContent Context="menuContext">
                                <MudTooltip Text="Create" Placement="@(_navOpen ? Placement.Top : Placement.Right)">
                                    <span class="sidebar-square primary" role="button" aria-label="Create">
                                        <MudIcon Icon="@Icons.Material.Outlined.Add" Size="Size.Small" />
                                    </span>
                                </MudTooltip>
                            </ActivatorContent>
                            <ChildContent>
                                <MudMenuItem Icon="@Icons.Material.Outlined.Business" Href="/clients?new=true">New client</MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Outlined.AccountTree" Href="/templates/client-templates?new=true">New client template</MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Outlined.Rule" Href="/templates/monitoring-templates?new=true">New monitoring template</MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Outlined.Tune" Href="/templates/policies?new=true">New policy</MudMenuItem>
                                <AuthorizeView Policy="@FleetifyPolicies.Admin" Context="adminContext">
                                    <MudDivider />
                                    <MudMenuItem Icon="@Icons.Material.Outlined.PersonAdd" Href="/settings/users?new=true">New user</MudMenuItem>
                                </AuthorizeView>
                            </ChildContent>
                        </MudMenu>
                    </AuthorizeView>
                </div>
            </div>
        </div>
    </MudDrawer>

    <MudMainContent>
        <LicenseBanner />
        <div class="content-area">
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-0">
                @if (_allowed)
                {
                    @Body
                }
                else
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }
            </MudContainer>
        </div>
    </MudMainContent>
</MudLayout>

@code {
    private const string NavOpenKey = "fleeto.nav.open";

    private bool _allowed;
    private Caller? _caller;
    private bool _navOpen = true;
    private bool _templatesExpanded;
    private bool _settingsExpanded;

    private bool IsClientsArea => IsUnder("/clients") || IsUnder("/sites") || IsUnder("/endpoints");

    protected override async Task OnInitializedAsync()
    {
        _templatesExpanded = IsUnder("/templates");
        _settingsExpanded = IsUnder("/settings");
        Navigation.LocationChanged += OnLocationChanged;
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        // Layout gate: a session without completed two-factor setup never renders a page body. The middleware already refuses
        // such sessions at the HTTP level; this covers navigation inside a circuit.
        if (state.User.Identity?.IsAuthenticated == true && await TwoFactorGate.RequiresSetupAsync(state.User))
        {
            Navigation.NavigateTo("/account/setup-2fa", forceLoad: true);
            return;
        }

        _allowed = true;
        if (state.User.Identity?.IsAuthenticated == true)
        {
            try
            {
                _caller = await CurrentUser.GetAsync();
            }
            catch (Exception)
            {
                // The profile menu falls back to the sign-in name; pages resolve the caller themselves.
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            TimeDisplay.SetZone(await JS.InvokeAsync<string>("fleeto.timeZone"));
        }
        catch (JSException)
        {
            // Unknown browser zone: the server zone stays in use.
        }
        catch (InvalidOperationException)
        {
            // Static rendering: no JavaScript connection.
        }

        try
        {
            // A per-browser preference, not account data: kept in local storage.
            if (await JS.InvokeAsync<string?>("fleeto.getPreference", NavOpenKey) == "false")
            {
                _navOpen = false;
                StateHasChanged();
            }
        }
        catch (JSException)
        {
            // No local storage: the navigation stays expanded.
        }
        catch (InvalidOperationException)
        {
        }
    }

    private async Task SetNavOpenAsync(bool open)
    {
        _navOpen = open;
        try
        {
            await JS.InvokeVoidAsync("fleeto.setPreference", NavOpenKey, open ? "true" : "false");
        }
        catch (JSException)
        {
            // The preference is not remembered; the navigation still toggles.
        }
    }

    private async Task SignOutAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("fleeto.submitForm", "fleeto-sign-out");
        }
        catch (JSException)
        {
            Navigation.NavigateTo("/account/login", forceLoad: true);
        }
    }

    private static string RoleText(Caller caller) =>
        caller.IsAdmin ? "Admin" : caller.CanManage ? "Technician" : "Read-only";

    // Opening a group from the collapsed navigation expands the navigation, otherwise its links would stay hidden.
    private async Task OnGroupExpandedAsync(bool expanded, bool isTemplates)
    {
        if (isTemplates)
        {
            _templatesExpanded = expanded;
        }
        else
        {
            _settingsExpanded = expanded;
        }

        if (expanded && !_navOpen)
        {
            await SetNavOpenAsync(true);
        }
    }

    private bool IsUnder(string prefix) =>
        ("/" + Navigation.ToBaseRelativePath(Navigation.Uri)).StartsWith(prefix, StringComparison.OrdinalIgnoreCase);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
